module("Core","RotationMatrix",[=[
-- Numerical part of FUN_005b8c40 (NR2003.exe), nine row-major cells.
-- Inputs are the original angle order in radians; no Roblox axis remap.
local F32 = require(script and script.Parent.Float32 or "Float32")
local M = {}
function M.fromAngles(a, b, c)
    a, b, c = F32.round(a), F32.round(b), F32.round(c)
    local c1, s1 = F32.round(math.cos(a)), F32.round(math.sin(a))
    local c2, s2 = F32.round(math.cos(b)), F32.round(math.sin(b))
    local c3, s3 = F32.round(math.cos(c)), F32.round(math.sin(c))
    return {
        F32.round(c2*c1), F32.round(s3*s2*c1-c3*s1), F32.round(s3*s1+c3*s2*c1),
        F32.round(c2*s1), F32.round(c3*c1+s3*s2*s1), F32.round(c3*s2*s1-s3*c1),
        F32.round(-s2), F32.round(s3*c2), F32.round(c3*c2),
    }
end
return M
]=])
module("Core","Steering",[=[
-- Ackermann, steering slew and speed reduction: Roblox geometry adapter.
local U=require(script and script.Parent.MathUtil or "core.MathUtil")
local M={}
function M.step(current,command,speed,p,wheelbase,track,dt)
    local fraction=math.max(p.minimumFraction,1/(1+math.abs(speed)*p.speedReduction))
    local target=U.clamp(command,-1,1)*p.maximum*fraction
    local angle=U.approach(current,target,(command==0 and p.returnRate or p.rate)*dt)
    if math.abs(angle)&lt;0.00001 then return angle,p.toe,-p.toe end
    local radius=wheelbase/math.tan(math.abs(angle))
    local inner=math.atan(wheelbase/math.max(0.1,radius-track*0.5))
    local outer=math.atan(wheelbase/(radius+track*0.5))
    inner=math.abs(angle)+(inner-math.abs(angle))*p.ackermann
    outer=math.abs(angle)+(outer-math.abs(angle))*p.ackermann
    if angle&gt;0 then return angle,outer+p.toe,inner-p.toe end
    return angle,-inner+p.toe,-outer-p.toe
end
return M
]=])
module("Core","Surface",[=[
local Data=require(script and script.Parent.RecoveredData or "core.RecoveredData")
local U=require(script and script.Parent.MathUtil or "core.MathUtil")
local M={}
M.indices={Asphalt=1,Concrete=2,Brick=3,Cobblestone=3,Grass=5,LeafyGrass=5,Ground=6,Mud=6,
    Sand=7,Pebble=8,Water=9,Metal=10,Wood=16,WoodPlanks=16}
function M.grip(index,multiplier)
    local row=Data.surfaces[(index or 1)+1] or Data.surfaces[2]
    return row.base*(multiplier or 1)
end
function M.resolve(name,index,multiplier)
    if not U.finite(index) then index=nil end
    if not U.finite(multiplier) then multiplier=1 end
    multiplier=U.clamp(multiplier,0,4)
    index=math.max(0,math.min(19,math.floor(index or M.indices[name] or 0)))
    return {index=index,grip=M.grip(index,multiplier)}
end
return M
]=])
module("Core","Suspension",[=[
local L=require(script and script.Parent.Lookup or "core.Lookup")
local F=require(script and script.Parent.Float32 or "core.Float32").round
local C=require(script and script.Parent.RecoveredConstants or "core.RecoveredConstants")
local M={}
-- 006f5b50, 25 samples, header 0/100/23. Actual binary shock lookup.
local shock=L.new(0,100,{0,600,970,1260,1470,1610,1730,1820,1900,1970,2030,2080,
    2130,2180,2230,2280,2330,2390,2445,2500,2560,2620,2690,2760,2840})
function M.springTable(rate,travel,bumpTravel,bumpForce,rounding)
    assert(bumpTravel&gt;0,"bumpTravel must be positive")
    local samples={}; local threshold=travel-bumpTravel
    for i=0,19 do
        local x=i*C["006ea4a4"]; local force=x*rate
        if x&gt;threshold then force=force+((x-threshold)/bumpTravel)^3*bumpForce end
        samples[i+1]=F(force)
    end
    -- 0055e490: unusual first sample is retained, not replaced by zero.
    samples[1]=F(C["006f5b1c"]*C["006f5b2c"]*C["006f5cd0"]*C["006ee5e4"])
    return L.new(0,100,samples,rounding)
end
function M.damperTable(motionRatio,positiveScale,negativeScale,rounding)
    -- 0055e510: asymmetry and exact sample count retained.
    local samples={}; local x=F(-0.35)
    for i=1,35 do
        samples[i]=F(L.sample(shock,-x*motionRatio)*motionRatio*negativeScale)
        x=F(x+C["006ea4a4"])
    end
    x=F(x+C["006ea4a4"]); samples[36]=0
    for i=37,70 do
        samples[i]=F(-L.sample(shock,x*motionRatio)*motionRatio*positiveScale)
        x=F(x+C["006ea4a4"])
    end
    return L.new(F(-0.35),100,samples,rounding)
end
function M.new(p,rounding)
    return {spring=M.springTable(p.rate,p.travel,p.bumpTravel,p.bumpForce,rounding),
        damper=M.damperTable(p.motionRatio,p.rebound,p.compression,rounding)}
end
function M.force(p,position,velocity)
    -- 00560b40
    local s=L.sample(p.spring,position); local d=L.sample(p.damper,velocity)
    return s+d,s,d
end
function M.antiRoll(left,right,preload,rate)
    -- 00560c30, opposite forces.
    local f=(left-right-preload)*rate; return f,-f
end
function M.rearAxle(leftTable,rightTable,heave,roll,heaveRate,rollRate,halfTrack,offset)
    -- 005608d0. Its first antiroll moment is overwritten in the recovered builder.
    local left=M.force(leftTable,heave+roll*halfTrack,heaveRate+rollRate*halfTrack)
    local right=M.force(rightTable,heave-roll*halfTrack-(offset or 0),heaveRate-rollRate*halfTrack)
    return left+right,(left-right)*halfTrack,left,right
end
return M
]=])
module("Core","TestTune",[=[
-- SI units. Diagnostic RWD tune; NOT an extracted NR2003 Cup setup.
local U=require(script and script.Parent.MathUtil or "core.MathUtil")
local T={
    name="NR2003 Lab RWD",version="3.5.0-stage5",originalCalibration=false,
    sourceCommit="03bcafb44cf63464493f1864edbd9f781fac24f4",
    solver="Selected by Roblox.ModeConfig; numeric chassis + raycast suspension by default",rounding="nearest",
    fixedStep=1/288,maxFrame=1/15,gravity=9.80665,
    metresPerStud=0.28,kilogramsPerMassUnit=21.952,mass=1500,
    chassisSize={1.78,0.38,4.45},wheelbase=2.79,frontTrack=1.60,rearTrack=1.59,
    frontZ=-1.35,rearZ=1.44,mountY=-0.05,
    wheelRadius=0.35,wheelWidth=0.30,wheelInertia=1.50,
    springFreeLength=0.38,initialCompression=0.067,maximumRaySlope=0.25,maximumNormalForce=18000,
    frontSuspension={rate=58000,travel=0.18,bumpTravel=0.045,bumpForce=6000,
        motionRatio=1,compression=0.85,rebound=1.15},
    rearSuspension={rate=54000,travel=0.18,bumpTravel=0.045,bumpForce=6000,
        motionRatio=1,compression=0.90,rebound=1.10},
    antiRollFront=18000,antiRollRear=9000,antiRollPreload=0,
    steering={maximum=math.rad(29),rate=math.rad(125),returnRate=math.rad(150),
        speedReduction=0.014,minimumFraction=0.23,ackermann=1,toe=0,camber=math.rad(-1)},
    brake={maximumTorque=7200,frontBias=0.61,handbrakeTorque=1600,dragTorque=1.5},
    tire={slipExponent=3,speedSensitivity=-0.055,slidingDecay=85,
        stiffnessExponent=-0.12,loadSensitivity=0.0155,relaxationLength=0.45,
        longitudinalStiffness=1.05,lateralStiffness=1.10,camberThrust=0.55,
        anisotropy=1/1.05,verticalStiffness=-300000,grip=1,rollingResistance=0.014,
        inverseLoad=1/4000,contactPatch=0.000005},
    thermal={enabled=true,initialK=298.15,coldPressure=28,referencePressure=28,
        optimumPressure=32,minimumPressure=1,loadReference=2000,optimumK=355,maximumK=470,
        heatScale=1,heatFraction=0.45,surfaceCapacity=8500,carcassCapacity=19000,
        conduction=120,surfaceCooling=28,carcassCooling=9,coolingSpeedOffset=0.01,
        brakeCapacity=6500,brakeCooling=0.008},
    engine={idleRPM=900,redlineRPM=8500,engineInertia=0.40,wheelInertia=1.50,
        clutchCapacity=850,gears={2.50,1.78,1.35,1.00},reverseRatio=-2.4,
        finalDrive=3.70,efficiency=0.94,shiftSeconds=0.18,diffPreload=35,diffPowerLock=0.08,
        netTorqueCurve={{0,0},{800,90},{1500,180},{3000,320},{4500,370},{6000,380},
            {7500,360},{8500,300},{9000,0},{25800,0}},
        frictionCurve={{0,20},{1000,35},{3000,60},{6000,100},{9000,155},{25800,650}}},
    aero={enabled=true,area=2.20,length=2.79,baseDrag=0.43,baseLift=-0.58,
        grilleDrag=0,spoilerDrag=0,grilleLift=0,spoilerLift=0,draftLift=0,
        grillePitch=0,spoilerPitch=0,rearDamagePitch=0,frontDamagePitch=0,
        curves={pitchDrag=0,yawDrag=0,yawDragDelta=0,yawSide=0,yawLift=0,yawLiftDelta=0,
            pitchLift=0,yawRoll=0,pitchMoment=0,yawPitch=0,yawPitchDelta=0,yawMoment=0,
            heightDrag=0,heightLift=0,heightPitch=0}},
    environment={ambientK=298.15,airDensity=1.20,wind={0,0,0}},
    adapter={frictionEnvelope=1.35,lowSpeedLongitudinalDamping=900,maxWheelOmega=600,
        thermalGripFloor=0.25,inputTimeout=0.5,telemetryHz=10,maxPacketHz=60},
}
function T.new()
    local p=U.copy(T); p.new=nil
    p.engine.wheelInertia=p.wheelInertia
    p.corners={
        {name="FL",x=-p.frontTrack/2,z=p.frontZ,front=true,side=-1},
        {name="FR",x=p.frontTrack/2,z=p.frontZ,front=true,side=1},
        {name="RL",x=-p.rearTrack/2,z=p.rearZ,front=false,side=-1},
        {name="RR",x=p.rearTrack/2,z=p.rearZ,front=false,side=1},
    }
    return p
end
return T
]=])
module("Core","TireCurves",[=[
local L=require(script and script.Parent.Lookup or "core.Lookup")
local F=require(script and script.Parent.Float32 or "core.Float32").round
local C=require(script and script.Parent.RecoveredConstants or "core.RecoveredConstants")
local M={}
local function finish(a) a[#a-1]=a[#a] end
function M.new(p,rounding)
    -- 0054c1c0, x87 operands inspected. Obfuscated pow helper 006c5c40
    -- remains an inference; these curves are not claimed bit-identical.
    local slip,speed,sliding,load,stiffness={},{},{},{},{}
    for i=0,314 do
        local x=math.abs(i*C["006e9824"]-C["006f58e8"])*0.5
        slip[i+1]=F(1/(1+x^p.slipExponent))
    end
    slip[1]=slip[2]; finish(slip)
    for i=0,28 do
        speed[i+1]=F(1+math.log(i*4+1)/math.log(10)*p.speedSensitivity)
        sliding[i+1]=F(math.exp(-i*4/p.slidingDecay))
        load[i+1]=F(C["006f58a0"]*p.loadSensitivity*C["006f58e4"]*math.exp(1-i*0.125))
    end
    local a=0.75^p.stiffnessExponent; local b=0.75^(p.stiffnessExponent-1)*p.stiffnessExponent
    stiffness[1]=F(a-0.75*b); stiffness[2]=F(a-0.5*b); stiffness[3]=F(a-0.25*b)
    for i=3,28 do stiffness[i+1]=F((i*1000*C["006f58e0"])^p.stiffnessExponent) end
    finish(speed); finish(sliding); finish(load); finish(stiffness)
    local camber={}
    -- 0055e8f0 and 0055e980: Gaussian camber attenuation, 41 samples.
    for i=0,40 do
        local x=C["006f5838"]+i*C["006ea4a4"]
        camber[i+1]=F(0.3*math.exp(x*x*math.log(0.5)/(10*C["006f5cd4"])^2)+0.7)
    end
    camber[1]=camber[2]; camber[#camber]=camber[#camber-1]
    return {slip=L.new(F(-31.4),5,slip,rounding),speed=L.new(0,0.25,speed,rounding),
        sliding=L.new(0,0.25,sliding,rounding),load=L.new(0,8,load,rounding),
        stiffness=L.new(0,F(0.001),stiffness,rounding),camber=L.new(F(-0.2),100,camber,rounding)}
end
return M
]=])
module("Core","TireForces",[=[
-- Numerical path 0054cab0. Call-site coordinates and integration are adapters.
local L=require(script and script.Parent.Lookup or "core.Lookup")
local Float=require(script and script.Parent.Float32 or "core.Float32")
local C=require(script and script.Parent.RecoveredConstants or "core.RecoveredConstants")
local F=Float.round
local M={}
function M.newState()
    return {relaxedLateral=0,relaxedLongitudinal=0,contactMode=2,
        slipLong=0,slipLat=0,slidingFraction=0,rollingTorque=0,rollingForce=0,
        statCount=0,statLong=0,statLat=0,statCombined=0}
end
function M.evaluate(s,p,i)
    local scale=i.scale or 1
    local long=F(i.treadSpeed-i.forwardSpeed); local lat=F(-i.lateralSpeed)
    local rolling=math.abs(i.treadSpeed); local camber=i.camber or 0
    local result={longitudinal=0,lateral=0,normal=0,creepLongitudinal=0,
        aligningMoment=0,rollingTorque=0,contactMode=2,impact=false}
    local bodyGap=i.bodyGap or 0
    local function bodyForce()
        return ((i.bodyDamping or 0)*i.normalSpeed+(i.bodyStiffness or 0)*scale*bodyGap)*scale
    end
    s.slipLong=long; s.slipLat=lat; s.forwardSpeed=i.forwardSpeed; s.rollingSpeed=rolling
    if i.gap&gt;=0 then
        s.relaxedLateral=0; s.relaxedLongitudinal=0
        s.slipLong=0; s.slipLat=0; s.forwardSpeed=0; s.slidingFraction=0; s.rollingForce=0
        if bodyGap&lt;0 then result.normal=F(bodyForce()) end
        result.impact=result.normal&gt;C["006f58f8"]
    else
        local rLat=F((lat-s.relaxedLateral*rolling)*p.relaxationStep+s.relaxedLateral)
        local rLong=F((long-s.relaxedLongitudinal*rolling)*p.relaxationStep+s.relaxedLongitudinal)
        if i.commit~=false then s.relaxedLateral=rLat; s.relaxedLongitudinal=rLong end
        local normal=F(scale*p.verticalStiffness*scale*i.gap); result.normal=normal
        local loadFactor=L.sample(p.curves.load,normal*p.inverseLoad)
        local speedFactor=L.sample(p.curves.speed,rolling)
        local forceScale=F((1-math.abs(camber)*C["006ee390"])*speedFactor*loadFactor*normal)
        local q=normal*C["006f58e0"]
        local longScale=F((1/(q*q+1)+1)*forceScale)
        local stiffness=L.sample(p.curves.stiffness,normal)
        local kLong=F(p.grip*p.longitudinalStiffness*stiffness)
        local kLat=F(p.grip*p.lateralStiffness*stiffness)
        local camberScale=L.sample(p.curves.camber,C["006f58fc"]/(C["006f5900"]-normal)*camber)
        kLong=F(kLong*camberScale); kLat=F(kLat*camberScale)
        local body=0
        if bodyGap&lt;0 then
            body=bodyForce(); result.normal=F(normal+body)
            -- Unresolved coefficient is explicit, rather than mislabeled as recovered.
            kLong=F(kLong*assert(p.bodyStiffnessScale)); kLat=F(kLat*p.bodyStiffnessScale)
        end
        assert(kLong~=0 and kLat~=0 and normal&gt;0,"Tire requires positive load and nonzero stiffness")
        local nLat=F(normal*kLat); local nLong=F(normal*kLong)
        local normalizedLat=F(forceScale/nLat*rLat)
        local camberSlip=F(-p.camberThrust*forceScale*camber/nLat)
        local normalizedLong=F(rLong/nLong*longScale)
        local squared=F(normalizedLat^2+normalizedLong^2)
        local combined=F(Float.inverseSqrt(squared)*squared)
        if math.abs(camber)&lt;C["006ed020"] then
            s.statCount=s.statCount+1; s.statLong=F(s.statLong+normalizedLong)
            s.statLat=F(s.statLat+normalizedLat); s.statCombined=F(s.statCombined+combined)
        end
        local camberBlend=L.sample(p.curves.slip,camberSlip)
        local blend=F(L.sample(p.curves.slip,combined)); s.slidingFraction=F(1-blend)
        local weightedLat=F(((p.anisotropy*blend+1-blend)/kLat)*kLong*lat)
        squared=F(long*long+weightedLat*weightedLat)
        local inverseSpeed=Float.inverseSqrt(squared)
        local adhesion=F(blend*blend*combined)
        local sliding=L.sample(p.curves.sliding,inverseSpeed*squared)*s.slidingFraction
        local multiplier=(sliding+adhesion)*inverseSpeed
        result.lateral=F(((camberBlend*camberBlend*camberSlip+1-camberBlend)*blend+weightedLat*multiplier)*nLat)
        result.longitudinal=F(multiplier*long*nLong)
        s.rollingForce=F(normal*p.rollingResistance); result.rollingTorque=F(p.radius*s.rollingForce)
        result.impact=body&gt;C["006f58f8"]
        if p.front and p.aligningTrailFactor then
            local lateralDirection=F(inverseSpeed*weightedLat*nLat)
            local patch=math.sqrt(math.max(0,normal*p.contactPatch))
            local trail=patch*0.5+result.longitudinal/longScale*C["006e9824"]+(i.trail or 0)+(i.steerTrail or 0)
            result.aligningMoment=F(C["006e9824"]/forceScale*result.lateral*result.longitudinal+
                adhesion*lateralDirection*(trail-patch*blend*p.aligningTrailFactor)+
                sliding*lateralDirection*(trail-(blend+1)*0.5*patch))
        end
        if math.abs(lat)+math.abs(long)+rolling&lt;C["006f58c4"] then
            local px,py=i.anchorLong or 0,i.anchorLat or 0
            local motionSquared=px*px+py*py; local anchorScale=1
            if motionSquared&lt;C["006f58bc"]^2 then result.contactMode=0
            elseif motionSquared&lt;C["006f58c0"]^2 then
                result.contactMode=1; anchorScale=C["006f58bc"]/math.sqrt(motionSquared)
            end
            if result.contactMode&lt;2 then
                result.creepLongitudinal=F((anchorScale*scale*px*C["006f58f4"]-long*C["006f58f0"])*scale*(i.brake or 0))
                result.lateral=F(result.lateral+(i.lateralSpeed*C["006f58f0"]-anchorScale*scale*py*C["006f58ec"])*scale)
            end
        end
    end
    s.contactMode=result.contactMode; s.rollingTorque=result.rollingTorque
    s.normalForce=result.normal; s.longForce=result.longitudinal; s.latForce=result.lateral
    return result
end
return M
]=])
module("Core","TireThermal",[=[
-- Selected numerical paths of 0054d610 and 0054f260.
-- Full wear/failure simulation is NOT replaced by a made-up wear counter.
local C=require(script and script.Parent.RecoveredConstants or "core.RecoveredConstants")
local F=require(script and script.Parent.Float32 or "core.Float32").round
local M={}
function M.new(p)
    return {surface={p.initialK,p.initialK,p.initialK},carcass={p.initialK,p.initialK,p.initialK},
        brakeK=295,pressure=p.coldPressure,gripFactor=1}
end
function M.properties(s,p,ambientK,stiffness)
    local sum=s.carcass[1]+s.carcass[2]+s.carcass[3]
    local pressure=(((sum*C["006f5938"]-ambientK)*0.4+ambientK)/ambientK)*p.coldPressure
    s.pressure=F(pressure)
    local pressureScale=pressure/p.referencePressure*0.9+0.1
    local optimumScale=pressure/p.optimumPressure*0.9+0.1
    local inverseLoad=(C["006f58e4"]-sum*C["006f5934"])/(2*optimumScale*p.loadReference)
    local patch=C["006f5894"]*C["006f588c"]^2/math.max(p.minimumPressure,pressure)
    local hottest=math.max(s.surface[1],s.surface[2],s.surface[3])
    local delta=(sum*C["006f5938"]+hottest)*0.5-p.optimumK
    local exponent=math.min(C["006f5914"],delta)*C["006f5910"]
    local loss=(math.exp(exponent)-1)^2*(delta&lt;0 and C["006f590c"] or 4)
    local pressureGrip=math.exp((pressure-(p.optimumPressure-4))^2*C["006f5908"])*0.1+0.9
    s.gripFactor=F((1-loss)*pressureGrip)
    return {verticalStiffness=stiffness*pressureScale,inverseLoad=inverseLoad,
        contactPatch=patch,rollingScale=1/pressureScale,gripFactor=s.gripFactor}
end
function M.step(s,p,i,dt)
    local slipPower=math.sqrt((i.latForce*i.slipLat*i.sliding)^2+(i.longForce*i.slipLong*i.sliding)^2)
    local rollPower=i.rollingForce*math.abs(i.treadSpeed)
    local speedSum=math.abs(i.slipLong)+math.abs(i.slipLat)+math.abs(i.treadSpeed)
    if speedSum&lt;3 then slipPower=0; rollPower=0
    elseif speedSum&lt;10 then
        local fade=(speedSum-3)*C["006f5930"]; slipPower=slipPower*fade; rollPower=rollPower*fade
    end
    local heat=0.5*p.heatScale*slipPower*p.heatFraction
    local rollingHeat=p.heatScale*rollPower*p.heatFraction
    local camber=(i.side or 1)*(i.camber or 0); local weights={0.6,1,1.4}
    if camber&lt;C["006f591c"] then weights={1.4,1,0.6}
    elseif camber&lt;=C["006f5924"] then local f=camber*C["006f5918"]*0.4; weights={1-f,1,1+f} end
    weights[2]=math.sqrt((s.pressure*0.9)/(p.optimumPressure-4)+0.1)
    weights[1]=weights[1]/weights[2]; weights[3]=weights[3]/weights[2]
    if math.abs(i.forwardSpeed)&lt;9 then
        local fade=math.abs(i.forwardSpeed)*C["006f4a50"]; heat=heat*fade; rollingHeat=rollingHeat*fade
    end
    -- Unknown global speed driver and small offset are explicit test inputs.
    local cooling=math.sqrt(math.max(0,i.speed)+p.coolingSpeedOffset)*dt*C["006ee5e0"]
    for j=1,3 do
        local conduction=(s.surface[j]-s.carcass[j])*p.conduction
        local top=s.surface[j]+(heat*weights[j]-conduction)/p.surfaceCapacity*dt
        local inner=s.carcass[j]+(conduction+rollingHeat)/p.carcassCapacity*dt
        top=top-(top-i.ambientK)*p.surfaceCooling*cooling/p.surfaceCapacity
        inner=inner-(inner-i.ambientK)*p.carcassCooling*cooling/p.carcassCapacity
        s.surface[j]=F(math.min(p.maximumK,top)); s.carcass[j]=F(math.min(p.maximumK,inner))
    end
    for _,j in ipairs({1,3}) do
        local transfer=(s.carcass[2]-s.carcass[j])*p.conduction/p.carcassCapacity*dt*C["006ea48c"]
        s.carcass[2]=F(s.carcass[2]-transfer); s.carcass[j]=F(s.carcass[j]+transfer)
    end
    s.brakeK=F(s.brakeK+((i.brakePower or 0)/p.brakeCapacity-
        (s.brakeK-i.ambientK)*(math.sqrt(math.max(0,i.speed))+1)*p.brakeCooling)*dt)
    return slipPower,rollPower
end
return M
]=])
module("Core","TrackProfile",[=[
-- Computational/data subset of FUN_0050fbd0, NOT the complete INI/Profile API.
local Data = require(script and script.Parent.RecoveredData or "RecoveredData")
local Float32 = require(script and script.Parent.Float32 or "Float32")
local M = {}

-- In the source, 0xcceb79a3 is the float sentinel for an absent override.
local SENTINEL = -123456792
local function override(base, specific, key, default)
    local value = base and base[key]
    if value == nil then value = default end
    local replacement = specific and specific[key]
    if replacement ~= nil and replacement ~= SENTINEL then value = replacement end
    assert(type(value) == "number", "Track profile value must be a number: " .. key)
    return Float32.round(value)
end

-- Inputs are already parsed [track] and [track_&lt;series suffix&gt;] values.
-- These are scalar material factors in the original engine; they do not replace
-- a tire model, nor do they map directly to Roblox CustomPhysicalProperties.
function M.resolve(base, specific)
    local result = { surfaces = {} }
    for key, value in pairs(Data.trackDefaults) do
        result[key] = override(base, specific, key, value)
    end
    for i = 1, #Data.surfaces do
        local surface = Data.surfaces[i]
        local multiplier = override(base, specific, surface.key, 1)
        result.surfaces[i] = {
            index = surface.index, key = surface.key,
            multiplier = multiplier,
            effectiveScalar = Float32.round(surface.base * multiplier),
        }
    end
    return result
end

return M
]=])
module("Core","Tune_Test_Recovered",[=[
-- Recovered embedded baseline for STRUCTURAL TESTS ONLY.
-- Not an A-Chassis tune. No vehicle dynamics solver or drivable car is included.
local Data = require(script and script.Parent.RecoveredData or "RecoveredData")
local Tree = require(script and script.Parent.ComponentTree or "ComponentTree")
local Track = require(script and script.Parent.TrackProfile or "TrackProfile")
local Rotation = require(script and script.Parent.RotationMatrix or "RotationMatrix")
local Tune = {}

function Tune.new()
    local nodes = {}
    for i = 1, #Data.components do
        local source = Data.components[i]
        local node = {}
        for key, value in pairs(source) do
            if type(value) == "table" then
                local copy = {}
                for k, v in pairs(value) do copy[k] = v end
                node[key] = copy
            else
                node[key] = value
            end
        end
        nodes[i] = node
        local fields = node.rawFieldsF32
        node.initialBasis = Rotation.fromAngles(fields["0x51"] * Data.angleScale,
            fields["0x55"] * Data.angleScale, fields["0x59"] * Data.angleScale)
    end
    local roots = Tree.build(nodes)
    local chassis = assert(Tree.find(nodes, "chassis"))
    local states = Tree.countStates(chassis)
    assert(#roots == 1 and states == 45, "Recovered layout differs from NR2003 initialization")
    return {
        name = "NR2003 Embedded Structural Baseline",
        sourceCommit = Data.sourceCommit,
        runnableVehicle = false,
        status = "PARTIAL_RECOVERY_NO_DYNAMICS_SOLVER",
        components = nodes, roots = roots, stateCount = states,
        track = Track.resolve(),
    }
end

return Tune
]=])
module("Core","VehicleDynamics",[=[
-- Adapter state update; numerical kernels remain independently callable/testable.
-- This is not the original 45-state NR2003 multibody integrator.
local U=require(script and script.Parent.MathUtil or "core.MathUtil")
local Suspension=require(script and script.Parent.Suspension or "core.Suspension")
local Curves=require(script and script.Parent.TireCurves or "core.TireCurves")
local Tire=require(script and script.Parent.TireForces or "core.TireForces")
local Thermal=require(script and script.Parent.TireThermal or "core.TireThermal")
local Drive=require(script and script.Parent.Drivetrain or "core.Drivetrain")
local Steering=require(script and script.Parent.Steering or "core.Steering")
local M={}; M.__index=M
function M.new(tune)
    local self=setmetatable({tune=tune,wheels={},steering=0,time=0,steps=0},M)
    self.drive=Drive.new(tune.engine,tune.rounding)
    self.front=Suspension.new(tune.frontSuspension,tune.rounding)
    self.rear=Suspension.new(tune.rearSuspension,tune.rounding)
    for j,c in ipairs(tune.corners) do
        local p=U.copy(tune.tire); p.curves=Curves.new(p,tune.rounding)
        p.front=c.front; p.radius=tune.wheelRadius
        self.wheels[j]={omega=0,angle=0,steer=0,compression=0,load=0,parameters=p,
            tire=Tire.newState(),thermal=Thermal.new(tune.thermal),
            force={longitudinal=0,lateral=0,normal=0},slipRatio=0}
    end
    return self
end
function M:shift(delta) Drive.shift(self.drive,delta,self.tune.engine) end
function M:steer(command,speed,dt)
    local t=self.tune; local left,right
    self.steering,left,right=Steering.step(self.steering,command,speed,t.steering,t.wheelbase,t.frontTrack,dt)
    self.wheels[1].steer=left; self.wheels[2].steer=right
end
function M:step(contacts,input,dt)
    local t=self.tune; local omega,loads,springs,dampers={},{},{},{}
    self.time=self.time+dt; self.steps=self.steps+1
    for j,w in ipairs(self.wheels) do
        local c=contacts[j]; omega[j]=w.omega
        local suspension=j&lt;3 and t.frontSuspension or t.rearSuspension
        w.compression=c.grounded and U.clamp(c.compression,0,suspension.travel+0.03) or 0
        loads[j]=0; springs[j]=0; dampers[j]=0
        if c.grounded then
            loads[j],springs[j],dampers[j]=Suspension.force(j&lt;3 and self.front or self.rear,
                w.compression,-c.compressionRate)
        end
    end
    for _,axle in ipairs({{1,2,t.antiRollFront},{3,4,t.antiRollRear}}) do
        local a,b=axle[1],axle[2]
        if contacts[a].grounded and contacts[b].grounded then
            local left,right=Suspension.antiRoll(self.wheels[a].compression,self.wheels[b].compression,t.antiRollPreload,axle[3])
            loads[a]=loads[a]+left; loads[b]=loads[b]+right
        end
    end
    local torques=Drive.step(self.drive,t.engine,input,omega,dt); local outputs={}
    for j,w in ipairs(self.wheels) do
        local c,p=contacts[j],w.parameters
        local normal=U.clamp(loads[j],0,t.maximumNormalForce)
        local properties=Thermal.properties(w.thermal,t.thermal,t.environment.ambientK,t.tire.verticalStiffness)
        p.verticalStiffness=properties.verticalStiffness; p.inverseLoad=properties.inverseLoad
        p.contactPatch=properties.contactPatch
        p.grip=t.tire.grip*c.grip*math.max(t.adapter.thermalGripFloor,properties.gripFactor)
        p.rollingResistance=t.tire.rollingResistance*properties.rollingScale
        p.relaxationStep=dt/t.tire.relaxationLength
        local force
        if normal&gt;1 and c.grounded and c.grip&gt;0 then
            force=Tire.evaluate(w.tire,p,{gap=normal/p.verticalStiffness,forwardSpeed=c.forwardSpeed,
                lateralSpeed=c.lateralSpeed,normalSpeed=c.normalSpeed,treadSpeed=w.omega*t.wheelRadius,
                camber=c.camber or 0,brake=input.brake,anchorLong=0,anchorLat=0,commit=true})
            -- Explicit raycast integration guard. Not an extra claim of NR parity.
            local magnitude=math.sqrt(force.longitudinal^2+force.lateral^2)
            local limit=normal*c.grip*t.adapter.frictionEnvelope
            if magnitude&gt;limit then
                force.longitudinal=force.longitudinal*limit/magnitude; force.lateral=force.lateral*limit/magnitude
            end
            if math.abs(c.forwardSpeed)&lt;0.5 and input.brake&gt;0 then
                local resistance=-c.forwardSpeed*t.adapter.lowSpeedLongitudinalDamping*input.brake
                force.longitudinal=U.clamp(force.longitudinal+resistance,-limit,limit)
            end
        else
            force=Tire.evaluate(w.tire,p,{gap=1,forwardSpeed=0,lateralSpeed=0,normalSpeed=0,treadSpeed=w.omega*t.wheelRadius})
        end
        local bias=j&lt;3 and t.brake.frontBias or 1-t.brake.frontBias
        local capacity=t.brake.maximumTorque*input.brake*bias*0.5+t.brake.dragTorque+force.rollingTorque
        if j&gt;=3 then capacity=capacity+input.handbrake*t.brake.handbrakeTorque end
        local external=torques[j]-force.longitudinal*t.wheelRadius
        local braking=Drive.brake(w.omega,external,capacity,t.wheelInertia,dt)
        w.omega=U.clamp(w.omega+(external+braking)/t.wheelInertia*dt,-t.adapter.maxWheelOmega,t.adapter.maxWheelOmega)
        w.angle=(w.angle+w.omega*dt)%(2*math.pi); w.load=normal; w.force=force
        w.springForce=springs[j]; w.damperForce=dampers[j]
        w.slipRatio=(w.omega*t.wheelRadius-c.forwardSpeed)/math.max(math.abs(c.forwardSpeed),2)
        w.brakeTorque=braking; w.driveTorque=torques[j]
        if t.thermal.enabled then
            Thermal.step(w.thermal,t.thermal,{latForce=force.lateral,longForce=force.longitudinal,
                slipLat=w.tire.slipLat,slipLong=w.tire.slipLong,sliding=w.tire.slidingFraction,
                rollingForce=w.tire.rollingForce,treadSpeed=w.omega*t.wheelRadius,forwardSpeed=c.forwardSpeed,
                speed=math.abs(c.forwardSpeed),camber=c.camber or 0,side=t.corners[j].side,
                ambientK=t.environment.ambientK,brakePower=math.abs(braking*w.omega)},dt)
        end
        outputs[j]={longitudinal=force.longitudinal,lateral=force.lateral,normal=normal,
            aligningMoment=force.aligningMoment or 0}
        U.assertFinite(outputs[j],"wheel"..j)
    end
    return outputs
end
return M
]=])
module("Roblox","CarBuilder",[=[
-- Generated test geometry. +X right, +Y up, -Z forward; cylinder axle is +X.
-- Wheels/arms are visual mechanisms. Raycast forces own suspension/tire physics.
local TestTune=require(script.Parent.Parent.Core.TestTune)
local Cockpit=require(script.Parent.Cockpit)
local M={}
local colors={body=Color3.fromRGB(35,87,140),frame=Color3.fromRGB(72,80,86),
    tire=Color3.fromRGB(26,27,29),metal=Color3.fromRGB(175,185,198),
    spring=Color3.fromRGB(240,177,52),brake=Color3.fromRGB(205,55,40)}
local function folder(parent,name)
    local f=Instance.new("Folder"); f.Name=name; f.Parent=parent; return f
end
local function part(parent,name,size,cf,color,shape)
    local p=Instance.new("Part"); p.Name=name; p.Size=size; p.CFrame=cf; p.Color=color
    p.Material=Enum.Material.SmoothPlastic; p.Shape=shape or Enum.PartType.Block
    p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
    p.Anchored=false; p.CanCollide=false; p.CanTouch=false; p.CanQuery=false; p.Massless=true
    p.Parent=parent; return p
end
local function attachment(parent,name,cf)
    local a=Instance.new("Attachment"); a.Name=name; a.CFrame=cf or CFrame.new(); a.Parent=parent; return a
end
local function joint(a,b,name,cf,motor)
    local w=Instance.new(motor and "Motor6D" or "Weld"); w.Name=name
    w.Part0=a; w.Part1=b; w.C0=cf; w.C1=CFrame.new(); w.Parent=b; return w
end
local function rod(parent,root,name,a,b,radius,color)
    local delta=b-a; local mid=(a+b)*0.5
    local cf=CFrame.lookAt(mid,mid+delta)*CFrame.Angles(math.pi/2,0,0)
    local p=part(parent,name,Vector3.new(radius,delta.Magnitude,radius),root.CFrame*cf,color)
    joint(root,p,"Pose",cf,false); return p
end
function M.create(parent,spawnCF,tune)
    tune=tune or TestTune.new(); local m=tune.metresPerStud
    local car=Instance.new("Model"); car.Name="TestCar"; car:SetAttribute("NR2003LabVersion",tune.version)
    car:SetAttribute("PhysicsMode","Recovered kernels / Roblox raycast adapter")
    car:SetAttribute("ConfiguredMassKg",tune.mass); car:SetAttribute("MetresPerStud",m)
    local visuals=folder(car,"Visuals"); local wheels=folder(car,"Wheels")
    local suspension=folder(car,"Suspension"); folder(car,"ImportedVisuals")
    local root=part(car,"Chassis",Vector3.new(tune.chassisSize[1],tune.chassisSize[2],tune.chassisSize[3])/m,spawnCF,colors.frame)
    root.Massless=false; root.CanCollide=true; root.CanQuery=true; root.RootPriority=127
    local volume=root.Size.X*root.Size.Y*root.Size.Z
    local density=tune.mass/tune.kilogramsPerMassUnit/volume
    assert(density&gt;=0.01 and density&lt;=100,"Chassis density outside Roblox range")
    root.CustomPhysicalProperties=PhysicalProperties.new(density,0.15,0,100,100)
    car.PrimaryPart=root; attachment(root,"CenterOfMass")
    local seat=Instance.new("VehicleSeat"); seat.Name="DriverSeat"; seat.Size=Vector3.new(0.48,0.15,0.48)/m
    local seatCF=CFrame.new(-0.35/m,0.32/m,0.10/m)
    seat.CFrame=spawnCF*seatCF; seat.CanCollide=false; seat.CanTouch=true; seat.CanQuery=false
    seat.Massless=true; seat.Torque=0; seat.MaxSpeed=0; seat.TurnSpeed=0
    seat.Disabled=false; seat.HeadsUpDisplay=false; seat.Parent=car; joint(root,seat,"DriverSeatMount",seatCF,false)
    local function body(name,size,position,color)
        local cf=CFrame.new(Vector3.new(position[1],position[2],position[3])/m)
        local p=part(visuals,name,Vector3.new(size[1],size[2],size[3])/m,spawnCF*cf,color)
        joint(root,p,"BodyWeld",cf,false); return p
    end
    body("Hood",{1.8,0.08,1.3},{0,0.24,-1.2},colors.body)
    body("Trunk",{1.8,0.08,0.80},{0,0.24,1.50},colors.body)
    body("Roof",{1.40,0.06,1.50},{0,0.93,0.05},colors.body)
    body("FrontBumper",{1.9,0.10,0.12},{0,-0.02,-2.3},colors.metal)
    body("RearBumper",{1.9,0.10,0.12},{0,-0.02,2.3},colors.metal)
    body("EngineBlock",{0.65,0.45,0.70},{0,0.36,-1.08},colors.frame)
    body("Transmission",{0.30,0.26,0.62},{0,0.03,-0.25},colors.metal)
    body("Differential",{0.42,0.28,0.30},{0,-0.24,tune.rearZ},colors.frame)
    body("Spoiler",{1.55,0.22,0.06},{0,0.41,1.9},colors.body)
    for _,x in ipairs({-0.62,0.62}) do
        rod(visuals,root,"RollCage",Vector3.new(x,0.2,-0.8)/m,Vector3.new(x,0.92,-0.5)/m,0.045/m,colors.metal)
        rod(visuals,root,"RearCage",Vector3.new(x,0.92,0.7)/m,Vector3.new(x,0.2,1.1)/m,0.045/m,colors.metal)
    end
    for _,c in ipairs(tune.corners) do
        local wf=folder(wheels,c.name); wf:SetAttribute("Front",c.front); wf:SetAttribute("Side",c.side)
        local mount=Vector3.new(c.x,tune.mountY,c.z)/m
        local upper=attachment(root,"Mount_"..c.name,CFrame.new(mount)); upper:SetAttribute("RayDirection","-Chassis.UpVector")
        local hubPosition=mount-Vector3.new(0,(tune.springFreeLength-tune.initialCompression)/m,0)
        local hub=part(wf,"Hub",Vector3.new(0.12,0.14,0.14)/m,spawnCF*CFrame.new(hubPosition),colors.brake)
        joint(root,hub,"SuspensionMotor",CFrame.new(hubPosition),true)
        attachment(hub,"WheelAxis"); attachment(hub,"SpringLower")
        local wheel=part(wf,"Wheel",Vector3.new(tune.wheelWidth,2*tune.wheelRadius,2*tune.wheelRadius)/m,
            hub.CFrame,colors.tire,Enum.PartType.Cylinder)
        joint(hub,wheel,"SpinMotor",CFrame.new(),true)
        local rim=part(wf,"Rim",Vector3.new(tune.wheelWidth+0.005,0.46,0.46)/m,hub.CFrame,colors.metal,Enum.PartType.Cylinder)
        joint(wheel,rim,"RimWeld",CFrame.new(),false)
        local marker=part(wf,"RotationMarker",Vector3.new(tune.wheelWidth+0.01,0.045,0.06)/m,
            wheel.CFrame*CFrame.new(0,0.23/m,0),colors.spring)
        joint(wheel,marker,"MarkerWeld",CFrame.new(0,0.23/m,0),false)
        local sf=folder(suspension,c.name)
        local inner=Vector3.new(c.x*0.62,tune.mountY+0.08,c.z)/m
        rod(sf,root,"Damper",inner,hubPosition,0.055/m,colors.metal):SetAttribute("Inner",inner)
        for _,dz in ipairs({-0.18,0.18}) do
            local a=Vector3.new(c.x*0.48,tune.mountY-0.05,c.z+dz)/m
            rod(sf,root,dz&lt;0 and "ControlArmFront" or "ControlArmRear",a,hubPosition,0.04/m,colors.frame):SetAttribute("Inner",a)
        end
        for j=1,16 do
            local coil=rod(sf,root,"Coil_"..j,inner,hubPosition,0.018/m,colors.spring)
            coil:SetAttribute("CoilIndex",j); coil:SetAttribute("Inner",inner)
        end
        local contact=attachment(root,"Contact_"..c.name,CFrame.new(hubPosition-Vector3.new(0,tune.wheelRadius/m,0)))
        local beam=Instance.new("Beam"); beam.Name="ContactRay"; beam.Attachment0=upper; beam.Attachment1=contact
        beam.Color=ColorSequence.new(Color3.fromRGB(50,220,110)); beam.Width0=0.018/m; beam.Width1=0.018/m
        beam.FaceCamera=true; beam.Enabled=false; beam.Parent=wf
    end
    Cockpit.ensure(car,tune)
    car.Parent=parent
    local prompt=Instance.new("ProximityPrompt"); prompt.Name="EnterCar"; prompt.ActionText="Dirigir"
    prompt.ObjectText="NR2003 Lab"; prompt.KeyboardKeyCode=Enum.KeyCode.F; prompt.MaxActivationDistance=12
    prompt.RequiresLineOfSight=false; prompt.Parent=seat
    return car
end
function M.makeTrack(parent)
    local track=folder(parent,"TestTrack")
    local function ground(name,size,cf,color,material,index)
        local p=part(track,name,size,cf,color); p.Anchored=true; p.Massless=false
        p.CanCollide=true; p.CanQuery=true; p.Material=material
        p:SetAttribute("NRSurface",index); p:SetAttribute("NRGripMultiplier",1); return p
    end
    ground("Asphalt",Vector3.new(400,2,1000),CFrame.new(0,-1,-350),Color3.fromRGB(57,60,64),Enum.Material.Asphalt,1)
    ground("GrassLane",Vector3.new(30,0.10,190),CFrame.new(65,0.05,-110),Color3.fromRGB(65,117,54),Enum.Material.Grass,5)
    ground("SandLane",Vector3.new(30,0.12,190),CFrame.new(-65,0.06,-110),Color3.fromRGB(209,190,143),Enum.Material.Sand,7)
    ground("Ramp",Vector3.new(22,1,42),CFrame.new(0,2.5,-180)*CFrame.Angles(math.rad(7),0,0),Color3.fromRGB(117,122,130),Enum.Material.Concrete,2)
    for j=1,9 do ground("Bump_"..j,Vector3.new(2.3,0.22,2.1),CFrame.new(25,0.11,-35-j*5),colors.spring,Enum.Material.Concrete,3) end
    for _,x in ipairs({-190,190}) do ground("Barrier",Vector3.new(2,6,1000),CFrame.new(x,3,-350),colors.metal,Enum.Material.Concrete,2) end
    local spawn=Instance.new("SpawnLocation"); spawn.Name="DriverSpawn"; spawn.Size=Vector3.new(7,0.4,7)
    spawn.CFrame=CFrame.new(10,0.2,8); spawn.Anchored=true; spawn.Neutral=true; spawn.Duration=0; spawn.Parent=track
    return track
end
function M.spawnCFrame(tune)
    local height=tune.wheelRadius+tune.springFreeLength-tune.initialCompression-tune.mountY
    return CFrame.new(0,(height+0.03)/tune.metresPerStud,0)
end
return M
]=])
module("Roblox","Cockpit",[=[
-- Visual steering column + wheel. +Z of the pivot points toward the driver.
-- Positive road steering (right) produces clockwise rotation as seen by driver.
local Config=require(script.Parent.DriverConfig)
local M={}
local function part(parent,name,size,cf,color)
    local p=Instance.new("Part"); p.Name=name; p.Size=size; p.CFrame=cf; p.Color=color
    p.Material=Enum.Material.SmoothPlastic; p.Anchored=false; p.Massless=true
    p.CanCollide=false; p.CanTouch=false; p.CanQuery=false; p.Parent=parent
    return p
end
local function weld(a,b,name,cf,motor)
    local w=Instance.new(motor and "Motor6D" or "Weld"); w.Name=name
    w.Part0=a; w.Part1=b; w.C0=cf; w.C1=CFrame.new(); w.Parent=b
    return w
end
local function vector(values) return Vector3.new(values[1],values[2],values[3]) end
local function rod(parent,anchor,name,a,b,thickness,color)
    local cf=CFrame.lookAt((a+b)*0.5,b)
    local p=part(parent,name,Vector3.new(thickness,thickness,(b-a).Magnitude),anchor.CFrame*cf,color)
    weld(anchor,p,"VisualWeld",cf); return p
end
function M.ensure(car,tune)
    local existing=car:FindFirstChild("Cockpit")
    if existing and existing:FindFirstChild("SteeringPivot") then return existing end
    local m=tune.metresPerStud; local root=car.Chassis; local seat=car.DriverSeat
    local cockpit=existing or Instance.new("Folder"); cockpit.Name="Cockpit"; cockpit.Parent=car
    local wheelCF=seat.CFrame*CFrame.new(vector(Config.wheelOffset)/m)*CFrame.Angles(math.rad(Config.columnTiltDegrees),0,0)
    local base=root.CFrame:ToObjectSpace(wheelCF)
    local pivot=part(cockpit,"SteeringPivot",Vector3.new(0.035,0.035,0.035)/m,wheelCF,Color3.fromRGB(60,65,70))
    pivot.Transparency=1
    weld(root,pivot,"SteeringMotor",base,true)
    pivot:SetAttribute("NeutralCFrame",base)
    local geometry=Instance.new("Folder"); geometry.Name="SteeringWheel"; geometry.Parent=cockpit
    local radius=Config.wheelRadius/m; local thickness=Config.wheelTubeRadius*2/m
    local function point(angle) return Vector3.new(math.sin(angle)*radius,math.cos(angle)*radius,0) end
    for i=1,32 do
        rod(geometry,pivot,"Rim_"..i,point((i-1)*math.pi/16),point(i*math.pi/16),thickness,
            Color3.fromRGB(25,28,31))
    end
    for _,angle in ipairs({math.pi/2,-math.pi/2,math.pi}) do
        rod(geometry,pivot,"Spoke",Vector3.zero,point(angle)*0.88,0.025/m,Color3.fromRGB(160,170,181))
    end
    local hub=part(geometry,"Hub",Vector3.new(0.07,0.07,0.05)/m,wheelCF,Color3.fromRGB(58,65,75))
    weld(pivot,hub,"HubWeld",CFrame.new())
    local markerCF=CFrame.new(0,radius,0.004/m)
    local marker=part(geometry,"CenterStripe",Vector3.new(0.026,0.032,0.038)/m,
        wheelCF*markerCF,Color3.fromRGB(255,190,60)); weld(pivot,marker,"MarkerWeld",markerCF)
    local columnCF=wheelCF*CFrame.new(0,0,-0.15/m)
    local column=part(cockpit,"SteeringColumn",Vector3.new(0.035,0.035,0.30)/m,
        columnCF,Color3.fromRGB(115,125,135))
    weld(root,column,"ColumnMount",root.CFrame:ToObjectSpace(columnCF))
    local camera=Instance.new("Attachment"); camera.Name="CockpitCamera"
    camera.CFrame=CFrame.new(vector(Config.cameraOffset)/m)*CFrame.Angles(math.rad(Config.cameraPitchDegrees),0,0)
    camera.Parent=seat
    local axis=Instance.new("Attachment"); axis.Name="SteeringAxis"; axis.Parent=pivot
    axis.CFrame=CFrame.Angles(0,-math.pi/2,0) -- Attachment.Axis = pivot local +Z
    car:SetAttribute("SteeringRatio",Config.steeringRatio)
    return cockpit
end
function M.angle(roadAngle,tune)
    local ratio=(tune.steering and tune.steering.wheelRatio) or Config.steeringRatio
    return roadAngle*ratio
end
function M.update(car,tune,roadAngle)
    local cockpit=car:FindFirstChild("Cockpit")
    local pivot=cockpit and cockpit:FindFirstChild("SteeringPivot")
    if not pivot then return end
    local angle=M.angle(roadAngle,tune)
    pivot.SteeringMotor.C0=pivot:GetAttribute("NeutralCFrame")*CFrame.Angles(0,0,-angle)
end
return M
]=])
module("Roblox","CoreChassisAdapter",[=[
-- Stage 5 host: numeric chassis integration, external geometry queries, pose output.
-- No ApplyImpulse/AssemblyMass or Roblox rigid-body integration for this chassis.
local Core=script.Parent.Parent.Core
local Math=require(Core.NR2003Math)
local Fixed=require(Core.NR2003FixedStep)
local Bridge=require(script.Parent.CoreChassisBridge)
local Contact=require(script.Parent.RaycastContacts)
local Visual=require(script.Parent.VisualRig)
local SeatAccess=require(script.Parent.SeatAccess)
local Cockpit=require(script.Parent.Cockpit)
local RenderSnapshot=require(script.Parent.RenderSnapshot)
local Legacy=require(script.Parent.VehicleController)
local M={};M.__index=M
local B={0,-1,0,0,0,1,-1,0,0};local BT=Math.transpose(B,3,3)
local function array(v) return {v.X,v.Y,v.Z} end
local function vector(a) return Vector3.new(a[1],a[2],a[3]) end
function M.numericPose(s,scale)
    local p=Math.mv(B,s.worldPosition,3)
    local r=Math.mul(Math.mul(B,s.worldRotation,3,3,3),BT,3,3,3)
    return CFrame.new(p[1]/scale,p[2]/scale,p[3]/scale,table.unpack(r))
end
function M:toNumericVector(v) return Math.mv(BT,array(self.origin:VectorToObjectSpace(v)),3) end
function M:toNumericPoint(p) return Math.scale(Math.mv(BT,array(self.origin:PointToObjectSpace(p)),3),self.tune.metresPerStud) end
function M:toWorldVector(v) return self.origin:VectorToWorldSpace(vector(Math.mv(B,v,3))) end
function M:kinematics()
    local s=self.bridge.state.components.chassis
    local linear=self:toWorldVector(Math.slice(s.totalVelocity,1,3))/self.tune.metresPerStud
    local angular=self:toWorldVector(Math.mv(s.worldRotation,Math.slice(s.totalVelocity,4,3),3))
    return linear,angular
end
function M.new(car,tune,remote)
    local self=setmetatable({car=car,root=car.Chassis,tune=tune,origin=car.Chassis.CFrame,
        telemetryTimer=0,debugVisible=false,droppedTime=0,fault=nil,renderSpin={},lastRenderSnapshotTime=nil,renderTeleport=true},M)
    self.spawn=car:GetPivot();self.oldAnchored=self.root.Anchored;self.oldCollide=self.root.CanCollide
    car:SetAttribute("NR2003CorePoseOwner",true);car:SetAttribute("PhysicsMode","NR2003_CORE")
    self.root.Anchored=true;self.root.CanCollide=false
    self.root.AssemblyLinearVelocity=Vector3.zero;self.root.AssemblyAngularVelocity=Vector3.zero
    self.contact=Contact.new(car,tune);self.visual=Visual.new(car,tune)
    self.access=SeatAccess.new(car,remote);Cockpit.ensure(car,tune)
    self:initialize()
    return self
end
function M:initialize()
    self.renderSpin={};self.lastRenderSnapshotTime=nil;self.renderTeleport=true
    self.bridge=Bridge.new(self.tune,self:toNumericVector(Vector3.new(0,-self.tune.gravity,0)))
    self.dynamics=self.bridge.dynamics;self.contacts=self.contact:sample(self.dynamics,function() return Vector3.zero end)
