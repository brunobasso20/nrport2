module("Roblox","CoreChassisBridge",[=[
-- Stage 5 numeric adapter: original integrator owns the chassis, while the tested
-- wheel/suspension/drivetrain adapter supplies forces once per fixed tick.
-- This is deliberately NOT the stage 6 complete 45-state vehicle integration.
local Core=script and script.Parent.Parent.Core
local Solver=require(Core and Core.NR2003VehicleSolver or "NR2003VehicleSolver")
local Integrator=require(Core and Core.NR2003Integrator or "NR2003Integrator")
local State=require(Core and Core.NR2003VehicleState or "NR2003VehicleState")
local Math=require(Core and Core.NR2003Math or "NR2003Math")
local Dynamics=require(Core and Core.VehicleDynamics or "VehicleDynamics")
local Aero=require(Core and Core.Aerodynamics or "Aerodynamics")
local M={};M.__index=M
function M.new(tune,gravity)
    local width,height,length=tune.chassisSize[1],tune.chassisSize[2],tune.chassisSize[3]
    local inertia=tune.coreChassis and tune.coreChassis.inertia or {
        tune.mass*(width^2+height^2)/12,tune.mass*(length^2+height^2)/12,tune.mass*(length^2+width^2)/12}
    local self=setmetatable({tune=tune,dynamics=Dynamics.new(tune),wrenches={},aligningMoments={}},M)
    self.solver=Solver.new({records={{name="chassis",parentName="inertial",flags=39,
        mass=tune.mass,inertia=inertia,offset={0,0,0},angles={0,0,0}}},
        gravity=gravity or {0,0,-tune.gravity},forces=function(_,acc)
            for _,w in ipairs(self.wrenches) do acc:worldWrench("chassis",w.force,w.torque,w.point) end
        end})
    self.state=self.solver.state;return self
end
function M:steer(input)
    local s=self.state.components.chassis
    local forward={s.worldRotation[1],s.worldRotation[4],s.worldRotation[7]}
    self.dynamics:steer(input.steer or 0,Math.dot(Math.slice(s.totalVelocity,1,3),forward),Integrator.dt)
end
-- packet.contacts are scalar raycast samples plus numeric position/normal/forward/right.
-- Host queries after steer(), before step(); no Instances enter this module.
function M:step(input,packet)
    local outputs=self.dynamics:step(packet.contacts,input,Integrator.dt)
    self.wrenches={};self.aligningMoments={}
    for i,o in ipairs(outputs) do
        local c=packet.contacts[i]
        local force=Math.add(Math.add(Math.scale(c.normal,o.normal),Math.scale(c.forward,o.longitudinal)),Math.scale(c.right,o.lateral))
        self.wrenches[#self.wrenches+1]={force=force,torque=Math.scale(c.normal,o.aligningMoment),point=c.position}
        self.aligningMoments[i]=o.aligningMoment
    end
    if self.tune.aero.enabled then
        local s=self.state.components.chassis;local r=s.worldRotation;local rt=Math.transpose(r,3,3)
        local v=Math.mv(rt,Math.sub(Math.slice(s.totalVelocity,1,3),packet.wind or {0,0,0}),3)
        local force,torque=Aero.wrench(self.tune.aero,v,Math.slice(s.totalVelocity,4,3),self.tune.environment.airDensity,
            self.tune.springFreeLength-(self.dynamics.wheels[1].compression+self.dynamics.wheels[2].compression)*.5)
        self.wrenches[#self.wrenches+1]={force=Math.mv(r,force,3),torque=Math.mv(r,torque,3)}
    end
    local flat=self.solver:step(input)
    self.state=self.solver.state;return flat
end
-- Host collision projection. Explicit kinematic collision boundary, not NR2003 crash physics.
function M:project(position,linearVelocity)
    Math.vector(position,3,"projected position");Math.vector(linearVelocity,3,"projected velocity")
    local s=self.state.components.chassis
    s.translation=Math.scale(position,1);s.worldPosition=Math.copy(s.translation)
    for i=1,3 do s.velocity[i]=Math.f(linearVelocity[i]);s.totalVelocity[i]=s.velocity[i] end
    s.momentum=Math.mv(self.solver.graph.byName.chassis.massMatrix,s.totalVelocity,6)
    Integrator.commit(self.solver.graph,self.state)
end
function M:checkpoint()
    return {core=self.solver:checkpoint(),dynamics=State.clone(self.dynamics),wrenches=State.clone(self.wrenches),aligningMoments=State.clone(self.aligningMoments)}
end
function M:restore(c)
    self.solver:restore(c.core);self.state=self.solver.state
    self.dynamics=setmetatable(State.clone(c.dynamics),getmetatable(self.dynamics))
    self.wrenches=State.clone(c.wrenches);self.aligningMoments=State.clone(c.aligningMoments)
end
return M
]=])
module("Roblox","Diagnostics",[=[
-- Run in Studio before and during Play. Checks actual Instances/CFrames.
local M={}
function M.run(car,tune)
    tune=tune or require(script.Parent.Parent.Core.TestTune).new()
    local errors,warnings={},{}; local root=car:FindFirstChild("Chassis")
    local function expect(value,message) if not value then table.insert(errors,message) end end
    expect(root and root:IsA("BasePart"),"Chassis missing or not BasePart")
    if not root then return {ok=false,errors=errors,warnings=warnings} end
    expect(car.PrimaryPart==root,"PrimaryPart must be Chassis")
    local corePose=car:GetAttribute("NR2003CorePoseOwner")==true
    local count,massive,colliding=0,0,0
    for _,p in ipairs(car:GetDescendants()) do
        if p:IsA("BasePart") then
            count=count+1
            expect((p==root and corePose) or not p.Anchored,p:GetFullName().." is unexpectedly anchored")
            if not p.Massless then massive=massive+1 end
            if p.CanCollide then colliding=colliding+1 end
            if p~=root then
                expect(p.Massless,p:GetFullName().." adds mass")
                expect(not p.CanCollide,p:GetFullName().." adds unwanted tire/body contact")
            end
        end
    end
    expect(massive==1,"Exactly one massive part is required")
    expect(colliding==(corePose and 0 or 1),"Collision ownership differs from physics mode")
    if corePose then expect(root.Anchored,"Numeric chassis must be pose-owned") end
    local graph={}; local connected={[root]=true}
    for _,j in ipairs(car:GetDescendants()) do
        if j:IsA("JointInstance") and j.Part0 and j.Part1 then
            graph[j.Part0]=graph[j.Part0] or {}; graph[j.Part1]=graph[j.Part1] or {}
            table.insert(graph[j.Part0],j.Part1); table.insert(graph[j.Part1],j.Part0)
        end
    end
    local queue={root}; local index=1
    while index&lt;=#queue do
        local p=queue[index]; index=index+1
        for _,q in ipairs(graph[p] or {}) do if not connected[q] then connected[q]=true; table.insert(queue,q) end end
    end
    for _,p in ipairs(car:GetDescendants()) do
        if p:IsA("BasePart") then expect(connected[p],p:GetFullName().." is not connected to chassis") end
    end
    local corners={}
    for _,c in ipairs(tune.corners) do
        local mount=root:FindFirstChild("Mount_"..c.name)
        local group=car.Wheels:FindFirstChild(c.name)
        expect(mount~=nil,"Mount missing: "..c.name); expect(group~=nil,"Wheel group missing: "..c.name)
        if mount and group then
            local expected=Vector3.new(c.x,tune.mountY,c.z)/tune.metresPerStud
            expect((mount.Position-expected).Magnitude&lt;0.001,"Mount position differs from tune: "..c.name)
            expect(group.Hub:FindFirstChild("SuspensionMotor")~=nil,"Suspension motor missing: "..c.name)
            expect(group.Wheel:FindFirstChild("SpinMotor")~=nil,"Spin motor missing: "..c.name)
            local axis=group.Hub.WheelAxis
            expect(math.abs(axis.Axis:Dot(Vector3.new(1,0,0))-1)&lt;1e-6,"Wheel axis must be local +X: "..c.name)
            local ray=workspace:Raycast(mount.WorldPosition,-root.CFrame.UpVector*
                ((tune.springFreeLength+tune.wheelRadius+0.1)/tune.metresPerStud),
                (function() local p=RaycastParams.new(); p.FilterType=Enum.RaycastFilterType.Exclude
                    p.FilterDescendantsInstances={car}; p.RespectCanCollide=true; return p end)())
            corners[c.name]={mount=mount.Position,axis=axis.WorldAxis,ground=ray and ray.Instance:GetFullName() or "none"}
            if not ray then table.insert(warnings,"No ground under "..c.name.." (expected during jumps)") end
        end
    end
    local result={ok=#errors==0,errors=errors,warnings=warnings,parts=count,corners=corners,
        connectedParts=#queue,configuredMassKg=tune.mass,assemblyMassUnits=root.AssemblyMass}
    print("NR2003 Diagnostics",result.ok and "PASS" or "FAIL",count,"parts",#queue,"connected")
    for _,e in ipairs(errors) do warn(e) end
    for _,w in ipairs(warnings) do warn(w) end
    return result
end
return M
]=])
module("Roblox","DriverConfig",[=[
-- Roblox cockpit/entry settings. These are test settings, not extracted NR2003 values.
-- Positions below are relative to DriverSeat; SI metres, except explicitly named studs.
return {
    version="3.5.0-stage5",
    entryDistanceStuds=12,
    requestCooldown=0.5,
    entryTimeout=3.5,
    retryInterval=0.35,
    steeringRatio=12, -- steering-wheel angle / centre road-wheel angle
    wheelRadius=0.185,
    wheelTubeRadius=0.016,
    wheelOffset={0,0.44,-0.46},
    columnTiltDegrees=-20,
    cameraOffset={0,0.90,0.08},
    cameraPitchDegrees=-12,
    cockpitFieldOfView=75,
}
