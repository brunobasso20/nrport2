<?xml version='1.0' encoding='utf-8'?>
<roblox version="4">
  <External>null</External>
  <Item class="ModuleScript" referent="RBX_INSTALLER">
    <Properties>
      <string name="Name">NR2003_Patch_Stage5</string>
      <ProtectedString name="Source">return function()
-- PATCH COMPLETO ATÉ O ESTÁGIO 5. Command Bar, fora de Play.
assert(not game:GetService("RunService"):IsRunning(), "Pare Play antes do patch")
local RS=game:GetService("ReplicatedStorage")
local SS=game:GetService("ServerScriptService")
local SP=game:GetService("StarterPlayer"):WaitForChild("StarterPlayerScripts")
local storage=game:GetService("ServerStorage")
local old=assert(RS:FindFirstChild("NR2003Lab"),"Instale a bancada antes do patch")
local world=assert(workspace:FindFirstChild("NR2003LabWorld"),"NR2003LabWorld ausente")
local car=assert(world:FindFirstChild("TestCar"),"TestCar ausente")
assert(car:FindFirstChild("Chassis") and car:FindFirstChild("DriverSeat"),"Chassis/DriverSeat ausente")
assert(old:FindFirstChild("Core") and old.Core:FindFirstChild("TestTune"),"TestTune ausente")
assert(car.Archivable and old.Archivable,"Habilite Archivable no carro e pacote para backup")
local oldServer=SS:FindFirstChild("NR2003Server")
local oldClient=SP:FindFirstChild("NR2003Client")
local package=Instance.new("Folder");package.Name="NR2003Lab"
local core=Instance.new("Folder");core.Name="Core";core.Parent=package
local roblox=Instance.new("Folder");roblox.Name="Roblox";roblox.Parent=package
local destinations={Core=core,Roblox=roblox}
local function module(folder,name,source)
    local m=Instance.new("ModuleScript");m.Name=name;m.Source=source;m.Parent=destinations[folder]
end
module("Core","Aerodynamics",[=[
-- Coefficient combination 00410280 and dynamic pressure 00561b70.
-- Caller supplies selected lookup tables; original branch/table initialization is pending.
local L=require(script and script.Parent.Lookup or "core.Lookup")
local U=require(script and script.Parent.MathUtil or "core.MathUtil")
local C=require(script and script.Parent.RecoveredConstants or "core.RecoveredConstants")
local M={}
local function curve(p,name,x)
    local v=assert(p.curves[name],"Missing aero curve "..name)
    return type(v)=="number" and v or L.sample(v,x)
end
function M.coefficients(p,pitch,yaw,ride,draft,frontHealth,rearHealth,a)
    a=a or {drag=0,lift=0,pitch=0,yaw=0,spoiler=0,grille=0}
    local cy,sy,cp=math.cos(yaw),math.sin(yaw),math.cos(pitch)
    local f=(cy+1)*0.5; local cx=cy*cp
    local h=math.max(0,C["006ec748"]-math.max(0,ride))
    local pitchDrag=curve(p,"pitchDrag",pitch)
    local deform=p.deformation or 0
    local yawDrag=curve(p,"yawDrag",yaw)+curve(p,"yawDragDelta",yaw)*deform
    local yawLift=curve(p,"yawLift",yaw)+curve(p,"yawLiftDelta",yaw)*deform
    local yawPitch=curve(p,"yawPitch",yaw)+curve(p,"yawPitchDelta",yaw)*deform
    local drag=(cy*pitchDrag+yawDrag*cp+(a.grille*p.grilleDrag*rearHealth+
        a.spoiler*p.spoilerDrag*f-p.baseDrag+curve(p,"heightDrag",h)+a.drag)*cx)*draft
    local side=sy*pitchDrag+curve(p,"yawSide",yaw)*cp
    local lift=curve(p,"pitchLift",pitch)*math.abs(cy)+(f*p.baseLift+yawLift+a.lift)*cp+
        (a.grille*p.grilleLift*rearHealth+a.spoiler*p.spoilerLift*f*frontHealth+
        (1-draft)*p.draftLift+curve(p,"heightLift",h))*cx
    local pitchMoment=curve(p,"pitchMoment",pitch)
    local roll=curve(p,"yawRoll",yaw)*cp-sy*pitchMoment*C["006ec744"]
    local pitchTorque=cy*pitchMoment+(yawPitch+a.pitch)*cp+
        (a.grille*p.grillePitch*rearHealth+a.spoiler*p.spoilerPitch*f*frontHealth+
        (1-rearHealth)*p.rearDamagePitch+(1-frontHealth)*p.frontDamagePitch+curve(p,"heightPitch",h))*cx
    return {drag,side,math.min(3,lift)},{roll,pitchTorque,(curve(p,"yawMoment",yaw)+a.yaw)*cp}
end
function M.wrench(p,v,omega,rho,ride)
    -- Source coordinates: forward, left, up.
    local q=(v[1]^2+v[2]^2+v[3]^2)*rho*0.5
    local yaw=U.atan2(v[2],v[1]); local pitch=U.atan2(-v[3],math.sqrt(v[1]^2+v[2]^2))+(p.pitchOffset or 0)
    local force,moment=M.coefficients(p,pitch,yaw,ride,p.draft or 1,1,1,p.adjust)
    local speed=math.sqrt(omega[1]^2+omega[2]^2+omega[3]^2)
    local damping=(speed&gt;0.1 and 1/speed or 10)*C["006f5cf8"]
    for j=1,3 do force[j]=force[j]*q*p.area; moment[j]=(moment[j]+omega[j]*damping)*q*p.area*p.length end
    return force,moment
end
return M
]=])
module("Core","ComponentTree",[=[
-- Configuration dependency port from NR2003.exe; not a motion solver.
-- Source addresses are retained below. Lua 5.1+ and Roblox Luau.
local M = {}

local function band(value, mask)
    local result, place = 0, 1
    while mask &gt; 0 do
        if value % 2 == 1 and mask % 2 == 1 then result = result + place end
        value, mask, place = math.floor(value / 2), math.floor(mask / 2), place * 2
    end
    return result
end

-- FUN_005b2b10, offsets 0x6d, 0x75, 0x71.
function M.clearLinks(node)
    node.parent, node.firstChild, node.nextSibling = nil, nil, nil
end

-- FUN_005b2b20: exact, case-sensitive name lookup.
function M.find(nodes, name)
    for i = 1, #nodes do
        if nodes[i].name == name then return nodes[i] end
    end
    return nil
end

-- FUN_005b2ac0: append after the final sibling.
function M.appendSibling(node, sibling)
    while sibling.nextSibling do sibling = sibling.nextSibling end
    sibling.nextSibling = node
end

-- FUN_005b2a30 + FUN_005b2af0: unknown parent becomes a root.
function M.attach(node, parentName, nodes, roots)
    local parent = M.find(nodes, parentName)
    if not parent then
        roots[#roots + 1] = node
        return
    end
    node.parent = parent
    if parent.firstChild then
        M.appendSibling(node, parent.firstChild)
    else
        parent.firstChild = node
    end
end

-- FUN_005b29c0: clear all links before attaching in record order.
-- Added validation rejects malformed user data; the embedded records pass it.
function M.build(nodes)
    local seen = {}
    for i = 1, #nodes do
        local node = nodes[i]
        assert(type(node.name) == "string" and not seen[node.name], "Invalid/duplicate component name")
        assert(type(node.parentName) == "string", "Missing parent name")
        assert(type(node.flags) == "number" and node.flags &gt;= 0 and node.flags &lt; 2^32
            and node.flags == math.floor(node.flags), "Invalid flags")
        seen[node.name] = node
        M.clearLinks(node)
    end
    for i = 1, #nodes do
        local chain, node = {}, nodes[i]
        while node do
            assert(not chain[node], "Component parent cycle")
            chain[node] = true
            node = seen[node.parentName]
        end
    end
    local roots = {}
    for i = 1, #nodes do M.attach(nodes[i], nodes[i].parentName, nodes, roots) end
    return roots
end

-- FUN_005b2c40. This counts numerical state entries, NOT degrees of freedom.
function M.countStates(node)
    local flags = node.flags
    local count = 2 * (band(flags, 1) + band(math.floor(flags / 2), 1)
        + band(math.floor(flags / 4), 1))
    if band(flags, 0x380) == 0 then
        if band(flags, 0x18) == 0 then
            if band(flags, 0x20) ~= 0 then count = count + 7 end
        else
            count = count + 2
        end
    else
        count = count + 2
    end
    if node.firstChild then count = count + M.countStates(node.firstChild) end
    if node.nextSibling then count = count + M.countStates(node.nextSibling) end
    return count
end

return M
]=])
module("Core","Drivetrain",[=[
local U=require(script and script.Parent.MathUtil or "core.MathUtil")
local Engine=require(script and script.Parent.Engine or "core.Engine")
local M={}
function M.limitTorque(capacity,demand)
    -- 00561040: signed torque opposing demand, limited by capacity.
    return demand&gt;=0 and -math.min(demand,capacity) or math.min(-demand,capacity)
end
function M.new(tune,rounding)
    return {omega=tune.idleRPM*math.pi/30,gear=1,shiftTimer=0,rpm=tune.idleRPM,
        tables=Engine.testTables(tune,rounding),engineTorque=0,clutchTorque=0,clutchSlip=0}
end
function M.shift(s,delta,tune)
    if s.shiftTimer&gt;0 then return end
    s.gear=U.clamp(s.gear+U.sign(delta),-1,#tune.gears); s.shiftTimer=tune.shiftSeconds
end
function M.step(s,tune,input,wheelOmega,dt)
    -- Adapter integration. Does NOT claim the original multibody solve.
    s.shiftTimer=math.max(0,s.shiftTimer-dt); s.rpm=s.omega*30/math.pi
    local ratio=s.gear==-1 and tune.reverseRatio or (s.gear==0 and 0 or tune.gears[s.gear])
    ratio=ratio*tune.finalDrive
    local throttle=math.max(input.throttle,U.clamp((tune.idleRPM-s.rpm)/500,0,0.4))
    local cut=s.rpm&gt;=tune.redlineRPM and 1 or s.shiftTimer
    local torque=Engine.torque(s.tables,s.rpm,throttle,1,cut,0)
    local clutch=1-(input.clutch or 0)
    if s.shiftTimer&gt;0 or ratio==0 then clutch=0 end
    local shaft=(wheelOmega[3]+wheelOmega[4])*0.5*ratio; local slip=s.omega-shaft
    clutch=clutch*U.clamp((s.rpm-tune.idleRPM+250)/1000,0,1)
    -- Automatic launch clutch opens at walking speed with no throttle; no idle creep.
    if math.abs(shaft)&lt;tune.idleRPM*math.pi/30*0.75 and input.throttle&lt;0.01 then clutch=0 end
    local reflected=tune.wheelInertia*2/math.max(ratio*ratio,0.001)
    local effective=1/(1/tune.engineInertia+1/reflected)
    local transfer=U.clamp(slip*effective/dt,-tune.clutchCapacity*clutch,tune.clutchCapacity*clutch)
    local total=transfer*ratio*tune.efficiency
    local capacity=tune.diffPreload+tune.diffPowerLock*math.abs(total)
    local lockDemand=(wheelOmega[3]-wheelOmega[4])*tune.wheelInertia/(2*dt)
    local lock=-M.limitTorque(capacity,lockDemand)
    s.omega=math.max(0,s.omega+(torque-transfer)/tune.engineInertia*dt)
    s.rpm=s.omega*30/math.pi; s.engineTorque=torque; s.clutchTorque=transfer; s.clutchSlip=slip; s.ratio=ratio
    return {0,0,total*0.5-lock,total*0.5+lock}
end
function M.brake(omega,external,capacity,inertia,dt)
    return M.limitTorque(math.max(0,capacity),external+omega*inertia/dt)
end
function M.differentialCapacity(engine,clutch,engagement,gear,finalDrive,powerRamp,coastRamp,axleForce,unloadForce)
    -- 005614b0 with the setup getters passed explicitly.
    local t=gear*finalDrive*(engine+(engagement&gt;=0.9 and clutch or 0))
    t=t&gt;=0 and t*powerRamp or -t*coastRamp
    return math.max(0,(1-math.abs(axleForce)/unloadForce)*t)
end
return M
]=])
module("Core","Engine",[=[
local L=require(script and script.Parent.Lookup or "core.Lookup")
local F=require(script and script.Parent.Float32 or "core.Float32").round
local M={}
function M.fit(p)
    -- 0051a4a0, raw six calibration parameters -&gt; cubic coefficients.
    local x,t,y,u,z,v=p[1],p[2],p[3],p[4],p[5],p[6]
    local x2,y2,z2=x*x,y*y,z*z; local z3=z2*z
    local y3v=y2*y*v; local z3u=z3*u; local delta=y2-2*z*y+z2
    local d=(((2*z3u+y3v-z2*u*y*3)*y*x+
        ((y2*v-2*z*u*y+z2*u)*x2*x-(2*y3v-y2*z*u*3+z3u)*x2))-
        t*delta*y2*z)/(((2*z+y)*y*x+x2*x-(2*y+z)*x2-y2*z)*delta)
    local c=-(((3*y-2*z)*z2*u+(2*z3+y2*y-z2*y*3)*d-y3v)/(delta*z*y))
    local b=((d-v)*y2*3+(3*y2-z2)*c*z)/((2*z-3*y)*z2*y)
    return {F(-(2*b*y+c)/(3*y2)),F(b),F(c),F(d)}
end
function M.testTables(tune,rounding)
    -- Explicit diagnostic torque maps. NOT original NR2003 engine calibration.
    local gross,loss={},{}
    for i=0,129 do
        local rpm=i*200
        loss[i+1]=F(L.linear(tune.frictionCurve,rpm))
        gross[i+1]=F(L.linear(tune.netTorqueCurve,rpm)+loss[i+1])
    end
    return {gross=L.new(0,F(0.005),gross,rounding),friction=L.new(0,F(0.005),loss,rounding)}
end
function M.torque(tables,rpm,throttle,running,cutTimer,damageTorque)
    -- 0051a870. scalar running corresponds to original +0x554.
    local sampleRpm=math.max(0,rpm)
    if cutTimer&gt;0 then throttle=0 end
    local gross=L.sample(tables.gross,sampleRpm)*running
    local idle=1000/math.max(1000,rpm)*running*65
    local combustion=math.max(0,gross-idle)*throttle+idle
    local friction=L.sample(tables.friction,sampleRpm)+math.max(0,damageTorque or 0)
    if rpm&lt;0 then friction=-friction end
    return F(combustion-friction),F(combustion),F(friction)
end
return M
]=])
module("Core","Float32",[=[
-- Round values assigned to C float fields. Extended x87 registers are not emulated.
local M = {}
local storage
if buffer then storage = buffer.create(4) end
function M.round(value)
    if storage then
        buffer.writef32(storage, 0, value)
        return buffer.readf32(storage, 0)
    end
    if string.pack and string.unpack then
        return (string.unpack("&lt;f", string.pack("&lt;f", value)))
    end
    error("Float32 requires Roblox buffer or Lua 5.3+ string.pack")
end
function M.bits(value)
    if storage then buffer.writef32(storage,0,value); return buffer.readu32(storage,0) end
    return (string.unpack("&lt;I4",string.pack("&lt;f",value)))
end
function M.fromBits(value)
    if storage then buffer.writeu32(storage,0,value); return buffer.readf32(storage,0) end
    return (string.unpack("&lt;f",string.pack("&lt;I4",value)))
end
function M.inverseSqrt(x)
    -- 0054cab0, bit reinterpretation (decompiler casts are misleading).
    local bits=math.floor(((0xbe7ffffd-M.bits(x))%4294967296)/2)
    local y=M.fromBits(bits)
    y=M.round((1.5-y*y*0.5*x)*y)
    return M.round((1.5-y*y*0.5*x)*y)
end
return M
]=])
module("Core","Lookup",[=[
-- 005677d1: FIST selects a segment, the argument is NOT clamped.
-- Caller x87 rounding mode is unresolved; expose rather than silently assume floor.
local M={}
function M.roundIndex(x,mode)
    if mode=="floor" then return math.floor(x) end
    if mode=="truncate" then return x&lt;0 and math.ceil(x) or math.floor(x) end
    local n=math.floor(x); local f=x-n
    if f&gt;0.5 or (f==0.5 and n%2~=0) then n=n+1 end
    return n
end
function M.new(x0,inverseStep,samples,rounding)
    assert(#samples&gt;=2 and inverseStep~=0,"Invalid lookup table")
    return {x0=x0,inverseStep=inverseStep,lastSegment=#samples-2,samples=samples,rounding=rounding or "nearest"}
end
function M.sample(t,x)
    local u=(x-t.x0)*t.inverseStep
    local i=math.max(0,math.min(t.lastSegment,M.roundIndex(u,t.rounding)))
    return t.samples[i+1]+(t.samples[i+2]-t.samples[i+1])*(u-i)
end
function M.linear(points,x)
    -- Adapter map, with bounded endpoints; not the NR table format.
    if x&lt;=points[1][1] then return points[1][2] end
    for i=2,#points do
        if x&lt;=points[i][1] then local a,b=points[i-1],points[i]
            return a[2]+(b[2]-a[2])*(x-a[1])/(b[1]-a[1]) end
    end
    return points[#points][2]
end
return M
]=])
module("Core","MathUtil",[=[
local M={}
function M.clamp(x,a,b) return math.max(a,math.min(b,x)) end
function M.sign(x) return x&lt;0 and -1 or (x&gt;0 and 1 or 0) end
function M.finite(x) return type(x)=="number" and x==x and math.abs(x)&lt;math.huge end
function M.approach(x,target,amount) return x+M.clamp(target-x,-amount,amount) end
function M.copy(t)
    if type(t)~="table" then return t end
    local c={}; for k,v in pairs(t) do c[k]=M.copy(v) end; return c
end
function M.atan2(y,x) if math.atan2 then return math.atan2(y,x) end return math.atan(y,x) end
function M.assertFinite(t,label)
    for k,v in pairs(t) do
        if type(v)=="number" then assert(M.finite(v),(label or "state").."."..tostring(k)) end
    end
end
return M
]=])
module("Core","NR2003Components",[=[
-- 005b29c0/005b2d00: physical hierarchy, masks and constant mass matrices.
local Math=require(script and script.Parent.NR2003Math or "NR2003Math")
local Data=require(script and script.Parent.RecoveredData or "RecoveredData")
local Rotation=require(script and script.Parent.RotationMatrix or "RotationMatrix")
local M={}
local function bit(flags,n) return math.floor(flags/2^n)%2==1 end
function M.new(records,overrides)
    local graph={nodes={},byName={},roots={},order={}}
    for _,r in ipairs(records or Data.components) do
        assert(not graph.byName[r.name],"Duplicate component: "..r.name)
        local raw=r.rawFieldsF32 or {}; local flags=r.flags or 0
        local function value(key) return raw[key] or 0 end
        local n={name=r.name,parentName=r.parentName or "inertial",flags=flags,children={},free={},
            offset=r.offset or {value("0x44"),value("0x48"),value("0x4c")},
            mass=math.abs(r.mass or value("0x5d")),
            inertia=r.inertia or {math.abs(value("0x61")),math.abs(value("0x65")),math.abs(value("0x69"))}}
        local angles=r.angles or {Math.f(value("0x51")*Data.angleScale),Math.f(value("0x55")*Data.angleScale),Math.f(value("0x59")*Data.angleScale)}
        n.baseRotation=Rotation.fromAngles(angles[1],angles[2],angles[3])
        n.rotationAxis=math.floor(flags/8)%4
        n.quaternion=n.rotationAxis==0 and bit(flags,5)
        n.axisymmetric=bit(flags,6)
        n.prescribed=math.floor(flags/128)%8
        assert(n.prescribed&lt;=6,"Unknown prescribed coordinate code")
        for axis=1,3 do if bit(flags,axis-1) then n.free[#n.free+1]=axis end end
        if n.rotationAxis&gt;0 then n.free[#n.free+1]=n.rotationAxis+3
        elseif n.quaternion then for axis=4,6 do n.free[#n.free+1]=axis end end
        n.constraint=Math.eye(6)
        for _,axis in ipairs(n.free) do n.constraint[(axis-1)*6+axis]=0 end
        local change=overrides and overrides[n.name]
        if change then n.mass=change.mass or n.mass; n.inertia=change.inertia or n.inertia end
        assert(Math.finite(n.mass) and n.mass&gt;=0,"Invalid mass")
        Math.vector(n.inertia,3,"inertia"); Math.vector(n.offset,3,"offset")
        n.mass=Math.f(n.mass); n.inertia=Math.scale(n.inertia,1); n.offset=Math.scale(n.offset,1)
        n.massMatrix=Math.zero(36)
        for axis=1,6 do
            local v=axis&lt;=3 and n.mass or n.inertia[axis-3]
            assert(v&gt;=0,"Negative inertia"); n.massMatrix[(axis-1)*6+axis]=v
        end
        graph.nodes[#graph.nodes+1]=n; graph.byName[n.name]=n
    end
    for _,n in ipairs(graph.nodes) do
        n.parent=graph.byName[n.parentName]
        assert(n.parent or n.parentName=="inertial","Unknown parent: "..n.parentName)
        local list=n.parent and n.parent.children or graph.roots; list[#list+1]=n
        local seen={}; local p=n
        while p do assert(not seen[p],"Component cycle"); seen[p]=true; p=graph.byName[p.parentName] end
    end
    local function visit(n) graph.order[#graph.order+1]=n for _,c in ipairs(n.children) do visit(c) end end
    for _,r in ipairs(graph.roots) do visit(r) end
    return graph
end
return M
]=])
module("Core","NR2003Constraints",[=[
-- Recovered recursive momentum solve, 005b3180..005b3850.
local Math=require(script and script.Parent.NR2003Math or "NR2003Math")
local Mass=require(script and script.Parent.NR2003MassProperties or "NR2003MassProperties")
local f=Math.f
local M={}
-- Original selected-axis LU, without pivoting: 005b3490 + 005b36c0.
function M.solveSelected(matrix,rhs,axes)
    local lu=Math.zero(36); local result=Math.zero(6)
    local function at(i,j) return (i-1)*6+j end
    for j,axis in ipairs(axes) do
        for k,row in ipairs(axes) do
            local value=matrix[at(row,axis)]
            for h=1,math.min(k,j)-1 do value=f(value-f(lu[at(row,axes[h])]*lu[at(axes[h],axis)])) end
            lu[at(row,axis)]=value
        end
        local diagonal=lu[at(axis,axis)]
        assert(Math.finite(diagonal) and diagonal~=0,"Singular component inertia on axis "..axis)
        if j&lt;#axes then
            local inv=f(1/diagonal)
            for k=j+1,#axes do local index=at(axes[k],axis); lu[index]=f(lu[index]*inv) end
        end
    end
    for j,row in ipairs(axes) do
        local value=rhs[row]
        for k=1,j-1 do value=f(value-f(lu[at(row,axes[k])]*result[axes[k]])) end
        result[row]=value
    end
    for j=#axes,1,-1 do
        local row=axes[j]; local value=result[row]
        for k=j+1,#axes do value=f(value-f(lu[at(row,axes[k])]*result[axes[k]])) end
        result[row]=f(f(1/lu[at(row,row)])*value)
    end
    return result
end
function M.solve(graph,state)
    local function collect(n)
        local s=state.components[n.name]
        s.force=Math.zero(6); s.compositeInertia=Math.copy(n.massMatrix)
        for _,child in ipairs(n.children) do
            collect(child)
            local c=state.components[child.name]
            c.spatialTransform=Mass.spatialTransform(child,state)
            local b=Math.mul(c.spatialTransform,Math.mul(child.constraint,c.compositeInertia,6,6,6),6,6,6)
            local passed=Math.sub(Math.mv(c.spatialTransform,Math.mv(child.constraint,c.momentum,6),6),Math.mv(b,c.velocity,6))
            s.momentum=Math.add(s.momentum,passed)
            s.compositeInertia=Math.add(s.compositeInertia,
                Math.mul(b,Math.transpose(c.spatialTransform,6,6),6,6,6))
        end
    end
    local function distribute(n,inherited)
        local s=state.components[n.name]
        if #n.free&gt;0 then
            local selector=Math.sub(Math.eye(6),n.constraint)
            local matrix=Math.mul(selector,s.compositeInertia,6,6,6)
            local rhs=Math.sub(Math.mv(selector,s.momentum,6),Math.mv(matrix,inherited,6))
            local v=M.solveSelected(matrix,rhs,n.free)
            for _,axis in ipairs(n.free) do s.velocity[axis]=v[axis] end
            s.totalVelocity=Math.add(inherited,s.velocity)
        else s.totalVelocity=Math.copy(inherited) end
        for _,child in ipairs(n.children) do
            local c=state.components[child.name]
            distribute(child,Math.mv(Math.transpose(c.spatialTransform,6,6),s.totalVelocity,6))
        end
    end
    for _,root in ipairs(graph.roots) do collect(root); distribute(root,Math.zero(6)) end
end
return M
]=])
module("Core","NR2003Contact",[=[
-- Contact queries belong to the host. Everything here is plain numeric SI data.
local Math=require(script and script.Parent.NR2003Math or "NR2003Math")
local Tire=require(script and script.Parent.TireForces or "core.TireForces")
local M={}
function M.validate(c)
    assert(type(c)=="table" and type(c.hit)=="boolean","Contact requires hit boolean")
    if not c.hit then return c end
    for _,key in ipairs({"position","normal","forward","left","groundVelocity"}) do Math.vector(c[key],3,key) end
    for _,key in ipairs({"normal","forward","left"}) do
        assert(math.abs(Math.dot(c[key],c[key])-1)&lt;1e-4,"Contact basis must be normalized")
    end
    assert(math.abs(Math.dot(c.normal,c.forward))&lt;1e-4 and math.abs(Math.dot(c.normal,c.left))&lt;1e-4
        and math.abs(Math.dot(c.left,c.forward))&lt;1e-4,"Contact basis must be orthogonal")
    assert(Math.dot(Math.cross(c.forward,c.left),c.normal)&gt;0.999,"Contact basis must be right handed")
    return c
end
function M.applyOutput(accumulator,name,contact,output)
    M.validate(contact); if not contact.hit then return end
    local force=Math.add(Math.add(Math.scale(contact.forward,output.longitudinal or 0),
        Math.scale(contact.left,output.lateral or 0)),Math.scale(contact.normal,output.normal or 0))
    local moment=output.aligningMoment or 0
    local torque=Math.scale(contact.normal,moment)
    -- Output rollingTorque must already have the signed wheel-axis convention.
    if output.rollingTorque then torque=Math.add(torque,Math.scale(contact.left,output.rollingTorque)) end
    accumulator:worldWrench(name,force,torque,contact.position)
    accumulator.aligningMoments[name]=moment
end
function M.evaluate(accumulator,name,contact,tireState,parameters,sample)
    assert(parameters and sample,"Explicit recovered tire parameters/sample required")
    M.validate(contact); if not contact.hit then return nil end
    local output=Tire.evaluate(tireState,parameters,sample)
    -- TireForces returns a resistance magnitude. Resolve its sign at this boundary.
    output.rollingTorque=-(sample.treadSpeed&gt;0 and 1 or sample.treadSpeed&lt;0 and -1 or 0)*(output.rollingTorque or 0)
    M.applyOutput(accumulator,name,contact,output)
    return output
end
return M
]=])
module("Core","NR2003Derivatives",[=[
-- The original step solves momentum/velocity twice. No independent continuous
-- acceleration callback has been identified. Do not label a finite difference f(t,y).
local Math=require(script and script.Parent.NR2003Math or "NR2003Math")
local M={}
function M.coordinateRates(graph,state,layout)
    local result={}
    for _,e in ipairs(layout.entries) do
        local n=graph.byName[e.component]; local s=state.components[e.component]
        if e.field=="translation" then result[e.index]=s.velocity[e.axis]
        elseif e.field=="orientation" then
            if n.quaternion then
                local dq=Math.quatMultiply(s.orientation,Math.join(Math.scale(Math.slice(s.velocity,4,3),0.5),{0}))
                result[e.index]=dq[e.axis]
            else local axis=n.prescribed&gt;=4 and n.prescribed-3 or n.rotationAxis
                result[e.index]=s.velocity[axis+3]
            end
        end
    end
    return {kind="coordinate_rates",values=result,velocityRates="resolved by momentum step"}
end
function M.stepAverage(before,after,dt)
    local a={} for i=1,#before do a[i]=Math.f((after[i]-before[i])/dt) end
    return {kind="step_average",values=a,dt=dt,orientationDifferenceIsWrapped=false}
end
return M
]=])
module("Core","NR2003DrivetrainProjection",[=[
-- 0055fc50 builds a velocity correction matrix; 0055f8f0 applies it.
-- Original model uses LR inertia for the symmetric rear wheel pair.
local Math=require(script and script.Parent.NR2003Math or "NR2003Math")
local f=Math.f
local M={threshold=f(0.9)}
function M.matrix(p)
    local ie,ic,io,iw=f(p.engineInertia),f(p.clutchInertia),f(p.outputInertia),f(p.wheelInertia)
    local g,d=f(p.gearRatio),f(p.finalDrive)
    local engaged=f(p.clutchEngagement or 0); local d2=f(d*d)
    assert(ie&gt;=0 and ic&gt;0 and io&gt;0 and iw&gt;0 and d~=0,"Invalid drivetrain inertias/ratio")
    local m=Math.zero(36)
    local function put(i,j,v) assert(Math.finite(v),"Singular drivetrain"); m[(i-1)*6+j]=f(v) end
    if g==0 then
        local inv=engaged&gt;=M.threshold and f(1/f(ic+ie)) or 0
        put(1,1,-f(ic*inv)); put(2,1,f(inv*ie)); put(1,2,f(ic*inv)); put(2,2,-f(inv*ie))
        inv=f(1/f(f(iw+iw)+f(io*d2)))
        local wheel=f(iw*inv); put(3,3,f(-2*wheel))
        local output=f(inv*io); local a=f(output*d); put(4,3,a); put(5,3,a)
        wheel=f(wheel*d); put(3,4,wheel); put(3,5,wheel)
        local b=f(f(output*d2)*(-0.5)); put(4,4,b); put(5,4,b); put(4,5,b); put(5,5,b)
    else
        local g2=f(g*g); local enabled=1
        if engaged&lt;M.threshold then enabled=0; ie=0 end
        local pair=f(f(ic+ie)*g2); local total=f(pair+io); local wheels=f(iw+iw)
        local inv=f(1/f(f(total*d2)+wheels))
        put(1,1,-(((g2*ic+io)*d2+wheels)*enabled*inv)); put(2,1,g2*inv*ie*d2)
        local a=f(inv*ie*g); put(3,1,d2*a); a=f(a*d); put(4,1,a); put(5,1,a)
        put(1,2,enabled*g2*inv*ic*d2); put(2,2,-(((g2*ie+io)*d2+wheels)*inv))
        a=f(inv*ic*g); put(3,2,d2*a); a=f(a*d); put(4,2,a); put(5,2,a)
        put(1,3,io*enabled*inv*g*d2); put(2,3,g*inv*io*d2); put(3,3,-((pair*d2+wheels)*inv))
        a=f(inv*io*d); put(4,3,a); put(5,3,a)
        a=f(enabled*inv*iw*g*d); local b=f(g*inv*iw*d); local c=f(inv*iw*d); local z=f(total*inv*d2*(-0.5))
        put(1,4,a); put(1,5,a); put(2,4,b); put(2,5,b); put(3,4,c); put(3,5,c)
        put(4,4,z); put(5,4,z); put(4,5,z); put(5,5,z)
    end
    return m
end
function M.apply(solver,accumulator,p)
    local names={"engine","clutch","outshaft","lrwheel","rrwheel"}; local axes={4,4,4,5,5}
    local velocity={0,0,0,0,0,0}
    for i,name in ipairs(names) do velocity[i]=assert(solver.state.components[name]).velocity[axes[i]] end
    local delta=Math.mv(M.matrix(p),velocity,6)
    local reaction=Math.zero(6)
    for i,name in ipairs(names) do
        local s=solver.state.components[name]; local n=solver.graph.byName[name]; local axis=axes[i]
        s.velocity[axis]=f(s.velocity[axis]+delta[i]); s.totalVelocity[axis]=f(s.totalVelocity[axis]+delta[i])
        reaction[axis]=f(reaction[axis]-f(f(delta[i]*288)*n.inertia[axis-3]))
    end
    accumulator:localWrench("chassis",reaction)
    return delta
end
return M
]=])
module("Core","NR2003FixedStep",[=[
-- Scheduling uses 1/288 wall seconds; equations use the recovered float32 dt.
-- Backlog is retained and exposed. Rendering never changes the simulation step.
local Math=require(script and script.Parent.NR2003Math or "NR2003Math")
local M={}; M.__index=M
function M.new(solver,maxSteps)
    maxSteps=maxSteps or 96
    assert(maxSteps&gt;=1 and maxSteps%1==0,"Invalid maxSteps")
    return setmetatable({solver=solver,accumulator=0,wallStep=1/288,maxSteps=maxSteps},M)
end
function M:advance(elapsed,inputProvider,contactProvider)
    assert(Math.finite(elapsed) and elapsed&gt;=0,"Invalid elapsed time")
    self.accumulator=self.accumulator+elapsed
    local count=0
    while self.accumulator+1e-12&gt;=self.wallStep and count&lt;self.maxSteps do
        local tick=self.solver.state.tick
        local input=type(inputProvider)=="function" and inputProvider(tick,self.solver) or inputProvider
        local contacts=type(contactProvider)=="function" and contactProvider(tick,self.solver) or contactProvider
        self.solver:step(input,contacts)
        self.accumulator=self.accumulator-self.wallStep; count=count+1
    end
    if math.abs(self.accumulator)&lt;1e-12 then self.accumulator=0 end
    return count,self.accumulator/self.wallStep
end
function M:checkpoint() return {accumulator=self.accumulator,solver=self.solver:checkpoint()} end
function M:restore(c)
    assert(Math.finite(c.accumulator) and c.accumulator&gt;=0,"Invalid backlog")
    self.solver:restore(c.solver); self.accumulator=c.accumulator
end
return M
]=])
module("Core","NR2003ForceAccumulator",[=[
-- Numeric force interface. Linear wrench is in attachment axes; torque in body axes.
local Math=require(script and script.Parent.NR2003Math or "NR2003Math")
local Mass=require(script and script.Parent.NR2003MassProperties or "NR2003MassProperties")
local M={}; M.__index=M
function M.new(graph,state) return setmetatable({graph=graph,state=state,aligningMoments={}},M) end
function M:localWrench(name,wrench)
    Math.vector(wrench,6,"wrench")
    local s=assert(self.state.components[name],"Unknown component "..tostring(name))
    s.force=Math.add(s.force,wrench)
end
function M:worldWrench(name,force,torque,position)
    local s=assert(self.state.components[name],"Unknown force target")
    Math.vector(force,3,"force"); torque=torque or {0,0,0}; Math.vector(torque,3,"torque")
    if position then Math.vector(position,3,"position"); torque=Math.add(torque,Math.cross(Math.sub(position,s.worldPosition),force)) end
    local linear=Math.mv(Math.transpose(s.attachmentRotation,3,3),force,3)
    local angular=Math.mv(Math.transpose(s.worldRotation,3,3),torque,3)
    self:localWrench(name,Math.join(linear,angular))
end
function M:gravity(acceleration)
    Math.vector(acceleration,3,"gravity")
    for _,n in ipairs(self.graph.nodes) do
        if n.mass~=0 then self:worldWrench(n.name,Math.scale(acceleration,n.mass)) end
    end
end
-- Equal/opposite internal joint force, using the recovered spatial transform.
function M:childReaction(name,wrench)
    local n=assert(self.graph.byName[name]); self:localWrench(name,wrench)
    if n.parent then
        local x=Mass.spatialTransform(n,self.state)
        self:localWrench(n.parent.name,Math.scale(Math.mv(x,wrench,6),-1))
    end
end
function M:jointTorque(name,axis,torque)
    assert(axis&gt;=1 and axis&lt;=3 and axis%1==0,"Invalid torque axis")
    local w=Math.zero(6); w[axis+3]=torque; self:childReaction(name,w)
end
function M:forcePair(a,b,worldForce,position)
    self:worldWrench(a,worldForce,nil,position)
    self:worldWrench(b,Math.scale(worldForce,-1),nil,position)
end
return M
]=])
module("Core","NR2003Integrator",[=[
-- 005b39a0 predictor, 005b3e50 corrector, 005b2fb0 commit.
-- This advances projected momentum; it is not an assumed RK4 or Euler solver.
local Math=require(script and script.Parent.NR2003Math or "NR2003Math")
local Mass=require(script and script.Parent.NR2003MassProperties or "NR2003MassProperties")
local Constraints=require(script and script.Parent.NR2003Constraints or "NR2003Constraints")
local f=Math.f
local M={dt=f(1/288),halfDt=f(1/576),frequency=288}
local function pose(n,state,velocity,h,input)
    local s=state.components[n.name]; local old=s.saved or s
    local prescribed=input and input.prescribed and input.prescribed[n.name]
    if n.prescribed&gt;=1 and n.prescribed&lt;=3 then
        if prescribed~=nil then assert(Math.finite(prescribed),"Invalid prescribed coordinate"); s.translation[n.prescribed]=f(prescribed) end
    else s.translation=Math.add(old.translation,Math.scale(Math.slice(velocity,1,3),h)) end
    if n.parent then
        local p=state.components[n.parent.name]
        s.attachmentRotation=Math.mul(p.worldRotation,n.baseRotation,3,3,3)
        s.attachmentPosition=Math.add(Math.mv(p.worldRotation,n.offset,3),p.worldPosition)
    else s.attachmentRotation=Math.copy(n.baseRotation); s.attachmentPosition=Math.copy(n.offset) end
    s.worldPosition=Math.add(Math.mv(s.attachmentRotation,s.translation,3),s.attachmentPosition)
    local axis=n.prescribed&gt;=4 and n.prescribed-3 or n.rotationAxis
    if axis&gt;0 then
        if n.prescribed&gt;=4 then
            if prescribed~=nil then assert(Math.finite(prescribed),"Invalid prescribed angle"); s.orientation[1]=f(prescribed) end
        else s.orientation[1]=Math.wrap(f(old.orientation[1]+f(h*velocity[axis+3]))) end
        s.relativeRotation=n.axisymmetric and Math.eye(3) or Math.axisRotation(axis,s.orientation[1])
    elseif n.quaternion then
        local omega=Math.scale(Math.scale(Math.slice(velocity,4,3),f(0.5)),h)
        local dq=Math.quatMultiply(old.orientation,Math.join(omega,{0}))
        s.orientation=Math.normalizeQuaternion(Math.add(old.orientation,dq))
        s.relativeRotation=Math.quatRotation(s.orientation)
    else s.relativeRotation=Math.eye(3) end
    s.worldRotation=Math.mul(s.attachmentRotation,s.relativeRotation,3,3,3)
end
function M.geometry(graph,state,input)
    for _,n in ipairs(graph.order) do
        local s=state.components[n.name]; pose(n,state,Math.zero(6),0,input)
        if n.parent then
            s.spatialTransform=Mass.spatialTransform(n,state)
            s.totalVelocity=Math.add(Math.mv(Math.transpose(s.spatialTransform,6,6),state.components[n.parent.name].totalVelocity,6),s.velocity)
        else s.totalVelocity=Math.copy(s.velocity) end
        s.momentum=Math.mv(n.massMatrix,s.totalVelocity,6)
    end
end
function M.commit(graph,state)
    for _,n in ipairs(graph.order) do
        local s=state.components[n.name]
        s.saved={translation=Math.copy(s.translation),orientation=Math.copy(s.orientation),
            attachmentRotation=Math.copy(s.attachmentRotation),worldRotation=Math.copy(s.worldRotation),
            velocity=Math.copy(s.velocity),momentum=Math.mv(n.massMatrix,s.totalVelocity,6),force=Math.copy(s.force)}
    end
end
local function advance(graph,state,h,correct,input)
    for _,n in ipairs(graph.order) do
        local s=state.components[n.name]; local old=s.saved
        local v=correct and Math.add(old.velocity,s.velocity) or old.velocity
        local currentForce=correct and Math.copy(s.force) or nil
        pose(n,state,v,h,input)
        local p=Math.add(old.momentum,Math.scale(old.force,h))
        local a=Math.mul(Math.transpose(s.attachmentRotation,3,3),old.attachmentRotation,3,3,3)
        local b=Math.mul(Math.transpose(s.worldRotation,3,3),old.worldRotation,3,3,3)
        s.momentum=Math.join(Math.mv(a,Math.slice(p,1,3),3),Math.mv(b,Math.slice(p,4,3),3))
        if correct then s.momentum=Math.add(s.momentum,Math.scale(currentForce,h)) end
    end
    Constraints.solve(graph,state)
end
function M.step(graph,state,evaluate,input,contacts)
    advance(graph,state,M.dt,false,input)
    evaluate("predictor",input,contacts)
    advance(graph,state,M.halfDt,true,input)
    evaluate("corrector",input,contacts)
    M.commit(graph,state); state.tick=state.tick+1
end
return M
]=])
module("Core","NR2003MassProperties",[=[
local Math=require(script and script.Parent.NR2003Math or "NR2003Math")
local M={}
-- 005b32e0. X maps a child wrench to its parent; transpose(X) maps velocity down.
function M.spatialTransform(n,state)
    local s=state.components[n.name]; local p=state.components[n.parent.name]
    local r=Math.add(Math.mv(n.baseRotation,s.translation,3),n.offset)
    local a=Math.mul(p.relativeRotation,n.baseRotation,3,3,3)
    local b=Math.mul(Math.skew(r),n.baseRotation,3,3,3)
    local d=Math.mul(n.baseRotation,s.relativeRotation,3,3,3)
    local x=Math.zero(36)
    for i=1,3 do for j=1,3 do
        x[(i-1)*6+j]=a[(i-1)*3+j]
        x[(i+2)*6+j]=b[(i-1)*3+j]
        x[(i+2)*6+j+3]=d[(i-1)*3+j]
    end end
    return x
end
function M.worldInertia(n,s)
    local i=Math.zero(9); for k=1,3 do i[(k-1)*3+k]=n.inertia[k] end
    return Math.mul(Math.mul(s.worldRotation,i,3,3,3),Math.transpose(s.worldRotation,3,3),3,3,3)
end
return M
]=])
module("Core","NR2003Math",[=[
-- Numeric cells of the 005b7xxx/005b8xxx expression engine, row-major matrices.
-- Each primitive corresponds to a stored float cell, not arbitrary Lua arithmetic.
local F = require(script and script.Parent.Float32 or "Float32")
local M = {f=F.round}
local f=F.round
function M.copy(a) local b={} for i=1,#a do b[i]=a[i] end return b end
function M.zero(n) local a={} for i=1,n do a[i]=0 end return a end
function M.eye(n) local a=M.zero(n*n) for i=1,n do a[(i-1)*n+i]=1 end return a end
function M.add(a,b) local c={} for i=1,#a do c[i]=f(a[i]+b[i]) end return c end
function M.sub(a,b) local c={} for i=1,#a do c[i]=f(a[i]-b[i]) end return c end
function M.scale(a,s) local c={} for i=1,#a do c[i]=f(a[i]*s) end return c end
function M.dot(a,b) local s=0 for i=1,#a do s=f(s+f(a[i]*b[i])) end return s end
function M.transpose(a,rows,cols)
    local b={} for i=1,rows do for j=1,cols do b[(j-1)*rows+i]=a[(i-1)*cols+j] end end return b
end
function M.mul(a,b,rows,inner,cols)
    local c={} for i=1,rows do for j=1,cols do
        local s=0 for k=1,inner do s=f(s+f(a[(i-1)*inner+k]*b[(k-1)*cols+j])) end
        c[(i-1)*cols+j]=s
    end end return c
end
function M.mv(a,b,n) return M.mul(a,b,n,#b,1) end
function M.slice(a,start,n) local b={} for i=1,n do b[i]=a[start+i-1] end return b end
function M.join(a,b) local c=M.copy(a) for _,x in ipairs(b) do c[#c+1]=x end return c end
function M.cross(a,b)
    return {f(f(a[2]*b[3])-f(a[3]*b[2])),f(f(a[3]*b[1])-f(a[1]*b[3])),f(f(a[1]*b[2])-f(a[2]*b[1]))}
end
function M.skew(a) return {0,-a[3],a[2],a[3],0,-a[1],-a[2],a[1],0} end
function M.wrap(a)
    local pi=f(math.pi); local tau=f(2*pi)
    while a&gt;=pi do a=f(a-tau) end while a &lt; -pi do a=f(a+tau) end return a
end
function M.axisRotation(axis,angle)
    local c,s=f(math.cos(angle)),f(math.sin(angle))
    if axis==1 then return {1,0,0,0,c,-s,0,s,c}
    elseif axis==2 then return {c,0,s,0,1,0,-s,0,c}
    else return {c,-s,0,s,c,0,0,0,1} end
end
function M.quatMultiply(a,b)
    local av,bv=M.slice(a,1,3),M.slice(b,1,3)
    return M.join(M.add(M.add(M.scale(bv,a[4]),M.scale(av,b[4])),M.cross(av,bv)),
        {f(f(a[4]*b[4])-M.dot(av,bv))})
end
function M.normalizeQuaternion(q)
    local n=M.dot(q,q); assert(n&gt;0 and n&lt;math.huge,"Invalid quaternion")
    return M.scale(q,f(1/f(math.sqrt(n))))
end
function M.quatRotation(q)
    local x,y,z,w=q[1],q[2],q[3],q[4]
    local w2,x2,y2,z2=f(2*w),f(2*x),f(2*y),f(2*z)
    local wx,wy,wz,ww=f(w2*x),f(w2*y),f(w2*z),f(w2*w)
    local xx,xy,xz,yy,yz,zz=f(x2*x),f(x2*y),f(x2*z),f(y2*y),f(y2*z),f(z2*z)
    return {f(f(ww+xx)-1),f(xy-wz),f(xz+wy),f(xy+wz),f(f(ww+yy)-1),f(yz-wx),
        f(xz-wy),f(yz+wx),f(f(ww+zz)-1)}
end
function M.finite(x) return type(x)=="number" and x==x and math.abs(x)&lt;math.huge end
function M.vector(a,n,label)
    assert(type(a)=="table" and #a==n,(label or "vector")..": wrong size")
    for i=1,n do assert(M.finite(a[i]),(label or "vector")..": non-finite value") end
    return a
end
return M
]=])
module("Core","NR2003RecoveredForces",[=[
-- Recovered force algebra; tables and capacities are explicit runtime inputs.
local Math=require(script and script.Parent.NR2003Math or "NR2003Math")
local Integrator=require(script and script.Parent.NR2003Integrator or "NR2003Integrator")
local f=Math.f
local M={}
-- 00561040, opposing torque limited by capacity.
function M.opposingTorque(capacity,demand)
    assert(Math.finite(capacity) and capacity&gt;=0 and Math.finite(demand),"Invalid torque limit")
    return f(-math.max(-capacity,math.min(capacity,demand)))
end
-- 00560b40; lookups return signed forces.
function M.frontSuspension(solver,acc,name,springLookup,damperLookup)
    local s=solver.state.components[name]
    local force=f(springLookup(s.translation[3])+damperLookup(s.velocity[3]))
    acc:childReaction(name,{0,0,force,0,0,0});return force
end
-- 00560c30.
function M.frontAntiRoll(solver,acc,coefficient,preload)
    local s=solver.state.components
    local delta=f(f(s.lfsusp.translation[3]-s.rfsusp.translation[3])-(preload or 0))
    local force=f(coefficient*delta)
    acc:childReaction("lfsusp",{0,0,force,0,0,0})
    acc:childReaction("rfsusp",{0,0,-force,0,0,0});return force
end
-- 005608d0. Initial ARB expression is overwritten in the recovered direct path.
function M.rearSuspension(solver,acc,p)
    local s=solver.state.components.raxle;local arm=p.halfTrack
    local roll=f(s.orientation[1]*arm);local rate=f(s.velocity[4]*arm)
    local left=f(p.leftSpring(f(s.translation[3]+roll))+p.leftDamper(f(s.velocity[3]+rate)))
    local right=f(p.rightSpring(f(f(s.translation[3]-roll)-(p.preload or 0)))+p.rightDamper(f(s.velocity[3]-rate)))
    acc:childReaction("raxle",{0,0,f(left+right),f(f(left*arm)-f(right*arm)),0,0})
