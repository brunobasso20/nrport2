		if fc then fc.trackPoint = trackPoint end
		loaded = true
		V.trackImageBytes = bytes
		return true
	end
	function V.trackLoaded() return loaded end
	function V.worldActive() return active end

	-- placement on the next session start / reset: (dlong, dlat) track coordinates (m), yaw (rad) relative to the track
	function V.setTrackStart(dlong, dlat, yaw)
		yaw = yaw or 0
		assert(dlong == dlong and dlat == dlat and yaw == yaw and math.abs(dlong) &lt; math.huge
			and math.abs(dlat) &lt; math.huge and math.abs(yaw) &lt; math.huge, "NR2003 track: finite start coordinates required")
		start[1], start[2], start[3] = dlong + 0.0, dlat + 0.0, yaw + 0.0
	end
	function V.trackStart() return start[1], start[2], start[3] end
	V.trackStalls = STALLS
	V.trackInfo = function()
		local profiles = {}
		local spec = r32(CAR + 0x58a)
		for w = 0, 3 do profiles[w+1] = r32(spec + 0x4c + 4*w) end
		return {name = TRACK_NAME, sections = r32(0xbad920), length = rf32(0xbad918), stalls = #STALLS,
			chassisType = ri32(CAR + 0x58e), spec = spec, tireProfiles = profiles}
	end

	-- ORIGINAL 005512f0 at its place inside the Frame's 00550a50 subset
	V._place = function()
		if loaded then callx(0x5512f0, nil, f2u(start[1]), f2u(start[2]), f2u(start[3])) end
	end

	local baseEnter = V.enterTrack
	function V.enterTrack()
		if not loaded then return baseEnter() end
		active = false
		for i = 0, 3 do
			local c = contacts[i]
			c.fx, c.fy, c.load, c.contacted, c.count = 0, 0, 0, false, 0
		end
		local k = ri32(CAR + 0x5b2)
		local carobj = BG_CAROBJ + k * CAROBJ_SIZE
		-- session start 00566e50, world part
		callx(0x59fa90, carobj - 0xcc)
		w32(carobj - 0xcc + 0x270, k)
		assert(callx(0x433cb0, nil, k, CAR + 0x58e, carobj) ~= 0, "NR2003 track: 00433cb0 (collision geometry) failed")
		callx(0x578610, WORLD)
		w32(CAR + 0x5ae, carobj + 0x98)
