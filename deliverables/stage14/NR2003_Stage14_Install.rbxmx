<roblox version="4"><Item class="Model" referent="RBX26"><Properties><string name="Name">NR2003_Stage14_Install</string></Properties><Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">Apply</string><ProtectedString name="Source">return function()
    local install=script.Parent;local H=require(install.Support);local manifest=require(install.Manifest)
    return H.lock(function()
        local pkg=game:GetService("ReplicatedStorage").NR2003Lab
        assert(pkg:GetAttribute("NR2003Track")=="watkins_glen","Install supplied Watkins Glen V6 first")
        local oldBackup=game:GetService("ServerStorage"):FindFirstChild(H.BACKUP)
        if oldBackup then
            assert(oldBackup:GetAttribute("Complete")==true and not oldBackup:GetAttribute("RolledBack"),"Retained incomplete backup; run its Rollback before reinstalling")
            for _,r in ipairs(H.records(oldBackup,manifest)) do
                assert(r.object and H.normal(H.source(r.object))==H.normal(r.new),"Stage 14 live source changed: "..r.item.key)
            end
            print("Stage 14 already installed; retained exact original backup");return true
        end
        local plan={}
        for _,item in ipairs(manifest.items) do
            local o,parent,name=H.resolve(item.key,true)
            local src=install.Sources:FindFirstChild(item.key)
            local payload=src and H.source(src)
            if item.server then
                assert(o and o.ClassName=="Script","NR2003Server missing")
                local old=H.source(o)
                assert(old:find("CupChassisAdapter",1,true) and old:find("PreSimulation",1,true),"Unsupported server controller")
                payload=manifest.serverPrefix..old
            else
                assert(payload and H.matches(payload,item.new),"Invalid payload: "..item.key)
                if item.old then assert(o and o.ClassName==item.class and H.matches(H.source(o),item.old),"V6 source differs: "..item.key)
                else assert(not o,"New module already exists: "..item.key) end
            end
            plan[#plan+1]={item=item,object=o,parent=parent,name=name,new=payload,old=o and H.source(o)}
        end
        for _,dep in ipairs(manifest.dependencies) do
            local o=H.resolve(dep.key,true);local accepted=false
            if o and o.ClassName==dep.class then
                for _,h in ipairs(dep.accepted) do if H.matches(H.source(o),h) then accepted=true;break end end
            end
            assert(accepted,"V6 dependency differs: "..dep.key)
        end
        local backup=Instance.new("Folder");backup.Name=H.BACKUP
        backup:SetAttribute("Bundle",manifest.bundle);backup:SetAttribute("PreviousStage14",pkg:GetAttribute("NR2003Stage14"))
        local records=Instance.new("Folder");records.Name="Records";records.Parent=backup
        for _,r in ipairs(plan) do
            local e=Instance.new("Folder");e.Name=r.item.key;e.Parent=records;r.record=e
            local ref=Instance.new("ObjectValue");ref.Name="Target";ref.Value=r.object;ref.Parent=e
            local installed=Instance.new("ModuleScript");installed.Name="Installed";installed.Source=r.new;installed.Parent=e
            local h=H.fingerprint(r.new);e:SetAttribute("NewBytes",h.bytes);e:SetAttribute("NewHash",h.fnv32)
            if r.old then
                local original=Instance.new("ModuleScript");original.Name="Original";original.Source=r.old;original.Parent=e
                h=H.fingerprint(r.old);e:SetAttribute("OldBytes",h.bytes);e:SetAttribute("OldHash",h.fnv32)
            end
        end
        for _,name in ipairs({"Support","Manifest","Rollback"}) do install[name]:Clone().Parent=backup end
        backup.Parent=game:GetService("ServerStorage")
        local ok,err=pcall(function()
            for _,r in ipairs(plan) do
                if not r.object then
                    r.object=Instance.new(r.item.class);r.object.Name=r.name
                    r.record.Target.Value=r.object;r.object.Parent=r.parent
                end
                H.write(r.object,r.new,r.old or "")
            end
            -- Pure protocol/codec smoke test in an isolated module graph (fresh require cache).
            local scratch=Instance.new("Folder");scratch.Name="Stage14SelfTest";scratch.Parent=backup
            local smoke=table.pack(pcall(function()
                for _,name in ipairs({"Stage14SelfTest","PredictionConfig","PredictionCheckpoint","PredictionProtocol","PredictionSession"}) do pkg.Roblox[name]:Clone().Parent=scratch end
                assert(require(scratch.Stage14SelfTest).run(),"Stage 14 smoke test failed")
            end))
            scratch:Destroy();assert(smoke[1],tostring(smoke[2]))
            pkg:SetAttribute("NR2003Stage14",manifest.bundle);backup:SetAttribute("Complete",true)
        end)
        if not ok then
            local restored,why=pcall(H.restore,backup,manifest,true)
            error("Stage 14 install failed: "..tostring(err)..(restored and "; original sources restored" or "; backup retained; rollback recovery failed: "..tostring(why)))
        end
        print("Stage 14 installed. Local NR2003 simulation + asynchronous server validation. Backup: ServerStorage."..H.BACKUP)
        return true
    end)
end
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">Support</string><ProtectedString name="Source">local SES=game:GetService("ScriptEditorService")
local M={}
M.BACKUP="NR2003Backup_Stage14"
function M.normal(s) return (s:gsub("\r\n","\n"):gsub("\r","\n")) end
function M.fingerprint(s)
    s=M.normal(s);local h=2166136261
    for i=1,#s do h=bit32.bxor(h,string.byte(s,i));h=(h*403+bit32.band(h,255)*16777216)%4294967296 end
    return {bytes=#s,fnv32=h}
end
function M.matches(s,h) local a=M.fingerprint(s);return h and a.bytes==h.bytes and a.fnv32==h.fnv32 end
function M.source(o)
    local s=SES:GetEditorSource(o)
    assert(M.normal(s)==M.normal(o.Source),"Save open editor before operation: "..o:GetFullName());return s
end
function M.write(o,s,before)
    SES:UpdateSourceAsync(o,function(current)
        assert(M.normal(current)==M.normal(before),"Concurrent source edit: "..o:GetFullName());return s
    end)
    assert(M.normal(M.source(o))==M.normal(s),"Incomplete source write: "..o:GetFullName())
end
function M.child(p,n,optional)
    local got;for _,c in ipairs(p:GetChildren()) do if c.Name==n then assert(not got,"Duplicate name: "..n);got=c end end
    assert(got or optional,"Missing: "..p:GetFullName().."."..n);return got
end
function M.resolve(key,optional)
    local pkg=M.child(game:GetService("ReplicatedStorage"),"NR2003Lab")
    local roots={Core=pkg.Core,Roblox=pkg.Roblox,CarModel=pkg:FindFirstChild("CarModel"),
        Server=game:GetService("ServerScriptService"),Client=game:GetService("StarterPlayer").StarterPlayerScripts}
    local parts=string.split(key,".");local parent=assert(roots[parts[1]],"Missing root: "..key)
    for i=2,#parts-1 do parent=M.child(parent,parts[i]) end
    return M.child(parent,parts[#parts],optional),parent,parts[#parts]
end
function M.lock(fn)
    assert(not game:GetService("RunService"):IsRunning(),"Stop Play/Run before Stage 14 install or rollback")
    local ss=game:GetService("ServerStorage")
    assert(not ss:FindFirstChild("NR2003WatkinsGlenOperation"),"Another NR2003 operation is running")
    local lock=Instance.new("Folder");lock.Name="NR2003WatkinsGlenOperation";lock.Parent=ss
    local result=table.pack(pcall(fn));lock:Destroy()
    if not result[1] then error(result[2],0) end
    return table.unpack(result,2,result.n)
end
function M.records(backup,manifest)
    assert(backup:GetAttribute("Bundle")==manifest.bundle,"Backup belongs to a different Stage 14 build")
    local records=M.child(backup,"Records");local list={}
    assert(#records:GetChildren()==#manifest.items,"Incomplete Stage 14 backup")
    for _,item in ipairs(manifest.items) do
        local e=M.child(records,item.key);local target=M.child(e,"Target")
        local object=M.resolve(item.key,true)
        assert(target.Value==object,"Target instance changed: "..item.key)
        local old=M.child(e,"Original",true)
        if old then
            assert(M.matches(M.source(old),{bytes=e:GetAttribute("OldBytes"),fnv32=e:GetAttribute("OldHash")}),"Damaged original backup: "..item.key)
            if item.old then assert(M.matches(M.source(old),item.old),"Original backup differs from V6: "..item.key) end
        end
        local new=M.child(e,"Installed")
        assert(M.matches(M.source(new),{bytes=e:GetAttribute("NewBytes"),fnv32=e:GetAttribute("NewHash")}),"Damaged installed backup: "..item.key)
        if not item.server then assert(M.matches(M.source(new),item.new),"Backup source mismatch: "..item.key) end
        if item.server then assert(old and M.normal(M.source(new))==M.normal(manifest.serverPrefix..M.source(old)),"Server backup mismatch") end
        list[#list+1]={item=item,entry=e,object=object,old=old and M.source(old),new=M.source(new)}
    end
    return list
end
function M.restore(backup,manifest,archive)
    local list=M.records(backup,manifest)
    -- Check all live sources before changing any of them.
    for _,r in ipairs(list) do
        if r.object then
            local live=M.source(r.object)
            assert(M.normal(live)==M.normal(r.new) or (r.old and M.normal(live)==M.normal(r.old)) or
                (not backup:GetAttribute("Complete") and not r.old and live==""),"Local edits prevent rollback: "..r.item.key)
        else assert(not r.old,"Original target disappeared: "..r.item.key) end
    end
    for _,r in ipairs(list) do
        if r.old then M.write(r.object,r.old,M.source(r.object)) end
    end
    -- Added modules are removed only after every original source was restored.
    for _,r in ipairs(list) do if not r.old and r.object then r.object:Destroy() end end
    local pkg=game:GetService("ReplicatedStorage").NR2003Lab
    pkg:SetAttribute("NR2003Stage14",backup:GetAttribute("PreviousStage14"))
    backup:SetAttribute("RolledBack",true)
    if archive then
        local name=M.BACKUP.."_RolledBack_"..os.time();local n=1;local unique=name
        while backup.Parent:FindFirstChild(unique) do n+=1;unique=name.."_"..n end
        backup.Name=unique
    end
end
return M
