end
end
-- ===== host side (005b2190 order; Roblox supplies contact planes instead of the track code) =====
local function b64decode(s)
	local map = {}
	local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	for i = 1, 64 do map[string.byte(chars, i)] = i - 1 end
	local out = buffer.create(#s * 3 // 4)
	local n, o = #s, 0
	for i = 1, n, 4 do
		local a, b, c, d = string.byte(s, i, i + 3)
		local va, vb = map[a], map[b]
		local vc, vd = c and map[c], d and map[d]
		local x = va * 262144 + vb * 4096 + (vc or 0) * 64 + (vd or 0)
		buffer.writeu8(out, o, rshift(x, 16)); o += 1
		if c ~= 61 then buffer.writeu8(out, o, band(rshift(x, 8), 0xff)); o += 1 end
		if d ~= 61 then buffer.writeu8(out, o, band(x, 0xff)); o += 1 end
	end
	return out, o
end
local PRISTINE = buffer.create(Image.size)
for _, w in ipairs(Image.windows) do
	local b, n = b64decode(w[2])
	buffer.copy(PRISTINE, w[1], b, 0, n)
end

local HOST = Image.host
local OUTF, OUTP, GV, BLK = HOST, HOST + 0x40, HOST + 0x80, HOST + 0xc0
local INPUTS, STATEBLK, ROOT = 0xbf6360, 0xbf6d40, 0x727290
local ENGINE = 0xc12030 + 0xc

local function f2u(x) wf(S, 0, x); return ru(S, 0) end
local function callx(addr, ...)
	local args = { ... }
	local n = #args
	ESP = band(ESP - 4 * (n + 1))
	for k = 1, n do w32(ESP + 4 * k, args[k]) end
	w32(ESP, 0)
	XF[addr]()
	ESP = band(ESP + 4 * n)
end

local V = {}
V.__index = V
V.frequency = 288
V.dt = 0.0034722222480922937

function V.reset()
	buffer.copy(M, 0, PRISTINE, 0, Image.size)
	EAX, EBX, ECX, EDX, ESI, EDI, EBP = 0, 0, 0, 0, 0, 0, 0
	ESP = Image.stackTop; table.clear(F); FT = 0; FSW = 0; BG = 1
	w8(0xbf6e04, 1)      -- 00551880: player vehicle simulated
	w32(0xbf6e9c, 8)     -- 00555140: ticks per task frame
	V.tick = 0
end

-- contact: {nx, ny, nz, d, gvx, gvy, gvz, surface, grip}: plane n.x + d = 0 in vehicle-world axes
local function tires(contacts, phase)
	-- contacts: array of 4 planes, or a function(phase) returning one (the original queries the
	-- track twice per tick, 00578da0 before the first forces pass and 00578de0 before the second)
	if type(contacts) == "function" then contacts = contacts(phase) end
	for i = 0, 3 do
		local c = contacts[i + 1]
		wf(M, GV + 16 * i - BASE, c[5] or 0); wf(M, GV + 16 * i + 4 - BASE, c[6] or 0); wf(M, GV + 16 * i + 8 - BASE, c[7] or 0)
		callx(0x55e1e0, OUTF + 16 * i, f2u(c[9] or 1), OUTP + 16 * i, GV + 16 * i, BLK + 32 * i, i,
			f2u(c[1]), f2u(c[2]), f2u(c[3]), f2u(c[4]), c[8] or 1)
		if FT &gt; 0 then F[FT] = nil; FT = FT - 1 end -- 0055e1e0 float10 return (skid level) unused here
	end
end

local INPUT_KEYS = { "lfSteer", "rfSteer", "throttle", "brake", "clutch", "gear" }
local TPF = 8 -- 00555140: physics ticks per 36 Hz task frame (288 / taskGetRate)

local function exportState() w32(0xe847c8, STATEBLK); callx(0x5b2cb0, STATEBLK, ROOT) end
local function frameEnd()
	-- 00554520 -&gt; 0051aac0(1/taskGetRate): ignition/shift cut timer (+0x550) countdown only.
	-- Engine thermal/fuel burn/damage/misfire of 0051aac0, tire thermal 0054d610 and fuel mass
	-- 005605c0 are Stage 11 and stay frozen at their build values (documented).
	local t = rf32(ENGINE + 0x550)
	if t &gt; 0 then
		t = fd(t - fd(1 / 36))
		wf32(ENGINE + 0x550, t &lt; 0 and 0 or t)
	end
end

-- Raw core tick (inputs written directly to bf6360; used by the emulator comparison tests)
function V.stepRaw(input, contacts)
	for k = 1, 6 do wf(M, INPUTS + 4 * (k - 1) - BASE, input[INPUT_KEYS[k]] or 0) end
	for k = 7, 9 do wf(M, INPUTS + 4 * (k - 1) - BASE, 0) end
	w8(0xe843fc, 1)
	callx(0x5b2b90, ROOT, INPUTS)
	tires(contacts); callx(0x5b2bd0)
	w8(0xe843fc, 0)
	callx(0x5b2be0)
	tires(contacts); callx(0x5b2bd0)
	callx(0x5b2c00)
	V.tick += 1
	if V.tick % TPF == 0 then frameEnd() end
end
V.step = V.stepRaw -- backwards-compatible name

-- ===== host services =====
-- 0055e1e0 per-wheel outputs of the last tire pass: out1 (z = normal load N; x/y semantics not
-- recovered) and contact point (vehicle-world)
function V.contactOut(i)
	local a, b = OUTF + 16 * i, OUTP + 16 * i
	return rf32(a), rf32(a + 4), rf32(a + 8), rf32(b), rf32(b + 4), rf32(b + 8)
end
-- persistent per-wheel contact block (param_5 of 0055e1e0): anchor xyz + 2 tire states.
-- 005778a0 re-initialises it when a contact pair is (re)created: anchor = contact position, states = 0.
function V.resetContactBlock(i, x, y, z)
	local b = BLK + 32 * i
	wf32d(b, x); wf32d(b + 4, y); wf32d(b + 8, z); w32(b + 12, 0); w32(b + 16, 0)
end
-- position teleport through the ORIGINAL state import 005b4560 (component positions are primary
-- integrator state; velocities/momenta are NOT changed by this path)
function V.translate(dx, dy, dz)
	local S = HOST + 0x140
	callx(0x5b2cb0, S, ROOT)
	wf32(S, rf32(S) + dx); wf32(S + 8, rf32(S + 8) + dy); wf32(S + 16, rf32(S + 16) + dz)
	w32(0xe847c8, S); w32(0xe84664, 0xe84474)
	callx(0x5b4560, ROOT)
end
-- Stage 14: closures are simulation state too. Registration never stores functions in packets.
local checkpointHooks = {}
local function copyState(x)
    if type(x) ~= "table" then return x end
    local t = {}; for k, v in pairs(x) do t[k] = copyState(v) end; return t
end
V._copyState = copyState
function V._registerCheckpoint(name, capture, restore)
    checkpointHooks[name] = {capture, restore}
end
function V.checkpoint()
	local c = buffer.create(Image.size)
	buffer.copy(c, 0, M, 0, Image.size)
	local hosts = {}
    for name, h in pairs(checkpointHooks) do hosts[name] = copyState(h[1]()) end
    return { memory = c, tick = V.tick, schema = 14, hosts = hosts,
        machine = {EAX, EBX, ECX, EDX, ESI, EDI, EBP, ESP, FT, FSW, FCW, FR, FZ, FS, FC, FO, FP, BG},
        fpu = table.clone(F) }
end
function V.restore(c)
	buffer.copy(M, 0, c.memory, 0, Image.size)
	ESP = Image.stackTop; table.clear(F); FT = 0
    assert(buffer.len(c.memory) == Image.size, "checkpoint memory size")
    V.tick = c.tick
    if c.schema == 14 then
        local r = c.machine
        EAX, EBX, ECX, EDX, ESI, EDI, EBP, ESP, FT, FSW, FCW = table.unpack(r, 1, 11)
        FR, FZ, FS, FC, FO, FP, BG = table.unpack(r, 12, 18)
        table.clear(F); for k, v in pairs(c.fpu) do F[k] = v end
        for name, h in pairs(checkpointHooks) do
            assert(c.hosts[name] ~= nil, "checkpoint host missing: " .. name)
            h[2](copyState(c.hosts[name]))
        end
    end
end

-- 45-state export (005b2cb0) into a host scratch block, so that reading the state never
-- changes the game's own state block bf6d40 (read by 00554f10 / 00554ee0 in the next tick)
local SCRATCH = HOST + 0x140
function V.state(out)
	out = out or table.create(45, 0)
	callx(0x5b2cb0, SCRATCH, ROOT)
	for i = 0, 44 do out[i + 1] = rf32(SCRATCH + 4 * i) end
	return out
end

-- raw access for adapters/telemetry/tests (addresses are original NR2003 addresses)
V.rf32 = rf32; V.ri32 = ri32; V.r32 = r32; V.r8 = r8; V.wf32 = wf32; V.w32 = w32
V.memory = function() return M end
V._callx = callx; V._tires = tires; V._w8 = w8
V._export = exportState; V._frameEnd = frameEnd
V._popF = function() local v = F[FT]; F[FT] = nil; FT = FT - 1; return v end
V.fd = fd; V.wf32d = wf32d; V.rf64 = rf64; V.wf64 = wf64; V.w8 = w8
V.TPF = TPF; V.ENGINE = ENGINE; V.ROOT = ROOT; V.INPUTS = INPUTS; V.STATEBLK = STATEBLK
V._fpu = function() return FT, ESP end
V._jit = function(a) JIT[a]() end
V.base = BASE
-- Stage 10: the setup application (NR2003CupBuild) rebuilds the car on M and commits the result as the
-- new reset image (the original rebuilds the car when a garage setup is applied)
V._pristine = function() return PRISTINE end
V.imageSize = Image.size
-- the translated callback table (005b9d10 targets) and a loader for another callback set built from the
-- same services (Stage 10 generic structure, NR2003CupJITG*)
V._jitTable = function() return JIT end

-- install the translated JIT callbacks (NR2003CupJIT* modules)
local ctx = { M = M, LKF = LKF, LKU = LKU, NB = NB, NC = NC, JIT = JIT }
for _, install in ipairs(jitModules or {}) do install(ctx) end
V._jitLoad = function(modules)
	local t = {}
	local c = { M = M, LKF = LKF, LKU = LKU, NB = NB, NC = NC, JIT = t }
	for _, install in ipairs(modules) do install(c) end
	return t
end
V.reset()
return V
end

</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">Core.NR2003Cup.NR2003CupFFB</string><ProtectedString name="Source">--!native
--!optimize 2
-- Stage 13: the ORIGINAL NR2003 force feedback (steering torque) of the player car, hand port of the x86
-- (recovered in recovery/stage13, STAGE13_RECOVERY.md). A presentation output: nothing here feeds the physics or the
-- steering chain (Stage 12 evidence ffbinterface.md + Stage 13 dynamic proof).
--
-- Producers (Stage 6/7 core, unchanged): the front tyre callback 0055e180 -&gt; 00554e70 accumulates per front wheel
-- (slot 0 LF, 1 RF), twice per tick (predictor + corrector): n 74c964+4i, A bf6ed4+4i += c085dc (relaxed lateral slip
-- state), B bf6edc+4i += |Fz| + 0.01, C bf6ee4+4i += Fy, D bf6eec+4i += 0.1 * (r x F).z + c081ec (aligning moment).
-- Per 288 Hz tick, 005539c0 @00553a64 (V._ffbTick, called by NR2003CupDriver.tickInputs):
--   00554d30  l = B_LF / (B_LF + B_RF) (only when n_LF &gt; 0 and the sum &gt; 0), a = 1/n_LF, b = 1/n_RF -&gt;
--             74c960 = min(B_RF b + B_LF a, 1500) (no reader), bf6ec4 = (1 - l) A_RF b + l A_LF a (slip),
--             bf6ec8 = C_RF b + C_LF a (no reader), bf6ed0 = D_RF b + D_LF a (moment); n, A, B, C, D &lt;- 0
-- Per 36 Hz frame, FFB block of the frame end 00554520 (0055464c..0055479d; V._ffbFrameEnd, called by
-- NR2003CupFrame right after the lifted 00554520, whose own copy of the block is skipped):
--   gate bf6ebb (FF effect acquired) != 0 and bf6eb8 (player controls suspended) == 0
--   d = (ec4 - ec0) * 36 ; ec0 = ec4 ; q = ec4 + d * (latency bf6f20 * 0.001) * (1 - 20 / (airspeed bf3a00 + 20))
--   m = |ec4| &gt; 1e-5 ? q / ec4 * ed0 : ed0 ; ecc = (m - damping bf6f24 * d + ecc) * 0.5
--   out = clamp(ecc * strength 74c9a4 / (setup item 0x30 * 1600), -1, 1) -&gt; 005d08d0(axis bf6ebc, out)
--   005d08d0 -&gt; 005d2260 -&gt; 005d3010: DirectInput constant force (one axis, rglDirection 0, autocentre off)
--   lMagnitude = _ftol(out * 10000), SetParameters(DIEP_TYPESPECIFICPARAMS | DIEP_START): the ADAPTER output here.
-- Controls / device (simulation side, ORIGINAL): 00550070(flag) (bf6eb8 = flag; flag 0 -&gt; 0054fed0 FF axis setup from
-- the control-7 binding: axis binding + FF on (bf6f1c) + capable device -&gt; acquired bf6ebb = 1, axis bf6ebc), 00550030
-- (zero force), 00550680 (release). bf6eb8 is ALSO the 005524f0 player-branch gate (@00552549, NR2003CupDriver).
-- Options (messages 8..11, sent only by the controls.cfg loader 0043f1d0): 00550270 on/off bf6f1c, 00550290 strength
-- 74c9a4, 005502d0 damping bf6f24, 005502b0 latency bf6f20 (controls.cfg integers converted by fild / fstp dword).
--
-- Arithmetic: the simulation task runs the x87 with CW 0x077f (64-bit precision, round toward -inf). The FFB code is
-- evaluated in EXACT x87 arithmetic (X87 below: every operation rounded to a 64-bit significand toward -inf, every
-- f32 store rounded toward -inf), not in IEEE double: an exact intermediate within double rounding of an f32 boundary
-- (e.g. f32 a + a tiny negative b: double returns a, the x87 a value below a) would otherwise change a stored bit.
-- Exact fast path in double when every operation is exact (checked by TwoSum / Dekker TwoProduct), limb arithmetic
-- otherwise. Pure Luau: no Instances.
return function(V)
	local rf32, r32, ri32, w32, r8, w8, wf32 = V.rf32, V.r32, V.ri32, V.w32, V.r8, V.w8, V.wf32
	local floor, huge = math.floor, math.huge
	local frexp, ldexp = math.frexp, math.ldexp

	---------------------------------------------------------------------------------------------------------
	-- X87: exact 64-bit-significand arithmetic, round toward -inf (x87 CW 0x077f). A value is a pair (h, l) of doubles,
	-- h + l exact, h = the value truncated toward zero to 53 significant bits, l the rest (same sign, |l| &lt; ulp(h)).
	---------------------------------------------------------------------------------------------------------
	local TWO32, TWO31 = 4294967296, 2147483648
	local function unpack(h, l)
		-- nonzero finite -&gt; sign, exponent e (2^e &lt;= |v| &lt; 2^(e+1)), significand m = m1 * 2^32 + m0 in [2^63, 2^64)
		local s = 0
		if h &lt; 0 then s = 1; h = -h; l = -l end
		local _, ex = frexp(h)
		local H, L = ldexp(h, 64 - ex), ldexp(l, 64 - ex)
		local m1 = floor(H / TWO32)
		return s, ex - 1, m1, (H - m1 * TWO32) + L
	end
	local function pack(s, e, m1, m0)
		local low = m0 % 2048
		local h, l = ldexp(m1 * TWO32 + (m0 - low), e - 63), ldexp(low, e - 63)
		if s == 1 then return -h, -l end
		return h, l
	end
	-- the magnitude m (+ a nonzero remainder when inexact) rounded toward -inf for the sign s
	local function round(s, e, m1, m0, inexact)
		if inexact and s == 1 then
			m0 += 1
			if m0 == TWO32 then
				m0 = 0; m1 += 1
				if m1 == TWO32 then m1 = TWO31; e += 1 end
			end
		end
		return pack(s, e, m1, m0)
	end
	-- IEEE 754 sign of an exact zero sum under round toward -inf: +0 only for (+0) + (+0)
	local function zeroSum(a, b)
		if a == 0 and b == 0 and 1 / a &gt; 0 and 1 / b &gt; 0 then return 0 end
		return -0.0
	end
	local function addSlow(ah, al, bh, bl)
		if ah == 0 then
			if bh == 0 then return zeroSum(ah, bh), 0 end
			return bh, bl
		end
		if bh == 0 then return ah, al end
		local sa, ea, a1, a0 = unpack(ah, al)
		local sb, eb, b1, b0 = unpack(bh, bl)
