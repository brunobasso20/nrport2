	end

	function V.trackContactState(i, out)
		assert(i &gt;= 0 and i &lt;= 3 and i % 1 == 0, "NR2003 track: wheel index 0..3 required")
		if not active then return nil end
		local c = contacts[i]
		out = out or {}
		out.fx, out.fy, out.load = c.fx, c.fy, c.load
		out.x, out.y, out.z, out.surface = c.x, c.y, c.z, c.surface
		out.contacted, out.grounded, out.count = c.contacted, c.contacted and c.load &gt; 0, c.count
		return out
	end
	V.trackContact = V.trackContactState
	function V.trackContactOut(i)
		local c = contacts[i]
		if not active or not c then return nil end
		return c.fx, c.fy, c.load, c.x, c.y, c.z
	end
	local baseContactOut = V.contactOut
	function V.contactOut(i)
		if active then return V.trackContactOut(i) end
		return baseContactOut(i)
	end

	-- Stage 14 checkpoint: track
	V._registerCheckpoint("track", function() return {loaded=loaded, active=active, start=start, contacts=contacts, R=ctx.R, F=ctx.F} end, function(h)
		loaded, active, start = h.loaded, h.active, h.start
		contacts = h.contacts
		for k,v in pairs(h.R) do ctx.R[k]=v end
		table.clear(ctx.F);for k,v in pairs(h.F) do ctx.F[k]=v end
	end)
	V._trackCtx = ctx
end
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">Roblox.CupChassisAdapter</string><ProtectedString name="Source">-- Stage 13: the ORIGINAL force feedback runs inside the core (00554d30 front tyre statistics per tick, the FFB block of the
-- frame end 00554520, 0054fed0 / 00550070 FF axis and controls; exact x87 arithmetic). Options = the controls.cfg values
-- (attributes ForceFeedback bool, ForceFeedbackStrength 0..100, ForceFeedbackDamping 0..100, ForceFeedbackLatency
-- 0..250 ms; absent = CupTune.driver bench defaults, then the original image values: off, 80, 0, 0). ForceFeedbackDevice
-- (bool) = the host offers an FF output for the steering axis (ADAPTER for DirectInput: the HUD + gamepad motors on the
-- client); the effect is acquired by the ORIGINAL 0054fed0 only while the steering is on an analog axis. No driver seated
-- = player controls suspended (ORIGINAL 00550070(1)). The output (the original constant force -1..1 and the DirectInput
-- magnitude _ftol(force x 10000)) is published as car attributes FFBForce / FFBMagnitude / FFBActive; nothing feeds back.
-- Stage 12: the ORIGINAL steering chain runs inside the core (00552720 device processing, linearity, x pi,
-- 00554fb0 setup ratio item 0x30 with the low-speed override, per-tick ramp + toe -&gt; prescribed hub coordinates).
-- The adapter is only the device layer (0057abc0 equivalent): keys -&gt; digital steering controls 7 / 8, an analog
-- axis (gamepad / wheel, normalised -1..1 by Roblox) -&gt; both controls split by sign. Driver options from car
-- attributes: SteeringLinearity (controls.cfg value 0..100), SteeringMomentum (0..100, 0 = no slew),
-- SteeringLowSpeedOverride (bool); absent = the original values when no controls.cfg was loaded. (The arcade
-- driving mode and steering assistance are not ported: the core refuses them.) The cockpit wheel draws the ORIGINAL 005662d0 angle; front wheels use the solver poses.
-- Stage 11: the ORIGINAL per-frame runtime systems run inside the core (fuel burn and fuel mass, tyre thermal /
-- hot pressure / wear / failure, brake temperature, engine thermal / damage / failure, random failures, collision
-- damage). The adapter only starts the Stage 11 session with the race options (car attributes RaceDamageLevel 0..3,
-- RaceConsumptionRate 0..3, RosterSeries, RandomSeed; Stage11Runtime="frozen" = Stage 6-10 frame end for A/B),
-- offers TEST-ONLY event injection (DamageTestImpact = magnitude of one ORIGINAL collision record at the front
-- bumper, PitTyresTest = ORIGINAL 00550f10 x4) and reads telemetry from the original cells. No state is kept here.
-- Stage 10: garage setup at initialize/reset (car attributes Setup_&lt;item&gt; in display units, e.g.
-- Setup_springLF = 1700, Setup_camberLF = -2.5; legacy SetupBrakeBias/SetupGrilleTape/SetupSpoiler map to
-- items brakeBias/grilleTape/spoilerAngle). Each value goes through the ORIGINAL garage function 005581d0
-- (snap to the step grid + clamp), and the setup is applied by the ORIGINAL car build (core:applySetup).
-- Rebuild only when the setup changed; the rebuilt car is the core's reset image.
-- Stage 9: session air + aero setup at initialize/reset (car attributes), per-frame track normal and
-- test-only phantom draft (aeroHostInputs), aero telemetry. The aero forces themselves are computed
-- by the ORIGINAL core (00561a80/00561b70); the host applies no aero force.
-- Stage 6/7 host for mode NR2003_CUP: the ORIGINAL NR2003 Cup vehicle core owns all 45 states
-- (chassis, LF/RF suspension + hub + wheel, rear axle + LR/RR wheels, engine, clutch, output
-- shaft, head). Roblox only supplies contact planes (raycasts at the core's own wheel positions),
-- driver controls, and presentation. Nothing rendered feeds back into the core.
-- No ApplyImpulse / AssemblyMass / Roblox rigid-body integration for this car.
local Core=script.Parent.Parent.Core
local Vehicle=require(Core.NR2003CupVehicle)
local CupTune=require(Core.CupTune)
local Surface=require(Core.Surface)
local Fixed=require(Core.NR2003FixedStep)
local U=require(Core.MathUtil)
local Visual=require(script.Parent.VisualRig)
local SeatAccess=require(script.Parent.SeatAccess)
local Cockpit=require(script.Parent.Cockpit)
local RenderSnapshot=require(script.Parent.RenderSnapshot)
local trackModule=script.Parent:FindFirstChild("NR2003WatkinsGlen")
local TrackHost=trackModule and require(trackModule)
local M={};M.__index=M

-- NR2003 vehicle-world (+X fwd, +Y left, +Z up) &lt;-&gt; Roblox origin-local (+X right, +Y up, -Z fwd)
local function toLocal(x,y,z) return Vector3.new(-y,z,-x) end
local function fromLocal(v) return -v.Z,-v.X,v.Y end
-- R' = B R B^T for a row-major NR2003 body-&gt;world matrix
local function localRotation(r)
    return r[5],-r[6],r[4],
        -r[8],r[9],-r[7],
        r[2],-r[3],r[1]
end

function M.new(car,tune,remote,options)
    options=options or {}
    local cup=CupTune.new()
    local self=setmetatable({car=car,root=car.Chassis,tune=cup,benchTune=tune,telemetryTimer=0,debugVisible=false,
        fault=nil,renderSpin={},lastRenderSnapshotTime=nil,renderTeleport=true,pendingShift=0,steeringOut={},
        planes={},inContact={},wheelPose={},contactPoints={},scratchPos={0,0,0},scratchRot={1,0,0,0,1,0,0,0,1},ffbOut={}},M)
    for j=1,4 do
        self.planes[j]={0,0,1,0,0,0,0,1,1};self.inContact[j]=false
        self.wheelPose[j]={pos={0,0,0},rot={1,0,0,0,1,0,0,0,1},compression=0,steer=0,angle=0,rate=0}
        self.contactPoints[j]={point=Vector3.zero,grounded=false}
    end
    self.spawn=car:GetPivot();self.oldAnchored=self.root.Anchored;self.oldCollide=self.root.CanCollide
    car:SetAttribute("NR2003CorePoseOwner",true);car:SetAttribute("PhysicsMode","NR2003_CUP")
    car:SetAttribute("NR2003Tune","CupTune")
    car:SetAttribute("CockpitWheelAngle",true) -- Stage 12: render snapshots carry the ORIGINAL steering-wheel angle
    self.root.Anchored=true;self.root.CanCollide=false
    self.root.AssemblyLinearVelocity=Vector3.zero;self.root.AssemblyAngularVelocity=Vector3.zero
    local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={car};params.RespectCanCollide=true;params.IgnoreWater=false
    self.params=params
    self.clientSimulation=options.client==true
    self.networked=options.networked==true
    self.visual=Visual.new(car,cup)
    if self.clientSimulation then
        -- Local physics has no admission, spawn, or server seat connections.
        self.access={driver=options.driver or function() return true end,step=function() end,destroy=function() end}
    else self.access=SeatAccess.new(car,remote) end
    Cockpit.ensure(car,cup)
    self.core=Vehicle.new(Core:WaitForChild("NR2003Cup"))
    if TrackHost then TrackHost.attach(self) end
    self:initialize()
    if self.originalTrack and not self.clientSimulation and options.prepareSpawn~=false then
        TrackHost.prepareDriverSpawn(self, assert(car.Parent, "Parent TestCar before initializing the original track"))
    end
    return self
end

-- numeric frame: origin on the ground under the spawn pose (the core starts at z=0.42 m)
function M:groundOrigin(pivot)
    local hit=workspace:Raycast(pivot.Position+pivot.UpVector*2,-pivot.UpVector*60,self.params)
    local rot=pivot-pivot.Position
    if hit then return CFrame.new(hit.Position)*rot end
    return CFrame.new(pivot.Position-pivot.UpVector*(0.42/self.tune.metresPerStud))*rot
end
function M:worldPoint(x,y,z) return self.origin:PointToWorldSpace(toLocal(x,y,z)/self.tune.metresPerStud) end
function M:worldVector(x,y,z) return self.origin:VectorToWorldSpace(toLocal(x,y,z)) end
function M:numericPoint(p)
    local x,y,z=fromLocal(self.origin:PointToObjectSpace(p)*self.tune.metresPerStud);return x,y,z
end
function M:numericVector(v) local x,y,z=fromLocal(self.origin:VectorToObjectSpace(v));return x,y,z end

-- Stage 10: garage setup from the car attributes (nil when the core has no Stage 10 modules)
local LEGACY_SETUP={brakeBias="SetupBrakeBias",grilleTape="SetupGrilleTape",spoilerAngle="SetupSpoiler"}
function M:garageSetup()
    local Setup=self.core.V.Setup
    if not Setup then return nil end
    local s=self.originalTrack and TrackHost.garageSetup(self,Setup) or Setup.cupGarageDefault()
    for i=0,70 do
        if Setup.adjustable(i) then
            local name=Setup.ITEM[i].name
            local v=self.car:GetAttribute("Setup_"..name)
            if not U.finite(v) and LEGACY_SETUP[name] then v=self.car:GetAttribute(LEGACY_SETUP[name]) end
            if U.finite(v) then Setup.set(s,i,v) end
        end
    end
    -- Stage 12.1: bench default of the garage steering ratio (item 0x30) when no Setup_steeringRatio attribute is set
    local ratio=self.tune.driver and self.tune.driver.setupSteeringRatio
    if not self.originalTrack and U.finite(ratio) and not U.finite(self.car:GetAttribute("Setup_steeringRatio")) then Setup.set(s,"steeringRatio",ratio) end
    return s
end
function M:applyGarageSetup(s)
    local key=table.concat(s,",",0,183)
    if key==self.appliedSetupKey then return end
    local ok,rep=self.core:applySetup(s)
    self.car:SetAttribute("SetupStructure",rep.structure);self.car:SetAttribute("SetupApplySeconds",rep.seconds)
    if ok then
        self.appliedSetupKey=key;self.car:SetAttribute("SetupError",nil)
        if self.originalTrack then
            self.trackSetupName=self.requestedTrackSetupName
            self.car:SetAttribute("TrackSetupApplied",self.trackSetupName)
            self.car:SetAttribute("TrackSetupSHA256",self.requestedTrackSetupSHA256)
        end
        local d=self.core:setupDump()
        local r=d.runtime
        print(string.format("[NR2003 Stage 10] setup aplicado (%s, %.2f s): molas %.0f/%.0f/%.0f/%.0f N/m, freio %.0f/%.0f N*m, marchas %.3f/%.3f/%.3f/%.3f x %.3f",
            rep.structure,rep.seconds or 0,r.springRate[1],r.springRate[2],r.springRate[3],r.springRate[4],r.brakeTorque[1],r.brakeTorque[3],
            r.gearRatio[3],r.gearRatio[4],r.gearRatio[5],r.gearRatio[6],r.finalDrive))
    else
        self.car:SetAttribute("SetupError",tostring(rep.firstViolation))
        warn("NR2003 Stage 10: setup não representável, mantido o anterior ("..tostring(rep.firstViolation)..")")
    end
end
function M:initialize()
    self.origin=self.originalTrack and TrackHost.origin(self) or self:groundOrigin(self.spawn)
    if self.originalTrack then TrackHost.checkSession(self) end
    -- Stage 12: the steering options are re-read from the attributes at every initialize/reset
    if self.core.V.clearSteeringOptions then self.core.V.clearSteeringOptions() end
    if self.core.V.clearForceFeedbackOptions then self.core.V.clearForceFeedbackOptions() end
    self.core:reset()
    local function num(name) local v=self.car:GetAttribute(name);return U.finite(v) and v or nil end
    local garage=self:garageSetup()
    if garage then
        -- Stage 10: the whole garage setup through the ORIGINAL build (brake bias, tape and spoiler included)
        self:applyGarageSetup(garage)
        self.brakeBias=select(2,self.core:brakeBias())
        self.car:SetAttribute("BrakeBiasApplied",self.brakeBias)
        local tape,spoiler=self.core:aeroSetup()
        self.car:SetAttribute("GrilleTapeApplied",tape);self.car:SetAttribute("SpoilerApplied",spoiler)
    else
        -- Stage 8: garage brake bias (setup item 0x28, % front, 50..90). Car attribute SetupBrakeBias;
        -- absent = shipped Cup default (74). Applied at build/reset only, like the original garage.
        local bias=self.car:GetAttribute("SetupBrakeBias")
        if U.finite(bias) then self.brakeBias=self.core:setBrakeBias(bias) else self.brakeBias=select(2,self.core:brakeBias()) end
        self.car:SetAttribute("BrakeBiasApplied",self.brakeBias)
        -- Stage 9: garage aero items read at run time by the original aero (00410280): grille tape
        -- (item 0x3b, % 0..100 step 5) and rear spoiler (item 0x3d, deg 45..70). Absent = Cup defaults.
        local tape,spoiler=self.core:setAeroSetup({grilleTape=num("SetupGrilleTape"),spoiler=num("SetupSpoiler")})
        self.car:SetAttribute("GrilleTapeApplied",tape);self.car:SetAttribute("SpoilerApplied",spoiler)
    end
    local tape,spoiler=self.core:aeroSetup()
    -- Stage 9: session start 005a3c00 = race weather settings (ADAPTER: car attributes standing for
    -- the race options; absent = original defaults 70 F, no wind, conditions 0, daytime). TrackNorth
    -- (rad) stands for the track's north angle (bdbcf8) in the core frame. AeroSession=false keeps the
    -- Stage 6/7/8 post-build state (no air) for A/B comparison.
    self.core:setDraftEnvironment(nil);self.core:setTrackNormal(nil)
    -- Stage 11: production = "original" runtime; Stage11Runtime="frozen" keeps the Stage 6-10 frame end (A/B only)
    local frozen=self.car:GetAttribute("Stage11Runtime")=="frozen"
    if self.core.V.setRuntimeMode then self.core:setRuntimeMode(frozen and "frozen" or "original") end
    -- Stage 12: ORIGINAL steering chain + driver options (ORIGINAL setters 005502f0 / 005500c0 / 00550110)
    if self.core.V.setSteeringMode then
        self.core:setSteeringMode("original")
        local function flag(name) local v=self.car:GetAttribute(name);if type(v)=="boolean" then return v end;return nil end
        -- Stage 12.1 bench options (CupTune.driver defaults; attributes override): steering lock, momentum per device,
        -- cockpit wheel draw limit. Lock 360 = the original constant; the others are host choices (STAGE12_RESULT.md)
        local d=self.tune.driver or {}
        local function pick(name,default) local v=num(name);if v~=nil then return v end;return default end
        local clamp=self.car:GetAttribute("CockpitWheelClamp")
        if clamp~="original" and clamp~="lock" then clamp=d.cockpitLimit end
        local o=self.core:setSteeringOptions({linearity=num("SteeringLinearity"),momentum=num("SteeringMomentum"),
            lowSpeedOverride=flag("SteeringLowSpeedOverride"),lockDegrees=pick("SteeringLockDegrees",d.steeringLockDegrees),
            momentumKeys=pick("SteeringMomentumKeys",d.momentumKeys),momentumAxis=pick("SteeringMomentumAxis",d.momentumAxis),
            cockpitLimit=clamp})
        self.car:SetAttribute("SteeringLinearityApplied",o.linearity);self.car:SetAttribute("SteeringRateApplied",o.steerRate)
        self.car:SetAttribute("SteeringRatioApplied",o.setupRatio);self.car:SetAttribute("SteeringLockApplied",o.lockDegrees)
        print(string.format("[NR2003 Stage 12] direção original: relação %g:1 (item 0x30), trava %g° (%g° por lado), override baixa velocidade %s, linearidade %.2f, taxa %.4f/quadro (teclas %s, eixo %s), volante até %g°",
            o.setupRatio,o.lockDegrees,o.lockDegrees/2,o.lowSpeedOverride and "on" or "off",o.linearity,o.steerRate,
            o.momentumKeys==nil and "imagem" or tostring(o.momentumKeys),o.momentumAxis==nil and "imagem" or tostring(o.momentumAxis),
            o.cockpitLimitDegrees))
    end
    -- Stage 13: ORIGINAL force feedback options (messages 8..11 = controls.cfg values) and the host FF device, set before
    -- the car is placed on the track (00550a50 -&gt; 00550070(0) -&gt; 0054fed0)
    self.controlsSuspended=nil
    if self.core.V.setForceFeedbackOptions then
        local d=self.tune.driver or {}
        local function boolAttr(name,default) local v=self.car:GetAttribute(name);if type(v)=="boolean" then return v end;return default end
        local function range(name,hi,default)
            local v=num(name);if v==nil then v=default end
            if v==nil then return nil end
            return math.clamp(math.floor(v),0,hi)            -- the front-end slider ranges (0043ef90 / 0043efe0 / 0043f030)
        end
        self.core:setForceFeedbackDevice({capable=boolAttr("ForceFeedbackDevice",d.ffbDevice==true)})
        local o=self.core:setForceFeedbackOptions({enabled=boolAttr("ForceFeedback",d.ffbEnabled),
            strength=range("ForceFeedbackStrength",100,d.ffbStrength),damping=range("ForceFeedbackDamping",100,d.ffbDamping),
            latency=range("ForceFeedbackLatency",250,d.ffbLatency)})
        self.car:SetAttribute("ForceFeedbackApplied",o.enabled)
        print(string.format("[NR2003 Stage 13] force feedback original %s: força %g, amortecimento %g, latência %g ms, dispositivo %s (efeito adquirido pelo 0054fed0 só com o eixo analógico)",
            o.enabled and "ligado" or "desligado",o.strength,o.damping,o.latency,boolAttr("ForceFeedbackDevice",d.ffbDevice==true) and "sim" or "não"))
    end
    if self.car:GetAttribute("AeroSession")==false then
        self.core:endSession();self.weather=nil
    else
        -- Stage 11 session options (race options of the original; absent = post-build values: damage scale 1.0,
        -- consumption x1, random stream state of the build). RosterSeries stands for the roster series field
        -- car+0x596 (PROVISIONAL host input, 1 = collision damage evaluated). The car is then placed on the
        -- track by the ORIGINAL 00550a50 subset (repair, engine and fuel init, four new tyres).
        self.weather=self.core:startSession({temperatureF=num("WeatherTemperatureF"),windSpeedMph=num("WeatherWindMph"),
            windDirection=num("WeatherWindDirection"),conditions=num("WeatherConditions"),night=self.car:GetAttribute("WeatherNight")==true,
            trackNorth=num("TrackNorth")},{damageLevel=num("RaceDamageLevel"),consumptionRate=num("RaceConsumptionRate"),
            series=num("RosterSeries"),seed=num("RandomSeed")})
    end
    self.stage11Out={}
    self.car:SetAttribute("AirDensityApplied",self.weather and self.weather.density or 0)
    self.aeroOut={};self.trackNormal=nil;self.draftTest=false
    local w=self.weather
    if w then
        print(string.format("[NR2003 Stage 9] sessão: %d F, condições %d, %s, vento %d mph dir %d -&gt; ar %.2f C, rho %.7g kg/m3, vento (%.3f, %.3f) m/s | fita %d%%, aerofólio %d°",
            w.temperatureF,w.conditions,w.night and "noite" or "dia",w.windSpeedMph,w.windDirection,w.densityTemperatureC,w.density,w.wind[1],w.wind[2],tape,spoiler))
    else
        print("[NR2003 Stage 9] AeroSession=false: estado pós-build (sem ar, rho = 0)")
    end
    self.renderSpin={};self.lastRenderSnapshotTime=nil;self.renderTeleport=true
    for j=1,4 do self.inContact[j]=false end
    self.pendingShift=0
    local controller=self
    local stepper={state={tick=0}}
    function stepper:step(input) controller:tickCore(input);self.state.tick=controller.core:tick() end
    function stepper:checkpoint() return {core=controller.core:checkpoint(),origin=controller.origin,contact=table.clone(controller.inContact)} end
    function stepper:restore(c)
        controller.core:restore(c.core);controller.origin=c.origin;controller.inContact=table.clone(c.contact)
        self.state.tick=controller.core:tick();controller:pose(true)
    end
    self.stepper=stepper
    self.runner=Fixed.new(stepper,96)
    self.contactFn=function(phase) return self:contacts(phase) end
    self:pose(true)
end

-- contact planes at the CURRENT wheel positions of the core (called by the core twice per tick,
-- like 00578da0 / 00578de0). Plane: n.x + d = 0 in vehicle-world axes (0055e1e0 arguments).
function M:contacts(phase)
    local t=self.tune;local q=t.contactQuery;local mps=t.metresPerStud
    local occupant=self.car.DriverSeat.Occupant
    self.params.FilterDescendantsInstances=occupant and {self.car,occupant.Parent} or {self.car}
    local _,crot=self.core:componentPose(0,self.scratchPos,self.scratchRot)
    local ux,uy,uz=crot[3],crot[6],crot[9]                      -- chassis +Z in vehicle-world
    local upWorld=self:worldVector(ux,uy,uz)
    for j,c in ipairs(t.corners) do
        local w=self.wheelPose[j]
        local p=self.core:componentPose(c.record,w.pos,w.rot)
        local origin=self:worldPoint(p[1]+ux*q.rayAbove,p[2]+uy*q.rayAbove,p[3]+uz*q.rayAbove)
        local hit=workspace:Raycast(origin,-upWorld*(q.rayLength/mps),self.params)
        local plane=self.planes[j]
        if hit and hit.Normal:Dot(upWorld)&gt;q.maximumSlopeCos then
            local nx,ny,nz=self:numericVector(hit.Normal)
            local px,py,pz=self:numericPoint(hit.Position)
            -- (+0 normalises signed zeros from the axis permutation; the track code passes +0)
            plane[1],plane[2],plane[3],plane[4]=nx+0,ny+0,nz+0,-(nx*px+ny*py+nz*pz)+0
            local gx,gy,gz=0,0,0
            if hit.Instance:IsA("BasePart") then
                gx,gy,gz=self:numericVector(hit.Instance:GetVelocityAtPosition(hit.Position)*mps)
            end
            plane[5],plane[6],plane[7]=gx+0,gy+0,gz+0
            local attr=hit.Instance:GetAttribute("NRSurface")
            plane[8]=U.finite(attr) and math.clamp(math.floor(attr),0,16) or (Surface.indices[hit.Material.Name] or 1)
            local grip=hit.Instance:GetAttribute("NRGripMultiplier")
            plane[9]=U.finite(grip) and math.clamp(grip,0,4) or 1
            if not self.inContact[j] then self.core:resetContactBlock(j-1,px,py,pz) end -- 005778a0 pair init
            self.inContact[j]=true
        else
            -- no geometry under the wheel: plane far below (tire separates). PROVISIONAL: the original
            -- simply has no contact pair for that wheel.
            plane[1],plane[2],plane[3]=ux,uy,uz
            plane[4]=-(ux*p[1]+uy*p[2]+uz*p[3])+q.noContactPlane
            plane[5],plane[6],plane[7],plane[8],plane[9]=0,0,0,1,1
            self.inContact[j]=false
        end
    end
    return self.planes
end

-- Stage 12 host device layer (0057abc0 equivalent, ADAPTER): the raw steering controls of the frame. Keys -&gt; steer
-- left / right key bindings (digital controls 7 / 8 = 1.0 while held); an analog axis (input.steerAnalog) -&gt; one axis
-- bound to both controls (negative half -&gt; 7, positive half -&gt; 8). A legacy client (input.steer only) = keys.
local function steerControls(controls,input)
    local axis=input.steerAxis
    if input.steerAnalog==true and U.finite(axis) then
        controls.steerAxis=U.clamp(axis,-1,1)
        return
    end
    local left,right=input.steerLeft,input.steerRight
    if not U.finite(left) and not U.finite(right) and U.finite(input.steer) then
        left=input.steer&lt;0 and 1 or 0;right=input.steer&gt;0 and 1 or 0
    end
    controls.steerLeft=U.finite(left) and U.clamp(left,0,1) or 0
    controls.steerRight=U.finite(right) and U.clamp(right,0,1) or 0
    controls.steerDigital=true
end
M.steerControls=steerControls

function M:tickCore(input)
    local frame=self.core:tick()%8==0
    -- Stage 8: the brake goes through the ORIGINAL input chain (00552d00/00553080 -&gt; bf6eac).
    -- The bench client sends keyboard keys (S/W = 0/1): NR2003 key binding (0057af60 digital).
    -- brakeAxis=true in the input selects the analog-axis binding for real pedals/triggers.
    -- No driver seated = 005524f0 'car not driven' branch (pedal held at 1.0).
    local controls
    if self:driver()==nil then
        controls={driver=false,throttle=0,clutch=0}
    else
        local throttle=U.clamp(input.throttle or 0,0,1)
        controls={throttle=throttle,throttleControl=throttle,throttleDigital=input.throttleAxis~=true,
            brakeControl=U.clamp(input.brake or 0,0,1),brakeDigital=input.brakeAxis~=true,
            clutch=1-U.clamp(input.clutch or 0,0,1),originalPedals=self.originalTrack==true}
        steerControls(controls,input)
    end
    if frame and self.pendingShift~=0 and controls.driver~=false then
        controls.shiftUp=self.pendingShift&gt;0;controls.shiftDown=self.pendingShift&lt;0;self.pendingShift=0
    end
    if frame and self.weather then self:aeroHostInputs() end
    -- Stage 13: no driver seated = player controls suspended (ORIGINAL 00550070(1): 005524f0 not-driven branch, FFB block
    -- gated, zero force); a driver seated = 00550070(0). Applied between frames, where the original drains its messages
    local suspended=controls.driver==false
    if frame and self.core.V.setControlsSuspended and suspended~=self.controlsSuspended then
        self.controlsSuspended=suspended;self.core:setControlsSuspended(suspended)
    end
    self.core:step(controls,self.contactFn)
    if self.core:tick()%8==0 and self.weather and not self.networked then self:stage11TestEvents() end
    self:pose(false)
end

-- Stage 11 TEST ADAPTER (not an NR2003 feature): one-shot attributes to exercise the ORIGINAL event paths on the
-- bench, which has no walls / other cars / pit lane. Applied after a frame end (where the original track contact code
-- would have entered the record during the frame).
--   DamageTestImpact = magnitude -&gt; ORIGINAL 0054a760 record: front bumper point (car frame +2.4 m x), wall
--                      normal against the car's heading, wall material 1; evaluated by 00549c40 at the next frame end
--   PitTyresTest = true          -&gt; ORIGINAL 00550f10 for the four wheels (pit tyre change)
function M:stage11TestEvents()
    local impact=self.car:GetAttribute("DamageTestImpact")
    if U.finite(impact) and impact&gt;0 then
        self.car:SetAttribute("DamageTestImpact",nil)
        local st=self.core:readState()
        local p,r=self.core:componentPose(0,self.scratchPos,self.scratchRot)
        self.core:collision({magnitude=impact,material=0x10,surface=1,point={p[1]+2.4*r[1],p[2]+2.4*r[4],p[3]+2.4*r[7]},
            localPoint={2.4,0,0.3},velocity={st[2],st[4],st[6]},normal={-r[1],-r[4],-r[7]},speed=math.abs(st[2]*r[1]+st[4]*r[4]+st[6]*r[7])})
        print(string.format("[NR2003 Stage 11] TESTE: registro de colisão original (magnitude %.0f) na frente do carro",impact))
    end
    if self.car:GetAttribute("PitTyresTest")==true then
        self.car:SetAttribute("PitTyresTest",nil)
        self.core:pitTyres({0,1,2,3})
        print("[NR2003 Stage 11] TESTE: troca dos 4 pneus pelo 00550f10 original")
    end
end

-- Stage 9 per-frame host inputs of the aero, set before the frame's first tick (005637e0 order):
--  * track-object surface normal (0051370a -&gt; car track object +0x24, used by 00561a80 to project the
--    wind): ADAPTER = mean normal of the grounded contact planes (core frame). Airborne: unchanged.
--  * drafting (005afd80): no other cars on the bench, so no race-order ring (factors stay 1.0).
--    TEST ADAPTER only: attribute DraftTestGap (m, &gt; 0) puts a phantom car that far ahead on a straight
--    line along the core +X axis (lap distance = x, lateral = y + DraftTestLateral, same velocity as
--    the player, Cup wake), to exercise the ORIGINAL drafting code. Not an NR2003 feature.
function M:aeroHostInputs()
    -- The recovered track query supplies the original normal and race-order context.
    if self.originalTrack then return end
    local nx,ny,nz,n=0,0,0,0
    for j=1,4 do
        if self.inContact[j] then local p=self.planes[j];nx+=p[1];ny+=p[2];nz+=p[3];n+=1 end
    end
    if n&gt;0 then
        local m=math.sqrt(nx*nx+ny*ny+nz*nz)
        if m&gt;1e-6 then self.trackNormal={nx/m,ny/m,nz/m};self.core:setTrackNormal(self.trackNormal) end
    end
    local gap=self.car:GetAttribute("DraftTestGap")
    if U.finite(gap) and gap&gt;0 then
        local st=self.core:readState()
        local lat=self.car:GetAttribute("DraftTestLateral");lat=U.finite(lat) and lat or 0
        local L=5000
        local other={lapDistance=(st[1]+gap)%L,lateral=st[3]+lat,vx=st[2],vy=st[4],vz=st[6]}
        self.core:setDraftEnvironment({trackLength=L,lapDistance=st[1]%L,lateral=st[3],ahead={other},behind={other}})
        self.draftTest=true
    elseif self.draftTest then
        self.core:setDraftEnvironment(nil);self.draftTest=false
    end
end

-- chassis pose from the core (+ host collision boundary). PROVISIONAL collision: a Blockcast of
-- the chassis box; on a hit the core is translated back through the ORIGINAL state import
-- 005b4560 (positions only). Momentum/velocity is not changed: NR2003 body collision response
-- (car-wall/car-car penalty forces) is not recovered yet.
function M:pose(teleport)
    local p,r=self.core:componentPose(0,self.scratchPos,self.scratchRot)
    local mps=self.tune.metresPerStud
    local function target()
        local lp=toLocal(p[1],p[2],p[3])/mps
        local r00,r01,r02,r10,r11,r12,r20,r21,r22=localRotation(r)
        return self.origin*CFrame.new(lp.X,lp.Y,lp.Z,r00,r01,r02,r10,r11,r12,r20,r21,r22)
    end
    local cf=target()
    if not self.originalTrack and not teleport and self.rootCF then
        local delta=cf.Position-self.rootCF.Position
        if delta.Magnitude&gt;1e-6 then
            local cast=self.rootCF*CFrame.new(0,self.tune.collision.raise/mps,0)
            local hit=workspace:Blockcast(cast,self.root.Size,delta,self.params)
            if hit then
                local allowed=self.rootCF.Position+delta.Unit*math.max(0,hit.Distance-0.01)
                local ax,ay,az=self:numericPoint(allowed)
                local tx,ty,tz=self:numericPoint(cf.Position)
                self.core:translate(ax-tx,ay-ty,az-tz) -- takes effect in the core's next tick
                cf=cf-cf.Position+allowed;self.collision=true
            else self.collision=false end
        end
    end
    self.rootCF=cf
end

function M:wheels()
    local _,cr=self.core:componentPose(0,self.scratchPos,self.scratchRot)
    local cp=self.scratchPos;local st=self.core:readState()
    for j,c in ipairs(self.tune.corners) do
        local w=self.wheelPose[j]
        local p,r=self.core:componentPose(c.record,w.pos,w.rot)
        local dx,dy,dz=p[1]-cp[1],p[2]-cp[2],p[3]-cp[3]
        w.compression=cr[3]*dx+cr[6]*dy+cr[9]*dz              -- centre height in chassis frame
        -- spin axis (wheel +Y column) in chassis frame -&gt; road-wheel yaw (Stage 5 sign: + right)
        local ax=cr[1]*r[2]+cr[4]*r[5]+cr[7]*r[8]
        local ay=cr[2]*r[2]+cr[5]*r[5]+cr[8]*r[8]
        w.steer=math.atan2(ax,ay)
        w.angle=st[c.state.angle+1];w.rate=st[c.state.rate+1]
    end
    return self.wheelPose
end

function M:driver() return self.access:driver() end
function M:requestEntry(player) return self.access:request(player) end
function M:exit(player) return self.access:exit(player) end
function M:shift(delta) if U.finite(delta) and delta~=0 then self.pendingShift=delta&gt;0 and 1 or -1 end end
function M:step(elapsed,input)
    self.access:step();self.telemetryTimer=self.telemetryTimer+elapsed
    if self.fault then return end
    local ok,reason=pcall(function()
        self.runner:advance(elapsed,input,nil)
        self:present()
    end)
    if not ok then self.fault=tostring(reason);self.car:SetAttribute("PhysicsFault",self.fault);warn("NR2003 Cup core paused: "..self.fault) end
end

-- Presentation may run at any rate; fixed ticks do not depend on it.
function M:present()
        if self.originalTrack then TrackHost.update(self) end
        self.car:PivotTo(self.rootCF)
        self.car:SetAttribute("CoreTick",self.core:tick());self.car:SetAttribute("CoreCollision",self.collision==true)
        local wheels=self:wheels()
        for j=1,4 do
            local _,_,_,px,py,pz=self.core:contactOut(j-1)
            self.contactPoints[j].point=self:worldPoint(px,py,pz);self.contactPoints[j].grounded=self.inContact[j]
        end
        self.visual:update({wheels=wheels},self.contactPoints,self.debugVisible)
        Cockpit.updateAngle(self.car,self:steeringWheelAngle())
        -- Stage 13: the ORIGINAL constant force (005d08d0 -&gt; 005d3010) for the client presentation (HUD, gamepad motors)
        if self.core.V.forceFeedbackState then
            local f=self.core:forceFeedbackState(self.ffbOut)
            self.car:SetAttribute("FFBForce",f.force);self.car:SetAttribute("FFBMagnitude",f.magnitude)
            self.car:SetAttribute("FFBActive",f.acquired and f.effect and not f.suspended)
        end
end

-- Stage 12 presentation: the ORIGINAL steering-wheel angle of the car model (005662d0: clamp(-(00554fb0() *
-- car[0x1554]), +-2.79 rad), + = clockwise seen by the driver (right turn)); 0 without the Stage 12 core
function M:steeringWheelAngle()
    if self.core.V.steeringWheelAngle then return self.core:steeringWheelAngle() end
    return 0
end

function M:kinematics()
    local st=self.core:readState()
    local _,r=self.core:componentPose(0,self.scratchPos,self.scratchRot)
    local linear=self:worldVector(st[2],st[4],st[6])/self.tune.metresPerStud
    local bx,by,bz=st[11],st[12],st[13]                          -- body rates
    local angular=self:worldVector(r[1]*bx+r[2]*by+r[3]*bz,r[4]*bx+r[5]*by+r[6]*bz,r[7]*bx+r[8]*by+r[9]*bz)
    return linear,angular
end

function M:renderSnapshot(seq,time,vehicleId)
    local cf=self.root.CFrame
    local px,py,pz,r00,r01,r02,r10,r11,r12,r20,r21,r22=cf:GetComponents()
    local qx,qy,qz,qw=RenderSnapshot.quatFromMatrix(r00,r01,r02,r10,r11,r12,r20,r21,r22)
    local linear,angular=self:kinematics()
    local dt=self.lastRenderSnapshotTime and math.max(0,time-self.lastRenderSnapshotTime) or 0
    local wheels={}
    for j,w in ipairs(self.wheelPose) do
        local spin=RenderSnapshot.unwrapSpin(self.renderSpin[j],w.angle,w.rate,dt)
        self.renderSpin[j]=spin
        local localPoint=cf:PointToObjectSpace(self.contactPoints[j].point)
        wheels[j]={comp=w.compression,steer=w.steer,spin=spin,cx=localPoint.X,cy=localPoint.Y,cz=localPoint.Z,
            grounded=self.contactPoints[j].grounded}
    end
    local flags=(self.renderTeleport and RenderSnapshot.FLAG_TELEPORT or 0)+RenderSnapshot.FLAG_WHEEL_ANGLE
    self.renderTeleport=false;self.lastRenderSnapshotTime=time
    return {vehicleId=vehicleId or 1,seq=seq,flags=flags,tick=self.core:tick(),time=time,
        px=px,py=py,pz=pz,qx=qx,qy=qy,qz=qz,qw=qw,
        lx=linear.X,ly=linear.Y,lz=linear.Z,ax=angular.X,ay=angular.Y,az=angular.Z,
        steer=self:steeringWheelAngle(),wheels=wheels}
end

function M:telemetry()
    local st=self.core:readState()
    local linear=self:kinematics()
    local _,r=self.core:componentPose(0,self.scratchPos,self.scratchRot)
    local forward=st[2]*r[1]+st[4]*r[4]+st[6]*r[7]
    local lf,rf,thr,brk,clu,gearIn=self.core:inputs()
    local wheels={}
    local track
    if self.originalTrack then
        local p=self.core.V.trackPosition(self.trackPositionOut)
        local vehicle=self.core.V.trackInfo()
        track={name="Watkins Glen",setup=self.trackSetupName,dlong=p.dlong,dlat=p.dlat,wheels={},
            chassisType=vehicle.chassisType,tireProfiles=vehicle.tireProfiles}
    end
    -- Stage 11: ORIGINAL runtime state (read-only view of the core cells)
    local s11=self.core.V.stage11State and self.core:stage11State(self.stage11Out) or nil
    for j,c in ipairs(self.tune.corners) do
        local fx,fy,fz=self.core:contactOut(j-1)
        local travel=st[c.state.travel+1]
        local w=self.wheelPose[j]
        -- Stage 8: original per-wheel brake/tire cells (no side effects on the core)
        local b=self.core:wheelBrake(j-1)
        local ty=s11 and s11.tyres[j]
        if track then
            local contact=self.core.V.trackContact(j-1,{})
            local grounded=contact.grounded==true
            local fx,fy,fz=grounded and b.fx or 0,grounded and b.fy or 0,grounded and b.fz or 0
            local surface=grounded and contact.surface or nil
            track.wheels[j]={name=c.name,grounded=grounded,surface=surface,
                surfaceGrip=surface and self.core.V.rf32(0x74fb30+4*surface) or 0,
                fx=fx,fy=fy,fz=fz,forceXY=math.sqrt(fx*fx+fy*fy),
                muUsed=fz&gt;1 and math.sqrt(fx*fx+fy*fy)/fz or 0,
                slipVelocity=b.vslip,wearFactor=ty and ty.gripWear or 1}
        end
        wheels[j]={name=c.name,load=self.inContact[j] and fz or 0,compression=travel,
            slip=b.vslip/math.max(math.abs(b.vx),2),
            omega=w.rate,temperature=ty and ty.surface[2]-273.15 or self.tune.environment.ambientC,grounded=self.inContact[j],
            tyreSurfaceK=ty and ty.surface,tyreCarcassK=ty and ty.carcass,tyrePressure=ty and ty.pressure,
            tyreWear=ty and ty.wear,tyreGrip=ty and ty.gripWear,tyreState=ty and ty.state,
            surface=self.planes[j][8],out1={fx,fy,fz},
            brakeTorque=b.torque,brakeCapacity=b.brakeCap,dragCapacity=b.dragCap,locked=b.locked,
            fx=b.fx,fy=b.fy,fz=b.fz,slipVelocity=b.vslip,brakeTemperatureK=b.temperature}
    end
    local pedal,target,tickValue,coreBrake=self.core:brakeState()
    local gear=self.core:gearIndex()
    -- Stage 9: ORIGINAL 00561b70 evaluated at the current state (read-only; see CORE_API.md)
    local a=self.core:aeroState(self.aeroOut)
    local tape,spoiler=self.core:aeroSetup()
    local aero={session=a.session,density=a.density,q=a.q,drag=a.drag,downforce=a.downforce,
        front=a.downforceFront,rear=a.downforceRear,side=a.side,mx=a.mx,my=a.my,mz=a.mz,
        factorDrag=a.factorDrag,factorFront=a.factorFront,factorRear=a.factorRear,airspeed=a.airspeedBody,
        yaw=a.yaw,pitch=a.pitch,rideHeight=a.rideHeightFront,proximity=a.groundProximity,stall=a.stall,
        windX=a.wind[1],windY=a.wind[2],grilleTape=tape,spoiler=spoiler,draftTest=self.draftTest==true}
    return {speed=linear.Magnitude*self.tune.metresPerStud*3.6,rpm=self.core:engineRpm(),
        gear=Vehicle.displayGear(gear),gearIndex=gear,wheels=wheels,torque=0,
        clutchSlip=st[35]-st[37],limiter=self.core:revLimiter(),
        throttleIn=thr,brakeIn=brk,clutchIn=clu,lfSteer=lf,rfSteer=rf,
        brakePedal=pedal,brakeTarget=target,brakeTick=tickValue,brakeCore=coreBrake,brakeBias=self.brakeBias,
        droppedTime=0,fault=self.fault,mode="NR2003_CUP",tick=self.core:tick(),backlog=self.runner.accumulator,
        chassisStateCount=45,chassisIntegration="NR2003 original JIT (005b39a0/005b3180/005b3e50/005b2fb0)",
        collision=self.collision==true,aero=aero,track=track,
        stage11=s11 and {mode=s11.mode,fuelKg=s11.fuel.kg,fuelRecordKg=s11.fuel.massRecord,water=s11.engine.water,oil=s11.engine.oil,
            coolantLevel=s11.engine.coolantLevel,oilLevel=s11.engine.oilLevel,power=s11.engine.power,life=s11.engine.life,
            overRev=s11.engine.overRev,damageScale=s11.damage.scale,engineDamage=s11.damage.engine,leakRadiator=s11.damage.radiator,
            leakOil=s11.damage.oil,leakFuel=s11.damage.fuel,zones=s11.damage.zones,failures=s11.damage.failures,
            broken=s11.damage.brokenFlags,airspeed=s11.airspeed,ambientK=s11.ambient} or nil,
        -- Stage 12: hubSteerAngle = mean prescribed hub coordinate q (states 15 / 21, + = left; the original car[0x1554]),
        -- a rotation about the inclined steering axis (caster 2.455 deg, inclination 9.215 deg); roadWheelAngle = mean
        -- front wheel yaw measured from the solver wheel poses (+ = right, Stage 5 sign; about -0.99 q, no Ackermann)
        hubSteerAngle=st[16]*0.5+st[22]*0.5,roadWheelAngle=(self.wheelPose[1].steer+self.wheelPose[2].steer)*0.5,
        steeringWheelAngle=self:steeringWheelAngle(),steering=self:steeringTelemetry(),ffb=self:forceFeedbackTelemetry()}
end
-- Stage 13 force-feedback telemetry (original cells + the last device output, see STAGE13_FFB_STATE_MAP.md)
function M:forceFeedbackTelemetry()
    if not self.core.V.forceFeedbackState then return nil end
    local f=self.core:forceFeedbackState(self.ffbOut)
    return {enabled=f.enabled,acquired=f.acquired,suspended=f.suspended,effect=f.effect,force=f.force,magnitude=f.magnitude,
        slip=f.slip,moment=f.moment,filtered=f.filtered,load=f.load,strength=f.strength,damping=f.damping,latency=f.latency,
        axis=f.axis}
end
-- Stage 12 steering telemetry (original cells, see STAGE12_STEERING_STATE_MAP.md); nil without the Stage 12 core
function M:steeringTelemetry()
    if not self.core.V.steeringState then return nil end
    local s=self.core:steeringState(self.steeringOut)
    return {left=s.left,right=s.right,digital=s.digital,input=s.input,shaped=s.shaped,ratio=s.ratio,ratioNow=s.ratioNow,
        target=s.target,current=s.current,lf=s.lf,rf=s.rf,hubLF=s.hubLF,hubRF=s.hubRF,wheelAngle=s.wheelAngle,
        sensitivity=s.sensitivity,mode=s.mode}
end
function M:reset()
    self.car:PivotTo(self.spawn);self.fault=nil;self.car:SetAttribute("PhysicsFault",nil)
    self.rootCF=nil;self:initialize();self.car:PivotTo(self.rootCF)
end
function M:destroy()
    if self.clientSimulation then self.access:destroy();return end
    if TrackHost then TrackHost.clearDriverSpawn(self) end
    self.access:destroy();self.car:SetAttribute("NR2003CorePoseOwner",nil)
    self.root.Anchored=self.oldAnchored;self.root.CanCollide=self.oldCollide
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">Roblox.RenderPresentation</string><ProtectedString name="Source">-- Client-only presentation layer for the server-authoritative NR2003_CORE vehicle.
-- It locally overrides the already replicated anchored car immediately before camera/render.
-- No rendered state is sent back to the server or consumed by physics.
local RunService=game:GetService("RunService")
local Snap=require(script.Parent.RenderSnapshot)
local Buffer=require(script.Parent.SnapshotBuffer)
local Visual=require(script.Parent.VisualRig)
local Cockpit=require(script.Parent.Cockpit)
local Config=require(script.Parent.RenderConfig)
local M={};M.__index=M
local function cframeFromSnapshot(s)
    local r00,r01,r02,r10,r11,r12,r20,r21,r22=Snap.quatToMatrix(s.qx,s.qy,s.qz,s.qw)
    return CFrame.new(s.px,s.py,s.pz,r00,r01,r02,r10,r11,r12,r20,r21,r22)
end
function M.new(car,tune,remote)
    local self=setmetatable({car=car,tune=tune,remote=remote,buffer=Buffer.new(Config.buffer),sampled={wheels={}},
        visual=Visual.new(car,tune),dynamics={wheels={}},contacts={},active=false,frames=0,fps=0,fpsClock=os.clock()},M)
    for j=1,4 do self.dynamics.wheels[j]={compression=0,steer=0,angle=0};self.contacts[j]={point=Vector3.zero,grounded=false} end
    self.normalBufferConfig=table.clone(self.buffer.cfg)
    self.connection=remote.OnClientEvent:Connect(function(packet)
        local s=Snap.decode(packet);if not s or s.vehicleId~=(self.car:GetAttribute("PredictionVehicleId") or Config.vehicleId) then return end
        self.buffer:push(s,workspace:GetServerTimeNow())
    end)
    return self
end
function M:setDriverActive(active)
    local enabled=active==true and self.car:GetAttribute("NR2003Track")=="watkins_glen"
    if enabled==self.lowDelayDriver then return end
    self.lowDelayDriver=enabled
    local cfg=self.buffer.cfg
    for name,value in pairs(self.normalBufferConfig) do cfg[name]=value end
    if enabled then
        for name,value in pairs(Config.driverBuffer or {}) do cfg[name]=value end
        self.buffer.delay=math.min(self.buffer.delay,cfg.initialDelay)
        self.buffer.targetDelay=math.max(cfg.minDelay,math.min(self.buffer.targetDelay,cfg.maxDelay))
    end
end
function M:update()
    if self.localPredictor then self.active=true;return true end
    self.frames=self.frames+1;local clock=os.clock();local span=clock-self.fpsClock
    if span&gt;=0.5 then self.fps=self.frames/span;self.frames=0;self.fpsClock=clock end
    if not Config.enabled or self.car:GetAttribute("NR2003CorePoseOwner")~=true then self.active=false;return false end
    local now=workspace:GetServerTimeNow()
    if self.buffer:isStale(now) then self.active=false;return false end
    local renderTime=self.buffer:advance(now);if not renderTime then self.active=false;return false end
    local s=self.buffer:sample(renderTime,self.sampled);if not s then self.active=false;return false end
    local cf=cframeFromSnapshot(s)
    self.car:PivotTo(cf)
    for j,w in ipairs(s.wheels) do
        local d=self.dynamics.wheels[j];d.compression,d.steer,d.angle=w.comp,w.steer,w.spin
        local c=self.contacts[j];c.point=cf:PointToWorldSpace(Vector3.new(w.cx,w.cy,w.cz));c.grounded=w.grounded
    end
    self.dynamics.steering=s.steer
    self.visual:update(self.dynamics,self.contacts,self.car:GetAttribute("DebugContacts")==true)
    if self.car:GetAttribute("CockpitWheelAngle")==true then Cockpit.updateAngle(self.car,s.steer) -- Stage 12 (NR2003_CUP)
    else Cockpit.update(self.car,self.tune,s.steer) end
    self.active=true;return true
end
function M:stats()
    local s=self.buffer:stats();s.renderFPS=self.fps;s.active=self.active;s.mode=self.sampled.mode or "waiting";s.alpha=self.sampled.alpha or 0
    local last=self.buffer.list[#self.buffer.list]
    s.remoteAge=last and math.max(0,workspace:GetServerTimeNow()-last.time) or nil
    return s
end
function M:destroy() if self.connection then self.connection:Disconnect();self.connection=nil end end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX12"><Properties><string name="Name">Roblox.PredictionConfig</string><ProtectedString name="Source">-- Host/network policy only. None of these values changes NR2003 equations.
return table.freeze({
    version=14, hz=288, frameTicks=8,
    maxSteps=24, clientBudget=0.006, serverBudget=0.012,
    historyFrames=256, checkpointFrames=18, checkpointSlots=8,
    batchFrames=12, pendingFrames=256, sendHz=30, ackHz=10,
    leadTicks=72, maxPacketHz=90, timeout=3,
    positionTolerance=0.02, velocityTolerance=0.05, rotationTolerance=0.001,
    -- A visual offset may decay; it is never imported into simulation.
    smoothSeconds=0.10, snapMetres=2, pageBytes=1024,
})
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">Roblox.PredictionCheckpoint</string><ProtectedString name="Source">-- Lossless sparse pages against an immutable epoch baseline. No float quantization.
local M={}
function M.copy(x)
    if type(x)~="table" then return x end
    local t={};for k,v in pairs(x) do t[k]=M.copy(v) end;return t
end
function M.pack(c,base)
    local m=c.memory;local n=buffer.len(m);local page=1024
    local offsets,parts={},{}
    for off=0,n-1,page do
        local count=math.min(page,n-off)
        local s=buffer.readstring(m,off,count)
        local b=base and buffer.readstring(base,off,count) or string.rep("\0",count)
        if s~=b then offsets[#offsets+1]=off;parts[#parts+1]=s end
    end
    local h=M.copy(c);h.memory=nil
    return {size=n,offsets=offsets,data=buffer.fromstring(table.concat(parts)),host=h}
end
function M.unpack(p,base)
    assert(type(p)=="table" and p.size&gt;0 and p.size&lt;=32*1024*1024,"checkpoint size")
    if base then assert(buffer.len(base)==p.size,"checkpoint baseline size") end
    local m=buffer.create(p.size);if base then buffer.copy(m,0,base) end
    local cursor,last=0,-1
    for _,off in ipairs(p.offsets) do
        assert(type(off)=="number" and off%1024==0 and off&gt;last and off&lt;p.size,"checkpoint page")
        local n=math.min(1024,p.size-off)
        assert(cursor+n&lt;=buffer.len(p.data),"checkpoint data")
        buffer.copy(m,off,p.data,cursor,n);cursor+=n;last=off
    end
    assert(cursor==buffer.len(p.data),"checkpoint trailing data")
    local c=M.copy(p.host);c.memory=m;return c
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">Roblox.PredictionProtocol</string><ProtectedString name="Source">local C=require(script and script.Parent.PredictionConfig or "./PredictionConfig")
local M={}
function M.finite(x) return type(x)=="number" and x==x and math.abs(x)&lt;math.huge end
function M.integer(x,lo,hi) return M.finite(x) and x%1==0 and x&gt;=lo and x&lt;=hi end
local ranges={throttle={0,1},brake={0,1},clutch={0,1},handbrake={0,1},steer={-1,1},
    steerLeft={0,1},steerRight={0,1},steerAxis={-1,1},shift={-1,1}}
local flags={steerAnalog=true,brakeAxis=true,throttleAxis=true}
function M.input(raw)
    if type(raw)~="table" then return nil end
    local input={}
    for key,r in pairs(ranges) do
        local x=raw[key]
        if x==nil then x=0 end
        if not M.finite(x) or x&lt;r[1] or x&gt;r[2] or (key=="shift" and x%1~=0) then return nil end
        input[key]=x
    end
    for key in pairs(flags) do
        if raw[key]~=nil and type(raw[key])~="boolean" then return nil end
        input[key]=raw[key]==true
    end
    return input
end
function M.command(raw,startTick)
    if type(raw)~="table" or not M.integer(raw.seq,1,2147483647) or
        raw.tick~=startTick+(raw.seq-1)*C.frameTicks then return nil end
    local input=M.input(raw.input);if not input then return nil end
    return {seq=raw.seq,tick=raw.tick,input=input}
end
function M.same(a,b)
    if a.tick~=b.tick then return false end
    for k in pairs(ranges) do if a.input[k]~=b.input[k] then return false end end
    for k in pairs(flags) do if a.input[k]~=b.input[k] then return false end end
    return true
end
function M.witness(raw)
    if type(raw)~="table" or #raw~=45 then return nil end
    local t={};for i=1,45 do if not M.finite(raw[i]) then return nil end;t[i]=raw[i] end
    return t
end
function M.error(a,b)
    local pos,vel,rot,maximum=0,0,0,0
    for i=1,45 do maximum=math.max(maximum,math.abs(a[i]-b[i])) end
    for _,i in ipairs({1,3,5}) do pos+=(a[i]-b[i])^2 end
    for _,i in ipairs({2,4,6}) do vel+=(a[i]-b[i])^2 end
    for i=7,10 do rot=math.max(rot,math.abs(a[i]-b[i])) end
    pos=math.sqrt(pos);vel=math.sqrt(vel)
    return pos&gt;C.positionTolerance or vel&gt;C.velocityTolerance or rot&gt;C.rotationTolerance,
        {position=pos,velocity=vel,rotation=rot,maximum=maximum}
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">Roblox.PredictionSession</string><ProtectedString name="Source">-- Pure scheduling/ordering: server never consumes client poses or client clock values.
local C=require(script and script.Parent.PredictionConfig or "./PredictionConfig")
local P=require(script and script.Parent.PredictionProtocol or "./PredictionProtocol")
local M={};M.__index=M
function M.new(epoch,startTick,now,sim)
    assert(startTick%8==0,"session must start on a device boundary")
    return setmetatable({epoch=epoch,startTick=startTick,started=now,sim=sim,ack=0,pending={},
        witnesses={},acceptedStates={},verifiedWitnesses={},lastPacket=now,lastReceive=now,tokens=C.maxPacketHz,rejected=0,steps=0,cpu=0},M)
end
function M:receive(packet,now)
    if type(packet)~="table" or packet.epoch~=self.epoch then return false,"epoch" end
    local refill=math.max(0,now-self.lastPacket)*C.maxPacketHz
    self.tokens=math.min(C.maxPacketHz,self.tokens+refill);self.lastPacket=now
    if self.tokens&lt;1 then return false,"rate" end;self.tokens-=1
    if type(packet.commands)~="table" or #packet.commands&gt;C.batchFrames then return false,"batch" end
    local accepted={}
    for _,raw in ipairs(packet.commands) do
        local cmd=P.command(raw,self.startTick)
        if not cmd then return false,"command" end
        if cmd.seq&gt;self.ack+C.pendingFrames then return false,"window" end
        if cmd.tick+8&gt;self.startTick+math.floor(math.max(0,now-self.started)*288)+C.leadTicks then return false,"timing" end
        if self.pending[cmd.seq] and not P.same(cmd,self.pending[cmd.seq]) then return false,"conflicting command" end
        accepted[#accepted+1]=cmd
    end
    local witnessSeq,witnessState
    if packet.witness then
        local w=packet.witness
        if not P.integer(w.seq,1,self.ack+C.pendingFrames) or
            w.tick~=self.startTick+w.seq*8 then return false,"witness tick" end
        local state=P.witness(w.state);if not state then return false,"witness" end
        witnessSeq,witnessState=w.seq,state
    end
    for _,cmd in ipairs(accepted) do if cmd.seq&gt;self.ack then self.pending[cmd.seq]=cmd end end
    if witnessSeq and witnessSeq&gt;self.ack then self.witnesses[witnessSeq]=witnessState end
    if witnessSeq and witnessSeq&lt;=self.ack and self.acceptedStates[witnessSeq] and self.onWitness and not self.verifiedWitnesses[witnessSeq] then
        self.verifiedWitnesses[witnessSeq]=true
        self.onWitness(witnessSeq,self.acceptedStates[witnessSeq],witnessState)
    end
    self.lastReceive=now;self.echo=P.finite(packet.echo) and packet.echo or nil;return true
end
function M:advance(maxTicks,budget,onFrame)
    local start=os.clock();local count=0
    while count&lt;maxTicks and (count==0 or os.clock()-start&lt;budget) do
        local cmd=self.pending[self.ack+1]
        if not cmd then break end -- a gap stops verification, never the local predictor
        if self.sim:tick()==cmd.tick and cmd.input.shift~=0 then self.sim:shift(cmd.input.shift) end
        self.sim:step(cmd.input);count+=1
        if self.sim:tick()==cmd.tick+8 then
            self.ack=cmd.seq;self.pending[cmd.seq]=nil
            self.acceptedStates[cmd.seq]=table.clone(self.sim:state())
            self.acceptedStates[cmd.seq-C.pendingFrames]=nil
            self.verifiedWitnesses[cmd.seq-C.pendingFrames]=nil
            local w=self.witnesses[cmd.seq];self.witnesses[cmd.seq]=nil
            if w and self.onWitness and not self.verifiedWitnesses[cmd.seq] then
                self.verifiedWitnesses[cmd.seq]=true;self.onWitness(cmd.seq,self.acceptedStates[cmd.seq],w)
            end
            if onFrame then onFrame(cmd,w) end
        end
    end
    self.steps+=count;self.cpu+=os.clock()-start;return count
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">Roblox.LocalPrediction</string><ProtectedString name="Source">local C=require(script and script.Parent.PredictionConfig or "./PredictionConfig")
local Codec=require(script and script.Parent.PredictionCheckpoint or "./PredictionCheckpoint")
local P=require(script and script.Parent.PredictionProtocol or "./PredictionProtocol")
local M={};M.__index=M
function M.new(sim,epoch,initial)
    sim:restore(initial)
    return setmetatable({sim=sim,epoch=epoch,startTick=sim:tick(),ack=0,ackTick=sim:tick(),commands={},
        states={},backlog=0,reconciliations=0,hardResyncs=0,correction=0,slots={},base=initial.memory,
        lastAck=-1,cpu=0,steps=0,rtt=0},M)
end
function M:advance(elapsed,sample,budget)
    assert(P.finite(elapsed) and elapsed&gt;=0,"elapsed")
    self.backlog+=elapsed
    local start=os.clock();local count=0
    while (self.backlog+1e-12&gt;=1/288 or (self.replayUntil and self.sim:tick()&lt;self.replayUntil)) and count&lt;C.maxSteps and
        (count==0 or os.clock()-start&lt;(budget or C.clientBudget)) do
        local tick=self.sim:tick();local seq=math.floor((tick-self.startTick)/8)+1
        local cmd=self.commands[seq]
        local replay=self.replayUntil and tick&lt;self.replayUntil
        if tick%8==0 and not replay then
            local input=assert(P.input(sample()),"local input")
            cmd={seq=seq,tick=tick,input=input};self.commands[seq]=cmd
        end
        assert(cmd,"missing current command")
        if tick%8==0 and cmd.input.shift~=0 then self.sim:shift(cmd.input.shift) end
        self.sim:step(cmd.input);if not replay then self.backlog-=1/288 end;count+=1
        if self.replayUntil and self.sim:tick()&gt;=self.replayUntil then self.replayUntil=nil end
        if self.sim:tick()%8==0 then
            self.states[seq]=table.clone(self.sim:state())
            if seq%C.checkpointFrames==0 then
                self.slots[#self.slots+1]={tick=self.sim:tick(),state=Codec.pack(self.sim:checkpoint(),self.base)}
                if #self.slots&gt;C.checkpointSlots then table.remove(self.slots,1) end
            end
            self.commands[seq-C.historyFrames]=nil;self.states[seq-C.historyFrames]=nil
        end
    end
    if math.abs(self.backlog)&lt;1e-12 then self.backlog=0 end
    self.steps+=count;self.cpu+=os.clock()-start;return count
end
function M:packet(now)
    local latest=math.floor((self.sim:tick()-self.startTick)/8)
    local commands={}
    for seq=self.ack+1,math.min(latest+1,self.ack+C.batchFrames) do
        if self.commands[seq] then commands[#commands+1]=self.commands[seq] end
    end
    -- Witness only for a frame included in this packet. Server compares at the SAME tick.
    local seq=commands[#commands] and math.min(commands[#commands].seq,latest)
    return {kind="commands",epoch=self.epoch,commands=commands,echo=now,
        witness=seq and self.states[seq] and {seq=seq,tick=self.startTick+seq*8,state=self.states[seq]} or nil}
end
function M:acknowledge(message,now)
    if message.epoch~=self.epoch or not P.integer(message.ack,0,2147483647) or
        message.tick~=self.startTick+message.ack*8 or message.ack&lt;self.ack then return false end
    if message.tick&gt;self.sim:tick() then return false end
    self.ack,self.ackTick=message.ack,message.tick
    if P.finite(message.echo) and now&gt;=message.echo then self.ackRTT=now-message.echo end
    if message.checkpoint and message.tick&gt;self.lastAck then
        local oldTick=math.max(self.sim:tick(),self.replayUntil or 0);local canReplay=oldTick-message.tick&lt;=C.historyFrames*8
        for tick=message.tick,oldTick-1,8 do
            local seq=math.floor((tick-self.startTick)/8)+1
            if not self.commands[seq] then canReplay=false;break end
        end
        self.sim:restore(Codec.unpack(message.checkpoint,self.base))
        assert(self.sim:tick()==message.tick,"mixed checkpoint ticks")
        if canReplay then
            self.replayUntil=oldTick
        else
            self.hardResyncs+=1;self.commands={};self.states={};self.replayUntil=nil
        end
        self.slots={};self.reconciliations+=1;self.correction=message.error and message.error.position or 0
        self.lastAck=message.tick
    end
    return true
end
function M:stats()
    return {tick=self.sim:tick(),ack=self.ack,ackTick=self.ackTick,
        unacknowledged=math.max(0,math.ceil((self.sim:tick()-self.startTick)/8)-self.ack),
        rtt=self.rtt,backlog=self.backlog,reconciliations=self.reconciliations,correction=self.correction,
        hardResyncs=self.hardResyncs,cpu=self.cpu,steps=self.steps,replayTicks=math.max(0,(self.replayUntil or 0)-self.sim:tick())}
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">Roblox.PredictionSimulation</string><ProtectedString name="Source">-- The SAME V6 adapter/core on both hosts. No transform is used as simulation input.
local Adapter=require(script.Parent.CupChassisAdapter)
local Codec=require(script.Parent.PredictionCheckpoint)
local M={};M.__index=M
local fields={"origin","inContact","planes","pendingShift","controlsSuspended","weather","trackNormal",
    "draftTest","rootCF","collision","appliedSetupKey","brakeBias","originalTrack",
    "appliedTrackSetupName","appliedTrackSetupSHA256","requestedTrackSetupName","requestedTrackSetupSHA256"}
function M.new(car,tune,remote,client,driver,prepareSpawn)
    local a=Adapter.new(car,tune,remote,{client=client,networked=true,driver=driver,prepareSpawn=prepareSpawn})
    assert(a.originalTrack,"Stage 14 requires installed V6 native track contacts")
    return setmetatable({adapter=a},M)
end
function M:tick() return self.adapter.core:tick() end
function M:step(input) self.adapter:tickCore(input) end
function M:shift(delta) self.adapter:shift(delta) end
function M:state() return self.adapter.core:readState() end
function M:checkpoint()
    local a=self.adapter;local c=a.core:checkpoint();c.adapter={}
    for _,key in ipairs(fields) do c.adapter[key]=Codec.copy(a[key]) end
    return c
end
function M:restore(c)
    assert(c.schema==14 and c.adapter and c.hosts,"Stage 14 requires a complete checkpoint")
    local a=self.adapter;a.core:restore(c)
    for _,key in ipairs(fields) do a[key]=Codec.copy(c.adapter[key]) end
    a.stepper.state.tick=a.core:tick();a.runner.accumulator=0
    -- rootCF comes from that checkpoint, never from the currently rendered car.
end
function M:present() self.adapter:present() end
function M:destroy() self.adapter:destroy() end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX18"><Properties><string name="Name">Roblox.PredictionServer</string><ProtectedString name="Source">local RS=game:GetService("ReplicatedStorage")
local Players=game:GetService("Players")
local Run=game:GetService("RunService")
local package=script.Parent.Parent
local C=require(script.Parent.PredictionConfig)
local P=require(script.Parent.PredictionProtocol)
local Codec=require(script.Parent.PredictionCheckpoint)
local Session=require(script.Parent.PredictionSession)
local Simulation=require(script.Parent.PredictionSimulation)
local Snap=require(script.Parent.RenderSnapshot)
local Tune=require(package.Core.TestTune)
local M={}
function M.start(ownerScript)
    assert(not package:GetAttribute("PredictionServerRunning"),"Another Stage 14 server controller is already running")
    package:SetAttribute("PredictionServerRunning",true)
    assert(require(script.Parent.ModeConfig).mode=="NR2003_CUP","Stage 14 requires NR2003_CUP")
    local function event(name,class)
        local r=package:FindFirstChild(name)
        if not r then r=Instance.new(class);r.Name=name;r.Parent=package end
        assert(r.ClassName==class,"remote class: "..name);return r
    end
    local control=event("PredictionControl","RemoteEvent")
    local state=event("PredictionState","UnreliableRemoteEvent")
    local input=package:WaitForChild("Input")
    local world=workspace:FindFirstChild("NR2003LabWorld")
    if not world then
        world=Instance.new("Folder");world.Name="NR2003LabWorld";world.Parent=workspace
    end
    if not world:FindFirstChild("TestCar") then
        local b=require(script.Parent.CarBuilder);b.create(world,b.spawnCFrame(Tune.new()),Tune.new())
    end
    local modelFolder=package:FindFirstChild("CarModel")
    local Draw=modelFolder and require(modelFolder.NR2003DrawState)
    local entries,conns={},{};local nextId=0;local ready={};local actionTimes={};local closed=false
    local function sendStart(e)
        if not e.driver or not ready[e.driver] then return end
        if e.sim:tick()%8~=0 then e.startRequested=true;return end
        e.startRequested=nil;e.correction=nil;e.needsCorrection=nil
        -- Ownership/reset epochs invalidate all traffic from an earlier lifecycle.
        e.epoch+=1;e.initial=e.sim:checkpoint();e.session=Session.new(e.epoch,e.sim:tick(),os.clock(),e.sim)
        e.lastAck=0;e.forceAck=true;e.base=e.initial.memory
        e.session.onWitness=function(seq,accepted,witness)
            local bad,error=P.error(accepted,witness)
            e.lastError=error;e.lastError.tick=e.session.startTick+seq*8
            if error.maximum&gt;0 then e.divergentFrames=(e.divergentFrames or 0)+1 end
            if bad then e.needsCorrection=true end
        end
        e.car:SetAttribute("PredictionEpoch",e.epoch)
        control:FireClient(e.driver,{kind="start",id=e.id,car=e.car,epoch=e.epoch,
            checkpoint=Codec.pack(e.initial),tick=e.sim:tick()})
    end
    local function add(car)
        if closed or car.Parent~=world or not car:IsA("Model") or not car:FindFirstChild("DriverSeat") or not car:FindFirstChild("Chassis") then return end
        if entries[car] then return end
        nextId+=1
        local sim=Simulation.new(car,Tune.new(),input,false,nil,nextId==1)
        local e={car=car,id=nextId,sim=sim,epoch=0,seq=0,renderTimer=0,ackTimer=0,idle=0}
        entries[car]=e;car:SetAttribute("PredictionVehicleId",e.id);car:SetAttribute("PredictionEnabled",true)
    end
    for _,car in ipairs(world:GetChildren()) do add(car) end
    local function deferAdd(car) if task then task.defer(add,car) else add(car) end end
    conns[#conns+1]=world.ChildAdded:Connect(deferAdd)
    if world.DescendantAdded then conns[#conns+1]=world.DescendantAdded:Connect(function(child)
        if child.Name=="DriverSeat" or child.Name=="Chassis" then deferAdd(child.Parent) end
    end) end
    local function find(player,id)
        for _,e in pairs(entries) do if e.id==id and e.driver==player and e.sim.adapter:driver()==player then return e end end
    end
    local function guard(fn)
        return function(...)
            local ok,err=pcall(fn,...);if not ok then warn("Stage 14: "..tostring(err)) end
        end
    end
    conns[#conns+1]=control.OnServerEvent:Connect(guard(function(player,msg)
        if type(msg)~="table" then return end
        if msg.kind=="ready" then
            if ready[player] and os.clock()-ready[player]&lt;1 then return end
            ready[player]=os.clock()
            for _,e in pairs(entries) do if e.driver==player then sendStart(e) end end
            return
        end
        local e=find(player,msg.id);if not e or not e.session or msg.epoch~=e.epoch then return end
        if msg.kind=="commands" then
            local ok=e.session:receive(msg,os.clock())
            if not ok then e.session.rejected+=1 end
        elseif msg.kind=="resync" and os.clock()-(e.lastResync or 0)&gt;1 then
            e.lastResync=os.clock();sendStart(e)
        elseif msg.kind=="ping" and P.finite(msg.echo) and os.clock()-(e.lastPing or -1)&gt;0.25 then
            e.lastPing=os.clock();control:FireClient(player,{kind="pong",id=e.id,epoch=e.epoch,echo=msg.echo})
        end
    end))
    conns[#conns+1]=input.OnServerEvent:Connect(guard(function(player,msg)
        if type(msg)~="table" then return end
        local e
        for _,candidate in pairs(entries) do
            if candidate.sim.adapter:driver()==player then e=candidate;break end
        end
        if msg.kind=="enter" then
            -- The existing seat handler still performs distance, life, cooldown, ownership checks.
            local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local nearest,dist
                for _,candidate in pairs(entries) do
                    local d=(candidate.car.DriverSeat.Position-root.Position).Magnitude
                    if not dist or d&lt;dist then nearest,dist=candidate,d end
                end
                if nearest then nearest.sim.adapter:requestEntry(player) end
            end
            return
        end
        if not e or os.clock()-(actionTimes[player] or 0)&lt;0.15 then return end
        actionTimes[player]=os.clock()
        if msg.kind=="exit" then e.sim.adapter:exit(player)
        elseif msg.kind=="reset" then
            e.sim.adapter:reset();sendStart(e)
        elseif msg.kind=="debug" then
            e.sim.adapter.debugVisible=not e.sim.adapter.debugVisible
            e.car:SetAttribute("DebugContacts",e.sim.adapter.debugVisible)
        end -- legacy input/shift messages cannot drive a Stage 14 car
    end))
    conns[#conns+1]=Players.PlayerRemoving:Connect(function(player)
        ready[player]=nil;actionTimes[player]=nil
        for _,e in pairs(entries) do
            if e.driver==player then e.driver=nil;e.session=nil;e.epoch+=1 end
        end
    end)
    conns[#conns+1]=Run.PreSimulation:Connect(function(dt)
        local cycleStart=os.clock()
        local ordered={};for _,e in pairs(entries) do ordered[#ordered+1]=e end
        table.sort(ordered,function(a,b) return a.id&lt;b.id end)
        M.cursor=((M.cursor or 0)%math.max(1,#ordered))+1
        for index=1,#ordered do
            local e=ordered[(M.cursor+index-2)%#ordered+1];local car=e.car
            if not car:IsDescendantOf(world) then e.sim:destroy();entries[car]=nil;continue end
            local ok,err=pcall(function()
                local a=e.sim.adapter;a.access:step()
                local driver=a:driver()
                if driver~=e.driver then
                    local old=e.driver
                    if old and old.Parent==Players then control:FireClient(old,{kind="stop",id=e.id,epoch=e.epoch}) end
                    e.driver=driver;e.session=nil;e.epoch+=1
                    -- Finish an idle partial device frame before changing ownership.
                    while e.sim:tick()%8~=0 do e.sim:step({}) end
                    sendStart(e)
                end
                if e.session and driver then
                    local s=e.session
                    local budget=math.max(0,C.serverBudget-(os.clock()-cycleStart))
                    if budget&gt;0 then
                        s:advance(C.maxSteps,budget,function()
                            if e.needsCorrection then
                                e.correction={tick=e.sim:tick(),ack=s.ack,checkpoint=Codec.pack(e.sim:checkpoint(),e.base),error=e.lastError}
                                e.needsCorrection=nil
                            end
                        end)
                    end
                    if e.needsCorrection and e.sim:tick()%8==0 then
                        e.correction={tick=e.sim:tick(),ack=s.ack,checkpoint=Codec.pack(e.sim:checkpoint(),e.base),error=e.lastError}
                        e.needsCorrection=nil
                    end
                    if e.startRequested and e.sim:tick()%8==0 then sendStart(e);s=e.session end
                    if os.clock()-s.lastReceive&gt;C.timeout then
                        -- End authority for a disconnected driver; its client can keep predicting until seat replication.
                        a:exit(driver);e.session=nil
                    end
                    e.ackTimer+=dt
                    if e.ackTimer&gt;=1/C.ackHz or e.forceAck or e.correction then
                        e.ackTimer=0;e.forceAck=false
                        local m=e.correction or {tick=s.startTick+s.ack*8,ack=s.ack}
                        m.kind="ack";m.id=e.id;m.epoch=e.epoch;m.echo=s.echo
                        m.divergence=e.lastError;m.rejected=s.rejected;m.validationCPU=s.cpu
                        control:FireClient(driver,m);e.correction=nil
                    end
                elseif not driver then
                    e.idle+=dt
                    local count=0
                    while e.idle&gt;=1/288 and count&lt;C.maxSteps do
                        e.sim:step({});e.idle-=1/288;count+=1
                    end
                end
                e.sim:present()
                e.renderTimer+=dt
                if e.renderTimer&gt;=1/30 and (e.lastSentTick~=e.sim:tick() or e.lastSentEpoch~=e.epoch) then
                    e.renderTimer=e.renderTimer%(1/30);e.seq=(e.seq+1)%65536
                    local time=workspace:GetServerTimeNow()
                    -- Accepted motion is entirely server-computed, even when a client witness is forged.
                    local snap=a:renderSnapshot(e.seq,time,e.id)
                    local draw=Draw and Draw.sample(a.core,{}, {})
                    state:FireAllClients({id=e.id,epoch=e.epoch,snapshot=Snap.encode(snap),
                        draw=draw and Draw.encode(e.seq,time,draw) or nil})
                    e.lastSentTick=e.sim:tick();e.lastSentEpoch=e.epoch
                end
            end)
            if not ok then
                car:SetAttribute("PredictionFault",tostring(err));warn("Stage 14 vehicle "..e.id..": "..tostring(err))
                if e.driver then e.sim.adapter:exit(e.driver) end;e.session=nil
            end
        end
    end)
    conns[#conns+1]=ownerScript.Destroying:Connect(function()
        closed=true
        for _,c in ipairs(conns) do c:Disconnect() end
        for _,e in pairs(entries) do e.sim:destroy() end
        package:SetAttribute("PredictionServerRunning",nil)
    end)
    return entries
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX19"><Properties><string name="Name">Roblox.PredictionClient</string><ProtectedString name="Source">local Run=game:GetService("RunService")
local UIS=game:GetService("UserInputService")
local Players=game:GetService("Players")
local package=script.Parent.Parent
local C=require(script.Parent.PredictionConfig)
local Codec=require(script.Parent.PredictionCheckpoint)
local Predictor=require(script.Parent.LocalPrediction)
local Simulation=require(script.Parent.PredictionSimulation)
local Render=require(script.Parent.RenderPresentation)
local Snap=require(script.Parent.RenderSnapshot)
local Tune=require(package.Core.TestTune)
local Driver=require(script.Parent.DriverConfig)
local M={};M.__index=M
function M.new(primary,presentation,keys,showTelemetry)
    local self=setmetatable({player=Players.LocalPlayer,entries={},connections={},keys=keys,showTelemetry=showTelemetry,
        control=package:WaitForChild("PredictionControl"),state=package:WaitForChild("PredictionState"),
        sendTimer=0,telemetryTimer=0,primary=primary},M)
    self.entries[primary]={car=primary,presentation=presentation}
    local world=primary.Parent
    local function add(car)
        if self.closed or self.entries[car] or not car:IsA("Model") or not car:FindFirstChild("DriverSeat") or not car:FindFirstChild("Chassis") then return end
        local pres=Render.new(car,require(package.Core.CupTune).new(),package.RenderState)
        self.entries[car]={car=car,presentation=pres}
        local f=package:FindFirstChild("CarModel")
        if f and f:FindFirstChild("NR2003CarModelClient") then
            local model=require(f.NR2003CarModelClient).new(car,pres,package,self.player,keys)
            self:bindModel(car,model)
        end
    end
    for _,car in ipairs(world:GetChildren()) do add(car) end
    local function deferAdd(car) if task then task.defer(add,car) else add(car) end end
    self.connections[#self.connections+1]=world.ChildAdded:Connect(deferAdd)
    if world.DescendantAdded then self.connections[#self.connections+1]=world.DescendantAdded:Connect(function(child)
        if child.Name=="DriverSeat" or child.Name=="Chassis" then deferAdd(child.Parent) end
    end) end
    self.connections[#self.connections+1]=self.control.OnClientEvent:Connect(function(msg)
        local ok,err=pcall(function() self:receive(msg) end)
        if not ok then self.fault=tostring(err);warn("Stage 14 local: "..self.fault) end
    end)
    self.connections[#self.connections+1]=self.state.OnClientEvent:Connect(function(msg)
        if type(msg)~="table" then return end
        for _,e in pairs(self.entries) do
            if e.car:GetAttribute("PredictionVehicleId")==msg.id then
                if e.predictor then return end -- local pose/cockpit never passes through remote buffers
                if e.epoch and msg.epoch&lt;e.epoch then return end
                if e.epoch~=msg.epoch then e.presentation.buffer= require(script.Parent.SnapshotBuffer).new(require(script.Parent.RenderConfig).buffer) end
                e.epoch=msg.epoch
                local snap=Snap.decode(msg.snapshot)
                if snap then e.presentation.buffer:push(snap,workspace:GetServerTimeNow());e.lastRemote=snap.time end
                if e.model and msg.draw then
                    local ds=e.drawModule.decode(msg.draw);if ds then e.model.buf:push(ds) end
                end
            end
        end
    end)
    -- Ready is sent after listeners exist; server records it even before seat ownership.
    self.control:FireServer({kind="ready"})
    if task then task.defer(function()
        local e=self.entries[primary]
        if not self.closed and e and not e.sim and not e.warm then
            e.warm=Simulation.new(primary,Tune.new(),nil,true,function() return self.player end,false)
        end
    end) end
    return self
end
function M:bindModel(car,model)
    local e=self.entries[car];if not e then return end
    e.model=model
    local f=package:FindFirstChild("CarModel")
    e.drawModule=f and require(f.NR2003DrawState)
    if model then model.stage14=true end
end
function M:stop(e,discard)
    e.pendingAck=nil
    if e.predictor then e.predictor=nil;e.presentation.localPredictor=nil end
    if e.sim then e.warm=e.sim;e.sim=nil end
    if discard and e.warm then e.warm:destroy();e.warm=nil end
    if e.model then e.model.localDrawState=nil end
    e.offset=nil
end
function M:receive(msg)
    if type(msg)~="table" then return end
    local e=self.entries[msg.car]
    if not e then for _,candidate in pairs(self.entries) do
        if candidate.car:GetAttribute("PredictionVehicleId")==msg.id then e=candidate;break end
    end end
    if not e then return end
    if msg.kind=="start" then
        if e.epoch and msg.epoch&lt;=e.epoch and e.predictor then return end
        if e.epoch and msg.epoch&lt;e.epoch then return end
        local h=self.player.Character and self.player.Character:FindFirstChildOfClass("Humanoid")
        if not h or h.SeatPart~=e.car.DriverSeat then e.pendingStart=msg;return end
        self:stop(e);e.epoch=msg.epoch
        -- Preparation can be costly; it happens once per ownership/reset, never per command.
        e.sim=e.warm or Simulation.new(e.car,Tune.new(),nil,true,function() return self.player end,false)
        e.warm=nil
        e.predictor=Predictor.new(e.sim,e.epoch,Codec.unpack(msg.checkpoint))
        e.presentation.localPredictor=e.predictor;e.sim:present()
        self.pendingShift=0;self.fault=nil
    elseif msg.kind=="stop" and msg.epoch==e.epoch then
        e.pendingStart=nil;self:stop(e)
    elseif msg.kind=="pong" and e.predictor and msg.epoch==e.epoch and type(msg.echo)=="number" then
        e.predictor.rtt=math.max(0,os.clock()-msg.echo)
    elseif msg.kind=="ack" and e.predictor and msg.epoch==e.epoch then
        -- Verification can finish a held 8-tick command before the local host reaches
        -- its end. Keep its correction until that tick exists locally.
        if type(msg.tick)~="number" then return end
        if msg.tick&gt;e.sim:tick() then
            if not e.pendingAck or msg.checkpoint or not e.pendingAck.checkpoint then e.pendingAck=msg end
            return
        end
        if e.pendingAck and e.pendingAck.checkpoint and not msg.checkpoint and msg.ack&gt;e.pendingAck.ack then return end
        local before=e.sim.adapter.rootCF
        local count=e.predictor.reconciliations
        e.predictor:acknowledge(msg,os.clock())
        if e.predictor.reconciliations~=count then
            local after=e.sim.adapter.rootCF
            local distance=(before.Position-after.Position).Magnitude*e.sim.adapter.tune.metresPerStud
            if distance&lt;C.snapMetres then e.offset=before*after:Inverse();e.offsetAge=0 else e.offset=nil end
        end
        e.divergence=msg.divergence;e.rejected=msg.rejected
    end
end
function M:shift(delta) self.pendingShift=delta end
function M:noteInput() self.inputEvent=os.clock() end
function M:sample()
    local k=self.keys();local axis,analog=0,false
    local last=UIS:GetLastInputType()
    if last.Name:sub(1,7)=="Gamepad" and UIS:GetGamepadConnected(last) then
        for _,obj in ipairs(UIS:GetGamepadState(last)) do
            if obj.KeyCode==Enum.KeyCode.Thumbstick1 then
                axis=obj.Position.X
                if math.abs(axis)&lt;(Driver.gamepadSteerDeadzone or 0) then axis=0 end
                analog=true
            end
        end
    end
    local shift=self.pendingShift or 0;self.pendingShift=0
    local left,right=k.Left and 1 or 0,k.Right and 1 or 0
    if self.inputEvent then self.sampleEvent=self.inputEvent;self.inputEvent=nil end
    return {throttle=k.Gas and 1 or 0,brake=k.Brake and 1 or 0,clutch=k.Clutch and 1 or 0,
        handbrake=k.Handbrake and 1 or 0,steer=analog and axis or right-left,
        steerLeft=left,steerRight=right,steerAxis=axis,steerAnalog=analog,shift=shift}
end
function M:frame(dt)
    local humanoid=self.player.Character and self.player.Character:FindFirstChildOfClass("Humanoid")
    local seat=humanoid and humanoid.SeatPart
    local focus
    for car,e in pairs(self.entries) do
        if not car.Parent then self:stop(e,true);e.presentation:destroy();if e.model then e.model:destroy() end;self.entries[car]=nil;continue end
        local driving=seat==car:FindFirstChild("DriverSeat")
        if driving then focus=e end
        if driving and e.pendingStart then local start=e.pendingStart;e.pendingStart=nil;self:receive(start) end
        if e.predictor and not driving then self:stop(e) end
        if e.predictor and driving then
            local ok,err=pcall(function()
                e.predictor:advance(dt,function() return self:sample() end,math.max(C.clientBudget,math.min(0.025,dt*0.5)))
                if e.pendingAck and e.pendingAck.tick&lt;=e.sim:tick() then
                    local ack=e.pendingAck;e.pendingAck=nil;self:receive(ack)
                end
                e.sim:present()
                if e.offset then
                    e.offsetAge+=dt
                    local alpha=math.clamp(e.offsetAge/C.smoothSeconds,0,1)
                    car:PivotTo(e.offset:Lerp(CFrame.identity,alpha)*e.sim.adapter.rootCF)
                    if alpha==1 then e.offset=nil end
                end
                if self.sampleEvent then
                    self.eventToPresent=os.clock()-self.sampleEvent;self.sampleEvent=nil
                end
                if e.model and e.drawModule then
                    e.model.localDrawState=e.drawModule.sample(e.sim.adapter.core,{}, {})
                end
            end)
            if not ok then self.fault=tostring(err);warn(self.fault);self:stop(e) end
        end
        if e~=focus then
            e.presentation:update();if e.model then e.model:update(dt,false) end
        end
    end
    self.focus=focus;self.sendTimer+=dt;self.telemetryTimer+=dt
    if focus and not focus.predictor then
        self.readyTimer=(self.readyTimer or 0)+dt
        if self.readyTimer&gt;=1 then self.readyTimer=0;self.control:FireServer({kind="ready"}) end
    else self.readyTimer=0 end
    if focus and focus.predictor then
        self.pingTimer=(self.pingTimer or 0)+dt
        if self.pingTimer&gt;=1 then
            self.pingTimer=0;self.control:FireServer({kind="ping",id=focus.car:GetAttribute("PredictionVehicleId"),epoch=focus.epoch,echo=os.clock()})
        end
        if self.sendTimer&gt;=1/C.sendHz then
            self.sendTimer=0
            local msg=focus.predictor:packet(os.clock());msg.id=focus.car:GetAttribute("PredictionVehicleId")
            self.control:FireServer(msg)
            local stats=focus.predictor:stats()
            if stats.unacknowledged&gt;=C.historyFrames-8 or stats.hardResyncs&gt;(focus.lastHardResync or 0) then
                focus.lastHardResync=stats.hardResyncs
                self.control:FireServer({kind="resync",id=msg.id,epoch=msg.epoch})
            end
        end
        if self.telemetryTimer&gt;=0.1 then
            self.telemetryTimer=0;self.showTelemetry(focus.sim.adapter:telemetry())
        end
    end
    return focus
end
function M:stats()
    local e=self.focus
    if e and e.predictor then
        local s=e.predictor:stats();s.mode="LOCAL NR2003";s.eventToPresent=self.eventToPresent
        s.divergence=e.divergence;s.fault=self.fault;return s
    end
    return {mode=self.fault or "waiting for driver/initial state",tick=0,ack=0,ackTick=0,unacknowledged=0,
        rtt=0,backlog=0,reconciliations=0,correction=0,remoteAge=e and e.lastRemote and workspace:GetServerTimeNow()-e.lastRemote}
end
function M:destroy()
    self.closed=true
    for _,c in ipairs(self.connections) do c:Disconnect() end
    for _,e in pairs(self.entries) do self:stop(e,true);e.presentation:destroy();if e.model then e.model:destroy() end end
    self.entries={}
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX20"><Properties><string name="Name">Roblox.Stage14SelfTest</string><ProtectedString name="Source">local P=require(script.Parent.PredictionProtocol)
local Codec=require(script.Parent.PredictionCheckpoint)
local Session=require(script.Parent.PredictionSession)
local M={}
function M.run()
    assert(P.input({steer=0/0})==nil,"nonfinite input")
    assert(P.input({throttle=2})==nil,"input range")
    assert(P.command({seq=2,tick=0,input={}},0)==nil,"tick sequence")
    local memory=buffer.create(4096);buffer.writeu32(memory,2048,123456)
    local packed=Codec.pack({memory=memory,tick=8})
    assert(buffer.tostring(Codec.unpack(packed).memory)==buffer.tostring(memory),"checkpoint round trip")
    local sim={t=0}
    function sim:tick() return self.t end
    function sim:state() return table.create(45,0) end
    function sim:shift() end
    function sim:step() self.t+=1 end
    local session=Session.new(1,0,0,sim)
    assert(not session:receive({epoch=2,commands={}},1),"old lifecycle")
    assert(session:receive({epoch=1,commands={{seq=2,tick=8,input={}}}},1))
    assert(session:advance(24,1)==0,"gap must hold validation")
    assert(session:receive({epoch=1,commands={{seq=1,tick=0,input={}}}},1))
    assert(session:advance(24,1)==16 and session.ack==2,"gap recovery")
    return true
end
return M
