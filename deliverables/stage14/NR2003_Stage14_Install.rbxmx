			local v = opts[name]
			if v ~= nil and not (type(v) == "number" and v &gt;= lo and v &lt;= hi) then
				error(string.format("NR2003 Stage 12.1: %s must be a number %g..%g (got %s)", name, lo, hi, tostring(v)))
			end
		end
