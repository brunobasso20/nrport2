sha256"]="604010620a5f7ad7e292638fe4cd82f6f18d7ae59d19231443989084f76cfa63",["fnv32"]=4176297414}}},{["class"]="ModuleScript",["key"]="Core.NR2003Cup.NR2003CupTrackData8",["accepted"]={{["bytes"]=166414,["sha256"]="6476c114ebd1d7993685b725346e0523bf331bdd8a69d4a334f29d1d2090bcf2",["fnv32"]=3148663224}}},{["class"]="ModuleScript",["key"]="Core.NR2003Cup.NR2003CupTrackData9",["accepted"]={{["bytes"]=115727,["sha256"]="5a89096169ec83cddfe87ab77f89301ab8898de8899be476298fb4ee68bbed33",["fnv32"]=968429767}}},{["class"]="ModuleScript",["key"]="Roblox.NR2003WatkinsGlen",["accepted"]={{["bytes"]=7805,["sha256"]="541b71e34fe5cb4f2a1d11a21d5f8b3163ea70183beca7d73aba476836fb2cc7",["fnv32"]=3840189536}}},{["class"]="ModuleScript",["key"]="Roblox.NR2003WatkinsGlenSetup",["accepted"]={{["bytes"]=5349,["sha256"]="5faaccd7628518a2923c331fc709e1c29969f7b1cabdcdcdb1dc99074afab2c2",["fnv32"]=734809296}}},{["class"]="ModuleScript",["key"]="Roblox.RenderConfig",["accepted"]={{["bytes"]=865,["sha256"]="1522e21a8175e0c1a29aa222e8e7cadbabb71f72909979ffd670e69b5116cb7a",["fnv32"]=3549820158}}},{["key"]="Core.NR2003Cup.NR2003CupBuild",["class"]="ModuleScript",["accepted"]={{["bytes"]=12202,["sha256"]="bb5852b5bb9f60063b62cba4e5e565e14d119217c3e13614e442897eba4f0259",["fnv32"]=4039559273}}},{["key"]="Core.NR2003Cup.NR2003CupJITPG1",["class"]="ModuleScript",["accepted"]={{["bytes"]=90638,["sha256"]="8f0231afee929c149af1ae481c99095d6bede8a102dad0d7b07959bad52eb276",["fnv32"]=1499156389}}},{["key"]="Core.NR2003Cup.NR2003CupJITPG2",["class"]="ModuleScript",["accepted"]={{["bytes"]=142212,["sha256"]="f68d2dd5291ba3799af048dcc95f47eeb107e13dc428e224b40088c25f4831b6",["fnv32"]=980421067}}},{["key"]="Core.NR2003Cup.NR2003CupJITPG3",["class"]="ModuleScript",["accepted"]={{["bytes"]=74788,["sha256"]="32362343837ca2a8e23b1a5614a566dc5e137817da41f04d7f8438d0566382eb",["fnv32"]=1140034572}}},{["key"]="Core.NR2003Cup.NR2003CupJITPG4",["class"]="ModuleScript",["accepted"]={{["bytes"]=126089,["sha256"]="5e72896222e0ed6bbf0cbc757aeadd53190a0fa96c5cfb2f10fc3c4e715053c1",["fnv32"]=1636573426}}},{["key"]="Core.NR2003Cup.NR2003CupJITWG1",["class"]="ModuleScript",["accepted"]={{["bytes"]=90639,["sha256"]="e8fec7e787bfda5754e2e5f68b1a47247b1aa7a74ed1249460da3d2d0ca3af6f",["fnv32"]=117086621}}},{["key"]="Core.NR2003Cup.NR2003CupJITWG2",["class"]="ModuleScript",["accepted"]={{["bytes"]=142213,["sha256"]="c48db7eaadf8be02c237a897813d1b8ea54dfb2fa7b44c6eed6a8abb801a91d5",["fnv32"]=3019099107}}},{["key"]="Core.NR2003Cup.NR2003CupJITWG3",["class"]="ModuleScript",["accepted"]={{["bytes"]=74789,["sha256"]="26c4de6b67bbb50d21e62fbea37f502a67cb427855cf60cec476de7c905410a1",["fnv32"]=4215266900}}},{["key"]="Core.NR2003Cup.NR2003CupJITWG4",["class"]="ModuleScript",["accepted"]={{["bytes"]=126090,["sha256"]="53c157260edc28467ad06079d72ec216ab0c58bd6c7c9c83dc018c7e3a4e2b5e",["fnv32"]=212818250}}},{["key"]="Core.NR2003Cup.NR2003CupTrackBuild",["class"]="ModuleScript",["accepted"]={{["bytes"]=143285,["sha256"]="1e06b2c88bdc078f7f3da02b0cab8401772dd67207e995196480e9c2faad21ef",["fnv32"]=1546747036}}},{["key"]="Core.NR2003Cup.NR2003CupWatkinsGlenSpec",["class"]="ModuleScript",["accepted"]={{["bytes"]=71885,["sha256"]="8b2e4e1ceace473f229f6f326f127d2475dce23c77812217d4cd4fb460bd1042",["fnv32"]=3868429419}}},{["key"]="Core.NR2003CupVehicle",["class"]="ModuleScript",["accepted"]={{["bytes"]=11559,["sha256"]="669c73328e6bb9ace39da18991a8a3877ca62540fc26dc68a0ce7e210fdd97cc",["fnv32"]=23420924}}},{["key"]="CarModel.NR2003DrawState",["class"]="ModuleScript",["accepted"]={{["bytes"]=9267,["fnv32"]=66146001}}},{["key"]="CarModel.NR2003Scale",["class"]="ModuleScript",["accepted"]={{["bytes"]=3914,["fnv32"]=3623640481}}}},["serverPrefix"]="-- Stage 14: exactly one controller path runs for NR2003_CUP.\ndo\n    local p=game:GetService(\"ReplicatedStorage\"):WaitForChild(\"NR2003Lab\")\n    if require(p.Roblox.ModeConfig).mode==\"NR2003_CUP\" then\n        require(p.Roblox.PredictionServer).start(script)\n        return\n    end\nend\n"}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX24"><Properties><string name="Name">Rollback</string><ProtectedString name="Source">return function()
    local backup=script.Parent;local H=require(backup.Support);local manifest=require(backup.Manifest)
    return H.lock(function()
        H.restore(backup,manifest,true)
        print("Stage 14 rolled back to the exact preceding V6 sources. Backup retained as "..backup.Name)
        return true
    end)
end
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX25"><Properties><string name="Name">Sources</string></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">CarModel.NR2003CarModelClient</string><ProtectedString name="Source">-- NR2003CarModelClient: client presentation of the ORIGINAL NR2003 car (model, cockpit, instruments, steering wheel,
-- cameras). Runs after RenderPresentation:update() in the client render step; reads the replicated draw state
-- (NR2003DrawState) at the SAME render time as the interpolated pose; never sends anything that feeds the physics.
-- 3do variables per frame, as NR2003.exe 005662d0 sets them for the focus car:
--   cockpitView      1 in cockpit / LookLeft / LookRight, 10 in Nose / Gearbox / F Susp / R Susp (car hidden), else 0
--   steeringWheelEnable = option "Animated Steering Wheel" ? 0 : 1 (image default ON); windshieldEnable = option
--   "Windshield (buildup)" ? 0 : 1 (image default ON); mirrorFrameEnable = 0 (00750194 = 2); day_night = 0 (day);
--   wheel_speed_N    00565b10(|rate|) (LF -&gt; wheel_speed_1, RF -&gt; 0, LR -&gt; 3, RR -&gt; 2); roofFlapsEnable / roof_flap_state
--   from car[0x15ac]; backfireFrame = car[0x15b0]; animate_driver = 0 (focus car); tach / oil / water / fuel lights
--   (NR2003Gauges.lights); timeValue = 10 max(0, trunc(deg(a) + 160.355)) outside the cockpit.
local Players=game:GetService("Players")
local UIS=game:GetService("UserInputService")
local Scale=require(script.Parent.NR2003Scale)
local Gauges=require(script.Parent.NR2003Gauges)
local DrawState=require(script.Parent.NR2003DrawState)
local Cameras=require(script.Parent.NR2003CameraSystem)
local Rig=require(script.Parent.NR2003CarModelRig)
local Mirror=require(script.Parent.NR2003Mirror)
local M={};M.__index=M
M.VERSION="1.1.0-carmodel"

local function attr(car,name,default)
    local v=car:GetAttribute(name)
    if v==nil then return default end
    return v
end

function M.new(car,presentation,package,player,getKeys)
    local folder=package:FindFirstChild("CarModel")
    assert(folder,"NR2003Lab.CarModel missing")
    local dataName=attr(car,"NR2003CarModelData","NR2003CarModelData_make_a")
    local dataFolder=folder:FindFirstChild("Data")
    local dataModule=dataFolder and dataFolder:FindFirstChild(dataName)
    local self=setmetatable({car=car,presentation=presentation,package=package,player=player,getKeys=getKeys,
        status="ok",active=false,ds={},vars={},camOut={},bodyR={},hidden={},hiddenChar={},lastCamera=nil},M)
    if not dataModule then self.status="descriptor "..dataName.." not installed (run INSTALL_CARMODEL_ASSETS)";return self end
    local data=require(dataModule)
    Scale.check({metresPerStud=data.metresPerStud})
    local assetsFolder=folder:FindFirstChild("Assets")
    local assets=assetsFolder and assetsFolder:FindFirstChild(data.meta.package)
    if not assets then self.status="imported model '"..data.meta.package.."' not found in NR2003Lab.CarModel.Assets";return self end
    self.data=data
    local ok,rig=pcall(Rig.new,data,assets,workspace,{name="NR2003CarModel_"..car.Name})
    if not ok then self.status="rig: "..tostring(rig);return self end
    self.rig=rig
    if #rig.missing&gt;0 then self.status=string.format("%d geometries missing in the import (first %s)",#rig.missing,rig.missing[1]) end
    local head=data.roles.head and data.nodes[data.roles.head[1]+1]
    self.headRest=head and head.t or {-0.75,0.4,0.467}
    self.cams=Cameras.new({onCar=data.cameras,widescreen=attr(car,"NR2003WidescreenProjection",true),
        fovDegrees=attr(car,"NR2003CockpitFOV",65)})
    self.buf=DrawState.newBuffer(64)
    local remote=package:FindFirstChild("DrawState")
    if remote then
        self.conn=remote.OnClientEvent:Connect(function(b)
            if self.stage14 then return end
            local s=DrawState.decode(b)
            if s then self.buf:push(s) end
        end)
    else self.status="RemoteEvent NR2003Lab.DrawState missing" end
    local livery=attr(car,"NR2003LiveryTexture",nil)
    if type(livery)=="string" and livery~="" then rig:setLivery(livery) end
    self.rayParams=RaycastParams.new();self.rayParams.FilterType=Enum.RaycastFilterType.Exclude
    -- rear-view mirror (original mirror camera through the cockpit portal; attribute NR2003Mirror = false disables)
    if attr(car,"NR2003Mirror",true) then
        local okM,mir=pcall(Mirror.new,data,rig.model,{})
        if okM then self.mirror=mir else warn("NR2003 mirror: "..tostring(mir)) end
    end
    -- NON-ORIGINAL orbit of the chase cameras (attribute NR2003OrbitCamera = false disables): right mouse button drag,
    -- mouse wheel zoom, gamepad right stick in the chase views; V / B reset it
    self.inputConns={}
    if UIS.InputBegan then
        local function chase() return self.driving and Cameras.CHASE[self.cams.mode]~=nil and attr(car,"NR2003OrbitCamera",true) end
        table.insert(self.inputConns,UIS.InputBegan:Connect(function(io,processed)
            if processed then return end
            if io.UserInputType==Enum.UserInputType.MouseButton2 and chase() then
                self.dragging=true;UIS.MouseBehavior=Enum.MouseBehavior.LockCurrentPosition
            end
        end))
        table.insert(self.inputConns,UIS.InputEnded:Connect(function(io)
            if io.UserInputType==Enum.UserInputType.MouseButton2 and self.dragging then
                self.dragging=false;UIS.MouseBehavior=Enum.MouseBehavior.Default
            end
        end))
        table.insert(self.inputConns,UIS.InputChanged:Connect(function(io,processed)
            if io.UserInputType==Enum.UserInputType.MouseMovement and self.dragging and chase() then
                self.cams:orbit(-io.Delta.X*M.ORBIT_MOUSE,io.Delta.Y*M.ORBIT_MOUSE)
            elseif io.UserInputType==Enum.UserInputType.MouseWheel and not processed and chase() then
                self.cams:zoom(1-io.Position.Z*0.1)
            end
        end))
    end
    self.active=true
    car:SetAttribute("NR2003CarModelStatus",self.status)
    return self
end

M.ORBIT_MOUSE=0.008          -- rad per pixel
M.ORBIT_STICK={2.5,1.5}       -- rad/s yaw / pitch at full right-stick deflection
function M:cameraActive() return self.active and self.driving==true end
function M:nextCamera() if self.cams then self.cams:nextCamera() end end
function M:prevCamera() if self.cams then self.cams:prevCamera() end end
function M:fovUp() if self.cams then self.cams:fovUp() end end
function M:fovDown() if self.cams then self.cams:fovDown() end end

local function setLocalHidden(list,root,on)
    for _,d in ipairs(root:GetDescendants()) do
        if d:IsA("BasePart") then
            if on then if list[d]==nil then list[d]=d.LocalTransparencyModifier end;d.LocalTransparencyModifier=1
            elseif list[d]~=nil then d.LocalTransparencyModifier=list[d];list[d]=nil end
        elseif d:IsA("Decal") or d:IsA("Texture") then
            if on then if list[d]==nil then list[d]=d.LocalTransparencyModifier end;d.LocalTransparencyModifier=1
            elseif list[d]~=nil then d.LocalTransparencyModifier=list[d];list[d]=nil end
        end
    end
end

local function ground(self,x,y,z)
    local p=Scale.point(x,y,z)
    local hit=workspace:Raycast(p+Vector3.new(0,20,0),Vector3.new(0,-400,0),self.rayParams)
    if not hit then return nil end
    local _,_,gz=Scale.toNRPoint(hit.Position)
    return gz
end

function M:update(dt,driving)
    if not self.active then return false end
    self.driving=driving
    local pres=self.presentation
    local rt=pres.buffer and pres.buffer.renderTime or nil
    local ds=self.localDrawState or self.buf:sample(rt,self.ds)
    if ds==nil then return false end
    local car=self.car
    -- hide the bench's generated visuals (client only, reversible); the original model replaces them
    if not self.benchHidden then
        setLocalHidden(self.hidden,car,true);self.benchHidden=true
        if car.DescendantAdded then   -- visuals the bench creates later (cockpit wheel, debug parts)
            self.addedConn=car.DescendantAdded:Connect(function(d)
                if (d:IsA("BasePart") or d:IsA("Decal") or d:IsA("Texture")) and self.hidden[d]==nil then
                    self.hidden[d]=d.LocalTransparencyModifier;d.LocalTransparencyModifier=1
                end
            end)
        end
    end
    local char=self.player.Character
    if driving and char then setLocalHidden(self.hiddenChar,char,true)
    elseif next(self.hiddenChar)~=nil and char then setLocalHidden(self.hiddenChar,char,false) end
    -- derived draw fields (005662d0)
    ds.wheelAngle=DrawState.steeringWheelAngle(ds)
    ds.needles=Gauges.needles(ds,ds.needles)
    ds.headTranslation=ds.headTranslation or {}
    ds.headTranslation[1]=self.headRest[1]+ds.headX
    ds.headTranslation[2]=self.headRest[2]+ds.headY
    ds.headTranslation[3]=self.headRest[3]+ds.headZ
    -- body frame = the core's component-0 pose as placed by CupChassisAdapter:pose / RenderPresentation (car:PivotTo)
    local bodyCF=car:GetPivot()
    local bx,by,bz,Rb=Scale.fromCFrame(bodyCF,self.bodyR)
    -- camera (driver only)
    local cam=nil
    if driving then
        local keys=self.getKeys and self.getKeys() or {}
        local axis=nil
        local stickX,stickY=0,0
        local last=UIS:GetLastInputType()
        if last.Name:sub(1,7)=="Gamepad" and UIS:GetGamepadConnected(last) then
            for _,o in ipairs(UIS:GetGamepadState(last)) do
                if o.KeyCode==Enum.KeyCode.Thumbstick2 then stickX,stickY=o.Position.X,o.Position.Y end
            end
        end
        local chase=Cameras.CHASE[self.cams.mode]~=nil
        if chase then
            -- right stick orbits the chase cameras (NON-ORIGINAL extension)
            if attr(car,"NR2003OrbitCamera",true) and (math.abs(stickX)&gt;0.15 or math.abs(stickY)&gt;0.15) then
                self.cams:orbit(-stickX*M.ORBIT_STICK[1]*dt,-stickY*M.ORBIT_STICK[2]*dt)
            end
        elseif math.abs(stickX)&gt;0 then axis=-stickX end                 -- cockpit: analog look (0x54 / 0x55 axis)
        self.cams:input(keys.LookLeft==true,keys.LookRight==true,axis,dt)
        self.cams:tick(dt)
        self.rayParams.FilterDescendantsInstances={car,self.rig.model,char}
        cam=self.cams:compute({bx,by,bz},Rb,{head=ds.headTranslation,headPitch=ds.headPitch,headRoll=ds.headRoll},
            function(x,y,z) return ground(self,x,y,z) end,self.camOut)
        if cam then self.lastCamera=cam end
        cam=cam or self.lastCamera
    end
    local cockpitView=(cam and cam.cockpitView) or 0
    -- 3do variables
    local v=self.vars
    v.cockpitView=cockpitView;v._cockpit=(cockpitView==1)
    v.steeringWheelEnable=attr(car,"NR2003AnimatedSteeringWheel",true) and 0 or 1
    v.windshieldEnable=attr(car,"NR2003Windshield",true) and 0 or 1
    v.mirrorFrameEnable=0;v.day_night=0;v.animate_driver=0
    v.wheel_speed_1=DrawState.wheelSpeedState(ds.rate1);v.wheel_speed_0=DrawState.wheelSpeedState(ds.rate2)
    v.wheel_speed_3=DrawState.wheelSpeedState(ds.rate3);v.wheel_speed_2=DrawState.wheelSpeedState(ds.rate4)
    v.roofFlapsEnable=(ds.roofFlap&gt;=0.01) and 1 or 0
    v.roof_flap_state=math.floor(ds.roofFlap*255)
    v.backfireFrame=ds.backfire
    Gauges.lights(ds,v)                                            -- focus car (bit 0x10): every view
    if not v._cockpit then v.timeValue=DrawState.timeValue(ds.wheelAngle) end   -- bit 0x01 clear: driver animation
    local camera=workspace.CurrentCamera
    self.rig:update(bodyCF,v,ds,camera.CFrame.Position,1)
    -- rear-view mirror: only with the cockpit drawn (cockpitView 1, mirrorFrameEnable case 0)
    if self.mirror then
        local show=driving and v._cockpit
        if show and not self.mirrorReady then
            local ok,n=pcall(self.mirror.snapshot,self.mirror,bodyCF.Position,{car,self.rig.model,char,self.mirror.part})
            self.mirrorReady=true
            if not ok then warn("NR2003 mirror snapshot: "..tostring(n));self.mirror=nil end
        end
        if self.mirror then
            local mc=show and self.cams:computeMirror({bx,by,bz},Rb,{head=ds.headTranslation,modelHead=self.headRest,
                headPitch=ds.headPitch,headRoll=ds.headRoll},self.mirrorOut) or nil
            self.mirror:update(bodyCF,mc,show)
        end
    end
    car:SetAttribute("NR2003Camera",cam and cam.name or nil)
    return true
end

-- write the NR2003 camera into the Roblox camera (Hor+ vertical FOV; the (0, -0.125) frustum shift approximated by
-- tilting the view so the original view axis lands at the same screen row, NR2003CameraShift = false disables it)
function M:applyCamera(camera)
    local c=self.lastCamera
    if not c then return false end
    local cf=Scale.cframe(c.eye[1],c.eye[2],c.eye[3],c.R)
    local vfov=Scale.verticalFov(c.fov43)
    -- 00587e8a..00587ee7: widescreen branch -&gt; horizontal FOV at the display aspect, clamped to 2.5 rad (006f697c)
    local aspect=camera.ViewportSize.X/math.max(camera.ViewportSize.Y,1)
    if self.cams.widescreen and 2*math.atan(aspect*math.tan(math.rad(vfov)*0.5))&gt;2.5 then
        vfov=math.deg(2*math.atan(math.tan(1.25)/aspect))
    end
    if attr(self.car,"NR2003CameraShift",true) and c.shift then
        local th=math.atan(-c.shift[2]*math.tan(math.rad(vfov)*0.5))
        local tw=math.atan(-c.shift[1]*math.tan(math.rad(vfov)*0.5)*aspect)
        cf=cf*CFrame.Angles(th,-tw,0)
    end
    camera.CameraType=Enum.CameraType.Scriptable
    camera.FieldOfView=vfov
    camera.CFrame=cf
    return true
end

function M:destroy()
    if self.conn then self.conn:Disconnect() end
    for _,c in ipairs(self.inputConns or {}) do c:Disconnect() end
    if self.dragging then UIS.MouseBehavior=Enum.MouseBehavior.Default end
    if self.mirror then self.mirror:destroy() end
    if self.addedConn then self.addedConn:Disconnect() end
    setLocalHidden(self.hidden,self.car,false)
    if self.player.Character then setLocalHidden(self.hiddenChar,self.player.Character,false) end
    if self.rig then self.rig:destroy() end
end
return M
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">Client.NR2003Client</string><ProtectedString name="Source">local Players=game:GetService("Players")
