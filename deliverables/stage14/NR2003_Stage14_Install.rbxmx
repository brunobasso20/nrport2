-- V: core with driver, aero, Stage 11 frame, garage, steering, force feedback installed
-- extra: {build = NR2003CupTrackBuild (decision tables of the placed car), placed = NR2003CupJITP*, placedGeneric =
-- NR2003CupJITPG* (callbacks of the car rebuilt at the placed pose, natural / generic garage structure)}
return function(V, codeParts, dataParts, extra)
	assert(#codeParts == CODE_PARTS, "NR2003CupTrackCode: expected " .. CODE_PARTS .. " parts, found " .. #codeParts)
	assert(#dataParts == DATA_PARTS, "NR2003CupTrackData: expected " .. DATA_PARTS .. " parts, found " .. #dataParts)
	local M, BASE = V.memory(), V.base
