["NR2003AudioPhases"]=[=[
-- CES shared transport: 004eac30, 004f01f0, 004f02d0. These are playback
-- states, not ignition/physics states. Native fixtures exercise the decisions.
local M={INTRO=0,OUTRO=1,LOOP=2,STOP=3}
function M.new() return {phase=M.STOP,lastTransition=-1000} end
function M.change(transport,phase,now)
    if phase==M.INTRO or phase==M.OUTRO then
        if transport.phase==phase or (now&gt;=0 and now&lt;=transport.lastTransition+0.5) then return false end
        transport.lastTransition=now
    else transport.lastTransition=-1000 end
    local changed=transport.phase~=phase
    transport.phase=phase
    return changed
end
function M.update(transport,thresholds,rpm,load,startGate,hasIntro,hasOutro,now)
    local a,b=thresholds[1],thresholds[2]
    local phase=transport.phase;local target=nil
    if a&gt;0 or b&gt;0 then
        local running=(a&lt;=0 or rpm&gt;a) and (b&lt;=0 or load&gt;b)
        if phase==M.INTRO or phase==M.LOOP then
            if not running then target=hasOutro and math.abs(startGate+2)&gt;0.5 and M.OUTRO or M.STOP end
        elseif phase==M.OUTRO then
            if running then target=hasIntro and M.INTRO or M.LOOP end
        elseif phase==M.STOP and running then
            local start=hasIntro and ((startGate&gt;=0 and rpm&lt;startGate) or math.abs(startGate+1)&lt;0.5)
            target=start and M.INTRO or M.LOOP
        end
    else target=load&gt;0.0001 and M.LOOP or M.STOP end
    if target~=nil then return M.change(transport,target,now) end
    return false
end
return M
]=],
["NR2003AudioProfiles"]=[=[
-- No proprietary samples and no made-up asset IDs. Local CES conversion fills
-- AudioAssets. Both profiles use the same physical-state and controller API.
local M={}
M.DEFAULT="NR2003_ORIGINAL_REFERENCE"
M.PROFILES={
    NR2003_ORIGINAL_REFERENCE={name="NR2003_ORIGINAL_REFERENCE",referenceOnly=true,banks={},assets={},
        status="Original sound resources have not been linked",masterGain=1,
        minPitch=0.25,maxPitch=20,rollOffMinMetres=8,rollOffMaxMetres=250},
    NASCAR_SELFMADE={name="NASCAR_SELFMADE",referenceOnly=false,banks={},assets={},
        status="Reserved for phase two; no self-made recordings are enabled",masterGain=1,
        minPitch=0.25,maxPitch=20,rollOffMinMetres=8,rollOffMaxMetres=250},
}
function M.resolve(name,assets)
    local base=M.PROFILES[name]
    assert(base,"Unknown audio profile: "..tostring(name))
    local out={};for k,v in pairs(base) do out[k]=v end
    local override=assets and assets.profiles and assets.profiles[name]
    if override then for k,v in pairs(override) do out[k]=v end end
    out.name=name
    return out
end
function M.assetId(value)
    if type(value)=="number" and value&gt;0 and value==math.floor(value) then return "rbxassetid://"..string.format("%.0f",value) end
    if type(value)=="string" and value:match("^rbxassetid://[1-9]%d*$") then return value end
    -- Studio-only local files may be linked through rbxasset:// in a private
    -- Studio content directory. Local content never makes a published asset.
    if type(value)=="string" and value:match("^rbxasset://sounds/nr2003_reference/[%w_./%-]+$")
        and not value:find("..",1,true) then return value end
    return nil
end
return M
]=],
["NR2003AudioServer"]=[=[
-- No work on the server beyond reading the core and appending one bounded tail.
local State=require(script and script.Parent.NR2003AudioState or "./NR2003AudioState")
local M={};M.__index=M
function M.new(controller,package)
    return setmetatable({controller=controller,package=package,state={wheels={}},epoch=0},M)
end
function M:encode(snapshot,packet)
    if self.package:GetAttribute("NR2003AudioEnabled")==false then return packet end
    local core=self.controller.core
    if not core then return packet end
    local car=self.controller.car
    if car and car:GetAttribute("NR2003AudioVehicleId")~=snapshot.vehicleId then
        car:SetAttribute("NR2003AudioVehicleId",snapshot.vehicleId)
    end
    if bit32.band(snapshot.flags or 0,1)~=0 or (self.lastTick and snapshot.tick&lt;self.lastTick) then self.epoch+=1 end
    self.lastTick=snapshot.tick
    return State.append(packet,State.sample(core,self.controller,self.state),self.epoch)
end
return M
