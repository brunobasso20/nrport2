--!native
--!optimize 2
-- NR2003 Cup aerodynamics: session air, per-frame aero factors, drafting, aero setup, telemetry
-- (Stage 9). Installed on the runtime returned by NR2003CupDriver. Hand port of x87 code: every
-- float32 store rounds toward -inf like every store of the simulation task (0055cef0 -&gt; CW 0x077f),
-- x87 extended intermediates are evaluated in IEEE double (same approximation as Stages 6-8).
--
-- The aero FORCE model is ORIGINAL generated code (Stage 6/7 modules, untouched). At car build
-- 00561960 registers two natives in the forces callback of the chassis (both lifted):
--   00561a80  half wind velocity (e0b840..e0b848 * 0.5), projected on the plane of the car's
--             track-object vector (car+0x5ae -&gt; +0x24) when the car has a track object
--   00561b70  body-frame air velocity (chassis velocity - half wind, rotated by the chassis
--             rotation) and body rates -&gt; q = 0.5*rho*|v|^2 (rho = e0b84c),
--             yaw = atan2(vy,vx), pitch = atan2(-vz,|vxy|) + c083c4 (setup item 0xb1),
--             front ride height = ((c084c8 - z_LF) + (c084cc - z_RF))/2 (items 0xad/0xae, live
--             LF/RF suspension translation), factors car+0x59e/0x5a2/0x5a6 -&gt;
--             00410280: coefficients from the car spec (+0xa0 area, +0xa4 length, +0xa8..+0xe0
--             scalars, +0xec..+0x134 yaw/pitch/ride-height curves, +0x138..+0x144 damage tables),
--             setup items 0x3b grille tape / 0x3d rear spoiler / 0x20 0x21, damage 00410910 -&gt;
--             force (Fx,Fy,Fz) and moment (Mx,My,Mz) in chassis axes about the chassis origin,
--             rotated to world (005b8370) and added to the chassis spatial force (005b8040).
--             Every 16th call 00410b50 integrates the yaw stall state 007636e0/007636e4.
-- What the car build never runs and the game runs on the simulation task (ported here):
--   session start  0055d3ec -&gt; 0055af80 -&gt; 0055b140 -&gt; 0055a830 -&gt; 005a3c00(weather e0b728,
--                  race settings c0692a): air temperature, wind e0b840/e0b844, density e0b84c
--                  (005a3ba0 humid ideal gas, 005a3be0 saturation pressure polynomial)
--   every frame    0055d3f4 -&gt; 0055b450 -&gt; 0055bfd0 -&gt; 005637e0(car), BEFORE the 8 physics ticks:
--                  factors = 1.0, airspeed car+0x5aa, drafting 005afd80 for the focused car
-- Without startSession() the core stays in its post-build state (rho = 0, factors = 0: no aero),
-- which is exactly the state of every Stage 6/7/8 fixture and self-test.
return function(V)
	local rf32, r32, w32, wf32, wf32d, fd = V.rf32, V.r32, V.w32, V.wf32, V.wf32d, V.fd
	local ri32 = V.ri32
	local callx = V._callx
	local sqrt, sin, cos, atan2, abs, floor = math.sqrt, math.sin, math.cos, math.atan2, math.abs, math.floor
	local S = buffer.create(8)
	local function bits(u) buffer.writeu32(S, 0, u); return buffer.readf32(S, 0) end
	local function f2u(x) buffer.writef32(S, 0, x); return buffer.readu32(S, 0) end
	local function near32(x) buffer.writef32(S, 0, x); return buffer.readf32(S, 0) end -- x87 CW 0x027f store
	local function qword(lo, hi) buffer.writeu32(S, 0, lo); buffer.writeu32(S, 4, hi); return buffer.readf64(S, 0) end
	local NEG0 = -(0 * 1)

	-------------------------------------------------------------------------------------------------
	-- ORIGINAL constants (address -&gt; IEEE-754 single bits). Most of them lie outside the Stage 6/7
	-- image windows; tests/stage9 checks every entry against the NR2003.exe memory export.
	-------------------------------------------------------------------------------------------------
	local KBITS = {
		[0x6e97d8] = 0x3f800000, -- 1.0
		[0x6ea44c] = 0x3f000000, -- 0.5
		[0x6ea4a4] = 0x3c23d70a, -- 0.01 (005afd80 attenuation limit; 00423de0 percent scale)
		[0x6ea4cc] = 0x3dcccccd, -- 0.1 (005afd80 minimum distance)
		[0x6ea514] = 0x40a00000, -- 5.0 (005afd80 minimum wake speed*length)
		[0x6ea67c] = 0x3a83126f, -- 0.001 (005afd80 rear lift distance weight)
		[0x6ef640] = 0x3e99999a, -- 0.3 (005afd80 drag blend)
		[0x6f4164] = 0x3f8ccccd, -- 1.1 (factor upper clamp)
		[0x6f4658] = 0x3ee66666, -- 0.45 (lateral attenuation base)
		[0x6f5350] = 0x40600000, -- 3.5 (005b0230 lateral column split)
		[0x6f5a64] = 0x40e00000, -- 7.0 (maximum lateral offset)
		[0x6f688c] = 0x39d1b717, -- 0.0004 (front lift distance weight)
		[0x6f7340] = 0x42840000, -- 66 (maximum normalised gap, car behind)
		[0x6f7344] = 0x3da0ea0f, -- 0.0785714 (lateral attenuation slope)
		[0x6f7348] = 0x42960000, -- 75 (gap normalisation speed)
		[0x6f734c] = 0x43840000, -- 264 (maximum normalised gap, car ahead)
		[0x6f7350] = 0x3e924925, -- 1/3.5 (005b0230)
		[0x6f7334] = 0x00000000, -- lateral breakpoints 0 / 3.5 / 7 m (005b0230)
		[0x6f7338] = 0x40600000,
		[0x6f733c] = 0x40e00000,
		[0x6f7228] = 0xc2340000, -- wake table x0 = -45 m
		[0x6f722c] = 0x3e088889, -- wake table 1/dx (dx = 7.5 m)
		-- weather -&gt; air (005a3c00 / 005a3ba0 / 005a3be0)
		[0x6efe7c] = 0x42000000, -- 32 (F -&gt; C)
		[0x6f53b8] = 0x3f0e38e4, -- 5/9
		[0x6f6f84] = 0x41e00000, -- +28 C (conditions &lt; 2 and daytime)
		[0x6f6f80] = 0x3f490fd0, -- 45 deg per wind direction step
		[0x6f6f7c] = 0x4553a87b, -- 3386.53 Pa per inHg
		[0x6f6f78] = 0x3b6453d2, -- 0.003484 (1/R_dry)
		[0x6f6f74] = 0x3aac9f30, -- 0.001317 (0.378/R_dry)
		[0x6ee350] = 0x43889333, -- 273.15
		[0x6f6f50] = 0x4418c000, -- 611      saturation vapour pressure (Pa) polynomial in T (C)
		[0x6f6f54] = 0x41dbd4fe, -- 27.479
		[0x6f6f58] = 0x40461965, -- 3.0953
		[0x6f6f5c] = 0xbcd288ce, -- -0.0257
		[0x6f6f60] = 0x3a6bedfa, -- 0.0009
	}
	local K = {}
	for a, u in pairs(KBITS) do K[a] = bits(u) end
	local K_0447 = qword(0xe353f7cf, 0x3fdc9ba5) -- qword 006ef7b0 (mph -&gt; m/s, 005a3c00)
	-- 005a38b0 weather constructor defaults kept in obfuscated (XOR) containers: relative humidity
	-- (weather +0x00) and barometric pressure in inHg (weather +0x2c). The per-frame drift of
	-- 005a4cc0 (dynamic weather, 005a4690/005a4b10) is mapped but not ported.
	local HUMIDITY0, PRESSURE0 = bits(0x3e99999a), bits(0x41ef5c29) -- 0.3, 29.92
	-- wake table 006f7228 (00567818 format: x0, 1/dx, last index 0x1e, 2 columns) rows 006f7234..
	-- column 0: lateral offset 0 m, column 1: 3.5 m; column 2 (7 m) is e7d27c, never written (0).
	local WAKE_BITS = {
		0x00000000, 0x00000000, 0x00000000, 0x00000000, 0xbcac0831, 0xbbe56041, 0xbd73b646, 0xbcac0831,
		0xbda4dd2f, 0xbca0902e, 0xbdc8b439, 0xbc83e426, 0xbdf3b646, 0xbcac0831, 0xbe010625, 0xbce56041,
		0xbdf97247, 0xbd0f5c29, 0xbdf0d844, 0xbd2ee632, 0xbde83e42, 0xbd4e703a, 0xbddfa440, 0xbd5fa440,
		0xbdd59b3d, 0xbd628241, 0xbdcb923a, 0xbd628241, 0xbdbeab36, 0xbd5fa440, 0xbdb33333, 0xbd5cc63f,
		0xbda64c2f, 0xbd542c3d, 0xbd9ad42c, 0xbd4b923a, 0xbd8c7e28, 0xbd3d3c36, 0xbd810625, 0xbd2ee632,
		0xbd6b1c43, 0xbd1db22d, 0xbd542c3d, 0xbd09a027, 0xbd401a37, 0xbcf0d844, 0xbd2c0831, 0xbcc8b439,
		0xbd17f62b, 0xbca64c2f, 0xbd03e426, 0xbc83e426, 0xbcd42c3d, 0xbc4e703a, 0xbca64c2f, 0xbc15182b,
		0xbc656041, 0xbbb78035, 0xbbfc5048, 0xbb378035, 0x00000000, 0x00000000, 0x00000000, 0x00000000,
	}
	local WAKE = table.create(#WAKE_BITS, 0)
	for i, u in ipairs(WAKE_BITS) do WAKE[i] = bits(u) end
	local WAKE_LAST, WAKE_COLS = 30, 2
	-- aero damage tables of the Cup spec (+0x138..+0x144 -&gt; 0071f908/0071f960/0071f9b8/0071fa10, 11 zones
	-- x {slope, detached value}, read by 00410910): these 16 cells (end of the lift table, first 12 cells of
	-- the yaw-moment table) lie outside the Stage 6/7 image windows because the build trace ran without
	-- damage. Original .data values (static export = post-build), restored on every reset.
	local DAMAGE_CELLS = {
		[0x71fa00] = 0x00000000, [0x71fa04] = 0x00000000, [0x71fa08] = 0x00000000, [0x71fa0c] = 0x00000000,
		[0x71fa10] = 0x00000000, [0x71fa14] = 0x00000000, [0x71fa18] = 0x00000000, [0x71fa1c] = 0x00000000,
		[0x71fa20] = 0x3c23d70a, [0x71fa24] = 0x3c449ba6, [0x71fa28] = 0xbc23d70a, [0x71fa2c] = 0xbc449ba6,
		[0x71fa30] = 0x3ba3d70a, [0x71fa34] = 0x3bb43958, [0x71fa38] = 0xbba3d70a, [0x71fa3c] = 0xbbb43958,
	}
	local function restoreImageCells()
		for a, u in pairs(DAMAGE_CELLS) do w32(a, u) end
	end
	restoreImageCells()

	-------------------------------------------------------------------------------------------------
	-- original cells
	-------------------------------------------------------------------------------------------------
	local WEATHER = 0xe0b728        -- 005a3c00 / 005a4cc0 'this' (session weather object)
	local AIR = WEATHER + 0x118     -- e0b840 wind x, e0b844 wind y, e0b848 wind z, e0b84c density
	local TRACK_NORTH = 0xbdbcf8    -- track orientation angle read by 005a3c00 (track data)
	local CAR = 0xc12030            -- player car slot (00562f70(0))
	local F_DRAG, F_FRONT, F_REAR, AIRSPEED, TRACKOBJ = 0x59e, 0x5a2, 0x5a6, 0x5aa, 0x5ae
	local SPEC = r32(CAR + 0x58a)   -- car spec (Cup speedway 0x7238e0)
	local SETUP = 0xc055c0          -- active setup (00557d60(n) = setup + 4n)
	local ITEM_TAPE, ITEM_SPOILER = 0x3b, 0x3d
	local DESC_TAPE, DESC_SPOILER = 0x6ee11c, 0x6ee138 -- garage descriptors: int min/max/step/default
	local ONE = 0x3f800000
	local HOST = 0xf7f100
	local BLOCK, OUT6, TOBJ = HOST + 0x600, HOST + 0x640, HOST + 0x680 -- telemetry args, outputs, track object
	local ROOT = V.ROOT
	local LF_SUSP, RF_SUSP = r32(0xc084c0), r32(0xc08310) -- lfsusp / rfsusp records (0055e9b0)

	-- x87 FSUB under RC = toward -inf: an exact zero difference is -0 (except +0 - (-0) = +0)
	local function subRTN(a, b)
		local r = a - b
		if r == 0 then
			if a ~= 0 then return NEG0 end
			if 1 / a &gt; 0 and 1 / b &lt; 0 then return 0 end
			return NEG0
		end
		return r
	end
	local function clampInt(x, lo, hi, default)
		x = tonumber(x)
		if x == nil or x ~= x then return default end
		x = floor(x + 0.5)
		if x &lt; lo then return lo elseif x &gt; hi then return hi end
		return x
	end
	local function f32(x) return near32(tonumber(x) or 0) end

	-------------------------------------------------------------------------------------------------
	-- weather -&gt; air (005a3c00 subset that feeds the aero cells; settings clamped by the option
	-- getters 004cd280 temperature 40..110 F, 004cd2d0 wind 0..30 mph, 004cd2b0 direction 0..7
	-- (out of range -&gt; 0), 004cd260 conditions 0..3 (out of range -&gt; 0))
	-------------------------------------------------------------------------------------------------
	-- 005a3be0: saturation vapour pressure (Pa) at T (C), Horner over 006f6f60..006f6f50
	local function esat(t)
		local v = K[0x6f6f60]
		v = v * t + K[0x6f6f5c]
		v = v * t + K[0x6f6f58]
		v = v * t + K[0x6f6f54]
		return v * t + K[0x6f6f50]
	end
	-- 005a3ba0(T C, P Pa (float32 argument), RH): the P*0.003484 product is stored back into the
	-- float argument slot (FSTP, RC down) before (P' - esat*RH*0.001317) / (T + 273.15)
	local function density(t, p, rh)
		local p2 = fd(p * K[0x6f6f78])
		return (p2 - esat(t) * rh * K[0x6f6f74]) / (t + K[0x6ee350])
	end
	V.airDensityOriginal = function(t, p, rh) return fd(density(t, p, rh)) end
	V.esatOriginal = esat

	local session = nil  -- applied weather settings (nil = post-build state, no aero inputs)
	local draftEnv = nil
	local trackNormal = nil

	local function applyWeather(w)
		local tF = clampInt(w.temperatureF, 40, 110, 70)
		local mph = clampInt(w.windSpeedMph, 0, 30, 0)
		local dir = clampInt(w.windDirection, -1, 8, 0); if dir &lt; 0 or dir &gt; 7 then dir = 0 end
		local cond = clampInt(w.conditions, -1, 4, 0); if cond &lt; 0 or cond &gt; 3 then cond = 0 end
		local night = w.night == true and 1 or 0
		local north = f32(w.trackNorth or 0)
		local rh = w.humidity ~= nil and f32(w.humidity) or HUMIDITY0
		local inHg = w.pressureInHg ~= nil and f32(w.pressureInHg) or PRESSURE0
		local applied = {temperatureF = tF, windSpeedMph = mph, windDirection = dir, conditions = cond,
			night = night == 1, trackNorth = north, humidity = rh, pressureInHg = inHg}
		-- +0x108 air temperature (C): FILD; FSUB 32; FMUL 5/9; FSTP
		local tC = fd((tF - K[0x6efe7c]) * K[0x6f53b8])
		wf32(WEATHER + 0x108, tC)
		-- +0x10c: +28 C when conditions &lt; 2 and the daytime container (+0x2bc, settings+0x48 bit 1) is 0
		local tAir = tC
		if cond &lt; 2 and night == 0 then tAir = fd(tC + K[0x6f6f84]) end
		wf32(WEATHER + 0x10c, tAir)
		-- +0x110 wind direction angle: FILD qword dir; FMUL 0.7853975; FSTP (container round trip)
		local ang = fd(dir * K[0x6f6f80])
		wf32(WEATHER + 0x110, ang)
		-- +0x114 wind speed m/s: FILD mph; FMUL qword 0.447; FSTP
		local spd = fd(mph * K_0447)
		wf32(WEATHER + 0x114, spd)
		-- +0x118 / +0x11c wind vector: -(cos|sin)(trackNorth - direction) * speed
		wf32(TRACK_NORTH, north)
		local d = subRTN(north, ang)
		wf32d(AIR, -(cos(d) * spd))
		wf32d(AIR + 4, -(sin(d) * spd))
		-- +0x120 (e0b848, wind z) is not written by 005a3c00 (BSS 0)
		-- +0x124 density: 005a3ba0(T = +0x10c, P = fd(inHg * 3386.53), RH)
		wf32d(AIR + 12, density(tAir, fd(inHg * K[0x6f6f7c]), rh))
		applied.airTemperatureC = tC; applied.densityTemperatureC = tAir
		applied.windAngle = ang; applied.windSpeed = spd
		applied.wind = {rf32(AIR), rf32(AIR + 4), rf32(AIR + 8)}; applied.density = rf32(AIR + 12)
		return applied
	end

	-------------------------------------------------------------------------------------------------
	-- drafting: 005afd80 + 005b0230 + 00567818 + 00516daa
	-------------------------------------------------------------------------------------------------
	-- 00516daa(a, b): b - a, increased by the track length (bad918) while negative
	local function trackGap(a, b, len)
		local g = subRTN(b, a)
		while g &lt; 0 do g = g + len end
		return g
	end
	-- 00567818 on the wake table: 2 float32 outputs (e7d274, e7d278); FIST rounds down (RC)
	local function wakeLookup(x)
		local u = (x - K[0x6f7228]) * K[0x6f722c]
		local i
		if u ~= u or u &gt;= 2147483648 or u &lt; -2147483648 then i = -2147483648 else i = floor(u) end
		local frac
		if i &lt; 0 then i = 0; frac = u
		elseif i &gt; WAKE_LAST then i = WAKE_LAST; frac = u - WAKE_LAST
		else frac = u - i end
		local row, nxt = i * WAKE_COLS, (i + 1) * WAKE_COLS
		local a0, a1 = WAKE[row + 1], WAKE[row + 2]
		return fd((WAKE[nxt + 1] - a0) * frac + a0), fd((WAKE[nxt + 2] - a1) * frac + a1)
	end
	-- 005b0230(gap, |lateral|): linear blend of the two lateral columns (column 2 = 0)
	local function wake(g, lat)
		local c0, c1 = wakeLookup(g)
		local lo, hi, bp
		if lat &lt; K[0x6f5350] then lo, hi, bp = c0, c1, K[0x6f7334] else lo, hi, bp = c1, 0, K[0x6f7338] end
		return subRTN(lat, bp) * subRTN(hi, lo) * K[0x6f7350] + lo
	end
	V.wakeOriginal = wake

	-- one direction of the race-order ring (car+4: cars ahead, car+8: cars behind)
	local function draftPass(cars, selfDist, selfLat, len, ahead)
		local maxGap = ahead and K[0x6f734c] or K[0x6f7340]
		local prod, att = 1.0, 1.0
		for _, c in ipairs(cars) do
			if not (att &gt; K[0x6ea4a4]) then break end
			local g
			if ahead then g = trackGap(selfDist, f32(c.lapDistance), len) else g = trackGap(f32(c.lapDistance), selfDist, len) end
			if not (g &lt; maxGap) then break end
			local vx, vy, vz = f32(c.vx), f32(c.vy), f32(c.vz)
			local d = sqrt((vx * vx + vy * vy) + vz * vz) * f32(c.wakeLength or rf32(SPEC + 0xd4))
			if d &lt; K[0x6ea514] then d = K[0x6ea514] end
			local gn = g * (K[0x6f7348] / d)
			local gn32 = fd(gn)
			if gn &gt; maxGap then break end
			local lat = abs(fd(subRTN(selfLat, f32(c.lateral))))
			if lat &lt; K[0x6f5a64] then
				local wk = wake(ahead and gn32 or -gn32, lat) * f32(c.wakeStrength or rf32(SPEC + 0xd0)) * att
				prod = fd((1 + wk) * prod)
				local gg = gn32 * gn32
				local r = sqrt(lat * lat + gg)
				if r &gt; K[0x6ea4cc] then
					local cell = CAR + (ahead and F_FRONT or F_REAR)
					local k = ahead and K[0x6f688c] or K[0x6ea67c]
					wf32d(cell, ((wk * gn32) / ((gg * k + 1) * r) + 1) * rf32(cell))
				end
				att = fd((lat * K[0x6f7344] + K[0x6f4658]) * att)
			end
		end
		return prod
	end
	local function clampFactor(v)
		if v &lt; K[0x6ea44c] then return K[0x6ea44c] end
		if v &lt; K[0x6f4164] or v == K[0x6f4164] or v ~= v then return v end
		return K[0x6f4164]
	end
	-- env: {trackLength, lapDistance, lateral, ahead = {car...}, behind = {car...}}, car = {lapDistance,
	-- lateral, vx, vy, vz, wakeStrength (spec+0xd0), wakeLength (spec+0xd4)} in race order
	local function drafting(env)
		local len = f32(env.trackLength)
		local selfDist, selfLat = f32(env.lapDistance), f32(env.lateral)
		local p14 = draftPass(env.ahead or {}, selfDist, selfLat, len, true)
		local p10 = draftPass(env.behind or {}, selfDist, selfLat, len, false)
		local mn = (p14 &lt; p10) and p14 or p10
		local mx = (p14 &lt; p10 or p14 == p10) and p10 or p14
		wf32d(CAR + F_DRAG, clampFactor((1 - (1 - mx) * K[0x6ef640]) * mn))
		wf32d(CAR + F_FRONT, clampFactor(rf32(CAR + F_FRONT)))
		wf32d(CAR + F_REAR, clampFactor(rf32(CAR + F_REAR)))
	end
	V.draftingOriginal = drafting

	-------------------------------------------------------------------------------------------------
	-- per-frame aero update: 005637e0 subset, run by NR2003CupDriver before frameStart
	-------------------------------------------------------------------------------------------------
	-- track-object velocity = render copy (005543f0) of the exported chassis velocity bf6d44/4c/54
	local function frameAero()
		if session == nil then return end
		local dx = fd(rf32(0xbf6d44) - rf32(AIR))
		local dy = rf32(0xbf6d4c) - rf32(AIR + 4)
		local dz = rf32(0xbf6d54) - rf32(AIR + 8)
		w32(CAR + F_DRAG, ONE); w32(CAR + F_FRONT, ONE); w32(CAR + F_REAR, ONE)
		wf32d(CAR + AIRSPEED, sqrt((dz * dz + dy * dy) + dx * dx))
		if draftEnv then drafting(draftEnv) end
	end
	V._aeroFrame = frameAero

	local function applyTrackObject()
		if trackNormal then
			wf32(TOBJ + 0x24, trackNormal[1]); wf32(TOBJ + 0x28, trackNormal[2]); wf32(TOBJ + 0x2c, trackNormal[3])
			w32(CAR + TRACKOBJ, TOBJ)
		else
			w32(CAR + TRACKOBJ, 0)
		end
	end

	-------------------------------------------------------------------------------------------------
	-- API
	-------------------------------------------------------------------------------------------------
	-- session start (005a3c00): weather = {temperatureF, windSpeedMph, windDirection (0..7, 45 deg
	-- steps), conditions (0..3), night, trackNorth (rad), humidity, pressureInHg}; nil = defaults
	-- of the race options (70 F, no wind, conditions 0, daytime) and of the weather constructor.
	function V.startSession(weather)
		session = applyWeather(weather or {})
		session.request = table.clone(weather or {})
		applyTrackObject()
		return session
	end
	-- back to the post-build state (no session start: rho = 0, factors as built)
	function V.endSession()
		session = nil
		w32(AIR, 0); w32(AIR + 4, 0); w32(AIR + 8, 0); w32(AIR + 12, 0)
		for _, o in ipairs({F_DRAG, F_FRONT, F_REAR, AIRSPEED}) do w32(CAR + o, 0) end
		w32(CAR + TRACKOBJ, 0)
	end
	function V.sessionActive() return session ~= nil end
	function V.weather() return session end
	-- drafting environment (005afd80 inputs); nil = no race-order ring (single car: factors 1.0)
	function V.setDraftEnvironment(env)
		if env ~= nil then
			assert(type(env) == "table", "draft environment must be a table")
			local hasCars = (env.ahead and #env.ahead &gt; 0) or (env.behind and #env.behind &gt; 0)
			assert(not hasCars or (tonumber(env.trackLength) or 0) &gt; 0, "draft environment needs trackLength &gt; 0")
		end
		draftEnv = env
	end
	-- vector of the car's track object (+0x24) used by 00561a80 to project the wind; nil = no
	-- track object (car+0x5ae = 0: wind used unprojected, as in the post-build state)
	function V.setTrackNormal(n)
		trackNormal = n and {f32(n[1]), f32(n[2]), f32(n[3])} or nil
		applyTrackObject()
	end
	function V.aeroFactors()
		return rf32(CAR + F_DRAG), rf32(CAR + F_FRONT), rf32(CAR + F_REAR), rf32(CAR + AIRSPEED)
	end

	-- garage aero items read at run time by 00410280 (no build-time conversion uses them):
	--   0x3b grille tape  % 0..100 step 5 -&gt; 00423de0: FILD; FMUL 0.01f; FSTP (CW 0x027f, nearest)
	--   0x3d rear spoiler deg 45..70 step 1 -&gt; 004241d0: FILD (deg - 45); FSTP
	-- (item 0x3b also feeds the engine cooling of 00554520 -&gt; 0051a000: Stage 11, frozen)
	local function desc(d) return ri32(d + 2), ri32(d + 6), ri32(d + 10), ri32(d + 14) end
	function V.setAeroSetup(s)
		s = s or {}
		local lo, hi, step, def = desc(DESC_TAPE)
		local tape = tonumber(s.grilleTape) or def
		tape = math.clamp(floor(tape / step + 0.5) * step, lo, hi)
		wf32(SETUP + 4 * ITEM_TAPE, near32(tape * K[0x6ea4a4]))
		local lo2, hi2, _, def2 = desc(DESC_SPOILER)
		local sp = math.clamp(floor((tonumber(s.spoiler) or def2) + 0.5), lo2, hi2)
		wf32(SETUP + 4 * ITEM_SPOILER, sp - 45)
		return tape, sp
	end
	function V.aeroSetup()
		local t, sp = rf32(SETUP + 4 * ITEM_TAPE), rf32(SETUP + 4 * ITEM_SPOILER)
		return floor(t * 100 + 0.5), sp + 45, t, sp
	end

	-- telemetry: the ORIGINAL 00561b70 evaluated at the current exported state (chassis velocity
	-- relative to the half wind of 00561a80, body rates), with its side effects (call counter
	-- 0074e090, stall state 007636e0/e4) saved and restored. Read-only for the simulation.
	local st = table.create(45, 0)
	local pos, rot = table.create(3, 0), table.create(9, 0)
	function V.aeroState(out)
		out = out or {}
		local exportTarget = r32(0xe847c8) -- 005b2cb0 records its target block here
		V.state(st)
		w32(0xe847c8, exportTarget)
		V.componentPose(0, pos, rot)
		local wx, wy, wz = rf32(AIR), rf32(AIR + 4), rf32(AIR + 8)
		local tobj = r32(CAR + TRACKOBJ)
		if tobj ~= 0 then
			local nx, ny, nz = rf32(tobj + 0x24), rf32(tobj + 0x28), rf32(tobj + 0x2c)
			local dn = wx * nx + wz * nz + wy * ny
			wx, wy, wz = wx - dn * nx, wy - dn * ny, wz - dn * nz
		end
		local rx, ry, rz = st[2] - wx * 0.5, st[4] - wy * 0.5, st[6] - wz * 0.5
		local bx = rot[1] * rx + rot[4] * ry + rot[7] * rz
		local by = rot[2] * rx + rot[5] * ry + rot[8] * rz
		local bz = rot[3] * rx + rot[6] * ry + rot[9] * rz
		for k = 0, 5 do w32(BLOCK + 4 * k, OUT6 + 4 * k) end
		wf32(BLOCK + 24, bx); wf32(BLOCK + 28, by); wf32(BLOCK + 32, bz)
		wf32(BLOCK + 36, st[11]); wf32(BLOCK + 40, st[12]); wf32(BLOCK + 44, st[13])
		local c0, e0, e4 = r32(0x74e090), r32(0x7636e0), r32(0x7636e4)
		callx(0x561b70, BLOCK)
		w32(0x74e090, c0); w32(0x7636e0, e0); w32(0x7636e4, e4)
		local fx, fy, fz = rf32(OUT6), rf32(OUT6 + 4), rf32(OUT6 + 8)
		local mx, my, mz = rf32(OUT6 + 12), rf32(OUT6 + 16), rf32(OUT6 + 20)
		local rho = rf32(AIR + 12)
		local v2 = bx * bx + by * by + bz * bz
		out.density = rho; out.wind = out.wind or {}; out.wind[1], out.wind[2], out.wind[3] = rf32(AIR), rf32(AIR + 4), rf32(AIR + 8)
		out.q = v2 * rho * 0.5; out.airspeedBody = sqrt(v2)
		out.vx, out.vy, out.vz = bx, by, bz
		out.yaw = atan2(by, bx); out.pitch = atan2(-bz, sqrt(bx * bx + by * by)) + rf32(0xc083c4)
		out.fx, out.fy, out.fz, out.mx, out.my, out.mz = fx, fy, fz, mx, my, mz
		out.drag = -fx; out.downforce = -fz; out.side = fy
		-- equivalent axle split of (Fz, My) about the chassis origin, lever arms = LF suspension and
		-- rear axle attachment x offsets of the component records (presentation/telemetry only)
		local xf, xr = rf32(LF_SUSP + 0x44), rf32(ROOT + 9 * 0x505 + 0x44)
		local front = (my - xr * out.downforce) / (xf - xr)
		out.downforceFront, out.downforceRear = front, out.downforce - front
		local zlf, zrf = rf32(r32(LF_SUSP + 0x2d5)), rf32(r32(RF_SUSP + 0x2d5))
		out.rideHeightFront = ((rf32(0xc084c8) - zlf) + (rf32(0xc084cc) - zrf)) * 0.5
		out.groundProximity = math.max(0, 0.1778 - math.max(0, out.rideHeightFront)) -- 006ec748 = 7 in
		local d, f, r, a = V.aeroFactors()
		out.factorDrag, out.factorFront, out.factorRear, out.airspeed = d, f, r, a
		out.stall = rf32(0x7636e4)
		out.session = session ~= nil
		return out
	end

	-- session state survives V.reset() (a reset reloads the car into the same session)
	local baseReset = V.reset
	function V.reset()
		baseReset()
		restoreImageCells()
		if session ~= nil then
			applyWeather(session.request)
			applyTrackObject()
		end
	end
	V._aeroConstants = KBITS
	V._aeroWake = WAKE_BITS
	V._aeroDamageCells = DAMAGE_CELLS

	-- Stage 14 checkpoint: aero
	V._registerCheckpoint("aero", function() return {session=session, draftEnv=draftEnv, trackNormal=trackNormal} end, function(h)
		session, draftEnv, trackNormal = h.session, h.draftEnv, h.trackNormal
	end)
	return V
end
]=]
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_Source5"><Properties><string name="Name">Source5</string><ProtectedString name="Source">return [=[
--!optimize 2
-- Stage 10: garage setup -&gt; runtime parameters for the NR2003 Cup core.
--
--   Garage / user setup        NR2003CupSetup (hand port of the ORIGINAL descriptor table c05150, unit
--   (display units)            converters 00423dc0..004241f0, garage API 005582d0/00558320/00557e40/
--         |                    005581d0/005580f0/005583e0/00558380, .sto validation 00558da0/004247e0)
--         v  raw 184-item setup (IEEE single / int32 bits, exactly the game's c03350/c055c0 layout)
--   Recovered NR2003 setup     NR2003CupBuild (ORIGINAL car-build sequence lifted from the exe:
--   conversion                 00559820 derived items, 00550c40 engine/gears, 00550c60 fuel, 00550bc0
--         |                    tyres, 005b29c0 component tree, 005b2f20 -&gt; 0055e9b0 setup -&gt; runtime
--         v                    cells + callback generation, 0054d610 x4)
--   Runtime physics            NR2003CupCore memory (cells read by the Stage 6/7 translated callbacks and
--   parameters                 lifted natives, Stage 8 driver layer, Stage 9 aero)
--
-- Applying a setup = the original rebuilds the car (garage -&gt; track). Here: the core memory is reset
-- to the current reset image, the ORIGINAL application sequence runs on it, the result becomes the new
-- reset image and the car is reset (V.reset: Stage 8/9 layers included). Nothing is converted by
-- hand-written formulas in this module (ROBLOX ADAPTER: orchestration, reporting only).
--
-- Callback structure (the original regenerates its x87 callbacks at every build, folding value-dependent
-- decisions, see SETUP_MAP.md "estrutura"):
--   "image"   the shipped image = ORIGINAL build of the Cup default garage setup (exact Stage 6-9 state)
--   "natural" the setup's own ORIGINAL emitter outcome equals the default's: same code as the shipped
--             callbacks (NR2003CupJIT*), cells rebuilt for the setup (exact original structure)
--   "generic" otherwise: setup-invariant structure (NR2003CupJITG*, no-fold at setup-dependent sites);
--             differs from the setup's own original code only by float32 rounding at fold sites
-- Pure Luau: no Instances.
return function(V, Setup, Build, genericJIT)
	local M, BASE = V.memory(), V.base
	local PRISTINE = V._pristine()
	local SIZE = V.imageSize
	local ru, rf = buffer.readu32, buffer.readf32
	local function r32(a) return ru(M, a - BASE) end
	local function rf32(a) return rf(M, a - BASE) end
	local ACTIVE = 0xc055c0

	local JIT = V._jitTable()
	local CODE = {natural = table.clone(JIT), generic = V._jitLoad(genericJIT or {})}
	assert(next(CODE.generic), "NR2003CupJITG modules missing")
	local selectedCode = "natural"
	local function selectCode(structure)
		selectedCode = structure == "generic" and "generic" or "natural"
		local src = CODE[structure == "generic" and "generic" or "natural"]
		table.clear(JIT)
		for a, f in pairs(src) do JIT[a] = f end
	end
	-- the shipped reset image is the original build of the Cup default garage setup (00559950)
	local IMAGE_FOOTPRINT = Build.saveFootprint(PRISTINE)
	local IMAGE_STRUCTURE = "natural"
	-- default garage setup before (00559950) and after (c055c0 of the image, items derived by 00559820)
	-- the application; both rebuild to the shipped image (00559820 recomputes the derived items)
	local DEFAULT = Setup.cupGarageDefault()
	local DEFAULT_APPLIED = table.create(184)
	for i = 0, 183 do DEFAULT_APPLIED[i] = ru(PRISTINE, ACTIVE + 4 * i - BASE) end
	local current = Setup.copy(DEFAULT_APPLIED)
	local active = "image"
	local lastReport = {ok = true, structure = "image", violations = 0, imposed = 0}

	V.Setup = Setup
	V.Build = Build
	-- Watkins Glen port: a loaded track changes the reset image (NR2003CupTrack): the shipped-image footprint follows it
	function V._garageRefreshImage()
		IMAGE_FOOTPRINT = Build.saveFootprint(PRISTINE)
		IMAGE_STRUCTURE = active == "generic" and "generic" or "natural"
	end
	function V._garageStructure() return active == "generic" and "generic" or "natural" end
	-- further callback sets (Watkins Glen port: the car placed on the track) and their selection by name
	function V._garageAddCode(name, modules) CODE[name] = V._jitLoad(modules) end
	function V._garageUseCode(name)
		selectedCode = name
		local src = assert(CODE[name], "NR2003 garage: no callback set " .. tostring(name))
		table.clear(JIT)
		for a, f in pairs(src) do JIT[a] = f end
	end

	local function same(a, b)
		for i = 0, 183 do if a[i] ~= b[i] then return false end end
		return true
	end
	local function isDefault(items) return same(items, DEFAULT) or same(items, DEFAULT_APPLIED) end
	-- s: raw setup array [0..183] (NR2003CupSetup representation). Runs the ORIGINAL application; on
	-- success the rebuilt car becomes the reset image and the car is reset. When neither structure can
	-- represent the setup (see SETUP_MAP.md) nothing is committed and the previous setup stays.
	-- opts.structure = "natural" | "generic" forces one structure; opts.rebuild = true rebuilds the
	-- default setup instead of restoring the shipped image.
	function V.applySetup(s, opts)
		opts = opts or {}
		assert(type(s) == "table" and s[0] ~= nil, "NR2003 applySetup: raw setup array [0..183] expected")
		local items = {}
		for i = 0, 183 do
			local u = s[i]
			assert(type(u) == "number" and u &gt;= 0 and u &lt; 4294967296 and u % 1 == 0, "NR2003 applySetup: item " .. i .. " is not a raw u32")
			items[i] = u
		end
		local t0 = os.clock()
		if isDefault(items) and not opts.rebuild and not opts.structure then
			Build.loadFootprint(PRISTINE, IMAGE_FOOTPRINT)
			selectCode(IMAGE_STRUCTURE)
			active = IMAGE_STRUCTURE == "natural" and "image" or "generic"
			lastReport = {ok = true, structure = active, violations = 0, imposed = 0, seconds = os.clock() - t0}
			V.reset()
			if V._bindDriverCells then V._bindDriverCells() end
			for i = 0, 183 do current[i] = r32(ACTIVE + 4 * i) end
			return true, lastReport
		end
		local tries = opts.structure and {opts.structure} or {"natural", "generic"}
		local ok, rep, attempts = false, nil, {}
		for _, structure in ipairs(tries) do
			buffer.copy(M, 0, PRISTINE, 0, SIZE)
			selectCode(structure)
			ok, rep = Build.run(items, structure)
			attempts[#attempts + 1] = rep
			if ok then break end
		end
		rep.attempts = attempts
		rep.seconds = os.clock() - t0
		if ok then
			Build.copyFootprint(PRISTINE, M)
			for i = 0, 183 do current[i] = r32(ACTIVE + 4 * i) end -- incl. items derived by 00559820
			active = rep.structure
		else
			selectCode(active == "generic" and "generic" or "natural")
		end
		lastReport = rep
		V.reset()
		if V._bindDriverCells then V._bindDriverCells() end -- Stage 8 cells of the active structure
		return ok, rep
	end
	function V.setupStructure() return active end
	-- applied setup (raw, as stored by the original in c055c0 after 00559820)
	function V.setup() return Setup.copy(current) end
	function V.setupReport() return lastReport end

	-- concise garage -&gt; runtime inspection (no per-tick output): display values of the adjustable items and
	-- the runtime cells the original build derived from them (current core memory)
	local C4 = {"LF", "RF", "LR", "RR"}
	local function cells4(base, ind)
		local t = table.create(4, 0)
		for w = 0, 3 do
			local a = base + 4 * w
			if ind then a = r32(a) end
			t[w + 1] = rf32(a)
		end
		return t
	end
	function V.setupDump(out)
		out = out or {}
		local s = current
		local items = {}
		for i = 0, 70 do
			local d = Setup.ITEM[i]
			if d.desc and Setup.adjustable(i) then
				items[#items + 1] = {index = i, name = d.name, unit = d.unit, display = Setup.display(s, i), raw = s[i]}
			end
		end
		out.items = items
		local ENGINE = 0xc12030 + 0xc
		local gears = {}
		for k = 0, 7 do gears[k + 1] = rf32(ENGINE + 0x448 + 4 * k) end
		out.runtime = {
			springRate = cells4(0x74e0a0),          -- 0055e9b0: wheel rate N/m (sign -), items 20..23
			bumpStopRate = cells4(0x74e0d0),        -- items 137..140 (derived)
			bumpStopGap = cells4(0x74e0b0),         -- items 149..152 (derived)
			bumpRubber = cells4(0x74e0c0),          -- items 28..31
			shockBump = cells4(0x74e0e0),           -- damper coefficients from items 129..132
			shockRebound = cells4(0x74e0f0),        -- items 133..136
			antiRollRate = {rf32(r32(0x74e788)), rf32(r32(0x74e78c))}, -- items 99/100 (variable cells)
			brakeTorque = cells4(0xc0850c, true),   -- item 40 x car max torque (variable cells, Stage 8)
			toeHalf = cells4(0xc086b0),             -- items 41/42 (x0.5)
			springPerch = cells4(0xc083b0),         -- items 145..148
			trackBar = {rf32(0xc085ac), rf32(r32(0xc085b0))}, -- items 45/46
			aeroRefHeight = {rf32(0xc084c8), rf32(0xc084cc)}, -- items 173/174 (Stage 9 aero)
			aeroPitchOffset = rf32(0xc083c4),       -- item 177
			casterTrail = {rf32(0xc082d4), rf32(0xc082d8)}, -- items 67/68
			gearCount = buffer.readi32(M, ENGINE + 0x444 - BASE),
			gearRatio = gears,                      -- items 102..109 via 0051a730
			finalDrive = rf32(ENGINE + 0x468),      -- item 110
			tyrePressure = {rf32(0xbf3a20), rf32(0xbf3a20 + 0xa39), rf32(0xbf3a20 + 2 * 0xa39), rf32(0xbf3a20 + 3 * 0xa39)},
		}
		out.corners = C4
		out.report = lastReport
		return out
	end

	-- Stage 14 checkpoint: garage
	V._registerCheckpoint("garage", function() return {active=active, current=current, selected=selectedCode} end, function(h)
		active, current = h.active, h.current
		V._garageUseCode(h.selected)
		if V._bindDriverCells then V._bindDriverCells() end
	end)
	return V
end
]=]
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_Source6"><Properties><string name="Name">Source6</string><ProtectedString name="Source">return [=[
--!optimize 2
-- GENERATED by recovery/stage11/gen_stage11.py from recovery/stage11/frame_host.luau; do not edit.
-- Stage 11: the ORIGINAL per-frame runtime systems of the NR2003 Cup car (fuel, mass, tyre thermal / pressure /
-- wear / failure, brake temperature, engine thermal / damage / failure, random failures, collision damage), run
-- by code lifted from NR2003.exe (NR2003CupFrameCode*) on the core memory, in the order of the simulation task:
--
--   task loop 005f78f0       ++getBGCount (0x7559bc) before the frame                       V._frameStart11
--   0055bfd0 -&gt; 005637e0     aero factors / airspeed / drafting (Stage 9, NR2003CupAero)      V._aeroFrame
--   005b2190                 00551e80 frame start, 8 x 288 Hz ticks (Stages 6-8)               NR2003CupDriver
--             -&gt; 00554520    FRAME END (whole ORIGINAL function, lifted):                     V._frameEnd
--                  00551ce0 attitude filter, [005547a0 world/replay record: host], bf3a00 = airspeed,
--                  radiator air factor (1 - grille tape, damage) -&gt; 0051a830, 0051aac0 engine (ignition and
--                  misfire, fuel burn, water / oil temperature and level, wear and failure), 0051c3d0 random
--                  component failures, 005605c0 fuel mass -&gt; fuel component record, 00551990 car snapshot +
--                  per tyre 0054d610 (thermal zones, hot pressure, wear 0054e9f0, brake temperature 0054f260)
--   0055bfd0 -&gt; 00549c40     collision damage of the records of this frame (lifted)
--
-- Host boundary (ADAPTER, documented in STAGE11_RECOVERY.md, identical in the Unicorn reference harness
-- recovery/stage11/orig_stage11.py): 005547a0 / 00592dc0 / 00557650 / 005d08d0 return immediately (track and
-- replay recorders, multiplayer damage sync, collision sound, force feedback: Stage 13 evaluates the FFB block in
-- NR2003CupFFB and delivers 005d08d0 to the host device layer); 005f58d0 (track point) copies the
-- point and clears the track-query fields (no track loaded); the car world record (car+0x5ae) is posed from the
-- exported state like 005543f0 does (position, 005f5a60 rotation, 005f5ac0 velocities) before the frame end.
-- Pure Luau: no Instances.
local CODE_PARTS, DATA_PARTS = 4, 1
local band = bit32.band
local ru, wu, rf, wf = buffer.readu32, buffer.writeu32, buffer.readf32, buffer.writef32

local B64 = {}
do
	local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	for i = 1, 64 do B64[string.byte(chars, i)] = i - 1 end
end
local function b64into(dst, off, s)
	local o = off
	for i = 1, #s, 4 do
		local a, b, c, d = string.byte(s, i, i + 3)
		local x = B64[a] * 262144 + B64[b] * 4096 + (c ~= 61 and B64[c] or 0) * 64 + (d ~= 61 and B64[d] or 0)
		buffer.writeu8(dst, o, bit32.rshift(x, 16)); o += 1
		if c ~= 61 then buffer.writeu8(dst, o, band(bit32.rshift(x, 8), 0xff)); o += 1 end
		if d ~= 61 then buffer.writeu8(dst, o, band(x, 0xff)); o += 1 end
	end
	return o - off
end

local CAR = 0xc12030
local ENGINE = CAR + 0xc
local DAMAGE = CAR + 0x1493          -- car vtable slots 1/2 (00592db0): damage object
local TIRE0, TIRE_STRIDE = 0xbf3a20, 0xa39
local BGCOUNT = 0x7559bc             -- getBGCount (005f7cb0)
-- getIntCount (005f7cd0): timer-interrupt counter, a host clock. ADAPTER (same convention as the Stage 8 harness,
-- orig_brake.INTCOUNT): +1 per frame at the frame start. Read by the lifted 00567660 (tyre / continuous contact
-- records 0054a8d0: table row copy + getIntCount stamp at car+0x1323); the Stage 8 speed cache (00554f50) is
-- recomputed in Luau and preserves its cache stamp
local INTCOUNT = 0x7559c4
local RNG = 0xf6eae4                 -- rndInt (005f5670) state of stream 0 (+4: stream 1)
local SETTINGS = 0xc0692a            -- race settings (0055a680)
local FRAME_STACK = 0xf7e000
local HOST = 0xf7f100
local TOBJ = HOST + 0x680            -- Stage 9 car world record block (0x32c bytes)
local S11 = 0xf7a000                 -- Stage 11 host blocks (unreferenced BSS): contact objects, body proxies, vectors
local KEYS, BODY, OTHER, VEC = S11, S11 + 0x80, S11 + 0x280, S11 + 0x480
-- ADAPTER host geometry: the car's collision object of the track system (c7e75c; built by the unrecovered track
-- collision code when the car is placed in the world, null in the bench): container + 9 parts (+0x18..+0x24 wheel
-- parts, +0x28..+0x38 deformable body parts), read by the original damage code 0054b0d0 / 00549860 / 0054a8d0 /
-- 00577cb0. No collision-mesh deformation is simulated by the host: zeroed parts (PROVISIONAL; Unicorn reference identical)
local COLL, COLL_PARTS, COLL_OBJ, HOST_SIZE = S11 + 0x500, S11 + 0x540, 0xc7e75c, 0x7c8

-- V: core with driver (NR2003CupDriver), aero (NR2003CupAero) and garage (NR2003CupGarage) installed
return function(V, codeParts, dataParts)
	assert(#codeParts == CODE_PARTS, "NR2003CupFrameCode: expected " .. CODE_PARTS .. " parts, found " .. #codeParts)
	assert(#dataParts == DATA_PARTS, "NR2003CupFrameData: expected " .. DATA_PARTS .. " parts, found " .. #dataParts)
	local M, BASE = V.memory(), V.base
	local PRISTINE = V._pristine()

	-- image supplement: cells of the original post-build memory that only the Stage 11 code touches
	local zbuf = buffer.create(4096)
	local SUPPLEMENT = 0
	for _, d in ipairs(dataParts) do
		for _, z in ipairs(d.zero) do
			local off, len = z[1], z[2]
			while len &gt; 0 do
				local n = math.min(len, 4096)
				buffer.copy(PRISTINE, off, zbuf, 0, n); off += n; len -= n
			end
			SUPPLEMENT += z[2]
		end
		for _, x in ipairs(d.data) do SUPPLEMENT += b64into(PRISTINE, x[1], x[2]) end
	end

	local ctx = {M = M, base = BASE, F = {}, R = table.create(10, 0), XF = {}}
	for _, p in ipairs(codeParts) do p(ctx) end
	local XF, R = ctx.XF, ctx.R
	V._frameCtx = ctx   -- Watkins Glen port: ctx.trackPoint (B_trackPoint -&gt; 005f58d0 on a loaded track)

	local function r32(a) return ru(M, a - BASE) end
	local function w32(a, v) wu(M, a - BASE, band(v)) end
	local function rf32(a) return rf(M, a - BASE) end
	local function wf32(a, v) wf(M, a - BASE, v) end
	local S = buffer.create(8)
	local function f2u(x) buffer.writef32(S, 0, x); return buffer.readu32(S, 0) end
	local function u2f(u) buffer.writeu32(S, 0, u); return buffer.readf32(S, 0) end

	-- call an ORIGINAL lifted function (cdecl args, optional ECX for thiscall) on the Stage 11 register file
	local function callx(addr, ecx, ...)
		local args = { ... }
		local n = #args
		local esp = FRAME_STACK - 4 * (n + 1)
		for k = 1, n do w32(esp + 4 * k, args[k]) end
		w32(esp, 0)
		for k = 1, 7 do R[k] = 0 end
		R[8] = esp; R[9] = 0; R[10] = 0
		if ecx then R[3] = ecx end
		table.clear(ctx.F)
		local f = XF[addr]
		if not f then error(string.format("NR2003 Stage 11: %08x not lifted", addr)) end
		f()
		assert(R[8] == esp + 4 * (n + 1) - 4 * n or R[8] == esp + 4, "NR2003 Stage 11: unbalanced stack")
		return R[1]
	end
	V._callx11 = callx

	-------------------------------------------------------------------------------------------------------------
	-- mode: "original" = the ORIGINAL frame end and collision frame (production); "frozen" = the Stage 6-10 frame
	-- end (0051aac0 cut-timer subset only: every Stage 11 state held at its post-build value), kept ONLY to
	-- compare against the Stage 6-10 golden data, which were produced by the original code with that frame end.
	-------------------------------------------------------------------------------------------------------------
	local mode = "original"
	local frozenFrameEnd = V._frameEnd
	local session11 = nil      -- Stage 11 session options applied at startSession (survive reset)

	local function ensureWorldRecord()
		if r32(CAR + 0x5ae) == 0 then
			wf32(TOBJ + 0x24, 0); wf32(TOBJ + 0x28, 0); wf32(TOBJ + 0x2c, 1)
			w32(CAR + 0x5ae, TOBJ)
		end
	end
	-- 005543f0 without the track query: world record &lt;- exported state (position, rotation, velocities)
	local function syncWorldRecord()
		ensureWorldRecord()
		local rec = r32(CAR + 0x5ae)
		w32(rec, r32(0xbf6d40)); w32(rec + 4, r32(0xbf6d48)); w32(rec + 8, r32(0xbf6d50))
		callx(0x5f5a60, nil, rec, 0xbf6d58)
		local v = VEC + 0x60
		w32(v, r32(0xbf6d44)); w32(v + 4, r32(0xbf6d4c)); w32(v + 8, r32(0xbf6d54))
		callx(0x5f5ac0, nil, rec, v, 0xbf6d68)
	end
	local function hostBlocks()
		for a = S11, S11 + HOST_SIZE - 4, 4 do w32(a, 0) end
		for k = 0, 7 do w32(KEYS + 16 * k + 4, BODY) end
		w32(BODY + 0x1a4, 0); w32(OTHER + 0x1a4, 1)
		for k = 0, 8 do w32(COLL + 0x18 + 4 * k, COLL_PARTS + 0x48 * k) end
		w32(COLL_OBJ, COLL)
	end

	local function frameStart11()
		if mode ~= "original" then return end
		w32(BGCOUNT, r32(BGCOUNT) + 1)
		w32(INTCOUNT, r32(INTCOUNT) + 1)
	end
	local function frameEnd11()
		if mode ~= "original" then frozenFrameEnd(); return end
		syncWorldRecord()
		-- Stage 13: the force-feedback block of 00554520 (0055464c..0055479d) is evaluated by NR2003CupFFB in exact x87
		-- arithmetic right after the lifted function (V._ffbFrameEnd: where the block ends the function); the lifted copy
		-- (IEEE double intermediates) is skipped by presenting bf6ebb = 0, its only reader in 00554520 / 00549c40
		local ffb = V._ffbFrameEnd
		if ffb then
			local acquired = buffer.readu8(M, 0xbf6ebb - BASE)
			buffer.writeu8(M, 0xbf6ebb - BASE, 0)
			callx(0x554520, nil)
			buffer.writeu8(M, 0xbf6ebb - BASE, acquired)
			ffb()
		else
			callx(0x554520, nil)
		end
		-- ADAPTER: the car is in the race order of the session (race-order ring car+4 / car+8, recovered in Stage 9;
		-- the Stage 6/7 build leaves it 0). car+4 != 0 gates the collision damage of 00549c40 (00549290 body damage,
		-- 0054a330 wheel / tyre impact states). One-car ring (links -&gt; car+4) around 00549c40 only, as in the Unicorn
		-- reference (orig_stage11.race_order): car+4 != 0 would also enable the per-tick render copy 005543f0.
		-- Watkins Glen port: on a loaded track the car is in the race order of the session (00563620): no adapter ring
		local l4, l8 = r32(CAR + 4), r32(CAR + 8)
		if l4 ~= 0 then
			callx(0x549c40, nil)
		else
			w32(CAR + 4, CAR + 4); w32(CAR + 8, CAR + 4)
			callx(0x549c40, nil)
			w32(CAR + 4, l4); w32(CAR + 8, l8)
		end
	end
	V._frameStart11 = frameStart11
	V._frameEnd = frameEnd11

	function V.setRuntimeMode(m)
		assert(m == "original" or m == "frozen", "runtime mode must be 'original' or 'frozen'")
		mode = m
	end
	function V.runtimeMode() return mode end

	-------------------------------------------------------------------------------------------------------------
	-- race options and session (simulation task paths)
	-------------------------------------------------------------------------------------------------------------
	-- race option 'damage' (settings +0x4c bits 22..23): ORIGINAL 00547e90 -&gt; damage scale bef700 = {0, .15, .6, 1}
	function V.setDamageLevel(level)
		level = math.clamp(math.floor(tonumber(level) or 3), 0, 3)
		w32(SETTINGS + 0x4c, bit32.bor(band(r32(SETTINGS + 0x4c), bit32.bnot(bit32.lshift(3, 22))), bit32.lshift(level, 22)))
		callx(0x547e90, nil, level)
		return level, rf32(0xbef700)
	end
	-- race option fuel / tyre consumption rate (settings +0x50 bits 0..1 -&gt; x1..x4, read by 0051aac0 / 0054e9f0)
	function V.setConsumptionRate(rate)
		rate = math.clamp(math.floor(tonumber(rate) or 0), 0, 3)
		w32(SETTINGS + 0x50, bit32.bor(band(r32(SETTINGS + 0x50), bit32.bnot(3)), rate))
		return rate + 1
	end
	-- roster series field of the player car (car+0x596): collision damage needs it nonzero (PROVISIONAL host input)
	function V.setSeriesField(v) w32(CAR + 0x596, math.floor(tonumber(v) or 1)) end
	-- rndSeed (005f5650) of stream 0, the stream used by every physics random draw (misfire, failures, damage)
	function V.setRandomSeed(seed) w32(RNG, band(math.floor(tonumber(seed) or 0))) end
	function V.randomState() return r32(RNG), r32(RNG + 4) end

	-- ORIGINAL 00550a50 subset (car placed on the track by the simulation task): 00563080(car, 1) damage repair,
	-- 00550c40 engine init, 00550c60 fuel load, 005512d0 four new tyres (00550f10), car+0x1518 = 0, 00550070(0)
	-- (Stage 13, NR2003CupFFB), bf6eb9 = 0
	function V.enterTrack()
		ensureWorldRecord()
		callx(0x563080, nil, CAR, 1)
		callx(0x550c40, nil)
		callx(0x550c60, nil)
		callx(0x5512d0, nil)
		-- Watkins Glen port (@00550aeb): ORIGINAL 005512f0 placement on the loaded track (NR2003CupTrack)
		if V._place then V._place() end
		w32(CAR + 0x1518, 0)
		-- Stage 13 (@00550b07): ORIGINAL 00550070(0), player controls active + FF axis setup (NR2003CupFFB)
		if V._ffbEnterTrack then V._ffbEnterTrack() end
		buffer.writeu8(M, 0xbf6eb9 - BASE, 0)
	end
	-- ORIGINAL 00433610(chassis type car+0x58e): the collision-damage zone tree (00433660, nodes from the static pool
	-- *bf39d4 via 00547e60), built in the game by the car-model load 00432d90; without it every zone lookup (0054a710)
	-- returns -1 and no collision damage exists. Built once per car load (table 00890490 is checked first).
	function V.buildDamageZones()
		callx(0x433610, nil, r32(CAR + 0x58e))
		return r32(0x890490) ~= 0
	end
	local function applySession11()
		hostBlocks()
		V.buildDamageZones()
		V.setSeriesField(session11.series)
		if session11.damageLevel ~= nil then V.setDamageLevel(session11.damageLevel) end
		if session11.consumptionRate ~= nil then V.setConsumptionRate(session11.consumptionRate) end
		if session11.seed ~= nil then V.setRandomSeed(session11.seed) end
		V.enterTrack()
	end
	-- startSession(weather, opts): Stage 9 weather (005a3c00) then, in "original" mode, the Stage 11 session: race
	-- options (opts.damageLevel 0..3, opts.consumptionRate 0..3, nil = post-build values), opts.series (car+0x596,
	-- default 1), opts.seed (stream 0 state, nil = post-build), then the car is placed on the track (enterTrack)
	local baseStart, baseEnd, baseReset = V.startSession, V.endSession, V.reset
	function V.startSession(weather, opts)
		local r = baseStart(weather)
		if mode == "original" then
			opts = opts or {}
			session11 = {series = opts.series or 1, damageLevel = opts.damageLevel, consumptionRate = opts.consumptionRate, seed = opts.seed}
			applySession11()
		end
		return r
	end
	function V.endSession()
		session11 = nil
		baseEnd()
	end
	-- reset = the car reloaded from the reset image (post-build); in an active Stage 11 session it is placed on
	-- the track again (00550a50: repaired, engine and fuel re-initialised, new tyres), like a restart
	function V.reset()
		baseReset()
		if session11 ~= nil and mode == "original" then applySession11() end
	end

	-------------------------------------------------------------------------------------------------------------
	-- events
	-------------------------------------------------------------------------------------------------------------
	-- ORIGINAL 0054a760 collision record entry (called by the track contact code 00576e00 / 0057xxxx). The host
	-- (Roblox geometry query) supplies the contact; NR2003 evaluates the damage (0054a8d0 -&gt; 0054aa20 immediately
	-- for tyre / flagged contacts, 00549c40 -&gt; 00549290 at the end of the frame). rec = {magnitude (impact
	-- magnitude in the units of the contact code), material (self, 0x13 = tyre), flags (0x2000000), surface (other
	-- material id), point (world), localPoint (car frame, zone lookup), otherLocal, velocity, normal, p9, speed,
	-- key 0..7 (contact object), other = true (contact with another car: body proxy index 1)}
	local function vec(a, v)
		v = v or {0, 0, 0}
		wf32(a, v[1] or 0); wf32(a + 4, v[2] or 0); wf32(a + 8, v[3] or 0)
	end
	function V.collision(rec)
		assert(type(rec) == "table" and rec.magnitude, "collision record needs a magnitude")
		vec(VEC, rec.point); vec(VEC + 12, rec.localPoint); vec(VEC + 24, rec.otherLocal)
		vec(VEC + 36, rec.velocity); vec(VEC + 48, rec.normal or {0, 0, 1})
		local key = math.clamp(math.floor(rec.key or 0), 0, 7)
		callx(0x54a760, nil, KEYS + 16 * key, f2u(rec.magnitude), band((rec.flags or 0) + (rec.material or 0x13)),
			rec.surface or 1, VEC, VEC + 12, VEC + 24, VEC + 36, rec.p9 or 0, f2u(rec.speed or 0),
			rec.other and OTHER or 0, VEC + 48)
	end
	-- ORIGINAL 00550f10 pit tyre change for wheels (0 LF, 1 RF, 2 LR, 3 RR): cold pressure from the setup, wear 0,
	-- temperatures = session air temperature e0b834 (sun-heated) + 11 C, tyre state reset, 0054d610 run once
	function V.pitTyres(wheels)
		for _, w in ipairs(wheels or {0, 1, 2, 3}) do callx(0x550f10, nil, w) end
	end

	-------------------------------------------------------------------------------------------------------------
	-- telemetry (reads the ORIGINAL cells; no duplicate state)
	-------------------------------------------------------------------------------------------------------------
	local function pf32(a) return u2f(bit32.bxor(r32(r32(a)), r32(r32(a + 8)))) end
	local function pf64(a)
		local p0, p2 = r32(a), r32(a + 8)
		buffer.writeu32(S, 0, bit32.bxor(r32(p0), r32(p2))); buffer.writeu32(S, 4, bit32.bxor(r32(p0 + 4), r32(p2 + 4)))
		return buffer.readf64(S, 0)
	end
	local function damageComponent(n)
		-- 005486a0: packed component n of the damage word +8 (table 006f56b8, stride 21 bytes)
		local e = 0x6f56b8 + n * 0x15
		local shift, mask, flag = band(r32(e), 31), r32(e + 4), buffer.readu8(M, e + 8 - BASE)
		local v = band(bit32.rshift(r32(DAMAGE + 8), shift), mask)
		if flag == 0 then return v / mask end
		if v == mask then return rf32(0x6ea4a0) end
		return v / (mask - 1)
	end
	V.damageComponentOriginal = damageComponent
	function V.stage11State(out)
		out = out or {}
		local fuel = pf64(ENGINE + 0x50c)
		local spec = r32(CAR + 0x58a)
		local fuelRec = r32(0xc08234)
		out.mode = mode
		out.fuel = {kg = fuel, massRecord = rf32(r32(fuelRec + 0x125)), inertiaRecord = rf32(r32(fuelRec + 0x179)),
			specInertiaPerKg = rf32(spec + 0x28)}
		out.engine = {water = pf32(ENGINE + 0x4a4), oil = pf32(ENGINE + 0x4d4), coolantLevel = rf32(ENGINE + 0x4a0),
			oilLevel = rf32(ENGINE + 0x49c), power = rf32(ENGINE + 0x554), cutTimer = rf32(ENGINE + 0x550),
			radiator = {rf32(ENGINE + 0x470), rf32(ENGINE + 0x474), rf32(ENGINE + 0x478), rf32(ENGINE + 0x47c), rf32(ENGINE + 0x480)},
			heat = {rf32(ENGINE + 0x494), rf32(ENGINE + 0x498)}, overRev = rf32(ENGINE + 0x508), wear = rf32(ENGINE + 0x558),
			life = rf32(ENGINE + 0x55c), blown = rf32(ENGINE + 0x560), flags = r32(ENGINE + 0x548), x4d0 = rf32(ENGINE + 0x4d0)}
		out.tyres = out.tyres or {}
		for w = 0, 3 do
			local t = TIRE0 + w * TIRE_STRIDE
			local o = out.tyres[w + 1] or {}
			o.coldPressure = rf32(t); o.pressure = rf32(t + 0x2a0)
			o.surface = {pf32(t + 0x160), pf32(t + 0x18c), pf32(t + 0x1b8)}
			o.carcass = {pf32(t + 0x1e4), pf32(t + 0x210), pf32(t + 0x23c)}
			o.wear = pf32(t + 0x74); o.gripWear = rf32(t + 0xcc); o.brake = pf32(t + 0x26c)
			o.state = band(bit32.rshift(buffer.readu16(M, DAMAGE + 2 - BASE), 2 * w), 3)
			o.wheel = band(bit32.rshift(buffer.readu16(M, DAMAGE - BASE), 6 + 2 * w), 3)
			out.tyres[w + 1] = o
		end
		local zones = {}
		for k = 0, 10 do zones[k + 1] = rf32(DAMAGE + 0x10 + 4 * k) end
		local broken = {}
		for k = 0, 8 do broken[k + 1] = buffer.readu8(M, 0xc086e0 + k - BASE) end
		out.damage = {words = {r32(DAMAGE), r32(DAMAGE + 4), r32(DAMAGE + 8), r32(DAMAGE + 0xc)}, zones = zones,
			tyre = {rf32(DAMAGE + 0x3c), rf32(DAMAGE + 0x40), rf32(DAMAGE + 0x44), rf32(DAMAGE + 0x48)},
			radiator = rf32(DAMAGE + 0x4c), oil = rf32(DAMAGE + 0x50), fuel = rf32(DAMAGE + 0x54), engine = rf32(DAMAGE + 0x58),
			x5c = rf32(DAMAGE + 0x5c), x60 = rf32(DAMAGE + 0x60), failures = buffer.readu8(M, DAMAGE + 0xe - BASE),
			brokenFlags = broken, scale = rf32(0xbef700), series = r32(CAR + 0x596)}
		out.airspeed = rf32(0xbf3a00); out.ambient = rf32(0x74c954); out.bgCount = r32(BGCOUNT); out.intCount = r32(INTCOUNT)
		out.random = r32(RNG)
		return out
	end
	V._stage11Supplement = SUPPLEMENT
	buffer.copy(M, 0, PRISTINE, 0, V.imageSize)   -- the supplement is part of the reset image
	V.reset()

	-- Stage 14 checkpoint: runtime
	V._registerCheckpoint("runtime", function() return {mode=mode, session=session11, R=ctx.R, F=ctx.F} end, function(h)
		mode, session11 = h.mode, h.session
		for k,v in pairs(h.R) do ctx.R[k]=v end
		table.clear(ctx.F);for k,v in pairs(h.F) do ctx.F[k]=v end
	end)
	return V
end
]=]
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_Source7"><Properties><string name="Name">Source7</string><ProtectedString name="Source">return [=[
--!native
--!optimize 2
-- Stage 12: the ORIGINAL NR2003 steering chain of the player car (hand port of the x86, float32 stores round
-- toward -inf like every store of the simulation task, CW 0x077f; x87 intermediates in IEEE double, the Stage 6/7
-- convention; exact-zero sums signed as under RC-down). Installed on a runtime created by NR2003CupCore +
-- NR2003CupDriver; NR2003CupDriver.frameStart calls V._steerDevices (inside 005524f0) and V._steerTail (00551e80).
--
-- Per 36 Hz task frame (005b2190 -&gt; 00551e80, player car), recovered in recovery/stage12 (STAGE12_RECOVERY.md):
--   device layer 0057abc0 (HOST): control 7 = steer left, control 8 = steer right, raw 0..1 in the control table
--     d35b18 + 10n (f32), binding d37cc8 + 29n (1 = analog axis, otherwise key/button: 0057af60 'digital')
--   005524f0 -&gt; bf63c8 = 00552720():
--     00552d00(8) / 00552d00(7): per-control slew limit 74c990 (steering 'momentum') and sin(x * pi/2) shaping
--       (only while the rate is &lt; 1; Stage 8 hand port V.axisOriginal)
--     speed sensitivity  k = L * 0.15 * exp(-0.000493827 * v^2) + (1 - L * 0.15),  L = 00552410()
--     yaw-rate limiter (race settings +0x4c bit 25 = driving mode ARCADE, player.ini DrivingMode, 0055a770):
--       (min(12.25 / v, |r|) / max(|r|, 0.01)) * 0.9 + 0.1 ; arcade also remaps L (00552410) and selects car chassis
--       spec 0 at build time (004233a0) -&gt; NOT PORTED as a production option (validation only, see setSteeringOptions)
--     steering assistance (bf6f08 &gt; 0, 00550230): needs the track racing line -&gt; NOT PORTED (refused)
--   00551e80 tail: bf63c0 = -bf63c8 ; 005524b0 ; linearity  x = sign * |x|^(L + 1)  (00552410() != 0 and both
--     steering controls analog) ; road-wheel target = f32(x * pi) / 00554fb0() ; bf63b8 / bf6e80 / ramp bf6e88
--   00554fb0: setup item 0x30 ratio (c055c0 + 0xc0) with the low-speed override (74c9a0, ini 'steer_ratio'):
--     ratio &gt;= 7 and v &lt;= 17.88 m/s: v &lt;= 8.94 -&gt; 7, else r - (17.88 - v) * (r - 7) * 0.111856826
-- Per 288 Hz tick (unchanged, NR2003CupDriver.tickInputs = 005539c0): bf63c0 += bf6e88, lf = bf63c0 - toe c086b0,
--   rf = c086b4 + bf63c0 -&gt; core input cells -&gt; prescribed lfhub / rfhub steer coordinates (states 15 / 21).
-- Presentation (005662d0, car model draw): steering-wheel angle = clamp(-(00554fb0() * car[0x1554]), +-2.79 rad),
--   car[0x1554] = (state15 + state21) * 0.5 written by the car snapshot 00551990 (Stage 11 frame end).
return function(V)
	local rf32, r32, ri32, w32, r8, w8 = V.rf32, V.r32, V.ri32, V.w32, V.r8, V.w8
	local wf32d, fd, rf64, wf32 = V.wf32d, V.fd, V.rf64, V.wf32
	local band, rshift = bit32.band, bit32.rshift
	local floor, abs = math.floor, math.abs

	local CAR = 0xc12030                       -- player car slot (00562f70(0))
	local SETTINGS = 0xc0692a                  -- 0055a680(): race settings record of the session
	local SETUP_RATIO = 0xc055c0 + 4 * 0x30    -- active setup item 0x30 (00557d60(0x30)), steering ratio (float)
	local CTRL_RAW, CTRL_TYPE = 0xd35b18, 0xd37cc8 -- 0057af30: f32 [d35b18 + 10n]; 0057af60: i32 [d37cc8 + 29n]
	local STEER_LEFT, STEER_RIGHT = 7, 8
	local DRAW_STEER = CAR + 0x1554            -- car snapshot (00551990): mean prescribed front steer angle
	-- .rdata constants read from the image (the cells the original reads)
	local K_ONE, K_ZERO, K_MONE = rf32(0x6e97d8), rf32(0x6ea454), rf32(0x6ea4a8) -- 1, 0, -1
	local K_CENTI = rf32(0x6ea4a4)             -- 0.01
	local K_SENS_EXP = rf32(0x6f59fc)          -- -0.000493827 (speed sensitivity exponent / v^2)
	local K_YAW_LAT = rf32(0x6f59f8)           -- 12.25 (lateral acceleration of the yaw limiter)
	local K_09, K_01 = rf32(0x6ed020), rf32(0x6ea4cc) -- 0.9, 0.1
	local K_SENS = rf32(0x6ee4c4)              -- 0.15
	local K_LIN_A, K_LIN_B = rf32(0x6ef740), rf32(0x6f59e4) -- 0.66, 0.34 (00552410 with aids)
	local K_PI = rf32(0x6f4a4c)                -- 3.14159274 (steering-wheel lock +-pi per unit input)
	local K_LOW_RATIO, K_V_HIGH, K_V_LOW, K_RAMP = rf32(0x6f5a64), rf32(0x6f5a60), rf32(0x6f5a5c), rf32(0x6f5a58)
	local K_DRAW_LOCK = rf32(0x6f5e6c)         -- 2.79 rad (005662d0 steering-wheel draw limit)
	local K_RATE = rf64(0x6f59c0)              -- 0.016663333999866692 (005500c0: rate = K / (momentum * 0.01))
	local LOG2E = 1.4426950408889634           -- FLDL2E (lifter convention)
	local scratch = buffer.create(4)
	-- Stage 12.1 host options (NOT part of the original; nil / 360 = the original behaviour, see setSteeringOptions)
	local lockK = K_PI          -- steering-wheel half lock per unit input (rad): the original x pi = 360 deg lock to lock
	local drawLimit = K_DRAW_LOCK -- cockpit wheel draw limit (rad): the original 2.79

	-- exact-zero sums signed as under round-toward-negative (IEEE 754: x + (-x) = -0 when RC = down)
	local function zadd(x, y)
		local r = x + y
		if r == 0 and not (x == 0 and y == 0 and 1 / x &gt; 0 and 1 / y &gt; 0) then return -0.0 end
		return r
	end
	local function zsub(x, y) return zadd(x, -y) end
	-- x87 F2XM1 / FLD1 / FADDP / FSCALE after FRNDINT (RC = down -&gt; floor), lifter convention (double)
	local function exp2(t)
		local n = t ~= t and t or floor(t)
		local f = 2 ^ (t - n) - 1
		f = f + 1
		if n &gt;= 0 then n = floor(n) else n = -floor(-n) end
		return f * 2 ^ n
	end
	-- f32 store rounded to nearest (UI thread, CW 0x027f): message payloads built by the front end
	local function f32near(x) buffer.writef32(scratch, 0, x); return buffer.readf32(scratch, 0) end

	-- 00554f50: vehicle speed from the exported state block (cached in bf6f44 as float32). observe = true: the
	-- same value without touching the cache (presentation / telemetry reads between frames)
	local function speed(observe)
		local vz, vy, vx = rf32(0xbf6d54), rf32(0xbf6d4c), rf32(0xbf6d44)
		local v = math.sqrt((vz * vz + vy * vy) + vx * vx)
		if observe then return fd(v) end
		wf32d(0xbf6f44, v)
		return rf32(0xbf6f44)
	end
	-- 0055a770: race settings +0x4c bit 25 (yaw-rate limiter + linearity remap)
	local function settingsBit25() return band(rshift(r32(SETTINGS + 0x4c), 25), 1) ~= 0 end
	-- 00550230: steering assistance; inServer() = false, inBackground() = true on the simulation task -&gt;
	-- 0055a680() = race settings; +0x4c bit 29 disables the driver aids
	local function assist()
		if band(r32(SETTINGS + 0x4c), 0x20000000) ~= 0 then return K_ZERO end
		return rf32(0xbf6f08)
	end
	-- 00552410: linearity value L (bf6f00, 0..1), remapped 0.66 L + 0.34 with the aids
	local function linearity()
		if not settingsBit25() then
			local a = assist()
			if a &lt;= K_ZERO or a ~= a then return rf32(0xbf6f00) end -- FCOMP 0; AND 0x4100; JZ remap
		end
		return rf32(0xbf6f00) * K_LIN_A + K_LIN_B
	end
	-- 0057af60: control n is not an analog-axis binding
	local function digital(n) return ri32(CTRL_TYPE + 29 * n) ~= 1 end

	local axis = V.axisOriginal -- 00552d00 (Stage 8 hand port; steering controls 7/8 with sin shaping)

	-- 00552720: processed steering input (returned float32 value, stored to bf63c8 by 005524f0)
	local yawLimiterFactor, sensitivity = 1, 1 -- last values (telemetry only)
	local function steerInput()
		local v = speed()
		local s = v
		if not (K_CENTI &lt;= v or v ~= v) then s = K_CENTI end -- FLD 0.01; FCOMP v; AND 0x4100; JNZ keep v
		local yaw = abs(rf32(0xbf6d70))                      -- |state[12]| chassis yaw rate (AND 0x7fffffff)
		local f = yaw
		if not (K_CENTI &lt;= yaw or yaw ~= yaw) then f = K_CENTI end
		local p = s * s                                      -- FLD s; FMUL s (exact in double)
		local e = fd(exp2(p * K_SENS_EXP * LOG2E))           -- exp(-0.000493827 v^2) -&gt; float32
		local q = K_YAW_LAT / s                              -- 12.25 / v
		local m = q
		if not (q &lt;= f or q ~= q or f ~= f) then m = f end   -- FCOM; AND 0x4100; JNZ keep q
		local limiter = fd(m / f * K_09 + K_01)
		local a = linearity() * K_SENS                       -- L * 0.15
		local sens = fd((K_ONE - a) + a * e)
		local a8 = fd(axis(STEER_RIGHT))                     -- FSTP dword
		local a7 = axis(STEER_LEFT)                          -- x87 value
		local x = fd(zsub(a8, a7) * sens)                    -- FSUBR; FMUL; FSTP
		if settingsBit25() then x = fd(x * limiter) end
		local aid = assist()
		if not (aid &lt;= K_ZERO or aid ~= aid) then
			-- the assistance branch blends the racing-line steering of the track system (car+0x5ae world record,
			-- racing line bd7960, 00527580 / 00536180 / 00536260 / 00535530): not available without a track
			error("NR2003 Stage 12: steering assistance (bf6f08 &gt; 0) needs the NR2003 track racing line: not ported")
		end
		yawLimiterFactor, sensitivity = limiter, sens
		return x
	end

	-- 00554fb0: steering ratio of the car at the current speed (setup item 0x30 + low-speed override)
	local function ratio(observe)
		local v = speed(observe)
		local r = rf32(SETUP_RATIO)
		if r8(0x74c9a0) == 0 then return r end
		if r &lt; K_LOW_RATIO and r == r then return r end              -- FCOM 7; TEST AH,5; JNP ret
		if not (v &lt; K_V_HIGH or v == K_V_HIGH or v ~= v) then return r end -- v &gt; 17.88
		if v &lt; K_V_LOW or v == K_V_LOW or v ~= v then
			if r &lt; K_LOW_RATIO or r == K_LOW_RATIO or r ~= r then return r end
			return K_LOW_RATIO
		end
		if r &lt; K_LOW_RATIO or r == K_LOW_RATIO or r ~= r then return r end
		return r - (K_V_HIGH - v) * (r - K_LOW_RATIO) * K_RAMP
	end

	-- 005524b0: ignition-sequence timer of the frame start (bf6e0c / bf6ea0)
	local function ignitionTimer()
		local t = ri32(0xbf6e0c)
		if t == 0 then return end
		t -= 1
		w32(0xbf6e0c, t)
		if t ~= 0 then return end
		local st = ri32(0xbf6ea0)
		if st == 5 then w32(0xbf6ea0, 6) elseif st == 7 then w32(0xbf6ea0, 0) end
	end

	-- host device layer (0057abc0 equivalent, ADAPTER): controls of one frame -&gt; control table cells 7 / 8.
	--   steerAxis (-1..1, + right): one analog axis bound to both controls (negative half -&gt; 7, positive -&gt; 8)
	--   steerLeft / steerRight (0..1) + steerDigital (true = keys / buttons, false = analog axes)
	local function hostDevices(c)
		local left, right, isDigital
		if c.steerAxis ~= nil then
			local x = math.clamp(tonumber(c.steerAxis) or 0, -1, 1)
			left = x &lt; 0 and -x or 0; right = x &gt; 0 and x or 0; isDigital = false
		else
			left = math.clamp(tonumber(c.steerLeft) or 0, 0, 1)
			right = math.clamp(tonumber(c.steerRight) or 0, 0, 1)
			isDigital = c.steerDigital ~= false
		end
		wf32(CTRL_RAW + 10 * STEER_LEFT, left); wf32(CTRL_RAW + 10 * STEER_RIGHT, right)
		local kind = isDigital and 0 or 1
		w32(CTRL_TYPE + 29 * STEER_LEFT, kind); w32(CTRL_TYPE + 29 * STEER_RIGHT, kind)
		return isDigital
	end

	-- steering mode: "original" (production) or "provisional" (the Stage 6-11 contract controls.steer = road-wheel
	-- target in rad, + left; used ONLY by the Stage 6-11 regression suites and self-tests whose golden data were
	-- produced with it)
	local mode = "original"
	function V.setSteeringMode(m)
		assert(m == "original" or m == "provisional", "steering mode must be 'original' or 'provisional'")
		mode = m
	end
	function V.steeringMode() return mode end

	-- inside 005524f0 (player branch, after the brake / clutch devices): bf63c8 = 00552720()
	local lastShaped, lastRatio, lastTarget = 0, 0, 0
	-- V._steerMutate (TEST ONLY, nil in production): function(stage, value) -&gt; value, used by tests/stage12 to show that
	-- the comparisons detect deliberately wrong mappings (stages "input", "shaped", "ratio", "target")
	local deviceMomentum -- forward declaration (defined with the options below)
	function V._steerDevices(c)
		if mode ~= "original" then return end
		deviceMomentum(hostDevices(c))
		local x = steerInput()
		local mu = V._steerMutate
		if mu then x = mu("input", x) end
		wf32d(0xbf63c8, x)
	end
	-- 00551e80 tail from @00552082 (after 005524f0): returns the road-wheel target (x87 value) or nil in the
	-- provisional mode
	function V._steerTail(c)
		if mode ~= "original" then return nil end
		wf32d(0xbf63c0, -rf32(0xbf63c8))                                  -- FLD; FCHS; FSTP
		ignitionTimer()
		local L = linearity()
		if L ~= K_ZERO or L ~= L then                                      -- FCOMP 0; TEST AH,0x44; JNP skip
			if not digital(STEER_LEFT) and not digital(STEER_RIGHT) then
				local x = rf32(0xbf63c0)
				local y = L + K_ONE
				local v
				if x &lt; K_ZERO or x == K_ZERO or x ~= x then              -- AND 0x4100; JNZ negative branch
					local b = -x
					v = -((b == 0) and 0 or b ^ y)                       -- _CIpow(-x, L + 1); FCHS
				else
					v = (x == 0) and 0 or x ^ y
				end
				wf32d(0xbf63c0, v)
			end
		end
		local mu = V._steerMutate
		if mu then wf32d(0xbf63c0, mu("shaped", rf32(0xbf63c0))) end
		lastShaped = rf32(0xbf63c0)
		local w = fd(lastShaped * lockK)                                   -- FMUL pi; FSTP dword (lockK = K_PI: 360 deg)
		local r = ratio()
		if mu then r = mu("ratio", r) end
		local t = w / r                                                    -- FDIVR (x87 value)
		if mu then t = mu("target", t) end
		lastRatio, lastTarget = r, t
		return t
	end
	V._zsub = zsub

	-- bit-level access for the Stage 12 tests (ORIGINAL functions)
	V.steerInputOriginal = steerInput   -- 00552720
	V.steerRatioOriginal = ratio        -- 00554fb0
	V.steerLinearityOriginal = linearity -- 00552410
	V.steerAssistOriginal = assist      -- 00550230

	---------------------------------------------------------------------------------------------------------
	-- driver options (simulation-side setters reached through the front-end messages: table 00752370, dispatcher 005bad80 drained on the simulation task)
	---------------------------------------------------------------------------------------------------------
	-- 005502f0: linearity bf6f00 = clamp(x, 0, 1)
	local function setLinearityRaw(x)
		if not (x &gt;= K_ZERO) and x == x then w32(0xbf6f00, 0)            -- x &lt; 0
		elseif x &gt;= K_ONE or x ~= x then w32(0xbf6f00, 0x3f800000)       -- x &gt;= 1 or NaN
		else wf32(0xbf6f00, x) end
	end
	-- 005500c0(i, momentum): control rate 74c990[i] (0 steering, 1 throttle, 2 brake), per frame
	local function setMomentum(i, m)
		local p = m * K_CENTI
		if p == 0 then w32(0x74c990 + 4 * i, 0x3f800000); return end
		wf32d(0x74c990 + 4 * i, K_ONE / p * K_RATE)
	end
	local options = nil -- applied option table (survives reset)
	local IMAGE_RATE = r32(0x74c990) -- the executable's steering rate (0.033 / frame) when no controls.cfg was loaded
	local baseRate = nil -- 74c990 bits after the option messages (image 0.033 or the momentum option)
	local function applyOptions()
		lockK, drawLimit, baseRate = K_PI, K_DRAW_LOCK, nil
		if options == nil then return end
		local o = options
		if o.linearityRaw ~= nil then setLinearityRaw(f32near(o.linearityRaw))
		elseif o.linearity ~= nil then
			-- controls.cfg value (int 0..100, slider shows 100 - value): 0043f1d0 sends (float)value * 0.01f
			setLinearityRaw(f32near(math.clamp(floor(o.linearity), 0, 100) * K_CENTI))
		end
		if o.momentum ~= nil then setMomentum(0, math.clamp(floor(o.momentum), 0, 100)) end
		if o.lowSpeedOverride ~= nil then w8(0x74c9a0, o.lowSpeedOverride and 1 or 0) end -- 00550110
		if o.yawLimiter ~= nil then
			local v = r32(SETTINGS + 0x4c)
			w32(SETTINGS + 0x4c, o.yawLimiter and bit32.bor(v, 0x2000000) or band(v, bit32.bnot(0x2000000)))
		end
		-- Stage 12.1 host options (NOT original): steering-wheel lock and cockpit draw limit
		if o.lockDegrees ~= nil and o.lockDegrees ~= 360 then lockK = f32near(math.rad(o.lockDegrees * 0.5)) end
		if o.cockpitLimit == "lock" then drawLimit = lockK
		elseif type(o.cockpitLimit) == "number" then drawLimit = f32near(math.rad(o.cockpitLimit)) end
		baseRate = o.momentum ~= nil and r32(0x74c990) or IMAGE_RATE
	end
	-- Stage 12.1 host option (NOT original): steering momentum per input device. The original has ONE steering momentum
	-- (74c990, 005500c0) for keys and axes alike; a player switching between keyboard and a wheel / mouse changes it in
	-- the controls menu. momentumKeys / momentumAxis (0..100, 0 = no slew / no sine, the original setter conversion) are
	-- applied by the same original setter while keys / an analog axis drive the steering controls; nil = the base value
	-- (the momentum option, or the image rate 0.033 = no controls.cfg). Both nil = the original single value, untouched.
	function deviceMomentum(isDigital)
		local o = options
		if o == nil or (o.momentumKeys == nil and o.momentumAxis == nil) then return end
		local m
		if isDigital then m = o.momentumKeys else m = o.momentumAxis end
		if m == nil then
			if baseRate ~= nil and r32(0x74c990) ~= baseRate then w32(0x74c990, baseRate) end
		else
			setMomentum(0, math.clamp(floor(m), 0, 100))
		end
	end
	-- opts: linearity (controls.cfg integer 0..100; nil = keep), linearityRaw (bf6f00 value 0..1), momentum (steering
	-- momentum 0..100, 0 = no slew limit), lowSpeedOverride (bool), assist (0..100: only 0 is accepted, see
	-- steerInput). Values survive reset(); nil options = the image values (no message).
	-- yawLimiter = race settings +0x4c bit 25, the session option DrivingMode = ARCADE (player.ini, default Simulation):
	-- besides the 00552720 limiter and the 00552410 remap, arcade makes 004233a0 select car chassis spec 0 (8945b8)
	-- instead of the Cup spec (7238e0) when the car is built -- not recovered / not ported. Bit 25 on the Cup spec is a
	-- combination the original never runs, so yawLimiter = true is refused unless `validation` is true (the tests use
	-- it to compare the 00552720 / 00552410 bit-25 branch with the Unicorn reference, which sets the same bit).
	function V.setSteeringOptions(opts, validation)
		opts = opts or {}
		if opts.assist ~= nil and (tonumber(opts.assist) or 0) ~= 0 then
			error("NR2003 Stage 12: steering assistance &gt; 0 needs the NR2003 track racing line: not ported")
		end
		if opts.yawLimiter == true and validation ~= true then
			error("NR2003 Stage 12: arcade driving mode (race settings bit 25) also selects car chassis spec 0 at build (004233a0): not ported")
		end
		local function range(name, lo, hi)
			local v = opts[name]
			if v ~= nil and not (type(v) == "number" and v &gt;= lo and v &lt;= hi) then
				error(string.format("NR2003 Stage 12.1: %s must be a number %g..%g (got %s)", name, lo, hi, tostring(v)))
			end
		end
		range("lockDegrees", 1, 3600); range("momentumKeys", 0, 100); range("momentumAxis", 0, 100)
		if opts.cockpitLimit ~= nil and opts.cockpitLimit ~= "original" and opts.cockpitLimit ~= "lock" then
			range("cockpitLimit", 1, 1800)
		end
		options = table.clone(opts)
		options.assist = nil
		applyOptions()
		return V.steeringOptions()
	end
	function V.clearSteeringOptions() options = nil end
	function V.steeringOptions()
		return {linearity = rf32(0xbf6f00), steerRate = rf32(0x74c990), releaseFactor = rf32(0x74c99c),
			lowSpeedOverride = r8(0x74c9a0) ~= 0, assist = rf32(0xbf6f08), yawLimiter = settingsBit25(),
			drivingMode = settingsBit25() and "arcade" or "simulation",
			aidsDisabled = band(r32(SETTINGS + 0x4c), 0x20000000) ~= 0, setupRatio = rf32(SETUP_RATIO),
			lockDegrees = options and options.lockDegrees or 360, cockpitLimitDegrees = math.deg(drawLimit),
			momentumKeys = options and options.momentumKeys, momentumAxis = options and options.momentumAxis}
	end
	local baseReset = V.reset
	function V.reset()
		baseReset()
		applyOptions()
	end

	---------------------------------------------------------------------------------------------------------
	-- observation (original cells; no side effects except the speed cache bf6f44 also written by 00554f50)
	---------------------------------------------------------------------------------------------------------
	-- 005662d0: steering-wheel angle of the car model (rad, + = clockwise seen by the driver for a right turn as
	-- drawn by NR2003: -(ratio * mean front steer), left road-wheel angles are positive)
	local function wheelAngle(drawSteer, r)
		local a = -(r * drawSteer)
		if a &lt; -drawLimit then return -drawLimit end   -- original 2.79 (Stage 12.1 option cockpitLimit)
		if a &gt; drawLimit then return drawLimit end
		return a
	end
	-- mean front steer of the draw state: the cell written by the ORIGINAL 00551990 (Stage 11 frame end); the
	-- Stage 6-10 frozen frame end does not run it -&gt; the same formula on the exported state block
	local function drawSteer()
		if V.runtimeMode and V.runtimeMode() == "original" then return rf32(DRAW_STEER) end
		return fd((rf32(0xbf6d7c) + rf32(0xbf6d94)) * 0.5)
	end
	function V.steeringWheelAngle()
		return wheelAngle(drawSteer(), ratio(true))
	end
	function V.steeringState(out)
		out = out or {}
		out.mode = mode
		out.left, out.right = rf32(CTRL_RAW + 10 * STEER_LEFT), rf32(CTRL_RAW + 10 * STEER_RIGHT)
		out.digital = digital(STEER_LEFT) or digital(STEER_RIGHT)
		out.slewLeft, out.slewRight = rf32(0xbf639c), rf32(0xbf63a0)    -- 00552d00 states (controls 7 / 8)
		out.input = rf32(0xbf63c8)                                       -- 00552720 output
		out.shaped = lastShaped                                          -- after linearity (transient bf63c0)
		out.sensitivity, out.yawLimiter = sensitivity, yawLimiterFactor
		out.ratio = lastRatio                                            -- 00554fb0 of the last frame start
		out.target = rf32(0xbf63b8)                                      -- road-wheel target of the frame
		out.frameTarget, out.ramp = rf32(0xbf6e80), rf32(0xbf6e88)
		out.current = rf32(0xbf63c0)                                     -- per-tick ramped value (005539c0)
		out.lf, out.rf = rf32(0xbf6360), rf32(0xbf6364)                  -- prescribed hub inputs (toe incl.)
		out.toeLeft, out.toeRight = rf32(0xc086b0), rf32(0xc086b4)
		out.hubLF, out.hubRF = rf32(0xbf6d7c), rf32(0xbf6d94)            -- exported states 15 / 21
		out.drawSteer = drawSteer()
		out.ratioNow = ratio(true)                                      -- 00554fb0 at the current speed
		out.wheelAngle = wheelAngle(out.drawSteer, out.ratioNow)
		return out
	end

	-- Stage 14 checkpoint: steering
	V._registerCheckpoint("steering", function() return {mode=mode, options=options, baseRate=baseRate, lockK=lockK, drawLimit=drawLimit, shaped=lastShaped, ratio=lastRatio, target=lastTarget, sensitivity=sensitivity, yawLimiterFactor=yawLimiterFactor} end, function(h)
		mode, options, lockK, drawLimit = h.mode, h.options, h.lockK, h.drawLimit
		baseRate = h.baseRate
		lastShaped, lastRatio, lastTarget = h.shaped, h.ratio, h.target
		sensitivity, yawLimiterFactor = h.sensitivity, h.yawLimiterFactor
	end)
	return V
end
]=]
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_Source8"><Properties><string name="Name">Source8</string><ProtectedString name="Source">return [=[
--!native
--!optimize 2
-- Stage 13: the ORIGINAL NR2003 force feedback (steering torque) of the player car, hand port of the x86
-- (recovered in recovery/stage13, STAGE13_RECOVERY.md). A presentation output: nothing here feeds the physics or the
-- steering chain (Stage 12 evidence ffbinterface.md + Stage 13 dynamic proof).
--
-- Producers (Stage 6/7 core, unchanged): the front tyre callback 0055e180 -&gt; 00554e70 accumulates per front wheel
-- (slot 0 LF, 1 RF), twice per tick (predictor + corrector): n 74c964+4i, A bf6ed4+4i += c085dc (relaxed lateral slip
-- state), B bf6edc+4i += |Fz| + 0.01, C bf6ee4+4i += Fy, D bf6eec+4i += 0.1 * (r x F).z + c081ec (aligning moment).
-- Per 288 Hz tick, 005539c0 @00553a64 (V._ffbTick, called by NR2003CupDriver.tickInputs):
--   00554d30  l = B_LF / (B_LF + B_RF) (only when n_LF &gt; 0 and the sum &gt; 0), a = 1/n_LF, b = 1/n_RF -&gt;
--             74c960 = min(B_RF b + B_LF a, 1500) (no reader), bf6ec4 = (1 - l) A_RF b + l A_LF a (slip),
--             bf6ec8 = C_RF b + C_LF a (no reader), bf6ed0 = D_RF b + D_LF a (moment); n, A, B, C, D &lt;- 0
-- Per 36 Hz frame, FFB block of the frame end 00554520 (0055464c..0055479d; V._ffbFrameEnd, called by
-- NR2003CupFrame right after the lifted 00554520, whose own copy of the block is skipped):
--   gate bf6ebb (FF effect acquired) != 0 and bf6eb8 (player controls suspended) == 0
--   d = (ec4 - ec0) * 36 ; ec0 = ec4 ; q = ec4 + d * (latency bf6f20 * 0.001) * (1 - 20 / (airspeed bf3a00 + 20))
--   m = |ec4| &gt; 1e-5 ? q / ec4 * ed0 : ed0 ; ecc = (m - damping bf6f24 * d + ecc) * 0.5
--   out = clamp(ecc * strength 74c9a4 / (setup item 0x30 * 1600), -1, 1) -&gt; 005d08d0(axis bf6ebc, out)
--   005d08d0 -&gt; 005d2260 -&gt; 005d3010: DirectInput constant force (one axis, rglDirection 0, autocentre off)
--   lMagnitude = _ftol(out * 10000), SetParameters(DIEP_TYPESPECIFICPARAMS | DIEP_START): the ADAPTER output here.
-- Controls / device (simulation side, ORIGINAL): 00550070(flag) (bf6eb8 = flag; flag 0 -&gt; 0054fed0 FF axis setup from
-- the control-7 binding: axis binding + FF on (bf6f1c) + capable device -&gt; acquired bf6ebb = 1, axis bf6ebc), 00550030
-- (zero force), 00550680 (release). bf6eb8 is ALSO the 005524f0 player-branch gate (@00552549, NR2003CupDriver).
-- Options (messages 8..11, sent only by the controls.cfg loader 0043f1d0): 00550270 on/off bf6f1c, 00550290 strength
-- 74c9a4, 005502d0 damping bf6f24, 005502b0 latency bf6f20 (controls.cfg integers converted by fild / fstp dword).
--
-- Arithmetic: the simulation task runs the x87 with CW 0x077f (64-bit precision, round toward -inf). The FFB code is
-- evaluated in EXACT x87 arithmetic (X87 below: every operation rounded to a 64-bit significand toward -inf, every
-- f32 store rounded toward -inf), not in IEEE double: an exact intermediate within double rounding of an f32 boundary
-- (e.g. f32 a + a tiny negative b: double returns a, the x87 a value below a) would otherwise change a stored bit.
-- Exact fast path in double when every operation is exact (checked by TwoSum / Dekker TwoProduct), limb arithmetic
-- otherwise. Pure Luau: no Instances.
return function(V)
	local rf32, r32, ri32, w32, r8, w8, wf32 = V.rf32, V.r32, V.ri32, V.w32, V.r8, V.w8, V.wf32
	local floor, huge = math.floor, math.huge
	local frexp, ldexp = math.frexp, math.ldexp

	---------------------------------------------------------------------------------------------------------
	-- X87: exact 64-bit-significand arithmetic, round toward -inf (x87 CW 0x077f). A value is a pair (h, l) of doubles,
	-- h + l exact, h = the value truncated toward zero to 53 significant bits, l the rest (same sign, |l| &lt; ulp(h)).
	---------------------------------------------------------------------------------------------------------
	local TWO32, TWO31 = 4294967296, 2147483648
	local function unpack(h, l)
		-- nonzero finite -&gt; sign, exponent e (2^e &lt;= |v| &lt; 2^(e+1)), significand m = m1 * 2^32 + m0 in [2^63, 2^64)
		local s = 0
		if h &lt; 0 then s = 1; h = -h; l = -l end
		local _, ex = frexp(h)
		local H, L = ldexp(h, 64 - ex), ldexp(l, 64 - ex)
		local m1 = floor(H / TWO32)
		return s, ex - 1, m1, (H - m1 * TWO32) + L
	end
	local function pack(s, e, m1, m0)
		local low = m0 % 2048
		local h, l = ldexp(m1 * TWO32 + (m0 - low), e - 63), ldexp(low, e - 63)
		if s == 1 then return -h, -l end
		return h, l
	end
	-- the magnitude m (+ a nonzero remainder when inexact) rounded toward -inf for the sign s
	local function round(s, e, m1, m0, inexact)
		if inexact and s == 1 then
			m0 += 1
			if m0 == TWO32 then
				m0 = 0; m1 += 1
				if m1 == TWO32 then m1 = TWO31; e += 1 end
			end
		end
		return pack(s, e, m1, m0)
	end
	-- IEEE 754 sign of an exact zero sum under round toward -inf: +0 only for (+0) + (+0)
	local function zeroSum(a, b)
		if a == 0 and b == 0 and 1 / a &gt; 0 and 1 / b &gt; 0 then return 0 end
		return -0.0
	end
	local function addSlow(ah, al, bh, bl)
		if ah == 0 then
			if bh == 0 then return zeroSum(ah, bh), 0 end
			return bh, bl
		end
		if bh == 0 then return ah, al end
		local sa, ea, a1, a0 = unpack(ah, al)
		local sb, eb, b1, b0 = unpack(bh, bl)
		if eb &gt; ea or (eb == ea and (b1 &gt; a1 or (b1 == a1 and b0 &gt; a0))) then
			sa, ea, a1, a0, sb, eb, b1, b0 = sb, eb, b1, b0, sa, ea, a1, a0
		end
		-- B aligned to A with a 32-bit guard limb (y1, y0, yg) + sticky (bits shifted out below the guard limb)
		local d = ea - eb
		local y1, y0, yg, sticky = b1, b0, 0, false
		if d &gt;= 96 then
			y1, y0, yg, sticky = 0, 0, 0, true
		else
			while d &gt;= 32 do
				sticky = sticky or yg ~= 0
				yg = y0; y0 = y1; y1 = 0; d -= 32
			end
			if d &gt; 0 then
				local p, q = 2 ^ d, 2 ^ (32 - d)
				local r1, r0, rg = y1 % p, y0 % p, yg % p
				sticky = sticky or rg ~= 0
				yg = (yg - rg) / p + r0 * q
				y0 = (y0 - r0) / p + r1 * q
				y1 = (y1 - r1) / p
			end
		end
		local z1, z0, zg
		if sa == sb then
			zg = yg; z0 = a0 + y0; z1 = a1 + y1
			if z0 &gt;= TWO32 then z0 -= TWO32; z1 += 1 end
			if z1 &gt;= TWO32 then
				local c0, cg = z0 % 2, zg % 2
				sticky = sticky or cg ~= 0
				zg = (zg - cg) / 2 + c0 * TWO31
				local c1 = z1 % 2
				z0 = (z0 - c0) / 2 + c1 * TWO31
				z1 = (z1 - c1) / 2
				ea += 1
			end
		else
			-- |A| - |B|; with sticky the true |B| exceeds (y1, y0, yg) by less than one guard unit: subtract one more
			-- unit, the remaining fraction (0, 1) is the (nonzero) remainder
			zg = -yg; z0 = a0 - y0; z1 = a1 - y1
			if sticky then zg -= 1 end
			if zg &lt; 0 then zg += TWO32; z0 -= 1 end
			if z0 &lt; 0 then z0 += TWO32; z1 -= 1 end
			if z1 == 0 and z0 == 0 and zg == 0 and not sticky then return -0.0, 0 end
			while z1 &lt; TWO31 do
				local t0, tg = floor(z0 / TWO31), floor(zg / TWO31)
				z1 = z1 * 2 + t0
				z0 = (z0 - t0 * TWO31) * 2 + tg
				zg = (zg - tg * TWO31) * 2
				ea -= 1
			end
		end
		return round(sa, ea, z1, z0, zg ~= 0 or sticky)
	end
	local function add(ah, al, bh, bl)
		if al == 0 and bl == 0 then
			local s = ah + bh
			if s ~= s or s == huge or s == -huge then return s, 0 end
			local bb = s - ah
			if (ah - (s - bb)) + (bh - bb) == 0 then          -- TwoSum error 0: exact
				if s == 0 then return zeroSum(ah, bh), 0 end
				return s, 0
			end
		end
		return addSlow(ah, al, bh, bl)
	end
	local function sub(ah, al, bh, bl) return add(ah, al, -bh, -bl) end
	local SPLIT = 134217729 -- 2^27 + 1 (Dekker)
	local function prodErr(a, b, p)
		local t = SPLIT * a
		local a1 = t - (t - a)
		local a2 = a - a1
		t = SPLIT * b
		local b1 = t - (t - b)
		local b2 = b - b1
		return ((a1 * b1 - p) + a1 * b2 + a2 * b1) + a2 * b2
	end
	local function limbs16(m1, m0)
		local x3, x1 = floor(m1 / 65536), floor(m0 / 65536)
		return m0 - x1 * 65536, x1, m1 - x3 * 65536, x3
	end
	local function mulSlow(ah, al, bh, bl)
		local sa, ea, a1, a0 = unpack(ah, al)
		local sb, eb, b1, b0 = unpack(bh, bl)
		local x0, x1, x2, x3 = limbs16(a1, a0)
		local y0, y1, y2, y3 = limbs16(b1, b0)
		local t = x0 * y0
		local p0 = t % 65536; t = (t - p0) / 65536 + x0 * y1 + x1 * y0
		local p1 = t % 65536; t = (t - p1) / 65536 + x0 * y2 + x1 * y1 + x2 * y0
		local p2 = t % 65536; t = (t - p2) / 65536 + x0 * y3 + x1 * y2 + x2 * y1 + x3 * y0
		local p3 = t % 65536; t = (t - p3) / 65536 + x1 * y3 + x2 * y2 + x3 * y1
		local p4 = t % 65536; t = (t - p4) / 65536 + x2 * y3 + x3 * y2
		local p5 = t % 65536; t = (t - p5) / 65536 + x3 * y3
		local p6 = t % 65536
		local p7 = (t - p6) / 65536
		local s, e = (sa + sb) % 2, ea + eb
		local m1, m0, inexact
		if p7 &gt;= 32768 then                                     -- product in [2^127, 2^128)
			m1, m0 = p7 * 65536 + p6, p5 * 65536 + p4
			inexact = p3 ~= 0 or p2 ~= 0 or p1 ~= 0 or p0 ~= 0
			e += 1
		else                                                    -- [2^126, 2^127): one bit left
			local c5, c3 = floor(p5 / 32768), floor(p3 / 32768)
			m1 = (p7 * 65536 + p6) * 2 + c5
			m0 = ((p5 - c5 * 32768) * 65536 + p4) * 2 + c3
			inexact = (p3 - c3 * 32768) ~= 0 or p2 ~= 0 or p1 ~= 0 or p0 ~= 0
		end
		return round(s, e, m1, m0, inexact)
	end
	local function mul(ah, al, bh, bl)
		if al == 0 and bl == 0 then
			local p = ah * bh
			if p == 0 or p ~= p or p == huge or p == -huge then return p, 0 end
			if prodErr(ah, bh, p) == 0 then return p, 0 end
		end
		if ah == 0 or bh == 0 then return ah * bh, 0 end          -- exact zero: sign = xor of the signs (h holds the sign)
		return mulSlow(ah, al, bh, bl)
	end
	local function divSlow(ah, al, bh, bl)
		local sa, ea, a1, a0 = unpack(ah, al)
		local sb, eb, b1, b0 = unpack(bh, bl)
		local e = ea - eb
		local r1, r0 = a1, a0
		if a1 &lt; b1 or (a1 == b1 and a0 &lt; b0) then
			r0 *= 2; r1 *= 2
			if r0 &gt;= TWO32 then r0 -= TWO32; r1 += 1 end
			e -= 1
		end
		local q1, q0 = 0, 0
		for i = 1, 64 do
			local bit = 0
			if r1 &gt; b1 or (r1 == b1 and r0 &gt;= b0) then
				bit = 1
				r0 -= b0; r1 -= b1
				if r0 &lt; 0 then r0 += TWO32; r1 -= 1 end
			end
			if i &lt;= 32 then q1 = q1 * 2 + bit else q0 = q0 * 2 + bit end
			r0 *= 2; r1 *= 2
			if r0 &gt;= TWO32 then r0 -= TWO32; r1 += 1 end
		end
		return round((sa + sb) % 2, e, q1, q0, r1 ~= 0 or r0 ~= 0)
	end
	local function div(ah, al, bh, bl)
		if al == 0 and bl == 0 then
			local q = ah / bh
			if q == 0 or q ~= q or q == huge or q == -huge then return q, 0 end
			local p = q * bh
			if p == ah and prodErr(q, bh, p) == 0 then return q, 0 end
		end
		if ah == 0 then return ah / bh, 0 end
		return divSlow(ah, al, bh, bl)
	end
	-- FST dword: the value rounded toward -inf to binary32 (returned as the double holding it)
	local SB = buffer.create(4)
	local function f32(h, l)
		buffer.writef32(SB, 0, h)
		local f = buffer.readf32(SB, 0)
		if f - h &gt; l then                                       -- f &gt; h + l
			local u = buffer.readu32(SB, 0)
			if f &gt; 0 then u -= 1 elseif f == 0 then u = 0x80000001 else u += 1 end
			buffer.writeu32(SB, 0, u)
			f = buffer.readf32(SB, 0)
		end
		return f
	end
	local X87 = {add = add, sub = sub, mul = mul, div = div, f32 = f32}
	V.x87 = X87 -- exposed for the Stage 13 arithmetic vectors (tests/stage13)

	---------------------------------------------------------------------------------------------------------
	-- cells (original addresses) and .rdata constants (the cells the original reads)
	---------------------------------------------------------------------------------------------------------
	local N_LF, N_RF = 0x74c964, 0x74c968
	local A_LF, A_RF, B_LF, B_RF = 0xbf6ed4, 0xbf6ed8, 0xbf6edc, 0xbf6ee0
	local C_LF, C_RF, D_LF, D_RF = 0xbf6ee4, 0xbf6ee8, 0xbf6eec, 0xbf6ef0
	local LOAD, SLIP, FY, MOMENT = 0x74c960, 0xbf6ec4, 0xbf6ec8, 0xbf6ed0
	local PREV, FILT = 0xbf6ec0, 0xbf6ecc
	local SUSPENDED, ACQUIRED, AXIS, DIRSIGN = 0xbf6eb8, 0xbf6ebb, 0xbf6ebc, 0x74c95c
	local FF_ON, STRENGTH, DAMPING, LATENCY = 0xbf6f1c, 0x74c9a4, 0xbf6f24, 0xbf6f20
	local AIRSPEED = 0xbf3a00                                  -- |v - wind| copied by 00554520 @0055455f
	local SETUP_RATIO = 0xc055c0 + 4 * 0x30                    -- 00557d60(0x30), ECX c055c0: raw item, no override
	local SIMULATED = 0xbf6e04                                 -- 00551880(): player vehicle simulated
	local REC7 = 0xd37cb8 + 29 * 7                             -- control-7 (steer left) binding record (0057b1e0(7))
	local K_ZERO, K_ONE, K_MONE = rf32(0x6ea454), rf32(0x6e97d8), rf32(0x6ea4a8) -- 0, 1, -1
	local K_LOADMAX = rf32(0x6f5878)                           -- 1500
	local K_V0 = rf32(0x6ecfc8)                                -- 20
	local K_MS = rf32(0x6ea67c)                                -- 0.001 (f32)
	local K_EPS = rf32(0x6ea480)                               -- 1e-5 (f32)
	local K_HALF = rf32(0x6ea44c)                              -- 0.5
	local K_SCALE = rf32(0x6f5a44)                             -- 1600
	local K_DI = rf32(0x6f5214)                                -- 10000 (005d3010)
	local RATE = 36                                            -- 005f7c50 taskGetRate (lifter builtin B_taskGetRate)
	local LOAD_MAX_BITS = 0x44bb8000                           -- mov dword [74c960], 1500.0 (immediate)


	---------------------------------------------------------------------------------------------------------
	-- host device layer (ADAPTER: the DirectInput module 005d0xxx / 005d2xxx; no simulation memory)
	---------------------------------------------------------------------------------------------------------
	local device = {capable = false, acquire = true} -- 005d0820 FF support of the bound axis / 005d0840 acquisition result
	local effect = false                             -- f5d414: constant-force effect acquired (005d2bb0)
	local sink = nil                                 -- host callback(axis, force, magnitude) per 005d3010 SetParameters
	local last = {axis = 0, force = 0, magnitude = 0, frames = 0, calls = 0, block = false}
	-- every 005d08d0 call of the ORIGINAL code (force as passed: f32, before the device conversion)
	local trace = nil                                -- tests: table receiving {kind, axis, value}
	local function deviceForce(axis, force)          -- 005d08d0(axis, force)
		last.calls += 1
		if trace then table.insert(trace, {"force", axis, force}) end
		if not effect then return end                 -- [f5d4f0] DirectInput up and [f5d414] effect acquired
		local x = force * K_DI                         -- fld dword ; fmul dword 10000 (exact: 24 x 14 bits)
		local mag = x &gt;= 0 and floor(x) or -floor(-x)  -- _ftol (truncation toward zero)
		last.axis, last.force, last.magnitude = axis, force, mag
		if sink then sink(axis, force, mag) end
	end
	local function deviceAcquire(axis)                -- 00550000 on the FG thread: 005d0840(axis) -&gt; f5d414
		if trace then table.insert(trace, {"acquire", axis}) end
		if not device.capable then return false end
		local ok = device.acquire ~= false
		if ok then effect = true end
		return ok
	end
	local function deviceRelease(axis)                -- 00550060 on the FG thread: 005d0870(axis)
		if trace then table.insert(trace, {"release", axis}) end
		if device.capable then effect = false end
	end

	---------------------------------------------------------------------------------------------------------
	-- simulation-side controls / FF setup (ORIGINAL; 005f79a0 FG requests run synchronously: ADAPTER)
	---------------------------------------------------------------------------------------------------------
	local function band8(x) return bit32.band(math.floor(tonumber(x) or 0), 0xff) end
	local configuredKind = nil -- control-7 binding type at the last 0054fed0 (host bookkeeping, see V._steerDevices)
	-- 00550030: condition effects (005d08a0: no effect exists, no-op) + zero constant force
	local function zeroForce() deviceForce(r32(AXIS), 0) end
	-- 0054fed0: FF axis = the control-7 binding (0057aff0 fields: +0x10 type, +0x14 axis, +0x1c direction)
	local function configure()
		local kind = ri32(REC7 + 0x10)
		configuredKind = kind
		if kind ~= 1 then                                         -- not an analog axis: release
			if r8(ACQUIRED) ~= 0 then deviceRelease(r32(AXIS)); w8(ACQUIRED, 0) end
			return
		end
		local axis = r32(REC7 + 0x14)
		-- axis name "&lt;n&gt;&lt;" / "&lt;n&gt;&gt;" (table 0074fc68, axis &lt; 16) or "?" (0074fd52): 74c95c = (char after digits) == '&gt;' ? -1 : 1
		local sign = (bit32.band(axis, 0x7fffffff) &lt; 16 and r8(REC7 + 0x1c) ~= 0) and -1 or 1
		if r8(ACQUIRED) ~= 0 then
			if not (r8(FF_ON) ~= 0 and r32(AXIS) == axis) then  -- 00550280() ; cmp bf6ebc, axis
				deviceRelease(r32(AXIS)); w8(ACQUIRED, 0)
			end
		end
		w32(DIRSIGN, sign); w32(AXIS, axis)
		if r8(ACQUIRED) ~= 0 or r8(FF_ON) == 0 then return end
		if not device.capable then return end                     -- 005d0820(axis)
		if deviceAcquire(axis) then                               -- 005f79a0(00550000, &amp;ok): ok -&gt; 00550030
			zeroForce()
			w8(ACQUIRED, 1)
		end
	end
	-- 00550070(flag): flag 0 = player controls active (FF axis set up), 1 = suspended (force zeroed); bf6eb8 = flag
	local function controls(flag)
		flag = band8(flag)
		if flag == 0 then configure() end
		if r8(ACQUIRED) ~= 0 and flag ~= 0 then zeroForce() end
		w8(SUSPENDED, flag)
	end
	-- 00550680: release at the end of the session (00572cb0 / 00573bc0)
	local function release()
		if r8(ACQUIRED) ~= 0 then deviceRelease(r32(AXIS)); w8(ACQUIRED, 0) end
	end


	---------------------------------------------------------------------------------------------------------
	-- 00554d30 (per tick): front tyre statistics of the last tick's passes; clears the accumulators
	---------------------------------------------------------------------------------------------------------
	local function makeStats(add, sub, mul, div, f32, mu)
		return function()
			local nL, nR = ri32(N_LF), ri32(N_RF)
			local bL, bR = rf32(B_LF), rf32(B_RF)
			local ah, al, l = K_ZERO, 0, 0                          -- 00554d75: fld 0.0 ; mov dword [esp], 0
			if nL &gt; 0 then
				local sh, sl = add(bR, 0, bL, 0)                    -- fld B_RF ; fadd B_LF
				local sx = f32(sh, sl)                              -- fst dword [esp]
				if sh &gt; 0 then                                      -- fcomp 0.0 ; and 0x4100 ; jne (sum &lt;= 0 or NaN)
					ah, al = div(K_ONE, 0, nL, 0)                   -- fild n_LF ; fdivr 1.0
					l = f32(div(bL, 0, sx, 0))                      -- fld B_LF ; fdiv dword [esp] ; fstp dword [esp]
				end
			end
			local bh, bl = K_ZERO, 0
			if nR &gt; 0 then bh, bl = div(K_ONE, 0, nR, 0) end        -- fild n_RF ; fdivr 1.0 (else fld 0.0)
			-- 74c960 = B_RF b + B_LF a (fst), &gt; 1500 -&gt; 1500 (NaN kept)
			local t1h, t1l = mul(bR, 0, bh, bl)
			local t2h, t2l = mul(bL, 0, ah, al)
			local vh, vl = add(t1h, t1l, t2h, t2l)
			wf32(LOAD, f32(vh, vl))
			if (vh &gt; K_LOADMAX or (vh == K_LOADMAX and vl &gt; 0)) and not (mu and mu("noclamp", true)) then w32(LOAD, LOAD_MAX_BITS) end
			-- bf6ec4 = ((1 - l) A_RF) b + (A_LF l) a
			local oh, ol = sub(K_ONE, 0, l, 0)
			local ph, pl = mul(oh, ol, rf32(A_RF), 0)
			ph, pl = mul(ph, pl, bh, bl)
			local qh, ql = mul(rf32(A_LF), 0, l, 0)
			qh, ql = mul(qh, ql, ah, al)
			local slip = f32(add(ph, pl, qh, ql))
			if mu then slip = f32(mu("slip", slip), 0) end
			wf32(SLIP, slip)
			-- bf6ec8 = C_RF b + C_LF a ; bf6ed0 = D_RF b + D_LF a
			ph, pl = mul(rf32(C_RF), 0, bh, bl)
			qh, ql = mul(rf32(C_LF), 0, ah, al)
			wf32(FY, f32(add(ph, pl, qh, ql)))
			ph, pl = mul(rf32(D_RF), 0, bh, bl)
			qh, ql = mul(rf32(D_LF), 0, ah, al)
			local moment = f32(add(ph, pl, qh, ql))
			if mu then moment = f32(mu("moment", moment), 0) end
			wf32(MOMENT, moment)
			-- integer MOV 0 (00554ddf..00554e59)
			w32(N_LF, 0); w32(N_RF, 0); w32(B_LF, 0); w32(B_RF, 0); w32(C_LF, 0); w32(C_RF, 0)
			w32(D_LF, 0); w32(D_RF, 0); w32(A_LF, 0); w32(A_RF, 0)
		end
	end

	---------------------------------------------------------------------------------------------------------
	-- FFB block of the frame end 00554520 (0055464c..0055479d)
	---------------------------------------------------------------------------------------------------------
	local function makeBlock(add, sub, mul, div, f32, mu)
		return function()
			if r8(ACQUIRED) == 0 or r8(SUSPENDED) ~= 0 then return end
			local ec4, ec0 = rf32(SLIP), rf32(PREV)
			local dh, dl = sub(ec4, 0, ec0, 0)                        -- fld ec4 ; fsub ec0
			w32(PREV, r32(SLIP))                                      -- ec0 = ec4 (MOV)
			local d = f32(mul(RATE, 0, dh, dl))                       -- fild rate ; fmulp ; fstp dword [esp]
			local th, tl = add(rf32(AIRSPEED), 0, K_V0, 0)            -- fld airspeed ; fadd 20
			th, tl = div(K_V0, 0, th, tl)                             -- fdivr 20
			th, tl = sub(K_ONE, 0, th, tl)                            -- fsubr 1.0
			local uh, ul = mul(rf32(LATENCY), 0, K_MS, 0)             -- fld latency ; fmul 0.001
			th, tl = mul(th, tl, uh, ul)                              -- fmulp st(1)
			th, tl = mul(th, tl, d, 0)                                -- fmul dword [esp] (d)
			local q = f32(add(th, tl, ec4, 0))                        -- fadd ec4 ; fstp dword [esp+0xc]
			if mu then q = f32(mu("q", q), 0) end
			local mh, ml
			local a = math.abs(ec4)                                   -- and 0x7fffffff
			if not (a &lt; K_EPS or a == K_EPS or a ~= a) then           -- fcomp 1e-5 ; and 0x4100 ; jne
				mh, ml = div(q, 0, ec4, 0)                            -- fld q ; fdiv ec4
				mh, ml = mul(mh, ml, rf32(MOMENT), 0)                 -- fmul ed0
			else
				mh, ml = rf32(MOMENT), 0                              -- fld ed0
			end
			local xh, xl = mul(rf32(DAMPING), 0, d, 0)                -- fld damping ; fmul d
			if mu then xh, xl = mu("damping", xh), 0 end
			local yh, yl = sub(mh, ml, xh, xl)                        -- fsubp st(1)
			yh, yl = add(yh, yl, rf32(FILT), 0)                       -- fadd ecc
			yh, yl = mul(yh, yl, K_HALF, 0)                           -- fmul 0.5
			local ecc = f32(yh, yl)                                   -- fst [esp+0x10] ; fstp ecc
			wf32(FILT, ecc)
			local ratio = rf32(SETUP_RATIO)
			if mu then ratio = mu("ratio", ratio) end
			local rh, rl = mul(ratio, 0, K_SCALE, 0)                  -- fld item 0x30 ; fmul 1600
			rh, rl = div(rf32(STRENGTH), 0, rh, rl)                   -- fdivr strength
			local out = f32(mul(rh, rl, ecc, 0))                      -- fmul ecc ; fstp dword [esp]
			if mu then out = f32(mu("out", out), 0) end
			if K_ONE &lt; out then out = K_ONE                           -- fcomp ; test ah,5 ; jp
			elseif K_MONE &gt; out then out = K_MONE end                 -- fcomp ; and 0x4100 ; jne
			last.block = true
			last.frames += 1
			deviceForce(r32(AXIS), out)                               -- 005d08d0(bf6ebc, out)
		end
	end

	-- the arithmetic of the two routines: exact x87 (production) or, TEST ONLY (V._ffbModel), the IEEE double model of the
	-- Stage 6-12 lifter convention (intermediates in double, round to nearest; f32 stores toward -inf) and a deliberate
	-- mapping error mu(stage, value) -&gt; value (level 5 of tests/stage13)
	local fd = V.fd
	local function dadd(ah, _, bh, _) local r = ah + bh; if r == 0 then return zeroSum(ah, bh), 0 end; return r, 0 end
	local function dsub(ah, _, bh, _) return dadd(ah, 0, -bh, 0) end
	local function dmul(ah, _, bh, _) return ah * bh, 0 end
	local function ddiv(ah, _, bh, _) return ah / bh, 0 end
	local function dstore(h, _) return fd(h) end
	local stats, frameBlock
	local function build(model, mu)
		if model == "double" then
			stats, frameBlock = makeStats(dadd, dsub, dmul, ddiv, dstore, mu), makeBlock(dadd, dsub, dmul, ddiv, dstore, mu)
		else
			stats, frameBlock = makeStats(add, sub, mul, div, f32, mu), makeBlock(add, sub, mul, div, f32, mu)
		end
	end
	build("x87", nil)
	V._ffbModel = function(model, mu) build(model or "x87", mu) end
	V.ffbStatsOriginal = function() stats() end
	V.ffbFrameOriginal = function() frameBlock() end

	-- integration points (NR2003CupDriver.tickInputs @00553a64 / NR2003CupFrame after the lifted 00554520)
	function V._ffbTick() stats() end
	function V._ffbFrameEnd()
		last.block = false
		if r8(SIMULATED) == 0 then return end                     -- 0055452a: whole frame end gated by 00551880
		frameBlock()
	end

	---------------------------------------------------------------------------------------------------------
	-- options (messages 8..11; controls.cfg integers, front-end ranges 0..100 / 0..100 / 0..250)
	---------------------------------------------------------------------------------------------------------
	local options = nil
	local function applyOptions()
		if options == nil then return end
		local o = options
		if o.enabled ~= nil then w8(FF_ON, o.enabled and 1 or 0) end                          -- 00550270
		if o.strength ~= nil then wf32(STRENGTH, math.clamp(floor(o.strength), 0, 100)) end  -- 00550290
		if o.damping ~= nil then wf32(DAMPING, math.clamp(floor(o.damping), 0, 100)) end     -- 005502d0
		if o.latency ~= nil then wf32(LATENCY, math.clamp(floor(o.latency), 0, 250)) end     -- 005502b0
	end
	-- opts: enabled (bool, FF on/off), strength (0..100, image 80), damping (0..100, image 0), latency (ms 0..250,
	-- image 0); nil = keep the image value (no controls.cfg). Values survive reset(). The FF axis is set up again at
	-- once (the front end re-selects the active controls when it returns to the car: 00550070(0)).
	function V.setForceFeedbackOptions(opts)
		opts = opts or {}
		local function range(name, hi)
			local v = opts[name]
			if v ~= nil and not (type(v) == "number" and v &gt;= 0 and v &lt;= hi) then
				error(string.format("NR2003 Stage 13: %s must be a number 0..%d (got %s)", name, hi, tostring(v)))
			end
		end
		range("strength", 100); range("damping", 100); range("latency", 250)
		if opts.enabled ~= nil and type(opts.enabled) ~= "boolean" then error("NR2003 Stage 13: enabled must be a boolean") end
		options = {enabled = opts.enabled, strength = opts.strength, damping = opts.damping, latency = opts.latency}
		applyOptions()
		controls(r8(SUSPENDED))
		return V.forceFeedbackOptions()
	end
	function V.clearForceFeedbackOptions() options = nil end
	function V.forceFeedbackOptions()
		return {enabled = r8(FF_ON) ~= 0, strength = rf32(STRENGTH), damping = rf32(DAMPING), latency = rf32(LATENCY)}
	end
	-- dev: {capable = bool (an FF device is bound to the steering axis: 005d0820), acquire = bool (005d0840 result,
	-- default true), sink = function(axis, force, magnitude) called on every constant-force update}
	function V.setForceFeedbackDevice(dev)
		dev = dev or {}
		local was = device.capable
		device = {capable = dev.capable == true, acquire = dev.acquire ~= false}
		if dev.sink ~= nil then sink = dev.sink end
		if was and not device.capable and r8(ACQUIRED) ~= 0 then  -- device removed: DirectInput loses the effect
			effect = false
		end
		controls(r8(SUSPENDED))
	end
	function V.setForceFeedbackSink(fn) sink = fn end
	-- ORIGINAL 00550070: true = player controls suspended (005524f0 not-driven branch, FFB off, force zeroed)
	function V.setControlsSuspended(flag) controls(flag and 1 or 0) end
	function V.controlsSuspended() return r8(SUSPENDED) ~= 0 end
	-- re-select the active controls (fgmsgSelectActiveControls: 00550070(0) on the current binding)
	function V.selectActiveControls() controls(0) end
	V._ffbControls = controls
	V._ffbDeviceForce = deviceForce
	V._ffbRelease = release
	V._ffbTrace = function(t) trace = t end
	-- TEST ONLY: raw host device state (capable, acquire result, effect acquired = f5d414) without the 00550070 that
	-- setForceFeedbackDevice runs
	V._ffbHostState = function(capable, acquire, eff)
		if capable ~= nil then device = {capable = capable, acquire = acquire ~= false} end
		if eff ~= nil then effect = eff end
		return device.capable, device.acquire, effect
	end

	---------------------------------------------------------------------------------------------------------
	-- lifecycle
	---------------------------------------------------------------------------------------------------------
	-- 00550a50 @00550b07 (car placed on the track): the options are simulation cells that the game keeps across car
	-- placements; the port's reset reloads the image, so they are re-applied first
	function V._ffbEnterTrack()
		applyOptions()
		controls(0)
	end
	local baseReset = V.reset
	function V.reset()
		effect = false                 -- the reloaded image has no acquired effect (bf6ebb 0): host side released
		configuredKind = nil
		last.force, last.magnitude, last.block = 0, 0, false
		baseReset()
		applyOptions()
	end
	-- checkpoint / restore: the host device state goes with the memory (bf6ebb / bf6ebc are in the memory; the effect
	-- acquired by the device layer and the binding type of the last 0054fed0 are host-side)
	local baseCheckpoint, baseRestore = V.checkpoint, V.restore
	function V.checkpoint()
		local c = baseCheckpoint()
		c.ffb = {effect = effect, configuredKind = configuredKind, force = last.force, magnitude = last.magnitude,
			axis = last.axis, block = last.block}
		return c
	end
	function V.restore(c)
		baseRestore(c)
		local h = c.ffb
		if h then
			effect, configuredKind = h.effect, h.configuredKind
			last.force, last.magnitude, last.axis, last.block = h.force, h.magnitude, h.axis, h.block
		end
	end
	if V.endSession then
		local baseEnd = V.endSession
		function V.endSession()
			release()                  -- 00550680 (session end)
			baseEnd()
		end
	end
	-- device layer (ADAPTER): the Roblox host re-binds controls 7 / 8 every frame (NR2003CupSteering.hostDevices); a change
	-- of the control-7 binding type (keys &lt;-&gt; analog axis) is what the game's controls menu + fgmsgSelectActiveControls
	-- produce, followed by 00550070(0). Run only while FF is on or acquired (otherwise 0054fed0 changes nothing
	-- observable but bf6ebc / 74c95c).
	if V._steerDevices then
		local baseDevices = V._steerDevices
		function V._steerDevices(c)
			baseDevices(c)
			if configuredKind ~= ri32(REC7 + 0x10) and (r8(FF_ON) ~= 0 or r8(ACQUIRED) ~= 0) then
				controls(0)
			end
		end
	end

	---------------------------------------------------------------------------------------------------------
	-- observation (original cells)
	---------------------------------------------------------------------------------------------------------
	function V.forceFeedbackState(out)
		out = out or {}
		out.enabled, out.acquired, out.suspended = r8(FF_ON) ~= 0, r8(ACQUIRED) ~= 0, r8(SUSPENDED) ~= 0
		out.effect = effect
		out.axis, out.directionSign = r32(AXIS), ri32(DIRSIGN)
		out.force, out.magnitude = last.force, last.magnitude     -- last constant force sent to the device
		out.blockRan = last.block                                  -- FFB block evaluated in the last frame end
		out.frames, out.calls = last.frames, last.calls
		out.slip, out.moment, out.fy, out.load = rf32(SLIP), rf32(MOMENT), rf32(FY), rf32(LOAD)
		out.previousSlip, out.filtered = rf32(PREV), rf32(FILT)
		out.strength, out.damping, out.latency = rf32(STRENGTH), rf32(DAMPING), rf32(LATENCY)
		out.setupRatio, out.airspeed = rf32(SETUP_RATIO), rf32(AIRSPEED)
		return out
	end

	-- Stage 14 checkpoint: ffb
	V._registerCheckpoint("ffb", function() return {device=device, effect=effect, kind=configuredKind, options=options, last=last} end, function(h)
		device, effect, configuredKind, options = h.device, h.effect, h.kind, h.options
		for k,v in pairs(h.last) do last[k]=v end
	end)
	return V
end
]=]
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_Source9"><Properties><string name="Name">Source9</string><ProtectedString name="Source">return [=[
--!native
--!optimize 2
-- NR2003 Cup driver layer + tick sequencing (Stage 7). Installs V.drive / V.componentPose on a
-- runtime created by NR2003CupCore. Every float32 store goes through V.wf32d (IEEE single,
-- rounding toward -inf: NR2003 bg task FPU CW 0x077f, 0055cef0 -&gt; 00567704(1,3)).
--
-- Per 36 Hz task frame (005b2190 -&gt; 00551e80 tail, player car):
--   pedals/axes -&gt; bf6390/bf6eac/bf6eb0, throttle^2/brake^2 targets, per-tick ramps (/N),
--   shift request (00552450/00552480).  Steering (Stage 12, NR2003CupSteering): ORIGINAL 00552720
--   (005524f0 -&gt; bf63c8) and the 00551e80 tail (linearity, x pi, 00554fb0 ratio -&gt; road-wheel target);
--   steering mode "provisional" keeps the Stage 6-11 host road-wheel target for the regression suites.
-- Per 288 Hz tick (005b2190 loop body):
--   005539c0 input composition (ramps, toe c086b0/c086b4, brake/clutch ramps, lifted 00553d70
--   shift FSM + auto clutch 005542f0, gear, rev limiter engine+0x438 with 006f5a3c hysteresis),
--   005b2b90 predictor+solve, 005b2cb0 export, tires (00578da0 -&gt; 0055e1e0 x4), 005b2bd0 forces,
--   005b2be0 corrector+solve, export, tires (00578de0), forces, 005b2c00 commit.
-- Per frame end (00554520): V._frameEnd. Stages 6-10: 0051aac0 cut-timer subset (core); Stage 11:
-- the ORIGINAL 00554520 + 00549c40 lifted (NR2003CupFrame, "frozen" runtime mode = the subset).
-- Stage 8 (brake input chain, per frame, 005524f0 player branch):
--   raw brake control (0057af30 control table) -&gt; 00552d00 axis limiter -&gt; 00553080 pedal
--   processing (auto-hold below 0.8 m/s, key ramp, braking help 00550130) -&gt; bf6eac; the
--   00551e80 tail squares it and ramps it per tick into bf636c -&gt; 005b2b90 -&gt; brake cell e84480,
--   which the ORIGINAL generated force code (005610b0 x4 + 00561040) turns into wheel torque.
-- Stage 9: frame start calls V._aeroFrame (005637e0 subset, NR2003CupAero) before frameStart.
-- Stage 13: tickInputs runs the ORIGINAL 00554d30 (V._ffbTick, NR2003CupFFB) at its slot @00553a64; frameStart takes
-- the 005524f0 not-driven branch while bf6eb8 (player controls suspended, 00550070) is set.
-- assist_implementation: NR2003CupAutomatic supplies ORIGINAL 005536b0 at the frame-tail slot.
-- Not ported (documented): replay/telemetry recording, H-pattern device input (bf6f0c 1/2),
-- ignition states driven by 005524f0/0057af40(0x19),
-- controls.originalPedals enables recovered throttle/clutch device processing
-- (00552df0 / 005534f0). Absent keeps the processed-pedal contract of older fixtures.
return function(V)
	local rf32, r32, ri32, w32, r8, w8 = V.rf32, V.r32, V.ri32, V.w32, V.r8, V.w8
	local wf32d, fd, rf64, wf64 = V.wf32d, V.fd, V.rf64, V.wf64
	local wf32 = V.wf32
	local callx, tires, export, frameEnd, popF = V._callx, V._tires, V._export, V._frameEnd, V._popF
	local M, BASE = V.memory(), V.base
	local TPF, ENGINE, ROOT, INPUTS = V.TPF, V.ENGINE, V.ROOT, V.INPUTS
	local abs, sqrt, atan2 = math.abs, math.sqrt, math.atan2
	-- exact-zero sums signed as under round-toward-negative (CW 0x077f; IEEE 754: x + (-x) = -0). Stage 12 change
	-- record C1 (STAGE12_RESULT.md): used by the driver-layer sums of 005539c0 and of the 00551e80 tail
	local function zadd(x, y)
		local r = x + y
		if r == 0 and not (x == 0 and y == 0 and 1 / x &gt; 0 and 1 / y &gt; 0) then return -0.0 end
		return r
	end
	local function zsub(x, y) return zadd(x, -y) end
	local function plainSub(x, y) return x - y end

	---------------------------------------------------------------------------------------------
	-- Stage 8: ORIGINAL brake input chain (hand port of x87 code; float32 stores round toward
	-- -inf like every store of the simulation task, intermediates in double).
	---------------------------------------------------------------------------------------------
	local CTRL_RAW, CTRL_TYPE = 0xd35b18, 0xd37cc8 -- 0057af30: f32 [d35b18+10n]; 0057af60: i32 [d37cc8+29n]
	local BRAKE_CTL, THROTTLE_CTL = 6, 5
	-- .rdata constants read from the image (same cells the original reads)
	local K_ONE, K_ZERO = rf32(0x6e97d8), rf32(0x6ea454) -- 1.0, 0.0
	local K_AXIS_LOW, K_AXIS_FAST = rf32(0x6ee390), 0x74c99c -- 0.025, release factor cell (2.5)
	local K_HOLD_SPEED, K_THROTTLE_ON = rf32(0x6efb28), rf32(0x6e9824) -- 0.8 m/s, 0.2
	local K_FLAT, K_HOLD = rf32(0x6f5a30), rf32(0x6efac8) -- 0.0087266 rad, 0.98
	local K_RAMP_UP = rf32(0x6f53c0) -- 1/12 per frame
	local K_SLOPE = rf64(0x6f5a28) -- 0.363636... (qword)
	local K_HALF, K_REL_FAST, K_REL_SLOW = rf32(0x6ea44c), rf32(0x6f4614), rf32(0x6f5a24) -- 0.5, 0.125, 1/24
	local K_HELP_SPEED, K_HELP_SLIP = rf32(0x6ea68c), rf32(0x6efbf0) -- 11 m/s, 12.5
	local K_1_5, K_R, K_F = rf32(0x6ea494), rf32(0x6f5a20), rf32(0x6f5a18) -- 1.5, -4/9, -20/33
	local K_2_1, K_R2, K_FLOOR, K_LOWHELP = rf32(0x6f5a1c), rf32(0x6f5a14), rf32(0x6ef640), rf32(0x6ed020) -- 2.1, 2/3, 0.3, 0.9
	local K_02 = 0.20000000298023224 -- literal 0x3e4ccccd (00553080 @0055323f)
	local K_PI = rf32(0x6f4a4c) -- 3.14159274 (005f74c0)
	local K_GIMBAL = rf64(0x6ef4c8) -- 0.01 (qword, 005f74c0)

	-- 00552d00(n): axis value with per-axis slew limit (controls 5..8). Returns the x87 value.
	local function axis(n)
		local raw = rf32(CTRL_RAW + 10 * n) -- 0057af30 (FLD dword; the FST copy is the same float)
		local ecx, edx
		if n == 5 then ecx, edx = 2, 1 elseif n == 6 then ecx, edx = 3, 2
		elseif n == 7 then ecx, edx = 0, 0 elseif n == 8 then ecx, edx = 1, 0 else return raw end
		local rate = rf32(0x74c990 + 4 * edx)
		if not (rate &lt; K_ONE or rate ~= rate) then return raw end -- FCOMP 1.0; AND 0x100; JZ ret
		if not (raw &gt;= K_AXIS_LOW or raw ~= raw) then rate = rate * rf32(K_AXIS_FAST) end -- TEST AH,5; JP
		local prev = rf32(0xbf639c + 4 * ecx)
		local v
		if raw &lt;= prev or raw ~= raw or prev ~= prev then -- AND 0x4100; JNZ
			v = zsub(prev, rate) -- FSUBR (Stage 12 C2: an exact-zero step is -0 under RC-down, stored 80000000)
			if not (v &gt;= raw or v ~= v or raw ~= raw) then v = raw end -- TEST AH,5; JP keep
		else
			v = rate + prev -- FADD
			if not (v &lt;= raw or v ~= v or raw ~= raw) then v = raw end -- AND 0x4100; JNZ keep
		end
		wf32d(0xbf639c + 4 * ecx, v) -- FST dword (state), ST0 keeps the x87 value
		if edx == 0 then -- steering axes only: FMUL 1.570796326793946 (9.5e-13 below pi/2); FSIN
			-- Stage 12 C2: for a state of exactly 1.0 the x87 FSIN under RC-down returns 1 - 2^-64 (the true value is
			-- 1 - 4.5e-25; hardware-verified, recovery/stage12/evidence/reports/verify-input.md), stored as 3f7fffff; double
			-- sin gives 1.0. 1 - 2^-53 reproduces every stored result (f32 store, a8 - a7 with the other control).
			-- Every other f32 state gives the same stored f32 as the x87 (exhaustive scan).
			if v == 1 then v = 1 - 2 ^ -53 else v = math.sin(v * rf64(0x6f5a00)) end
		end
		return v
	end

	-- 00554f50: vehicle speed |v| from the exported state block, cached in bf6f44 (float32).
	-- The original recomputes when the timer-interrupt count changes; the state block does not
	-- change inside a frame start, so recomputing on every call returns the same value. Preserve the ORIGINAL
	-- getIntCount stamp as well: the track-world regression compares the full written-memory footprint.
	local function speed()
		local vz, vy, vx = rf32(0xbf6d54), rf32(0xbf6d4c), rf32(0xbf6d44)
		wf32d(0xbf6f44, sqrt((vz * vz + vy * vy) + vx * vx))
		w32(0x74c9ac, r32(0x7559c4))
		return rf32(0xbf6f44)
	end

	-- 005f7570 = 005f6e40 (quaternion xyzw -&gt; row-major 3x3, float32 stores) + 005f74c0 (angles).
	-- Returns the three float32 outputs (out1, out2, out3) in the original order.
	local function attitude(q)
		local x, y, z, w = rf32(q), rf32(q + 4), rf32(q + 8), rf32(q + 12)
		local w2 = w + w
		local wx, wy, wz = w2 * x, w2 * y, w2 * z
		local ww = fd(w2 * w)
		local x2 = x + x
		local e0, e4 = fd(x2 * y), fd(x2 * z)
		local y2 = y + y
		local e8, ec = fd(y2 * z), fd(y2 * y)
		local e10 = fd((z * z) + (z * z))
		local m0 = fd((x2 * x + ww) - K_ONE)
		local m1 = fd(e0 - wz)
		local m2 = fd(e4 + wy)
		local m3 = fd(e0 + wz)
		local m4 = fd((ec + ww) - K_ONE)
		local m5 = fd(e8 - wx)
		local m6 = fd(e4 - wy)
		local m7 = fd(e8 + wx); local _ = m7
		local m8 = fd((e10 + ww) - K_ONE); local _2 = m8
		local a1 = fd(atan2(m3, m0))
		local c = sqrt(m0 * m0 + m3 * m3)
		local a2 = fd(atan2(-m6, c))
		local a3
		if c &gt;= K_GIMBAL or c ~= c then
			local ic = K_ONE / c
			local nA, B = -(ic * m3), ic * m0
			local Y = -(B * m5 + nA * m2)
			local X = B * m4 + nA * m1
			a3 = fd(atan2(Y, X))
		else
			local r = a1 - atan2(m5, m2)
			a3 = fd(r)
			if not (m6 &lt;= K_ZERO or m6 ~= m6) then a3 = fd(K_PI - r) end
		end
		return a1, a2, a3
	end

	-- 00550130: braking help option (bf6f04), disabled per car by flag 0x20000000 at
	-- 0055a680()+0x4c (inServer() = false offline; simulation runs inBackground()).
	local function brakingHelp()
		if bit32.band(r32(0xc0692a + 0x4c), 0x20000000) ~= 0 then return false end
		return r8(0xbf6f04) ~= 0
	end

	-- 00553080: processed brake pedal (returned as the x87 value; 005524f0 stores it to bf6eac)
	local function pedal()
		-- 005c2d20([c08194]) is the online-session state; offline host -&gt; 0 (ADAPTER), so the
		-- driver kind comes from 005672e0 -&gt; 0055a730 = [c067e0] (1 -&gt; brake fully applied)
		local r
		if ri32(0xc067e0) == 1 then r = K_ONE else r = fd(axis(BRAKE_CTL)) end
		local spd = speed()
		local hold = false
		if not (spd &gt;= K_HOLD_SPEED or spd ~= spd) then
			if rf32(0xbf6390) &lt; K_THROTTLE_ON then hold = true
			elseif ri32(0x74c97c) == 1 then hold = true end -- neutral
		end
		if hold then
			local _, a2, a3 = attitude(0xbf6d58)
			local pa = abs(a2)
			if not (pa &gt;= K_FLAT or pa ~= pa) then
				if r &gt;= K_HOLD or r ~= r then return r end
				local v = rf32(0xbf6eac) + K_RAMP_UP
				if v &lt; K_HOLD or v == K_HOLD then return v end
				return K_HOLD
			end
			local h
			local pr = abs(a3)
			if pr &lt;= K_ZERO or pr ~= pr then h = K_02
			else
				local q = pa * K_SLOPE / pr
				if not (q &lt;= K_ONE or q ~= q) then q = K_ONE end
				h = fd((K_ONE - q) * K_HOLD)
				if not (h &gt;= K_THROTTLE_ON or h ~= h) then h = K_02 end
			end
			if not (r &gt;= h or r ~= r or h ~= h) then
				local v = rf32(0xbf6eac) + K_RAMP_UP
				if v &lt; h or v == h then return v end
				return h
			end
		end
		-- 0055327b: button/key binding (0057af60(6)) -&gt; per-frame ramp toward the key state
		if ri32(CTRL_TYPE + 29 * BRAKE_CTL) ~= 1 then
			local t = fd(axis(THROTTLE_CTL))
			local p = rf32(0xbf6eac)
			local v
			if not (p &gt;= r or p ~= p or r ~= r) then v = p + K_RAMP_UP
			elseif p &lt;= r or p ~= p or r ~= r then v = r
			elseif t &gt;= K_HALF or t ~= t then v = p - K_REL_FAST
			else v = p - K_REL_SLOW end
			if v &gt;= K_ZERO or v ~= v then
				if not (v &lt;= K_ONE or v ~= v) then v = K_ONE end
			else v = K_ZERO end
			r = fd(v)
		end
		-- 0055332c: braking help (driving aid) while the pedal is rising
		if brakingHelp() then
			local p = rf32(0xbf6eac)
			if p &gt; r or p ~= p or r ~= r then return r end
			local s = speed()
			if s &lt;= K_HELP_SPEED or s ~= s then return r * K_LOWHELP end
			local s0, s1, s2, s3 = rf32(0xbf3cd4), rf32(0xbf470d), rf32(0xbf5146), rf32(0xbf5b7f)
			local A, B = s0, s2
			if not (s1 &lt;= A or s1 ~= s1 or A ~= A) then A = s1 end
			if not (s3 &lt;= B or s3 ~= s3 or B ~= B) then B = s3 end
			local mn = s0
			if not (s1 &gt;= mn or s1 ~= s1 or mn ~= mn) and s1 ~= K_ZERO then mn = s1 end
			if not (s2 &gt;= mn or s2 ~= s2 or mn ~= mn) and s2 ~= K_ZERO then mn = s2 end
			if not (s3 &gt;= mn or s3 ~= s3 or mn ~= mn) and s3 ~= K_ZERO then mn = s3 end
			if not (mn &lt;= K_HELP_SLIP or mn ~= mn) then return r end
			local x = (B - K_1_5) * K_R
			local y = fd((A - K_2_1) * K_F)
			if not (x &lt; y) then x = y end
			if not (x &lt; K_ZERO or x ~= x) then x = (K_1_5 - B) * K_R2 end
			x = x * K_REL_FAST + rf32(0xbf6eac)
			if not (x &gt;= K_FLOOR or x ~= x) then x = K_FLOOR end
			if x &lt;= r or x ~= x or r ~= r then return x end
			return r
		end
		return r
	end
	V.brakePedalOriginal = pedal -- exposed for the bit-level tests (tests/stage8)
	V.attitudeOriginal = attitude
	V.axisOriginal = axis

	-- 00550180: throttle help is independent of the keyboard pedal ramp.
	local function throttleHelp()
		if bit32.band(r32(0xc0692a + 0x4c), 0x20000000) ~= 0 then return false end
		return r8(0xbf6f05) ~= 0
	end
	-- 00552df0. Explicit fd() calls correspond to the original local float stores.
	-- Even with traction control OFF a digital binding rises by 0.1/frame and
	-- falls by 0.05/frame (0.15 while braking); analog pedals keep their axis value.
	local function throttlePedal()
		local value = fd(axis(THROTTLE_CTL))
		local previous = rf32(0xbf6390)
		if ri32(CTRL_TYPE + 29 * THROTTLE_CTL) == 1 then
			w8(0xbf6eba, 0)
		else
			w8(0xbf6eba, value &gt; K_HALF and 1 or 0)
			local brake = fd(axis(BRAKE_CTL))
			if previous &lt; value then value = previous + rf32(0x6ea4cc)
			elseif previous &gt; value then
				value = previous - (brake &lt; K_HALF and rf32(0x6ea508) or rf32(0x6ee4c4))
			else value = previous end
			if value &lt; K_ZERO then value = K_ZERO elseif value &gt; K_ONE then value = K_ONE end
			value = fd(value)
		end
		if throttleHelp() and ri32(0x74c97c) ~= 1 and previous &lt;= value then
			local slip = math.max(abs(rf32(0xbf513e)), abs(rf32(0xbf5b77)))
			local low, high = rf32(0x6f598c), rf32(0x6f5988)
			local velocity = math.max(speed(), rf32(0x6ea4a4))
			local candidate
			if velocity &lt; low then candidate = previous + K_THROTTLE_ON
			else
				if velocity &lt; high then slip = fd((velocity - low) / (high - low) * slip) end
				local limit = math.max((high - speed()) / (high - low), K_ZERO)
				limit = limit * rf32(0x6f5a10) + rf32(0x6f5a0c)
				local fraction
				if slip &lt;= limit then fraction = (limit - slip) / limit
				else fraction = -(slip - limit) / (rf32(0x6f5a08) - limit) end
				candidate = math.max(fraction * rf32(0x6ee398) + previous, K_FLOOR)
			end
			if candidate &lt;= value then return candidate end
		end
		return value
	end
	-- 005534f0: manual-transmission low-speed gate, then 1 - raw clutch control 4.
	local function clutchPedal()
		if ri32(0x74c974) ~= 0 and abs(fd(rf32(0xbf6d88) * rf32(0x6f5a50))) &lt; rf32(0x6ea478)
			and rf32(0xbf6390) &lt; K_THROTTLE_ON then return K_ZERO end
		return zsub(K_ONE, rf32(CTRL_RAW + 10 * 4))
	end
	V.throttlePedalOriginal = throttlePedal
	V.clutchPedalOriginal = clutchPedal

	-- 005524f0 'car not driven' branch (another car / no driver): pedal held at 1.0
	local function notDriven()
		for _, a in ipairs({0xbf63c8, 0xbf6f14, 0x74c98c, 0xbf6388, 0xbf6e84, 0xbf63bc, 0xbf638c, 0xbf6390, 0xbf6eb0}) do w32(a, 0) end
		w32(0xbf6eac, 0x3f800000)
		w8(0xbf6e20, 0); w8(0xbf6e21, 0); w8(0xbf6e22, 0)
	end

	-- frame start: 005524f0 (driver devices) + 00551e80 tail for the player car.
	-- controls: throttle pedal 0..1, clutch = engagement 0..1 (1 = pedal up), shiftUp/shiftDown =
	-- sequential shift keys. Steering (Stage 12): steerLeft/steerRight (controls 7/8, 0..1) + steerDigital,
	-- or steerAxis (-1..1, + right); steer = road-wheel target (rad, + = left) only in the steering mode
	-- "provisional" (Stage 6-11 contract, regression suites).
	-- Brake (Stage 8): brakeControl = raw brake control value 0..1 of the input device (keyboard
	-- 0/1 or pedal axis), brakeDigital = key/button binding (default true; false = analog axis),
	-- throttleControl/throttleDigital = raw throttle control (key release-rate choice in 00553080).
	-- Without brakeControl, controls.brake is injected directly as the processed pedal bf6eac
	-- (Stage 6/7 contract, kept for regression fixtures). driver = false -&gt; 005524f0 'not driven'.
	local function frameStart(c)
		local N = ri32(0xbf6e9c)
		-- Stage 13: 005524f0 @00552549 also takes the not-driven branch while the player controls are suspended
		-- (bf6eb8, written by the ORIGINAL 00550070: NR2003CupFFB.setControlsSuspended / car placement)
		if c.driver == false or r8(0xbf6eb8) ~= 0 then
			notDriven()
		else
			if c.brakeControl ~= nil then
				local bc = math.clamp(tonumber(c.brakeControl) or 0, 0, 1)
				wf32(CTRL_RAW + 10 * BRAKE_CTL, bc)
				w32(CTRL_TYPE + 29 * BRAKE_CTL, c.brakeDigital == false and 1 or 0)
				local tc = c.throttleControl
				if tc == nil then tc = c.throttle or 0 end
				wf32(CTRL_RAW + 10 * THROTTLE_CTL, math.clamp(tonumber(tc) or 0, 0, 1))
				w32(CTRL_TYPE + 29 * THROTTLE_CTL, c.throttleDigital == false and 1 or 0)
				if c.originalPedals then
					wf32(CTRL_RAW + 10 * 4, K_ONE - math.clamp(c.clutch or 0, 0, 1))
				end
				if r8(0xbf6eb9) ~= 0 then -- 005524f0: car held (bf6eb9)
					w32(0xbf6eac, 0x3f800000); w32(0xbf6eb0, 0)
				else
					wf32d(0xbf6eac, pedal()) -- ORIGINAL 00553080 (reads the previous frame's bf6390)
					wf32d(0xbf6eb0, c.originalPedals and clutchPedal() or (c.clutch or 0))
				end
			else
				wf32d(0xbf6eac, c.brake or 0)
				wf32d(0xbf6eb0, c.clutch or 0)
			end
			-- Stage 12: bf63c8 = ORIGINAL 00552720 (steering devices), NR2003CupSteering
			if V._steerDevices then V._steerDevices(c) end
			wf32d(0xbf6390, c.originalPedals and throttlePedal() or (c.throttle or 0))
		end
		for w = 0, 3 do -- per-frame tire accumulators cleared by 00551e80 (bf3ccc.., bf4705.., ...)
			local t = 0xbf3a20 + w * 0xa39
			w32(t + 0x2ac, 0); w32(t + 0x2b0, 0); w32(t + 0x2b4, 0); w32(t + 0x2b8, 0)
			w32(t + 0x2d0, 0); w32(t + 0x2d4, 0); w32(t + 0x2bc, 0); w32(t + 0x2c0, 0)
		end
		-- Stage 12: road-wheel target of the ORIGINAL 00551e80 tail (linearity, x pi, / 00554fb0 ratio), or the
		-- Stage 6-11 PROVISIONAL host target in the steering mode "provisional" (regression suites only)
		local target = V._steerTail and V._steerTail(c)
		local provisional = target == nil
		if provisional then target = c.steer or 0 end
		wf32d(0xbf63b8, target)
		w32(0xbf6e38, r32(0xbf6eb0))
		w32(0xbf63c0, r32(0xbf6e80)); w32(0xbf636c, r32(0xbf6e64))
		w32(0xbf6ea4, r32(0xbf6e60)); w32(0xbf6e14, r32(0xbf6e68))
		local thr, brk = rf32(0xbf6390), rf32(0xbf6eac)
		wf32d(0xbf6e30, thr * thr); wf32d(0xbf6e34, brk * brk)
		-- ramps (/N): the original tail signs exact-zero differences under RC-down (x - x = -0); the provisional
		-- mode keeps the Stage 6-11 arithmetic of its golden data (Python hand port of the tail)
		local sub = provisional and plainSub or zsub
		wf32d(0xbf6e88, sub(target, rf32(0xbf6e80)) / N)
		wf32d(0xbf6394, sub(rf32(0xbf6e30), rf32(0xbf6e60)) / N)
		wf32d(0xbf6358, sub(rf32(0xbf6e34), rf32(0xbf6e64)) / N)
		local cl = sub(rf32(0xbf6eb0), rf32(0xbf6e68))
		buffer.copy(M, 0xbf6e58 - BASE, M, 0xbf6e28 - BASE, 36) -- rep movsd bf6e28 -&gt; bf6e58 (9 dwords)
		wf32d(0xbf6e50, cl / N)
		wf32d(0xbf6e80, target)
		-- sequential shift request (bf6f0c == 0, transmission mode 0074c974 ~= 0); the 'not driven'
		-- branch of 005524f0 clears the shift keys (bf6e20/21/22)
		-- Original 00551e80: automatic selection precedes the manual-key branch.
		local driven=c.driver~=false and r8(0xbf6eb8)==0
		if ri32(0xbf6f0c) ~= 2 and ri32(0xbf63cc) == 0 and ri32(0x74c974) == 0 and V.automaticShiftOriginal then
			w8(0xbf6e20,driven and c.shiftUp and 1 or 0)
			w8(0xbf6e21,driven and c.shiftDown and 1 or 0)
			V.automaticShiftOriginal()
		elseif driven and ri32(0xbf6f0c) ~= 2 and ri32(0xbf63cc) == 0 and ri32(0x74c974) ~= 0 and ri32(0xbf6f0c) == 0 then
			local d = (c.shiftUp and 1 or 0) - (c.shiftDown and 1 or 0)
			local st = ri32(0xbf6ea0)
			if d ~= 0 and (st == 0 or st == 3 or st == 4) then
				w32(0xbf63cc, d &gt; 0 and 1 or 5); w32(0xbf6e98, 0)
			end
		end
	end

	-- 005539c0 input composition (player car; replay/telemetry recording not ported)
	-- Stage 12 (scoped correction, STAGE12_RESULT.md change record C1): the steering / pedal composition sums
	-- (@00553a40..00553ab5) sign exact-zero sums as the x87 under RC-down; until Stage 11 they returned
	-- +0 where the original stores -0 (e.g. +0 + -0 at rest). Only the sign of a zero changes.
	local function tickInputs()
		wf64(0xbf6ef8, rf64(0xbf6ef8) + rf32(0x74fd74))
		wf32d(0xbf6ea4, zadd(rf32(0xbf6394), rf32(0xbf6ea4)))
		wf32d(0xbf63c0, zadd(rf32(0xbf6e88), rf32(0xbf63c0)))
		-- Stage 13 (@00553a64): ORIGINAL 00554d30 front tyre statistics for the force feedback (NR2003CupFFB)
		local ffb = V._ffbTick
		if ffb then ffb() end
		wf32d(0xbf6360, zadd(rf32(0xbf63c0), -rf32(0xc086b0)))
		w32(0xbf6368, r32(0xbf6ea4))
		wf32d(0xbf6364, zadd(rf32(0xc086b4), rf32(0xbf63c0)))
		wf32d(0xbf636c, zadd(rf32(0xbf636c), rf32(0xbf6358)))
		local c = zadd(rf32(0xbf6e50), rf32(0xbf6e14))
		wf32d(0xbf6e14, c); wf32d(0xbf6370, c)
		callx(0x553d70) -- lifted original: shift FSM, throttle blip/cut, auto clutch (005542f0)
		wf32d(0xbf6374, ri32(0x74c97c))
		-- rev limiter (005539c0): engine+0x438 (Cup 9300 rpm), band = max * 006f5a3c
		local maxr = rf32(ENGINE + 0x438)
		callx(0x554f10) -- lifted original rpm (state[34] * 9.5493, clamp 300..32000)
		local rpm = popF()
		local rpm32 = fd(rpm)
		local band = fd(maxr * rf32(0x6f5a3c))
		if maxr &lt; rpm or ((maxr - band) &lt; rpm32 and r8(0xbf6f3c) ~= 0) then
			w32(0xbf6368, 0); w8(0xbf6f3c, 1)
		elseif not ((maxr - band) &lt; rpm32) then
			w8(0xbf6f3c, 0)
		end
	end

	-- one 288 Hz tick. contacts: 4 planes or function(phase) -&gt; 4 planes (see core tires()).
	-- Stage 9: the per-frame car update 005637e0 (aero factors, airspeed, drafting) runs in
	-- 0055bfd0 before 005b2190 starts the frame; V._aeroFrame is installed by NR2003CupAero and
	-- does nothing until a session is started (post-build state of Stages 6-8).
	-- Stage 11 (integration point): the task loop increments getBGCount before the frame
	-- (V._frameStart11) and the frame end is looked up at run time (V._frameEnd): NR2003CupFrame
	-- replaces the Stage 6-10 subset by the ORIGINAL 00554520 + 00549c40.
	-- the frame start of the 36 Hz task frame (task loop counter, 005637e0 aero subset, 005524f0 + 00551e80);
	-- also called alone by the Stage 12 frame-start snapshot tests
	local function frameStartAll(controls)
		if V._frameStart11 then V._frameStart11() end
		if V._aeroFrame then V._aeroFrame() end
		frameStart(controls)
	end
	V._frameStartOnly = frameStartAll
	-- Watkins Glen port: with the car placed on a loaded track (NR2003CupTrack, V._world.active()) the ORIGINAL world
	-- runs in the 005b2190 order: 005789c0 + 00578a60 at the frame head, 005543f0 + 00551480 after each export
	-- (005539c0 / 005544e0 tails) and the contact passes 00578da0 / 00578de0 (tyres -&gt; 0055e1e0, body spheres -&gt; walls)
	-- in place of the host contact planes. Without a loaded track: unchanged (contacts from the host).
	function V.drive(controls, contacts)
		local W = V._world
		local world = W ~= nil and W.active()
		if V.tick % TPF == 0 then
			if world then W.frame() end
			frameStartAll(controls)
		end
		w32(0xe8441c, V.tick % TPF)
		w8(0xe843fc, 1)
		tickInputs()
		callx(0x5b2b90, ROOT, INPUTS); export()
		if world then W.record(); W.pass(1) else tires(contacts, 1) end
		callx(0x5b2bd0)
		w8(0xe843fc, 0)
		callx(0x5b2be0); export()
		if world then W.record(); W.pass(2) else tires(contacts, 2) end
		callx(0x5b2bd0)
		callx(0x5b2c00)
		V.tick += 1
		if V.tick % TPF == 0 then V._frameEnd() end
	end

	-- component world transforms (vehicle-world axes) through the record pointer fields
	-- (+0x32d position, +0x339 row-major body-&gt;world 3x3) used by the original export/render paths.
	-- Records: 0 chassis, 4 lfhub, 5 lfwheel, 7 rfhub, 8 rfwheel, 9 raxle, 10 lrwheel, 11 rrwheel.
	local POSP, ROTP = {}, {}
	for r = 0, 15 do
		local rec = ROOT + r * 0x505
		POSP[r] = { r32(rec + 0x32d), r32(rec + 0x331), r32(rec + 0x335) }
		local rot = {}
		for k = 0, 8 do rot[k + 1] = r32(rec + 0x339 + 4 * k) end
		ROTP[r] = rot
	end
	function V.componentPose(r, pos, rot)
		pos = pos or table.create(3, 0); rot = rot or table.create(9, 0)
		local p, q = POSP[r], ROTP[r]
		pos[1], pos[2], pos[3] = rf32(p[1]), rf32(p[2]), rf32(p[3])
		for k = 1, 9 do rot[k] = rf32(q[k]) end
		return pos, rot
	end

	-- engine/drivetrain readouts (original cells)
	function V.engineRpm() return rf32(0xbf6d40 + 4 * 34) * 9.549296585513721 end -- state[34] rad/s
	function V.gearIndex() return ri32(0x74c97c) end      -- 0 = R, 1 = N, 2.. = 1st..
	function V.gearCount() return ri32(ENGINE + 0x444) end -- Cup: 4
	function V.revLimiter() return r8(0xbf6f3c) ~= 0 end
	function V.inputs()
		return rf32(0xbf6360), rf32(0xbf6364), rf32(0xbf6368), rf32(0xbf636c), rf32(0xbf6370), rf32(0xbf6374)
	end

	---------------------------------------------------------------------------------------------
	-- Stage 8: brake setup + read-only brake/tire observation (original cells, no side effects)
	---------------------------------------------------------------------------------------------
	local SETUP_BIAS = 0xc055c0 + 4 * 0x28 -- active setup item 0x28 (00557d60(0x28)): front fraction
	local BIAS_DESC = 0x6edf78 -- setup descriptor of item 0x28: int min/max/step/default (50/90/1/74 %)
	local KB = {} -- per-wheel brake torque cells (0055e9b0 -&gt; c0850c..c08518, JIT cells)
	local RR = {} -- per-wheel rolling-resistance torque cells (0054cab0 -&gt; c081f4..c08200)
	local BRAKE_CELL, DRAG0, DRAG2, RATE
	local WHEEL_RECORD = {[0] = 5, 8, 10, 11} -- lfwheel, rfwheel, lrwheel, rrwheel (00561090/1230/1250/1270)
	local OMEGA, INERTIA = {}, {}
	-- the cell addresses are allocated by the car build (emitter cells); Stage 10 rebuilds the car for a
	-- garage setup (NR2003CupGarage), possibly with the generic callback structure whose constant cells
	-- differ: the garage re-binds them after every rebuild (V._bindDriverCells)
	local function bindCells()
		for w = 0, 3 do KB[w] = r32(0xc0850c + 4 * w); RR[w] = r32(0xc081f4 + 4 * w) end
		BRAKE_CELL = r32(0xe84480) -- e84474[3]: core brake input written by 005b2b90 from bf636c
		DRAG0, DRAG2, RATE = r32(0x74e798), r32(0x74e79c), r32(0x74fda0) -- 10, 1e-4, 288 (005610b0)
		for w = 0, 3 do
			local rec = ROOT + WHEEL_RECORD[w] * 0x505
			OMEGA[w] = r32(rec + 0x395)   -- spin joint velocity cell (velocity +0x385, axis 4)
			INERTIA[w] = r32(rec + 0x195) -- articulated spin inertia cell (mass matrix +0x125, [4][4])
		end
	end
	bindCells()
	V._bindDriverCells = bindCells
	local scratch = buffer.create(4)

	-- garage brake bias (front %, integer 50..90) -&gt; setup item 0x28 -&gt; runtime cells, exactly as
	-- the original car build does: toInternal 00423de0 (pct * 0.01f, x87 default CW = nearest),
	-- then 0055e9b0 @0055f314: Kb[LF]=Kb[RF]=fd(maxT*b), Kb[LR]=Kb[RR]=fd(maxT*fd(1-b)),
	-- maxT = car spec +0x1bc via slot +0x582 (Cup 3800 N*m). The original has no in-car brake bias
	-- adjustment (0055e6d0 is unreferenced): apply after reset(), before driving.
	function V.setBrakeBias(percent)
		local lo, hi = ri32(BIAS_DESC + 2), ri32(BIAS_DESC + 6)
		local p = math.clamp(math.floor((tonumber(percent) or ri32(BIAS_DESC + 14)) + 0.5), lo, hi)
		buffer.writef32(scratch, 0, rf32(0x6ea4a4)); local k = buffer.readf32(scratch, 0)
		buffer.writef32(scratch, 0, p * k)
		wf32(SETUP_BIAS, buffer.readf32(scratch, 0))
		local b, maxT = rf32(SETUP_BIAS), rf32(0xc12030 + 0x582)
		local front, rest = fd(maxT * b), fd(K_ONE - b)
		local rear = fd(maxT * rest)
		wf32(KB[0], front); wf32(KB[1], front); wf32(KB[2], rear); wf32(KB[3], rear)
		return p
	end
	function V.brakeBias()
		local b = rf32(SETUP_BIAS)
		return b, math.floor(b * 100 + 0.5), rf32(0xc12030 + 0x582)
	end

	-- brake chain readout: processed pedal (bf6eac), frame target pedal^2 (bf6e34), per-tick ramp
	-- value (bf636c) and the core brake cell (e84480) used by the force code
	function V.brakeState()
		return rf32(0xbf6eac), rf32(0xbf6e34), rf32(0xbf636c), rf32(BRAKE_CELL)
	end

	-- brake temperature of wheel w (K): XOR-obfuscated storage of the tire object (+0x26c ^ +0x274),
	-- evolved per frame by 0054f260 inside 0054d610 (Stage 11: frozen at the build value)
	function V.brakeTemperature(w)
		local t = 0xbf3a20 + w * 0xa39
		buffer.writeu32(scratch, 0, bit32.bxor(r32(r32(t + 0x26c)), r32(r32(t + 0x274))))
		return buffer.readf32(scratch, 0)
	end

	-- per-wheel observation of the last tire + forces pass (w: 0 LF, 1 RF, 2 LR, 3 RR)
	--   torque   : friction/brake torque recorded by the original 0055e450..0055e480 (tire +0x268)
	--   kb       : brake torque per unit core brake input (setup cells)
	--   brakeCap : core brake input * kb (brake share of the 00561040 capacity)
	--   dragCap  : 10 + 1e-4*omega^2 + rolling-resistance torque (rest of the capacity)
	--   omega    : wheel spin rate relative to its hub/axle (rad/s); inertia = articulated Iyy
	--   fx/fy/fz : tire outputs (+0x2d8/+0x2dc/+0x2e0, tire frame), vx: contact longitudinal
	--              velocity (+0x2f0), vslip: tread - ground (+0x2ec), tread: |band speed| (+0x2cc)
	function V.wheelBrake(w, out)
		out = out or {}
		local t = 0xbf3a20 + w * 0xa39
		local core, kb, om = rf32(BRAKE_CELL), rf32(KB[w]), rf32(OMEGA[w])
		out.torque = rf32(t + 0x268); out.kb = kb; out.brakeCap = core * kb
		out.dragCap = rf32(DRAG0) + om * om * rf32(DRAG2) + rf32(RR[w])
		out.omega = om; out.inertia = rf32(INERTIA[w]); out.rate = rf32(RATE)
		out.fx = rf32(t + 0x2d8); out.fy = rf32(t + 0x2dc); out.fz = rf32(t + 0x2e0)
		out.vx = rf32(t + 0x2f0); out.vslip = rf32(t + 0x2ec); out.tread = rf32(t + 0x2cc)
		out.rollingTorque = rf32(RR[w])
		out.temperature = V.brakeTemperature(w)
		-- presentation-only lock indicator: tread speed ~ 0 while the contact still slides
		out.locked = abs(out.vx) &gt; 0.5 and out.tread &lt; 0.05 * abs(out.vx)
		return out
	end
	return V
end
]=]
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX_Source10"><Properties><string name="Name">Source10</string><ProtectedString name="Source">return [=[
-- Original automatic gear selection: 00562f90 initialization, 00553920 predicted RPM, 005536b0 selector.
-- Shift execution remains the existing original 00553d70 FSM. No assist defaults are selected here.
return function(V)
    local rf, ru, ri, wf, wu, r8 = V.rf32, V.r32, V.ri32, V.wf32d, V.w32, V.r8
    local fd = V.fd
    local GARAGE, ACTIVE, FLAGS = 0xC03350, 0xC055C0, 0xC086E0
    local CAR, ENGINE = 0xC12030, V.ENGINE

    -- 00562f90 reads the GARAGE's derived ratios; 00553920 reads the ACTIVE setup.
    function V.initializeAutomaticOriginal()
        local final = rf(GARAGE + 0x6E * 4)
        for gear = 0, 7 do
            local ratio = final * rf(GARAGE + (0x66 + gear) * 4) * rf(0x6F5E20)
            wf(0xC53438 + gear * 4, ratio)
            wf(0xC53418 + gear * 4, ratio == 0 and 0 or 1 / ratio)
        end
        local engineSet = ru(ENGINE + 0x56A)
        wf(0xC08728, rf(engineSet + 0x2C) - rf(0x6ED00C))
        for gear = 0, 7 do
            if gear &lt; 3 then wu(0xC533F8 + gear * 4, 0)
            elseif gear == 3 then wf(0xC53404, rf(0xC08728) * rf(0x6EA470))
            else
                wf(0xC533F8 + gear * 4, rf(0xC53438 + gear * 4) / rf(0xC53434 + gear * 4)
                    * rf(0x74E928 + ri(0xBDBD00) * 4) * rf(0xC08728))
            end
        end
        return true
    end

    -- 0054c1c0 already bound these profiles through the same 0056ed60(spec,wheel) lookup used by
    -- 00553920. Read the identical current-car radius through tyre+0x70: the old runtime image
    -- omitted the otherwise redundant global profile-pointer table at 00734368.
    function V.predictedRPMOriginal(speed, spec, gear)
        assert(spec == ru(CAR + 0x58A), "Automatic RPM requires the current built car specification")
        local left = rf(ru(0xBF3A20 + 2 * 0xA39 + 0x70))
        local right = rf(ru(0xBF3A20 + 3 * 0xA39 + 0x70))
        local radii = fd(right + left) -- 00553969 FSTP dword before the denominator product
        local item = ru(FLAGS + gear * 4) == 0 and (gear + 0x66) or 0x67
        return rf(ACTIVE + item * 4) * rf(ACTIVE + 0x6E * 4) * speed * rf(0x6F4754)
            / (radii * rf(0x6F5A34))
    end
    local function nextGear(gear)
        local top = ri(ENGINE + 0x444) + 1
        local candidate = gear + 1
        while candidate ~= 1 and candidate &lt;= top and ru(FLAGS + candidate * 4) ~= 0 do candidate += 1 end
        return math.min(candidate, top)
    end
    local function previousGear(gear)
        local candidate = gear - 1
        while candidate ~= 1 and candidate &gt;= 0 and ru(FLAGS + candidate * 4) ~= 0 do candidate -= 1 end
        return candidate &lt; 0 and 1 or candidate
    end
    local function request(direction)
        local phase = ri(0xBF6EA0)
        if phase == 0 or phase == 3 or phase == 4 then
            wu(0xBF63CC, direction &gt; 0 and 1 or 5)
            wu(0xBF6E98, 0)
            return direction
        end
        return 0
    end
    local function speed()
        if ru(0x74C9AC) ~= ru(0x7559C4) then
            local z, y, x = rf(0xBF6D54), rf(0xBF6D4C), rf(0xBF6D44)
            wf(0xBF6F44, math.sqrt((z * z + y * y) + x * x))
            wu(0x74C9AC, ru(0x7559C4))
        end
        return rf(0xBF6F44)
    end
    function V.automaticShiftOriginal()
        V._callx(0x554F10)
        local rpm = fd(V._popF()) -- original selector stores this return to a local float
        local gear, gearbox = ri(0x74C97C), ri(0xBF6F0C)
        if gear == 0 then
            if (gearbox == 0 and r8(0xBF6E20) ~= 0)
                or (gearbox == 1 and r8(0xBF6E22) ~= 0 and ri(0xBF6E23) &gt; 0)
                or ru(FLAGS) ~= 0 then return request(1) end
            return 0
        elseif gear == 1 then
            if (gearbox == 0 and r8(0xBF6E21) ~= 0)
                or (gearbox == 1 and r8(0xBF6E22) ~= 0 and ri(0xBF6E23) == 0) then return request(-1) end
            if rf(0xC53400) &lt; rpm and rf(0x6EA470) &lt; rf(0xBF6EA4) then
                if gearbox == 1 then wu(0xBF6E23, 2) end
                return request(1)
            end
            return 0
        end
        if gear == nextGear(1) and rpm &lt; rf(0x6F58F8) and rf(0xBF6EA4) &lt; rf(0x6E9824) and r8(0xBF6EBA) == 0 then
            if gearbox == 1 then wu(0xBF6E23, 1) end
            return request(-1)
        end
        local predicted = V.predictedRPMOriginal(speed(), ru(CAR + 0x58A), gear)
        if rf(0xC08728) * rf(0x6F599C + gear * 4) &lt; predicted then
            if gearbox == 1 then wu(0xBF6E23, gear + 1) end
            return request(1)
        end
        local low = previousGear(gear) == 1 and 0 or rf(0xC533F8 + gear * 4)
        if fd(predicted) &lt;= low then -- 00553878 TEST AH,0x41: downshift includes equality; uses stored RPM
            if gearbox == 1 then wu(0xBF6E23, gear - 1) end
            return request(-1)
        end
        return 0
    end
    return V
end
