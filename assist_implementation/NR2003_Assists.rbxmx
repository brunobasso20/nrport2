--!optimize 2
-- GENERATED by watkinsglen_implementation/recovery/lift/gen_track.py from track_host.luau; do not edit.
-- NR2003CupTrack: the ORIGINAL NR2003 track and collision world, run on the car's core memory by code lifted from
-- NR2003.exe (NR2003CupTrackCode*) over the track image (NR2003CupTrackData*: what the ORIGINAL track load, track build,
-- track.ini loaders and 00573010 track init leave in memory; Unicorn reference recovery/orig_world.py).
--
--   V.loadTrack()          the track image into the reset image and the memory; garage rebuild inputs follow it
--   session start / reset  (NR2003CupFrame applySession11 -&gt; V.enterTrack, wrapped here):
--                          00566e50 world part: 0059fa90 BG car object, 00433cb0 collision geometry (4 tyre spheres +
--                          body spheres, collision object c7e75c), 00578610 world reset, car+0x5ae = world record;
--                          00550a50 subset with 005512f0 placement on the track at its place (@00550aeb, V._place);
--                          00563620 race-order insert
--   per frame / tick       (NR2003CupDriver V.drive, V._world): 005789c0 + 00578a60 at the frame head (broadphase:
--                          track primitives near the car, pairs), after each export 005543f0 (world record + track
--                          query 005f58d0 -&gt; 0051370a) + 00551480 (external force accumulators cleared), contact
--                          passes 00578da0 / 00578de0 (tyre spheres -&gt; 0055e1e0 of the core, body spheres -&gt; walls)
--   Stage 11 frame code    its 005f58d0 calls (00549c40) query the track (ctx.trackPoint of NR2003CupFrame)
-- Host boundary: B_tire (0055e1e0 = the core's lifted tyre contact, same memory), __chkstk / atexit (encrypted CRT:
-- crt_x87.py semantics), rts.dll _memFree (no-op, as the reference), rts.dll RBNodeBase::Remove lifted from rts.dll.
local CODE_PARTS, DATA_PARTS = 6, 9
local TOP = 0x1250000                -- end of the track memory (arena 0x1180000..0x124c000)
local STACK = 0xfbff00              -- track virtual stack top (64 KB)
local HOSTBLK = 0xfc0000            -- host scratch (track queries)
local TRACK_NAME = "Watkins Glen"
-- garage rebuild inputs changed by the track load (offset from the image base -&gt; u32)
local BUILD_INPUTS = {[403932] = 0x3f8f5c29, [420656] = 0x3f4ccccd, [5286640] = 0x3f3222dc, [5289256] = 0x3222dc3f, [5291872] = 0x22dc3f80, [5291876] = 0x00003f32, [5294488] = 0xdc3f8000, [5294492] = 0x003f3222}
-- pit stalls of pit lane 0 (track.ini stall_&lt;n&gt; = dlong dlat yaw; 005410f0 records)
local STALLS = {{341.13, -19.61, -0.0}, {332.57, -19.61, -0.0}, {323.76, -19.61, -0.0}, {314.94, -19.61, -0.0}, {306.13, -19.61, -0.0}, {297.31, -19.61, -0.0}, {288.49, -19.6, -0.0}, {279.67, -19.6, -0.0}, {270.85, -19.6, -0.0}, {262.03, -19.61, -0.0}, {253.21, -19.61, -0.0}, {244.38, -19.61, -0.0}, {235.56, -19.61, -0.0}, {226.74, -19.61, -0.0}, {217.92, -19.61, -0.0}, {209.09, -19.61, -0.0}, {200.27, -19.61, -0.0}, {191.45, -19.61, 0.0}, {182.62, -19.61, -0.0}, {173.8, -19.61, -0.0}, {164.97, -19.61, -0.0}, {156.14, -19.61, -0.0}, {147.32, -19.62, -0.0}, {138.49, -19.62, -0.0}, {129.66, -19.62, -0.0}, {120.83, -19.62, -0.0}, {112.01, -19.62, -0.0}, {103.18, -19.62, -0.0}, {94.35, -19.62, -0.0}, {85.51, -19.62, -0.0}, {76.68, -19.62, -0.0}, {67.85, -19.62, -0.0}, {59.02, -19.62, -0.0}, {50.19, -19.62, -0.0}, {41.35, -19.63, -0.0}, {32.52, -19.63, -0.0}, {23.68, -19.63, -0.0}, {3908.94, -19.62, -0.0}, {3891.2, -19.6, -0.0}, {3873.45, -19.59, -0.0}, {3855.71, -19.59, -0.0}, {3837.97, -19.49, -0.0}, {3820.23, -19.49, -0.0}}
local START = STALLS[1]          -- default placement: pit stall 0
local band = bit32.band
local ru, wu, rf, wf = buffer.readu32, buffer.writeu32, buffer.readf32, buffer.writef32

local B64 = {}
do
	local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	for i = 1, 64 do B64[string.byte(chars, i)] = i - 1 end
end
local function b64into(dst, off, s)
	local o = off
	for i = 1, #s, 4 do
		local a, b, c, d = string.byte(s, i, i + 3)
		local x = B64[a] * 262144 + B64[b] * 4096 + (c ~= 61 and B64[c] or 0) * 64 + (d ~= 61 and B64[d] or 0)
		buffer.writeu8(dst, o, bit32.rshift(x, 16)); o += 1
		if c ~= 61 then buffer.writeu8(dst, o, band(bit32.rshift(x, 8), 0xff)); o += 1 end
		if d ~= 61 then buffer.writeu8(dst, o, band(x, 0xff)); o += 1 end
	end
	return o - off
end

local CAR = 0xc12030
local WORLD = 0xc74e20               -- collision world object (00578590 ctor)
local BG_CAROBJ, CAROBJ_SIZE = 0xc08874, 0x32c

-- V: core with driver, aero, Stage 11 frame, garage, steering, force feedback installed
-- extra: {build = NR2003CupTrackBuild (decision tables of the placed car), placed = NR2003CupJITP*, placedGeneric =
-- NR2003CupJITPG* (callbacks of the car rebuilt at the placed pose, natural / generic garage structure)}
return function(V, codeParts, dataParts, extra)
	assert(#codeParts == CODE_PARTS, "NR2003CupTrackCode: expected " .. CODE_PARTS .. " parts, found " .. #codeParts)
	assert(#dataParts == DATA_PARTS, "NR2003CupTrackData: expected " .. DATA_PARTS .. " parts, found " .. #dataParts)
	local M, BASE = V.memory(), V.base
	assert(buffer.len(M) &gt;= TOP - BASE, "NR2003CupTrack: core memory below the track image (load through NR2003CupVehicle.fromLoader)")
	local PRISTINE = V._pristine()
	local function r32(a) return ru(M, a - BASE) end
	local function ri32(a) return buffer.readi32(M, a - BASE) end
	local function w32(a, v) wu(M, a - BASE, band(v)) end
	local function rf32(a) return rf(M, a - BASE) end
	local function wf32(a, v) wf(M, a - BASE, v) end
	local S = buffer.create(8)
	local function f2u(x) buffer.writef32(S, 0, x); return buffer.readu32(S, 0) end

	-- B_tire: the pair callback 00576e00 calls the tyre contact 0055e1e0 (11 cdecl arguments, float10 result): the core's
	-- own lifted 0055e1e0 on the core's registers (the same function the host-contact path calls)
	local contacts = {}
	for i = 0, 3 do contacts[i] = {fx=0, fy=0, load=0, x=0, y=0, z=0, surface=0, contacted=false, count=0} end
	local coreCall, popF = V._callx, V._popF
	local function tire(a)
		coreCall(0x55e1e0, a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8], a[9], a[10], a[11])
		local result = popF()
		local c = contacts[a[6]]
		if c then
			c.fx, c.fy, c.load = rf32(a[1]), rf32(a[1]+4), rf32(a[1]+8)
			c.x, c.y, c.z = rf32(a[3]), rf32(a[3]+4), rf32(a[3]+8)
			c.surface, c.contacted, c.count = a[11], true, c.count + 1
		end
		return result
	end
	-- B_fgAction: bgRequestFGAction(00551760) from 00551520 (placement): the foreground task rebuilds the car from the
	-- state block (00551760 -&gt; 005b2f20(root, bf6d40)), the ORIGINAL sequence of NR2003CupBuild (steps 7..18)
	local function fgAction(fn, a, b)
		if fn ~= 0x551760 then error(string.format("NR2003 track: foreground action %08x not ported", fn)) end
		local B = V.Build
		assert(B and B.rebuildFromState, "NR2003 track: the Stage 10 build (NR2003CupBuild) is required")
		-- the callbacks this rebuild generates: the placed structure of the garage's active structure
		local placed = V._garageStructure() == "generic" and "placedGeneric" or "placed"
		V._garageUseCode(placed)
		local ok, rep = B.rebuildFromState(placed)
		if not ok then
			error("NR2003 track: car rebuild after the placement is outside the " .. placed .. " structure: " ..
				tostring(rep.error or ("violations " .. tostring(rep.violations) .. ", first " .. tostring(rep.firstViolation))))
		end
		if V._bindDriverCells then V._bindDriverCells() end   -- Stage 8 cells of the regenerated callbacks
		return 0
	end
	local ctx = {M = M, base = BASE, F = {}, R = table.create(10, 0), XF = {}, tire = tire, fgAction = fgAction}
	for _, p in ipairs(codeParts) do p(ctx) end
	local XF, R = ctx.XF, ctx.R

	-- call an ORIGINAL lifted function (cdecl arguments, optional ECX for thiscall) on the track register file
	local function callx(addr, ecx, ...)
		local args = { ... }
		local n = #args
		local esp = STACK - 4 * (n + 1)
		for k = 1, n do w32(esp + 4 * k, args[k]) end
		w32(esp, 0)
		for k = 1, 7 do R[k] = 0 end
		R[8] = esp; R[9] = 0; R[10] = 0
		if ecx then R[3] = ecx end
		table.clear(ctx.F)
		local f = XF[addr]
		if not f then error(string.format("NR2003 track: %08x not lifted", addr)) end
		f()
		local d = R[8] - esp
		assert(d == 4 or d == 4 * (n + 1), "NR2003 track: unbalanced stack")
		return R[1]
	end
	V._callxTrack = callx

	-------------------------------------------------------------------------------------------------------------
	-- track image
	-------------------------------------------------------------------------------------------------------------
	local zbuf = buffer.create(4096)
	local function apply(dst)
		local bytes = 0
		for _, d in ipairs(dataParts) do
			for _, z in ipairs(d.zero) do
				local off, len = z[1], z[2]
				while len &gt; 0 do
					local n = math.min(len, 4096)
					buffer.copy(dst, off, zbuf, 0, n); off += n; len -= n
				end
				bytes += z[2]
			end
			for _, x in ipairs(d.data) do bytes += b64into(dst, x[1], x[2]) end
		end
		return bytes
	end
	local loaded, active = false, false
	local start = {START[1], START[2], START[3]}

	-- 005f58d0(out, point): world point -&gt; track record (0051370a), for the Stage 11 frame code and the host
	local function trackPoint(out, pos)
		callx(0x5f58d0, nil, out, pos)
		return R[1], R[3], R[4]
	end

	function V.loadTrack()
		if loaded then return true end
		local bytes = apply(PRISTINE)
		apply(M)
		local B = V.Build
		assert(B and B.setInputOverrides and V.applySetup and V._garageAddCode, "NR2003 track: the Stage 10 garage / build is required")
		assert(extra and extra.build and #extra.placed &gt; 0 and #extra.placedGeneric &gt; 0,
			"NR2003 track: NR2003CupTrackBuild / NR2003CupJITP* / NR2003CupJITPG* missing")
		for _, name in ipairs({"placed", "placedGeneric"}) do
			B.addStructure(name, extra.build[name])
			V._garageAddCode(name, extra[name])
		end
		assert(extra.vehicle and #extra.roadGeneric &gt; 0, "NR2003 track: original road-course vehicle modules missing")
		B.addStructure("generic", extra.vehicle.generic)
		V._garageAddCode("generic", extra.roadGeneric)
		for off, value in pairs(extra.vehicle.inputs) do BUILD_INPUTS[off] = value end
		B.setInputOverrides(BUILD_INPUTS)
		-- the car built once with the track loaded (ORIGINAL Stage 10 sequence, default garage setup), as the game builds it
		-- after the track load: the reset image then holds the complete post-build state, which the in-place rebuild of
		-- every placement (00551760 -&gt; 005b2f20) starts from
		local initialSetup = V.Setup.cupGarageDefault()
		initialSetup[182] = extra.vehicle.chassisType
		local ok, rep = V.applySetup(initialSetup, {rebuild = true, structure = "generic"})
		if not ok then error("NR2003 track: car build with the track failed: " .. tostring(rep.error or rep.violations)) end
		V._garageRefreshImage()
		local fc = V._frameCtx
		if fc then fc.trackPoint = trackPoint end
		loaded = true
		V.trackImageBytes = bytes
		return true
	end
	function V.trackLoaded() return loaded end
	function V.worldActive() return active end

	-- placement on the next session start / reset: (dlong, dlat) track coordinates (m), yaw (rad) relative to the track
	function V.setTrackStart(dlong, dlat, yaw)
		yaw = yaw or 0
		assert(dlong == dlong and dlat == dlat and yaw == yaw and math.abs(dlong) &lt; math.huge
			and math.abs(dlat) &lt; math.huge and math.abs(yaw) &lt; math.huge, "NR2003 track: finite start coordinates required")
		start[1], start[2], start[3] = dlong + 0.0, dlat + 0.0, yaw + 0.0
	end
	function V.trackStart() return start[1], start[2], start[3] end
	V.trackStalls = STALLS
	V.trackInfo = function()
		local profiles = {}
		local spec = r32(CAR + 0x58a)
		for w = 0, 3 do profiles[w+1] = r32(spec + 0x4c + 4*w) end
		return {name = TRACK_NAME, sections = r32(0xbad920), length = rf32(0xbad918), stalls = #STALLS,
			chassisType = ri32(CAR + 0x58e), spec = spec, tireProfiles = profiles}
	end

	-- ORIGINAL 005512f0 at its place inside the Frame's 00550a50 subset
	V._place = function()
		if loaded then callx(0x5512f0, nil, f2u(start[1]), f2u(start[2]), f2u(start[3])) end
	end

	local baseEnter = V.enterTrack
	function V.enterTrack()
		if not loaded then return baseEnter() end
		active = false
		for i = 0, 3 do
			local c = contacts[i]
			c.fx, c.fy, c.load, c.contacted, c.count = 0, 0, 0, false, 0
		end
		local k = ri32(CAR + 0x5b2)
		local carobj = BG_CAROBJ + k * CAROBJ_SIZE
		-- session start 00566e50, world part
		callx(0x59fa90, carobj - 0xcc)
		w32(carobj - 0xcc + 0x270, k)
		assert(callx(0x433cb0, nil, k, CAR + 0x58e, carobj) ~= 0, "NR2003 track: 00433cb0 (collision geometry) failed")
		callx(0x578610, WORLD)
		w32(CAR + 0x5ae, carobj + 0x98)
		-- 00550a50 (Stage 11 subset + 005512f0 through V._place), then the race-order insert (0055bfd0)
		baseEnter()
		callx(0x563620, nil, CAR)
		-- Host startup boundary: publish the placed pose before broadphase sees the new collision object.
		-- 005512f0 reinitialises its BG object with 0059fa90; leaving that record zero selects primitives near
		-- the origin on the first frame and produces invalid contacts elsewhere around the lap. Use the same
		-- ORIGINAL record publication / external-force reset as the ordinary tick export, in both hosts.
		callx(0x5543f0, nil)
		callx(0x551480, nil)
		active = true
	end
	local baseReset, baseEnd = V.reset, V.endSession
	function V.reset()
		active = false
		-- the reset image is the car built at the bench pose: its callbacks (the garage's structure) until placed again
		if loaded then V._garageUseCode(V._garageStructure()) end
		baseReset()
	end
	function V.endSession()
		active = false
		baseEnd()
	end

	V._world = {
		active = function() return active end,
		-- 005b2190 head: 005789c0(00562f70, 00566a20) broadphase, 00578a60 pair maintenance
		frame = function()
			callx(0x5789c0, WORLD, 0x562f70, 0x566a20)
			callx(0x578a60, WORLD)
		end,
		-- 005539c0 / 005544e0 tails after the export: 005543f0 world record + track query, 00551480
		record = function()
			callx(0x5543f0, nil)
			callx(0x551480, nil)
		end,
		-- contact passes 00578da0 (before the first forces pass) / 00578de0 (before the second)
		pass = function(phase)
			-- A wheel can leave the track; do not report the previous pass's output as a current contact.
			for i = 0, 3 do
				local c = contacts[i]
				c.fx, c.fy, c.load, c.contacted, c.count = 0, 0, 0, false, 0
			end
			callx(phase == 1 and 0x578da0 or 0x578de0, WORLD)
		end,
	}

	-- the car's world record (005a13f0 record, car+0x5ae): position, rotation rows, velocity + the track query fields
	function V.worldRecord(out)
		out = out or {}
		local rec = r32(CAR + 0x5ae)
		if rec == 0 then return nil end
		for k = 0, 0x57, 4 do out[k // 4 + 1] = r32(rec + k) end
		return out, rec
	end
	-- world point -&gt; track record (ORIGINAL 005f58d0 on a host block): raw 0x58-byte record (u32 cells)
	function V.trackPointRaw(x, y, z, out)
		assert(loaded, "NR2003 track: loadTrack first")
		local pos, rec = HOSTBLK, HOSTBLK + 0x10
		wf32(pos, x); wf32(pos + 4, y); wf32(pos + 8, z)
		trackPoint(rec, pos)
		out = out or {}
		for k = 0, 0x57, 4 do out[k // 4 + 1] = r32(rec + k) end
		return out
	end

	-- Read-only views of the ORIGINAL track query and contact inputs. Vehicle coordinates are metres, Z up.
	-- 005150fa: eleven output pointers followed by dlong, dlat and the packed search hint.
	function V.trackToWorld(dlong, dlat, out, hint)
		assert(loaded, "NR2003 track: loadTrack first")
		assert(dlong == dlong and dlat == dlat and math.abs(dlong) &lt; math.huge and math.abs(dlat) &lt; math.huge,
			"NR2003 track: finite coordinates required")
		local p = HOSTBLK + 0x80
		local h = callx(0x5150fa, nil, p, p+4, p+8, p+12, p+16, p+20, p+24, p+28, p+32, p+36, p+40,
			f2u(dlong), f2u(dlat), hint or 0)
		out = out or {}
		out.x, out.y, out.z, out.bumpedZ = rf32(p), rf32(p+4), rf32(p+8), rf32(p+12)
		out.nx, out.ny, out.nz = rf32(p+16), rf32(p+20), rf32(p+24)
		out.tx, out.ty = rf32(p+28), rf32(p+32)
		out.surface, out.surfaceMetadata, out.hint = rf32(p+36), rf32(p+40), h
		return out
	end
	local function decodeTrackRecord(rec, out)
		out = out or {}
		out.x, out.y, out.z = rf32(rec), rf32(rec+4), rf32(rec+8)
		out.surfaceX, out.surfaceY, out.surfaceZ = rf32(rec+0x18), rf32(rec+0x1c), rf32(rec+0x20)
		out.nx, out.ny, out.nz = rf32(rec+0x24), rf32(rec+0x28), rf32(rec+0x2c)
		out.bumpedZ, out.tx, out.ty = rf32(rec+0x30), rf32(rec+0x34), rf32(rec+0x38)
		out.dlong, out.dlat = rf32(rec+0x3c), rf32(rec+0x40)
		out.surface, out.surfaceMetadata, out.hint = ri32(rec+0x4c), ri32(rec+0x50), r32(rec+0x54)
		out.valid = band(out.hint, 0x8000) ~= 0
		return out
	end
	function V.projectTrackWorld(x, y, z, out)
		assert(loaded, "NR2003 track: loadTrack first")
		assert(x == x and y == y and z == z and math.abs(x) &lt; math.huge and math.abs(y) &lt; math.huge
			and math.abs(z) &lt; math.huge, "NR2003 track: finite world coordinates required")
		local pos, rec = HOSTBLK, HOSTBLK + 0x10
		wf32(pos, x); wf32(pos+4, y); wf32(pos+8, z)
