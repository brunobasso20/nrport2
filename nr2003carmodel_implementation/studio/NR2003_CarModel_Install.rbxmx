module_("NR2003CarModelSelfTest",8187,3950335339,[=[
-- NR2003CarModelSelfTest: Studio self-test of the nr2003carmodel modules against golden vectors of the ORIGINAL
-- NR2003.exe / rendserv.dll code (NR2003CarModelGolden, generated by recovery/gen_fixtures.py). Read-only: it creates no
-- Instances and never touches the physics core. run(full, codeOnly) -&gt; ok, lines (codeOnly: skip the descriptor / imported
-- model checks, used by INSTALL_CARMODEL before the assets exist).  (The complete suite, with the rig checked node by
-- node against the reference rig, is tests/carmodel_run.luau in the Luau CLI.)
--   require(game.ReplicatedStorage.NR2003Lab.CarModel.NR2003CarModelSelfTest).run(true)
local M={}
local folder=script.Parent
function M.run(full,codeOnly)
    local passed,failed,lines=0,0,{}
    local function check(name,ok,detail)
        if ok then passed+=1 else failed+=1 end
        local line=(ok and "PASS  " or "FAIL  ")..name..(detail and ("  "..detail) or "")
        table.insert(lines,line)
        if full or not ok then print("[NR2003 car model self-test] "..line) end
    end
    local pkg=folder.Parent
    local Scale=require(folder.NR2003Scale)
    local Gauges=require(folder.NR2003Gauges)
    local DrawState=require(folder.NR2003DrawState)
    local Cameras=require(folder.NR2003CameraSystem)
    local Rig=require(folder.NR2003CarModelRig)
    local G=require(folder.NR2003CarModelGolden)
    local f32=Cameras.f32
    -- scale: the ONE constant shared with the bench / Cup adapter
    local core=pkg:FindFirstChild("Core")
    local cup=core and core:FindFirstChild("CupTune") and require(core.CupTune)
    local test=core and core:FindFirstChild("TestTune") and require(core.TestTune)
    check("METRES_PER_STUD == Core.CupTune / Core.TestTune metresPerStud",cup~=nil and test~=nil
        and Scale.METRES_PER_STUD==cup.metresPerStud and Scale.METRES_PER_STUD==test.metresPerStud,
        string.format("%g m/stud",Scale.METRES_PER_STUD))
    do
        local worst=0
        local rnd=Random.new(2003)
        for _=1,100 do
            local R=Scale.euler(rnd:NextNumber(-3,3),rnd:NextNumber(-1.5,1.5),rnd:NextNumber(-3,3))
            local t={rnd:NextNumber(-50,50),rnd:NextNumber(-50,50),rnd:NextNumber(-5,5)}
            local v={rnd:NextNumber(-3,3),rnd:NextNumber(-3,3),rnd:NextNumber(-3,3)}
            local a=Scale.cframe(t[1],t[2],t[3],R)*Scale.point(v[1],v[2],v[3])
            local x,y,z=Scale.apply(R,v[1],v[2],v[3])
            worst=math.max(worst,(a-Scale.point(t[1]+x,t[2]+y,t[3]+z)).Magnitude)
        end
        check("Scale.cframe(t, R) * point(v) == point(t + R v) with Roblox CFrame",worst&lt;1e-4,string.format("max %.2g studs",worst))
    end
    -- 005f6f20 / 005f74c0
    local we,wd=0,0
    for _,e in ipairs(G.euler) do
        local R=Scale.euler(e[1][1],e[1][2],e[1][3])
        for i=1,9 do we=math.max(we,math.abs(R[i]-e[2][i])) end
    end
    for _,e in ipairs(G.decompose) do
        local h,p,r=Scale.decompose(e[1])
        wd=math.max(wd,math.abs(h-e[2][1]),math.abs(p-e[2][2]),math.abs(r-e[2][3]))
    end
    check("Euler / decompose == ORIGINAL 005f6f20 / 005f74c0",we&lt;=1.2e-7 and wd&lt;=4.8e-7,string.format("%.2g / %.2g",we,wd))
    -- 0056f040, 00565b10
    local gw=0
    for _,g in ipairs(G.gauges) do gw=math.max(gw,math.abs(Gauges.angle(Gauges.CAL[g[1]],g[2])-g[3])) end
    local ws=0
    for _,w in ipairs(G.wheelSpeed) do if DrawState.wheelSpeedState(w[1])==w[2] then ws+=1 end end
    check("needle angles == ORIGINAL 0056f040, wheel_speed == 00565b10",gw&lt;=2.4e-7 and ws==#G.wheelSpeed,
        string.format("%d needles max %.2g rad, %d/%d",#G.gauges,gw,ws,#G.wheelSpeed))
    -- look easing
    local ew=0
    for _,e in ipairs(G.ease) do
        local x=e[1]
        ew=math.max(ew,math.abs(f32(Cameras.easeOut(x))-e[2]),math.abs(f32(Cameras.invEaseOut(x))-e[3]),
            math.abs(f32(Cameras.easeIn(x))-e[4]),math.abs(f32(Cameras.invEaseIn(x))-e[5]))
    end
    check("look easing == ORIGINAL 00569210 / 00569230 / 00569250 / 00569260",ew&lt;=1.2e-7,string.format("max %.2g",ew))
    -- 0056a9a0 cameras
    local cams=Cameras.new({onCar=G.onCar,widescreen=false})
    local e1,r1,f1,bad=0,0,0,0
    for _,c in ipairs(G.cameras) do
        cams.mode=c.mode;cams.lookSign,cams.lookEased,cams.lookAnalog=1,c.look,c.analog
        local o=cams:compute(c.pos,c.R,{head=c.head,headPitch=c.headPitch,headRoll=c.headRoll},nil,{})
        local e,r=0,0
        for i=1,3 do e=math.max(e,math.abs(o.eye[i]-c.eye[i])) end
        for i=1,9 do r=math.max(r,math.abs(o.R[i]-c.M[i])) end
        local f=math.max(math.abs(o.fov43-c.fov[1]),math.abs(o.shift[1]-c.fov[2]),math.abs(o.shift[2]-c.fov[3]),math.abs(o.near-c.near))
        e1,r1,f1=math.max(e1,e),math.max(r1,r),math.max(f1,f)
        if e&gt;2e-4 or r&gt;2e-6 or f&gt;1e-6 then bad+=1 end
    end
    check(string.format("cameras == ORIGINAL 0056a9a0 (%d poses, 14 modes)",#G.cameras),bad==0,
        string.format("eye %.2g m, rotation %.2g, fov %.2g",e1,r1,f1))
    local C=G.constants
    local cok=Cameras.FOV_MIN==C.fovMin and Cameras.FOV_MAX==C.fovMax and Cameras.FOV_STEP==C.fovStep
        and Cameras.FOV_OPTION_DEFAULT_DEG==C.fovDefaultDeg and Cameras.LOOK_TIME==C.lookTime and Cameras.WIDESCREEN_COCKPIT_FOV==C.wideFov
    for i=0,21 do if Cameras.NEXT[i]~=G.camTables.next[i+1] or Cameras.PREV[i]~=G.camTables.prev[i+1] then cok=false end end
    check("camera tables / constants == ORIGINAL image (006ec798 / 006ec7f0, FOV option, look, widescreen)",cok)
    -- rendserv compiled nodes
    local sok=0
    for _,s in ipairs(G.stateSwitch) do if Rig.selectState(s[1],s[2])==s[3] then sok+=1 end end
    local lok=0
    for _,l in ipairs(G.lod) do if Rig.selectLod(l[1],l[2],l[3])==l[4] then lok+=1 end end
    check("StateSwitch / LodSwitch == ORIGINAL rendserv 10011ec0 / 100118e0",sok==#G.stateSwitch and lok==#G.lod,
        string.format("%d/%d, %d/%d",sok,#G.stateSwitch,lok,#G.lod))
    -- draw state wire format
    local s={}
    for i,k in ipairs(DrawState.FIELDS) do s[k]=f32(i*0.37-5) end
    local d=DrawState.decode(DrawState.encode(7,123.25,s))
    local same=d~=nil and d.seq==7 and d.time==123.25
    if d then for _,k in ipairs(DrawState.FIELDS) do if d[k]~=s[k] then same=false end end end
    check("draw state encode / decode",same)
    -- installed data / assets
    local data=(not codeOnly) and folder:FindFirstChild("Data")
    local desc=nil
    if data then for _,m in ipairs(data:GetChildren()) do if m:IsA("ModuleScript") and m.Name=="NR2003CarModelData_make_a" then desc=require(m) end end end
    if desc and cup then
        local fx,rx=-cup.frontZ,-cup.rearZ
        local want={lfwheel={fx,cup.frontTrack/2},rfwheel={fx,-cup.frontTrack/2},lrwheel={rx,cup.rearTrack/2},rrwheel={rx,-cup.rearTrack/2}}
        local w,n=0,0
        for _,nd in ipairs(desc.nodes) do
            local q=want[nd.name]
            if q and nd.t then n+=1;w=math.max(w,math.abs(nd.t[1]-q[1]),math.abs(nd.t[2]-q[2])) end
        end
        check("descriptor wheel nodes == physics hub positions (no rescaling)",n&gt;=4 and w&lt;1e-4,string.format("%d nodes, %.2g m",n,w))
        local assets=folder:FindFirstChild("Assets")
        local imported=assets and assets:FindFirstChild(desc.meta.package)
        if imported then
            local ok,cf,k,err=pcall(Rig.calibrate,imported,desc)
            local missing=0
            for _,g in ipairs(desc.geometries) do if not imported:FindFirstChild(g.name,true) then missing+=1 end end
            check("imported model: markers rigid + uniform, every geometry present",ok and missing==0,
                ok and string.format("scale %.4f studs/stud, orthogonality %.2g, %d missing",k,err,missing) or tostring(cf))
        else
            check("imported model (CarModel.Assets."..desc.meta.package..")",false,"not installed yet: INSTALL_CARMODEL_ASSETS")
        end
    elseif not codeOnly then
        check("descriptor (CarModel.Data.NR2003CarModelData_make_a)",desc~=nil,desc and nil or "not installed yet: INSTALL_CARMODEL_ASSETS")
    end
    local summary=string.format("%d passed, %d failed",passed,failed)
    table.insert(lines,summary)
    print("[NR2003 car model self-test] "..summary)
    return failed==0,lines
end
return M
]=])
-- 1) baseline check (nothing is changed before every target is verified) -----------------------------------
local plan,problems={},{}
for _,it in ipairs(SCRIPTS) do
    local s=FOLDERS[it.folder]:FindFirstChild(it.name)
    if s==nil then table.insert(problems,it.folder.."."..it.name.." ausente (Stage 13 requerido)")
    else
        local src=s.Source;local n,h=#src,fnv(src)
        if n==it.newLen and h==it.newHash then table.insert(plan,{it=it,s=s,state="current"})
        elseif n==it.oldLen and h==it.oldHash then table.insert(plan,{it=it,s=s,state="replace"})
        else table.insert(problems,string.format("%s.%s difere do Stage 13 publicado (%d bytes, hash %08x): alterado localmente?",it.folder,it.name,n,h)) end
    end
end
if #problems&gt;0 and not _G.NR2003_CARMODEL_FORCE then
    error("Instalação do modelo recusada, nada foi alterado:\n  "..table.concat(problems,"\n  ")..
        "\n(_G.NR2003_CARMODEL_FORCE=true instala mesmo assim, com backup do que existir)")
end
if #problems&gt;0 then
    for _,it in ipairs(SCRIPTS) do
        local s=FOLDERS[it.folder]:FindFirstChild(it.name)
        local seen=false
        for _,p in ipairs(plan) do if p.it==it then seen=true end end
        if s and not seen then table.insert(plan,{it=it,s=s,state="replace"}) end
    end
end
-- 2) backup of exactly what this installer changes (created once; a re-run keeps the first backup) -----------
local backup=storage:FindFirstChild("NR2003Backup_CarModel")
local firstInstall=backup==nil
local folder=pkg:FindFirstChild("CarModel")
local remote=pkg:FindFirstChild("DrawState")
if firstInstall then
    backup=Instance.new("Folder");backup.Name="NR2003Backup_CarModel"
    backup:SetAttribute("FromStage",stage);backup:SetAttribute("FromVersion",pkg:GetAttribute("NR2003Version"))
    backup:SetAttribute("Created",os.time())
    for _,p in ipairs(plan) do local c=p.s:Clone();c.Name=p.it.folder.."."..p.it.name;c.Parent=backup end
    local added={}
    if folder==nil then table.insert(added,"NR2003Lab.CarModel") end
    if remote==nil then table.insert(added,"NR2003Lab.DrawState") end
    for _,k in ipairs(added) do
        local v=Instance.new("StringValue");v.Name="ADDED:"..k;v.Value=k;v.Parent=backup
    end
    backup.Parent=storage
end
-- 3) apply and self-test; revert on any failure ------------------------------------------------------------
local touched,created={},{}
local function apply()
    if folder==nil then
        folder=Instance.new("Folder");folder.Name="CarModel";folder.Parent=pkg;table.insert(created,folder)
    end
    for _,n in ipairs({"Data","Assets"}) do
        if not folder:FindFirstChild(n) then local f=Instance.new("Folder");f.Name=n;f.Parent=folder;table.insert(created,f) end
    end
    if remote==nil then
        remote=Instance.new("UnreliableRemoteEvent");remote.Name="DrawState";remote.Parent=pkg;table.insert(created,remote)
    end
    for _,m in ipairs(MODULES) do
        local s=folder:FindFirstChild(m.name)
        if s==nil then
            s=Instance.new("ModuleScript");s.Name=m.name;setSource(s,m.source);s.Parent=folder;table.insert(created,s)
        else
            table.insert(touched,{s=s,old=s.Source});setSource(s,m.source)
        end
        assert(#s.Source==m.newLen and fnv(s.Source)==m.newHash,"fonte truncada: CarModel."..m.name)
    end
    for _,p in ipairs(plan) do
        if p.state~="current" then
            table.insert(touched,{s=p.s,old=p.s.Source});setSource(p.s,p.it.source)
            assert(#p.s.Source==p.it.newLen and fnv(p.s.Source)==p.it.newHash,"fonte truncada: "..p.it.folder.."."..p.it.name)
        end
    end
    pkg:SetAttribute("NR2003CarModel","1.0.0-carmodel")
    local ok,r=require(folder.NR2003CarModelSelfTest).run(false,true)
    assert(ok,"auto-teste do modelo falhou:\n"..table.concat(r,"\n"))
end
local previous=pkg:GetAttribute("NR2003CarModel")
local ok,reason=pcall(apply)
if not ok then
    for i=#touched,1,-1 do setSource(touched[i].s,touched[i].old) end
    for i=#created,1,-1 do created[i]:Destroy() end
    pkg:SetAttribute("NR2003CarModel",previous)
    if firstInstall then backup:Destroy() end
    error("Instalação do modelo revertida (fontes restauradas): "..tostring(reason))
end
print("Modelo do carro ORIGINAL instalado (código "..(firstInstall and "novo; backup: ServerStorage.NR2003Backup_CarModel" or "re-execução: backup anterior mantido")..").")
print("Próximo passo: importe &lt;pacote&gt;/obj/make_a.obj pelo 3D Importer (unidade Stud, sem reescala) e rode")
print("  INSTALL_CARMODEL_ASSETS.lua (gerado pelo convert_car.py) para o descritor + o modelo importado.")
print("Sem os assets a bancada continua como no Stage 13. Atributos do TestCar: NR2003CockpitFOV (65..78), NR2003WidescreenProjection,")
print("  NR2003AnimatedSteeringWheel, NR2003Windshield, NR2003CameraShift, NR2003LiveryTexture (rbxassetid opcional).")
print("Teclas: V/B câmera +/-, Z/C olhar esq./dir., [ ] FOV. O place NÃO foi salvo. Reverter: ROLLBACK_CARMODEL.lua.")

end
