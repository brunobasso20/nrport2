990723,0,3},{{0.0,2.0,4.5,6.800000190734863,9.199999809265137,12.300000190734863,16.399999618530273,20.899999618530273,30.5,48.20000076293945,70.0},9.090798377990723,2,3},{{0.0,2.0,4.5,6.800000190734863,9.199999809265137,12.300000190734863,16.399999618530273,20.899999618530273,30.5,48.20000076293945,70.0},31.30011558532715,0,8},{{0.0,2.0,4.5,6.800000190734863,9.199999809265137,12.300000190734863,16.399999618530273,20.899999618530273,30.5,48.20000076293945,70.0},31.30011558532715,2,8},{{0.0,2.0,4.5,6.800000190734863,9.199999809265137,12.300000190734863,16.399999618530273,20.899999618530273,30.5,48.20000076293945,70.0},-1.0,0,0},{{0.0,2.0,4.5,6.800000190734863,9.199999809265137,12.300000190734863,16.399999618530273,20.899999618530273,30.5,48.20000076293945,70.0},-1.0,2,2},{{0.0,2.0,4.5,6.800000190734863,9.199999809265137,12.300000190734863,16.399999618530273,20.899999618530273,30.5,48.20000076293945,70.0},1000000.0,0,10},{{0.0,2.0,4.5,6.800000190734863,9.199999809265137,12.300000190734863,16.399999618530273,20.899999618530273,30.5,48.20000076293945,70.0},1000000.0,2,10},{{0.0,30.0},0.0,0,0},{{0.0,30.0},0.0,2,0},{{0.0,30.0},30.0,0,0},{{0.0,30.0},30.0,2,0},{{0.0,30.0},16.25603675842285,0,0},{{0.0,30.0},16.25603675842285,2,0},{{0.0,30.0},3.37725567817688,0,0},{{0.0,30.0},3.37725567817688,2,0},{{0.0,30.0},38.403316497802734,0,1},{{0.0,30.0},38.403316497802734,2,1},{{0.0,30.0},4.086333274841309,0,0},{{0.0,30.0},4.086333274841309,2,0},{{0.0,30.0},34.602638244628906,0,1},{{0.0,30.0},34.602638244628906,2,1},{{0.0,30.0},16.71146011352539,0,0},{{0.0,30.0},16.71146011352539,2,0},{{0.0,30.0},8.477571487426758,0,0},{{0.0,30.0},8.477571487426758,2,0},{{0.0,30.0},26.20221710205078,0,0},{{0.0,30.0},26.20221710205078,2,0},{{0.0,30.0},33.45103454589844,0,1},{{0.0,30.0},33.45103454589844,2,1},{{0.0,30.0},8.730631828308105,0,0},{{0.0,30.0},8.730631828308105,2,0},{{0.0,30.0},20.470361709594727,0,0},{{0.0,30.0},20.470361709594727,2,0},{{0.0,30.0},36.8828010559082,0,1},{{0.0,30.0},36.8828010559082,2,1},{{0.0,30.0},23.83747100830078,0,0},{{0.0,30.0},23.83747100830078,2,0},{{0.0,30.0},25.521495819091797,0,0},{{0.0,30.0},25.521495819091797,2,0},{{0.0,30.0},15.208067893981934,0,0},{{0.0,30.0},15.208067893981934,2,0},{{0.0,30.0},17.308515548706055,0,0},{{0.0,30.0},17.308515548706055,2,0},{{0.0,30.0},11.217888832092285,0,0},{{0.0,30.0},11.217888832092285,2,0},{{0.0,30.0},17.659555435180664,0,0},{{0.0,30.0},17.659555435180664,2,0},{{0.0,30.0},38.90749740600586,0,1},{{0.0,30.0},38.90749740600586,2,1},{{0.0,30.0},14.94224739074707,0,0},{{0.0,30.0},14.94224739074707,2,0},{{0.0,30.0},14.804872512817383,0,0},{{0.0,30.0},14.804872512817383,2,0},{{0.0,30.0},27.883825302124023,0,0},{{0.0,30.0},27.883825302124023,2,0},{{0.0,30.0},21.847320556640625,0,0},{{0.0,30.0},21.847320556640625,2,0},{{0.0,30.0},4.292018413543701,0,0},{{0.0,30.0},4.292018413543701,2,0},{{0.0,30.0},5.747978210449219,0,0},{{0.0,30.0},5.747978210449219,2,0},{{0.0,30.0},-1.0,0,0},{{0.0,30.0},-1.0,2,0},{{0.0,30.0},1000000.0,0,1},{{0.0,30.0},1000000.0,2,1}}}
