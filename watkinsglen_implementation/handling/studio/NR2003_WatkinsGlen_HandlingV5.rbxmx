<?xml version='1.0' encoding='utf-8'?>
<roblox version="4">
  <External>null</External>
  <External>nil</External>
  <Item class="Model" referent="RBX1">
    <Properties>
      <string name="Name">NR2003_WatkinsGlen_HandlingV5</string>
    </Properties>
    <Item class="ModuleScript" referent="RBX2">
      <Properties>
        <string name="Name">Apply</string>
        <ProtectedString name="Source">-- Run in Studio's Command Bar outside Play:
-- require(workspace.NR2003_WatkinsGlen_HandlingV5.Apply)()
-- No simulation modules or uploaded scripts are executed by this installer.
local function applyLocked(install, H, manifest)
    local pkg, folders = H.folders()
    H.origin()
    local storage = game:GetService("ServerStorage")
    assert(pkg:GetAttribute("NR2003Track") == "watkins_glen" and
        (pkg:GetAttribute("NR2003WatkinsGlenPatch") == manifest.baseBundle or
         pkg:GetAttribute("NR2003WatkinsGlenPatch") == manifest.bundle),
        "Handling V5 requires the installed Watkins Glen V4 patch; use the full V5 installer for a fresh place")
    local baseBackup = H.child(storage, "NR2003Backup_WatkinsGlen")
    assert(baseBackup.ClassName == "Folder" and baseBackup:GetAttribute("Complete") == true and
        baseBackup:GetAttribute("Bundle") == manifest.baseBundle, "The original complete V4 backup must be retained")
    H.backupEntries(baseBackup, require(install.BaseManifest))
    local existingBackup = H.child(storage, "NR2003Backup_WatkinsGlenHandlingV5", true)
    if existingBackup then
        assert(existingBackup.ClassName == "Folder", "Watkins Glen backup is not a Folder")
        if existingBackup:GetAttribute("Complete") == true then
            assert(existingBackup:GetAttribute("Bundle") == manifest.bundle,
                "A backup from a different Watkins Glen patch exists; roll back that patch before updating")
            H.backupEntries(existingBackup, manifest)
        end
    end

    -- All payloads, targets and required solver dependencies are checked before mutation.
    local problems, plan = {}, {}
    for _, item in ipairs(manifest.targets) do
        local payload = H.payload(install, item.key)
        assert(H.matches(payload, item.new), "Bundled source is incomplete: " .. item.key)
        local object, parent, name = H.resolve(folders, item.key, true)
        local source = object and object:IsA("LuaSourceContainer") and H.source(object) or nil
        if object and object.ClassName ~= item.class then
            table.insert(problems, item.key .. " has an unexpected instance class")
        elseif object == nil and item.old ~= nil then
            table.insert(problems, item.key .. " is missing from the existing Stage 13 installation")
        elseif source and not H.matches(source, item.new) and not H.matches(source, item.old) then
            table.insert(problems, item.key .. " contains local changes; this patch will not overwrite them")
        else
            table.insert(plan, {item = item, object = object, parent = parent, name = name,
                old = source, payload = payload, current = source and H.matches(source, item.new)})
        end
    end
    for _, check in ipairs(manifest.dependencies) do
        local object = H.resolve(folders, check.key, true)
        local accepted = false
        if object and object.ClassName == check.class then
            local source = H.source(object)
            for _, expected in ipairs(check.accepted) do
                if H.matches(source, expected) then accepted = true; break end
            end
        end
        if not accepted then table.insert(problems, check.key .. " is incompatible with the recovered track runtime") end
    end
    local world = H.child(workspace, "NR2003LabWorld", true)
    local bench = world and H.child(world, "TestTrack", true)
    if bench then
        assert(bench.ClassName == "Folder", "NR2003LabWorld.TestTrack is not the generated bench folder")
        assert(not existingBackup or not H.child(existingBackup, "MovedBench", true),
            "A second TestTrack appeared after installation; move it manually before reapplying")
    end
    local car = world and H.child(world, "TestCar", true)
    if car then
        local setup = car:GetAttribute("WatkinsGlenSetup")
        assert(setup == nil or setup == "fast" or setup == "easy" or setup == "qualify" or setup == "jasper",
            "TestCar.WatkinsGlenSetup must be fast, easy, qualify or jasper")
        assert(car:GetAttribute("AeroSession") ~= false and car:GetAttribute("Stage11Runtime") ~= "frozen",
            "Watkins Glen requires AeroSession enabled and Stage11Runtime original")
    end
    assert(#problems == 0, "Watkins Glen patch refused; nothing was changed:\n  " .. table.concat(problems, "\n  "))

    if existingBackup and existingBackup:GetAttribute("Complete") ~= true then
        H.archiveRestoredBackup(existingBackup, manifest, plan, pkg, folders)
        existingBackup = nil
    end

    local backup = existingBackup
    local createdBackup = backup == nil
    local entries, verifiedEntries
    if createdBackup then
        local prepared, prepareReason = pcall(function()
            backup = Instance.new("Folder")
            backup.Name = "NR2003Backup_WatkinsGlenHandlingV5"
            backup:SetAttribute("Bundle", manifest.bundle)
            backup:SetAttribute("CreatedUTC", os.time())
            backup:SetAttribute("Complete", false)
            -- ScriptEditorService operates on scripts in the DataModel. The
            -- incomplete owned backup is parented before any source write.
            backup.Parent = storage
            H.snapshotAttribute(backup, pkg, "NR2003Track")
            H.snapshotAttribute(backup, pkg, "NR2003WatkinsGlenPatch")
            entries = Instance.new("Folder"); entries.Name = "Entries"; entries.Parent = backup
            for _, moduleName in ipairs({"Support", "Rollback", "Manifest"}) do
                local clone = install[moduleName]:Clone(); clone.Parent = backup
            end
            for _, change in ipairs(plan) do
                local entry = Instance.new("Folder"); entry.Name = change.item.key; entry.Parent = entries
                entry:SetAttribute("Added", change.object == nil)
                entry:SetAttribute("Class", change.item.class)
                entry:SetAttribute("NewBytes", change.item.new.bytes)
                entry:SetAttribute("NewHash", change.item.new.fnv32)
                local reference = Instance.new("ObjectValue"); reference.Name = "Target"
                reference.Value = change.object; reference.Parent = entry
                if change.old then
                    local saved = Instance.new("ModuleScript"); saved.Name = "Original"; saved.Parent = entry
                    H.write(saved, change.old)
                    local bytes, hash = H.fingerprint(change.old)
                    entry:SetAttribute("OldBytes", bytes); entry:SetAttribute("OldHash", hash)
                end
            end
            entries, verifiedEntries = H.backupEntries(backup, manifest)
            backup:SetAttribute("Prepared", true)
        end)
        if not prepared then
            local cleaned, cleanReason = pcall(function() if backup then backup:Destroy() end end)
            assert(cleaned, "Backup preparation and cleanup failed; retain the incomplete ServerStorage backup:\n" ..
                tostring(prepareReason) .. "\n" .. tostring(cleanReason))
            error("Watkins Glen backup preparation failed; live sources and attributes were not changed:\n" ..
                tostring(prepareReason))
        end
    else
        entries, verifiedEntries = H.backupEntries(backup, manifest)
    end

    local touched, movedBench = {}, nil
    local priorTrack, priorPatch = pkg:GetAttribute("NR2003Track"), pkg:GetAttribute("NR2003WatkinsGlenPatch")
    local function apply()
        for _, change in ipairs(plan) do
            if not change.current then
                local saved = verifiedEntries[change.item.key]
                assert(entries.Parent == backup and saved.entry.Parent == entries and saved.reference.Parent == saved.entry,
                    "Backup entry was removed during installation: " .. change.item.key)
                local object = change.object
                if not object then
                    object = Instance.new(change.item.class); object.Name = change.name
                    object.Parent = change.parent
                end
                table.insert(touched, {object = object, old = change.old, added = change.object == nil})
                saved.reference.Value = object
                H.write(object, change.payload, change.old)
                assert(H.matches(H.source(object), change.item.new), "Source verification failed: " .. change.item.key)
                assert(entries.Parent == backup and saved.entry.Parent == entries and saved.reference.Parent == saved.entry,
                    "Backup entry was removed during installation: " .. change.item.key)
            end
        end
        if bench then
            movedBench = Instance.new("Folder"); movedBench.Name = "MovedBench"
            local parent = Instance.new("ObjectValue"); parent.Name = "OriginalParent"
            parent.Value = bench.Parent; parent.Parent = movedBench
            movedBench.Parent = backup
            bench.Parent = movedBench
        end
        pkg:SetAttribute("NR2003Track", "watkins_glen")
        pkg:SetAttribute("NR2003WatkinsGlenPatch", manifest.bundle)
        backup:SetAttribute("Complete", true)
    end
    local ok, reason = pcall(apply)
    if not ok then
        local restored, restoreReason = pcall(function()
            pkg:SetAttribute("NR2003Track", priorTrack); pkg:SetAttribute("NR2003WatkinsGlenPatch", priorPatch)
            if movedBench then bench.Parent = world; movedBench:Destroy() end
            for i = #touched, 1, -1 do
                local change = touched[i]
                if change.added then change.object:Destroy() else H.write(change.object, change.old) end
            end
            if createdBackup then backup:Destroy() end
        end)
        if not restored then
            backup:SetAttribute("Complete", false)
            error("Installation failed and automatic recovery was incomplete. Backup retained in ServerStorage.\n" ..
                tostring(reason) .. "\nRecovery error: " .. tostring(restoreReason))
        end
        error("Watkins Glen installation failed; prior sources, attributes and bench were restored:\n" .. tostring(reason))
    end
    print("Watkins Glen V5 installed: original track setups/pedals and per-wheel track HUD; backup: ServerStorage.NR2003Backup_WatkinsGlenHandlingV5")
    print("Rollback outside Play: require(game.ServerStorage.NR2003Backup_WatkinsGlenHandlingV5.Rollback)()")
    return true, manifest.bundle
end

return function()
    local install = script.Parent
    local H = require(install.Support)
    local manifest = require(install.Manifest)
    return H.exclusive(install, "install", function() return applyLocked(install, H, manifest) end)
end
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX3">
      <Properties>
        <string name="Name">Support</string>
        <ProtectedString name="Source">-- Shared read-only validation and transactional source helpers for the Watkins Glen Studio patch.
local SES = game:GetService("ScriptEditorService")
local M = {}

function M.normalize(source)
    return (source:gsub("\r\n", "\n"):gsub("\r", "\n"))
end

function M.fingerprint(source)
    source = M.normalize(source)
    local h = 2166136261
    for i = 1, #source do
        h = bit32.bxor(h, string.byte(source, i))
        -- Exact in a double: multiply by 403, then add the low byte shifted 24 bits.
        h = (h * 403 + bit32.band(h, 255) * 16777216) % 4294967296
    end
    return #source, h
end

function M.matches(source, fingerprint)
    if not fingerprint then return false end
    local length, hash = M.fingerprint(source)
    return length == fingerprint.bytes and hash == fingerprint.fnv32
end

function M.source(object)
    local editor = SES:GetEditorSource(object)
    assert(M.normalize(editor) == M.normalize(object.Source),
        "Save the open script editor before installing: " .. object:GetFullName())
    return editor
end

function M.write(object, source, expectedBefore)
    SES:UpdateSourceAsync(object, function(current)
        if expectedBefore ~= nil then
            assert(M.normalize(current) == M.normalize(expectedBefore),
                "Source changed during the operation: " .. object:GetFullName())
        end
        return source
    end)
    assert(M.normalize(M.source(object)) == M.normalize(source),
        "Studio did not save the complete source: " .. object:GetFullName())
end

function M.child(parent, name, optional)
    local found
    for _, item in ipairs(parent:GetChildren()) do
        if item.Name == name then
            assert(found == nil, "Duplicate instance name: " .. parent:GetFullName() .. "." .. name)
            found = item
        end
    end
    assert(optional or found, "Required instance missing: " .. parent:GetFullName() .. "." .. name)
    return found
end

function M.stop()
    assert(not game:GetService("RunService"):IsRunning(), "Stop Play/Run before applying or rolling back this patch")
end

-- Acquire before any source operation can yield. Separate imported copies share
-- the same DataModel lock; module-local flags cannot protect those copies.
function M.exclusive(owner, operation, callback)
    M.stop()
    local storage = game:GetService("ServerStorage")
    assert(M.child(storage, "NR2003WatkinsGlenOperation", true) == nil,
        "A Watkins Glen install or rollback is already running; wait for its final output before running another command")
    local lock = Instance.new("Folder")
    lock.Name = "NR2003WatkinsGlenOperation"
    lock:SetAttribute("Operation", operation)
    lock:SetAttribute("StartedUTC", os.time())
    local reference = Instance.new("ObjectValue")
    reference.Name = "Owner"; reference.Value = owner; reference.Parent = lock
    lock.Parent = storage
    local result = table.pack(pcall(callback))
    lock:Destroy()
    if not result[1] then error(result[2], 0) end
    return table.unpack(result, 2, result.n)
end

function M.backupEntries(backup, manifest)
    local entries = M.child(backup, "Entries")
    assert(entries.ClassName == "Folder", "Backup Entries is not a Folder")
    assert(#entries:GetChildren() == #manifest.targets,
        "Backup entry count is incomplete; live sources were not changed")
    local verified = {}
    for _, item in ipairs(manifest.targets) do
        local entry = M.child(entries, item.key)
        assert(entry.ClassName == "Folder" and entry:GetAttribute("Class") == item.class and
            entry:GetAttribute("NewBytes") == item.new.bytes and entry:GetAttribute("NewHash") == item.new.fnv32,
            "Backup metadata is incompatible: " .. item.key)
        local target = M.child(entry, "Target")
        assert(target.ClassName == "ObjectValue", "Backup target reference is invalid: " .. item.key)
        local original = M.child(entry, "Original", true)
        local added = entry:GetAttribute("Added")
        assert(type(added) == "boolean" and (not added or item.old == nil)
            and (added and original == nil or not added and original ~= nil),
            "Backup original is incomplete: " .. item.key)
        if original then
            assert(original.ClassName == "ModuleScript", "Backup original has an invalid class: " .. item.key)
            local source = M.source(original)
            assert(M.matches(source, {bytes = entry:GetAttribute("OldBytes"), fnv32 = entry:GetAttribute("OldHash")})
                and (M.matches(source, item.old) or M.matches(source, item.new)),
                "Original backup was edited: " .. item.key)
        end
        verified[item.key] = {entry = entry, reference = target}
    end
    return entries, verified
end

-- Recover only the state observed in the supplied export: every original target
-- restored, every added track module absent, attributes restored, no moved bench.
-- Retain the entire stale backup under a different name rather than delete it.
function M.archiveRestoredBackup(backup, manifest, plan, pkg, folders)
    assert(backup.ClassName == "Folder" and backup:GetAttribute("Complete") ~= true,
        "Only an unfinished Watkins Glen backup can be recovered automatically")
    local bundle = backup:GetAttribute("Bundle")
    local known = bundle == manifest.bundle
    for _, previous in ipairs(manifest.previousBundles) do if bundle == previous then known = true end end
    assert(known, "Unrecognized unfinished backup; retain it for inspection")
    for _, change in ipairs(plan) do
        local original = change.item.old
        assert(original and change.old and M.matches(change.old, original) or original == nil and change.object == nil,
            "Unfinished backup retained: live target is not fully restored: " .. change.item.key)
    end
    if bundle ~= manifest.bundle then
        for _, item in ipairs(manifest.recoveryTargets) do
            local relevant = item.bundles == nil
            for _, oldBundle in ipairs(item.bundles or {}) do if oldBundle == bundle then relevant = true end end
            if not relevant then continue end
            local object = M.resolve(folders, item.key, true)
            assert(object and object.ClassName == item.class and M.matches(M.source(object), item.old),
                "Unfinished earlier backup retained: original server was not restored: " .. item.key)
        end
    end
    assert(pkg:GetAttribute("NR2003WatkinsGlenPatch") == nil and pkg:GetAttribute("NR2003Track") ~= "watkins_glen",
        "Unfinished backup retained: the track patch is still active")
    for _, name in ipairs({"NR2003Track", "NR2003WatkinsGlenPatch"}) do
        local expected = nil
        if backup:GetAttribute("Previous_" .. name .. "_Present") then expected = backup:GetAttribute("Previous_" .. name) end
        assert(pkg:GetAttribute(name) == expected, "Unfinished backup retained: package attribute was not restored: " .. name)
    end
    assert(M.child(backup, "MovedBench", true) == nil and M.child(backup, "RollbackStaging", true) == nil,
        "Unfinished backup retained: bench or rollback staging needs recovery")
    local name = "NR2003Backup_WatkinsGlen_Recovered_" .. tostring(os.time())
    local unique, suffix = name, 1
    while M.child(backup.Parent, unique, true) do suffix += 1; unique = name .. "_" .. tostring(suffix) end
    backup.Name = unique
    backup:SetAttribute("RecoveredUTC", os.time())
    print("Verified restored live sources; unfinished backup retained as ServerStorage." .. unique)
end

function M.folders()
    local pkg = M.child(game:GetService("ReplicatedStorage"), "NR2003Lab")
    local core = M.child(pkg, "Core")
    local roblox = M.child(pkg, "Roblox")
    local cup = M.child(core, "NR2003Cup")
    assert(pkg:IsA("Folder") and core:IsA("Folder") and roblox:IsA("Folder") and cup:IsA("Folder"),
        "NR2003Lab must contain the existing Core, Roblox and Core.NR2003Cup folders")
    return pkg, {Core = core, Roblox = roblox, Server = game:GetService("ServerScriptService"),
        Client = M.child(game:GetService("StarterPlayer"), "StarterPlayerScripts")}
end

function M.resolve(folders, key, optional)
    local components = string.split(key, ".")
    local parent = assert(folders[components[1]], "Unsupported target root: " .. key)
    for i = 2, #components - 1 do parent = M.child(parent, components[i]) end
    return M.child(parent, components[#components], optional), parent, components[#components]
end

function M.payload(install, key)
    local object = M.child(install, "Sources")
    for _, name in ipairs(string.split(key, ".")) do object = M.child(object, name) end
    assert(object.ClassName == "ModuleScript", "Source payload is not a ModuleScript: " .. key)
    return M.source(object)
end

function M.origin()
    local model = M.child(workspace, "NR2003WatkinsGlen")
    assert(model.ClassName == "Model" and model:GetAttribute("TrackOriginEnabled") == true,
        "Run the visual asset installers before enabling Watkins Glen")
    local scale = model:GetAttribute("NR2003MetresPerStud")
    assert(type(scale) == "number" and math.abs(scale - 0.28) &lt; 1e-12,
        "Watkins Glen visuals must use 0.28 metres per stud")
    local current, expected = {model:GetPivot():GetComponents()}, {CFrame.identity:GetComponents()}
    for i = 1, 12 do
        assert(math.abs(current[i] - expected[i]) &lt; 1e-5,
            "Watkins Glen visual root pivot must remain identity after calibration")
    end
    local terrain, parts = false, 0
    for _, object in ipairs(model:GetDescendants()) do
        if object:GetAttribute("NR2003VisualKind") == "terrain" then terrain = true end
        if object:IsA("BasePart") then
            parts += 1
            assert(object.Anchored and not object.CanCollide and not object.CanTouch,
                "Track visuals must remain anchored and non-colliding: " .. object:GetFullName())
            if object.CanQuery then
                local kind, owner = nil, object.Parent
                while owner and owner ~= model do
                    kind = owner:GetAttribute("NR2003VisualKind")
                    if kind ~= nil then break end
                    owner = owner.Parent
                end
                assert(object:GetAttribute("NR2003TerrainQuery") == true and kind == "terrain",
                    "Only tagged terrain meshes may answer camera queries: " .. object:GetFullName())
            end
        end
    end
    assert(terrain and parts &gt; 0, "Import and calibrate Watkins Glen terrain before installing the physics patch")
    return model
end

function M.snapshotAttribute(backup, object, name)
    local value = object:GetAttribute(name)
    backup:SetAttribute("Previous_" .. name .. "_Present", value ~= nil)
    backup:SetAttribute("Previous_" .. name, value)
end

function M.restoreAttribute(backup, object, name)
    if backup:GetAttribute("Previous_" .. name .. "_Present") then
        object:SetAttribute(name, backup:GetAttribute("Previous_" .. name))
    else
        object:SetAttribute(name, nil)
    end
end

return M
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX4">
      <Properties>
        <string name="Name">Rollback</string>
        <ProtectedString name="Source">-- Run outside Play: require(game.ServerStorage.NR2003Backup_WatkinsGlenHandlingV5.Rollback)()
-- Restores the pre-install source/attributes and any moved generated bench. Track visuals stay imported.
local function rollbackLocked(backup, H, manifest)
    assert(backup.Name == "NR2003Backup_WatkinsGlenHandlingV5" and backup.ClassName == "Folder",
        "Run the Rollback module stored in ServerStorage.NR2003Backup_WatkinsGlenHandlingV5")
    local pkg, folders = H.folders()
    local entries = H.backupEntries(backup, manifest)
    local plan, problems = {}, {}
    local activePatch = pkg:GetAttribute("NR2003WatkinsGlenPatch")
    assert(activePatch == nil or activePatch == backup:GetAttribute("Bundle"),
        "A different Watkins Glen patch is active; this backup cannot roll it back")
    for _, entry in ipairs(entries:GetChildren()) do
        local object = H.resolve(folders, entry.Name, true)
        local original = H.child(entry, "Original", true)
        local source = original and H.source(original)
        local expectedOld = {bytes = entry:GetAttribute("OldBytes"), fnv32 = entry:GetAttribute("OldHash")}
        if source then assert(H.matches(source, expectedOld), "Original backup was edited: " .. entry.Name) end
        local added = entry:GetAttribute("Added") == true
        if not object and not added then
            table.insert(problems, entry.Name .. " was removed after installation")
        elseif object then
            local current = object:IsA("LuaSourceContainer") and H.source(object)
            if object.ClassName ~= entry:GetAttribute("Class") or not current or
                (not H.matches(current, {bytes = entry:GetAttribute("NewBytes"), fnv32 = entry:GetAttribute("NewHash")})
                    and not H.matches(current, source and expectedOld or nil)) then
                table.insert(problems, entry.Name .. " has local changes; rollback will not overwrite them")
            else table.insert(plan, {object = object, source = source, current = current, added = added}) end
        end
    end
    local moved = H.child(backup, "MovedBench", true)
    local bench, parent
    if moved then
        bench = H.child(moved, "TestTrack")
        parent = H.child(moved, "OriginalParent").Value
        assert(parent and parent:IsDescendantOf(workspace), "Original generated bench parent no longer exists")
        assert(H.child(parent, bench.Name, true) == nil, "A different TestTrack blocks restoration of the saved bench")
    end
    assert(#problems == 0, "Rollback refused; nothing was changed:\n  " .. table.concat(problems, "\n  "))

    -- Keep added modules intact in a temporary folder until every original source is restored.
    local removed = Instance.new("Folder"); removed.Name = "RollbackStaging"; removed.Parent = backup
    local touched, movedObjects = {}, {}
    local priorTrack, priorPatch = pkg:GetAttribute("NR2003Track"), pkg:GetAttribute("NR2003WatkinsGlenPatch")
    local ok, reason = pcall(function()
        for _, change in ipairs(plan) do
            if change.added then
                table.insert(movedObjects, {object = change.object, parent = change.object.Parent})
                change.object.Parent = removed
            else
                table.insert(touched, change)
                H.write(change.object, change.source, change.current)
            end
        end
        H.restoreAttribute(backup, pkg, "NR2003Track")
        H.restoreAttribute(backup, pkg, "NR2003WatkinsGlenPatch")
        if bench then bench.Parent = parent end
    end)
    if not ok then
        local restored, restoreReason = pcall(function()
            if bench and bench.Parent == parent then bench.Parent = moved end
            pkg:SetAttribute("NR2003Track", priorTrack); pkg:SetAttribute("NR2003WatkinsGlenPatch", priorPatch)
            for i = #touched, 1, -1 do H.write(touched[i].object, touched[i].current) end
            for _, change in ipairs(movedObjects) do change.object.Parent = change.parent end
            removed:Destroy()
        end)
        assert(restored, "Rollback and its recovery failed; retain the ServerStorage backup:\n" ..
            tostring(reason) .. "\n" .. tostring(restoreReason))
        error("Rollback failed; installed state was restored:\n" .. tostring(reason))
    end
    removed:Destroy()
    backup:Destroy()
    print("Watkins Glen handling update rolled back to V4. Previous sources, package attributes and generated bench restored; imported car and track visuals retained.")
    return true
end

return function()
    local backup = script.Parent
    local H = require(backup.Support)
    local manifest = require(backup.Manifest)
    return H.exclusive(backup, "rollback", function() return rollbackLocked(backup, H, manifest) end)
end
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX5">
      <Properties>
