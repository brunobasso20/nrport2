          <Item class="ModuleScript" referent="RBX13">
            <Properties>
              <string name="Name">NR2003CupTrackBuild</string>
              <ProtectedString name="Source">-- GENERATED by watkinsglen_implementation/recovery/lift/gen_placed.py; do not edit.
-- Emitter decision tables of the car placed on the track (ORIGINAL 005b2f20 at the placed pose), for
-- NR2003CupBuild B.addStructure: fold = one byte per 0057c8d0 / 0057c900 / 0057ca60 event, litf = 005b9970
-- append (1) / share (0), lita = u32 literal addresses; ref = pool / literal top / code end / slots.
return {
placed = {fold = "",
litf = "",
lita = "",
ref = {pool = 4660, litTop = 15464784, codeEnd = 15445734, nlit = 1690, nfold = 60358, slots = {15389312, 15399923, 15418265, 15419778, 15421290, 15422769, 15424247, 15428041, 15440344}}},
placedGeneric = {fold = "",
litf = "",
lita = "",
ref = {pool = 4714, litTop = 15464700, codeEnd = 15445999, nlit = 1731, nfold = 60387, slots = {15389312, 15399962, 15418541, 15420054, 15421566, 15423045, 15424523, 15428294, 15440635}}},
}
</ProtectedString>
            </Properties>
          </Item>
