              <ProtectedString name="Source">--!optimize 2
-- GENERATED by recovery/stage10/gen_build10.py from recovery/stage10/build_host.luau; do not edit.
-- Stage 10: host of the ORIGINAL NR2003 setup application, lifted from NR2003.exe (NR2003CupBuildCode*).
-- Runs the original car-build sequence on the core memory for a garage setup:
--   00559820 (c03350, c055c0) derived setup items -&gt; 00550c40 engine -&gt; 00550c60 fuel -&gt; 00550bc0 tyres
--   -&gt; 005b29c0 component tree -&gt; 005b2f20 (0055e9b0 setup -&gt; runtime cells, 005b4060/005b4560/005b3f50/
--   005b2fb0/005b9ce0 callback generation, 005b3090 solve pass through the translated JIT) -&gt; 0054d610 x4.
-- The emitter decisions follow the GENERIC (setup-invariant) structure of the core's translated
-- callbacks (G tables in NR2003CupBuildData*); a setup whose natural emitter outcome cannot be
-- represented by that structure is reported (violation) and not committed.
local REF = {generic = {pool = 4711, litTop = 15464700, codeEnd = 15445999, nlit = 1731, nfold = 60387, slots = {15389312, 15399962, 15418541, 15420054, 15421566, 15423045, 15424523, 15428294, 15440635}},
	natural = {pool = 4660, litTop = 15464784, codeEnd = 15445734, nlit = 1690, nfold = 60358, slots = {15389312, 15399923, 15418265, 15419778, 15421290, 15422769, 15424247, 15428041, 15440344}}}
local CODE_PARTS, DATA_PARTS = 6, 2
local band, rshift = bit32.band, bit32.rshift
local ru, wu, rf, wf = buffer.readu32, buffer.writeu32, buffer.readf32, buffer.writef32

local B64 = {}
do
	local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	for i = 1, 64 do B64[string.byte(chars, i)] = i - 1 end
end
local function b64into(dst, off, s)
	local o = off
	for i = 1, #s, 4 do
		local a, b, c, d = string.byte(s, i, i + 3)
		local x = B64[a] * 262144 + B64[b] * 4096 + (c ~= 61 and B64[c] or 0) * 64 + (d ~= 61 and B64[d] or 0)
		buffer.writeu8(dst, o, rshift(x, 16)); o += 1
		if c ~= 61 then buffer.writeu8(dst, o, band(rshift(x, 8), 0xff)); o += 1 end
		if d ~= 61 then buffer.writeu8(dst, o, band(x, 0xff)); o += 1 end
	end
	return o - off
end

local ACTIVE, GARAGE, SLOT, ROOT = 0xc055c0, 0xc03350, 0xc12030, 0x727290
local BUILD_STACK_TOP = 0xf7c000

-- V: core (NR2003CupCore) ; codeParts: NR2003CupBuildCode1..n ; dataParts: NR2003CupBuildData1..n
return function(V, codeParts, dataParts)
	local REF = table.clone(REF) -- callback layouts belong to this vehicle instance
	assert(#codeParts == CODE_PARTS, "NR2003CupBuildCode: expected " .. CODE_PARTS .. " parts, found " .. #codeParts)
	assert(#dataParts == DATA_PARTS, "NR2003CupBuildData: expected " .. DATA_PARTS .. " parts, found " .. #dataParts)
	local M, BASE = V.memory(), V.base
	local G = {on = false, strict = false, fk = 0, lk = 0, viol = 0, imposed = 0, firstViol = nil, FOLD = "", LITF = "", LITA = nil, NLIT = 0}
	local JIT = V._jitTable()
	local function callJIT(a)
		local f = JIT[a]
		if not f then error(string.format("NR2003 build: generated callback %08x not in the active callback set", a)) end
		f()
	end
	local ctx = {M = M, base = BASE, F = {}, R = table.create(10, 0), XF = {}, G = G, callJIT = callJIT}
	for _, p in ipairs(codeParts) do p(ctx) end
	local XF, R = ctx.XF, ctx.R

	-- inputs: pre-application memory runs + decision tables of both callback structures:
	--   natural = the ORIGINAL emitter decisions of the default setup (the shipped NR2003CupJIT* code),
	--   generic = setup-invariant structure (NR2003CupJITG* code)
	local ZERO, DATA = {}, {}
	local TABLES = {natural = {}, generic = {}}
	local function u32s(s)
		local b = buffer.create(#s * 3 // 4)
		local n = b64into(b, 0, s)
		local t = buffer.create(n); buffer.copy(t, 0, b, 0, n)
		return t
	end
	for _, d in ipairs(dataParts) do
		if d.fold then TABLES.generic.FOLD = d.fold end
		if d.litf then TABLES.generic.LITF = d.litf end
		if d.lita then TABLES.generic.LITA = u32s(d.lita) end
		if d.nfold then TABLES.natural.FOLD = d.nfold end
		if d.nlitf then TABLES.natural.LITF = d.nlitf end
		if d.nlita then TABLES.natural.LITA = u32s(d.nlita) end
		for _, z in ipairs(d.zero) do ZERO[#ZERO + 1] = z end
		for _, x in ipairs(d.data) do DATA[#DATA + 1] = x end
	end
	for name, t in pairs(TABLES) do
		local r = REF[name]
		assert(t.FOLD and #t.FOLD == r.nfold and #t.LITF == r.nlit and buffer.len(t.LITA) == 4 * r.nlit, "NR2003CupBuildData tables (" .. name .. ")")
	end
	-- footprint runs (offsets, lengths) and decoded input bytes
	local RUNS, INPUT = {}, nil
	do
		local total = 0
		for _, x in ipairs(DATA) do total += #x[2] * 3 // 4 end
		INPUT = buffer.create(total)
		local o = 0
		for _, x in ipairs(DATA) do
			local n = b64into(INPUT, o, x[2])
			RUNS[#RUNS + 1] = {x[1], n, o}
			o += n
		end
		for _, z in ipairs(ZERO) do RUNS[#RUNS + 1] = {z[1], z[2], -1} end
	end
	local ZBUF = buffer.create(4096)
	-- Watkins Glen port: pre-application cells that a loaded track changed (track.ini tyre heat / wear tables, ...),
	-- written after the restore so that a garage rebuild sees the track (NR2003CupTrack, B.setInputOverrides)
	local OVERRIDE = {}
	local function restoreInputs()
		for _, r in ipairs(RUNS) do
			local off, len, src = r[1], r[2], r[3]
			if src &gt;= 0 then
				buffer.copy(M, off, INPUT, src, len)
			else
				while len &gt; 0 do
					local n = math.min(len, 4096)
					buffer.copy(M, off, ZBUF, 0, n)
					off += n; len -= n
				end
			end
		end
		for off, v in pairs(OVERRIDE) do buffer.writeu32(M, off, v) end
	end
	-- copy the footprint (everything the application writes or reads) between buffers
	local function copyFootprint(dst, src)
		for _, r in ipairs(RUNS) do buffer.copy(dst, r[1], src, r[1], r[2]) end
	end
	local FOOTPRINT_BYTES = 0
	for _, r in ipairs(RUNS) do FOOTPRINT_BYTES += r[2] end
	-- compact copy of the footprint of a memory buffer (and back)
	local function saveFootprint(src)
		local b, o = buffer.create(FOOTPRINT_BYTES), 0
		for _, r in ipairs(RUNS) do buffer.copy(b, o, src, r[1], r[2]); o += r[2] end
		return b
	end
	local function loadFootprint(dst, b)
		local o = 0
		for _, r in ipairs(RUNS) do buffer.copy(dst, r[1], b, o, r[2]); o += r[2] end
	end

	local function r32(a) return ru(M, a - BASE) end
	local function w32(a, v) wu(M, a - BASE, band(v)) end
	local function callx(addr, ecx, ...)
		local args = { ... }
		local n = #args
		local esp = band(R[8] - 4 * (n + 1))
		for k = 1, n do w32(esp + 4 * k, args[k]) end
		w32(esp, 0)
		R[8] = esp
		if ecx then R[3] = ecx end
		local f = XF[addr]
		if not f then error(string.format("NR2003 build: %08x not lifted", addr)) end
		f()
		R[8] = band(R[8] + 4 * n)
		return R[1]
	end

	-- the ORIGINAL application sequence (recovery/stage10/orig_setup.APPLY_CALLS), one entry per step
	local STEPS = {
		function() callx(0x559820, GARAGE) end,
		function() callx(0x559820, ACTIVE) end,
		function() callx(0x550c40); w32(SLOT + 0x5b2, 0) end,
		function() callx(0x550c60) end,
		function() callx(0x550bc0, nil, SLOT) end,
		function()
			local roots = callx(0x5b29c0)
			assert(roots == 1, "NR2003 build: 005b29c0 roots ~= 1")
			w32(0xbf6e1c, ROOT); wf(M, 0xbf6d58 + 12 - BASE, 1.0)
		end,
		-- 005b2f20(root, bf6d40), body call by call (identical sequence); emitter session = 57dcd0(0)..57dcd0(1)
		function() G.on = true; callx(0x57dcd0, nil, 0) end,
		function() callx(0x57c930) end,
		function() callx(0x55e9b0) end,
		function() for cell = 0xe84474, 0xe84494, 4 do callx(0x57c990, nil, cell, 0) end end,
		function() callx(0x5b4060, nil, ROOT) end,
		function() w32(0xe84664, 0xe84474); w32(0xe847c8, 0xbf6d40); callx(0x5b4560, nil, ROOT) end,
		function() w32(0xe84664, 0xe84474); callx(0x5b3f50, nil, ROOT) end,
		function() callx(0x5b2fb0, nil, ROOT) end,
		function() callx(0x5b9ce0) end,
		function() callx(0x57dcd0, nil, 2) end,
		function() callx(0x5b3090, nil, ROOT) end,
		function() callx(0x57dcd0, nil, 1); G.on = false end,
		function() for w = 0, 3 do callx(0x54d610, 0xbf3a20 + w * 0xa39) end end,
	}

	local SLOTS = {0xe84548, 0xe84498, 0xe84b90, 0xe84b94, 0xe84b98, 0xe84b9c, 0xe84bdc, 0xe84ba0, 0xe84604}
	local B = {}
	B.STEPS = #STEPS
	B.REF = REF
	-- begin: restore the pre-application memory, write the garage items into c03350 and c055c0
	-- items: {[index] = raw 32-bit internal value} (indices 0..183, NR2003CupSetup representation)
	function B.begin(items, structure)
		structure = structure or "natural"
		local t = TABLES[structure]
		assert(t, "NR2003 build: structure must be 'natural' or 'generic'")
		G.FOLD, G.LITF, G.LITA, G.NLIT = t.FOLD, t.LITF, t.LITA, #t.LITF
		G.strict = structure == "natural"
