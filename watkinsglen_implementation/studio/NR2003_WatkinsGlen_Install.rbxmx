          <Item class="ModuleScript" referent="RBX41">
            <Properties>
              <string name="Name">NR2003CupTrackData9</string>
              <ProtectedString name="Source">-- GENERATED by watkinsglen_implementation/recovery/lift/gen_track.py; do not edit.
-- Watkins Glen track image part 9/9: memory left by the ORIGINAL track load / build / track.ini /
-- 00573010 track init (Unicorn reference ref_track.py), offsets from the image base; top = end of the
-- track memory (the core memory is created to cover it).
return {part=9, parts=9, top=19202048,
zero={

},
data={
