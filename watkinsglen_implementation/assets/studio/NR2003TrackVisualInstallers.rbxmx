local storage = game:GetService("ServerStorage")
local PACKAGE = "watkins_glen_terrain_068"
local KIND = "terrain"
local SOURCE_HASH = "807e2c17ebda29c22e288625c38bb5026e8a2fad260437b83cf74ac02232a49d"
local GEOMETRIES = {
    {name="G000_terrain_106_10_part0",center=Vector3.new(1364.152854,87.124882,24.016741),opacity=1.0,blend=false,texture="trackmat__grass"},
}
local selected = Selection:Get()
local src
