@echo off
setlocal
set "WG_DOWNLOAD_DIR=%~dp0"
echo Downloading the real Watkins Glen Studio package. Keep this window open.
powershell.exe -NoProfile -Command "$ErrorActionPreference='Stop'; [Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12; $ProgressPreference='SilentlyContinue'; $root=$env:WG_DOWNLOAD_DIR; $info=Get-Content -LiteralPath (Join-Path $root 'package_info.json') -Raw | ConvertFrom-Json; $dest=Join-Path $root $info.file; $tmp=$dest+'.download'; $verified=(Test-Path -LiteralPath $dest) -and ((Get-Item -LiteralPath $dest).Length -eq $info.bytes) -and ((Get-FileHash -LiteralPath $dest -Algorithm SHA256).Hash.ToLower() -eq $info.sha256); if(-not $verified){ $body=@{operation='download';transfers=@('basic');objects=@(@{oid=$info.sha256;size=[long]$info.bytes})} | ConvertTo-Json -Depth 5; $batch=Invoke-RestMethod -Method Post -Uri 'https://github.com/brunobasso20/nrport2.git/info/lfs/objects/batch' -ContentType 'application/vnd.git-lfs+json' -Headers @{Accept='application/vnd.git-lfs+json'} -Body $body; $action=$batch.objects[0].actions.download; if(-not $action){throw 'GitHub did not return a download action'}; $headers=@{}; if($action.header){foreach($p in $action.header.PSObject.Properties){$headers[$p.Name]=$p.Value}}; Invoke-WebRequest -UseBasicParsing -Uri $action.href -Headers $headers -OutFile $tmp; if((Get-Item -LiteralPath $tmp).Length -ne $info.bytes -or (Get-FileHash -LiteralPath $tmp -Algorithm SHA256).Hash.ToLower() -ne $info.sha256){Remove-Item -LiteralPath $tmp;throw 'Download integrity check failed; please retry'}; if(Test-Path -LiteralPath $dest){throw 'An existing ZIP differs; rename it and rerun'}; Move-Item -LiteralPath $tmp -Destination $dest }; Write-Host ('Verified package saved: '+$dest); Write-Host 'Extract the ZIP, then follow README.md.'"
if errorlevel 1 echo Download failed. Read the message above and retry.
pause
